#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputBuffer {
    uint in_pixels[];
};

layout(std430, binding = 1) writeonly buffer OutputBuffer {
    uint out_pixels[];
};

struct LayerData {
    float isEnabled;              // 0: Disabled, 1: Enabled
    float opacity;                // 0.0 to 1.0
    float blendMode;              // 0:Normal, 1:Screen, 2:Linear Add, 3:Overlay, 4:Soft Light, 5:Multiply
    float brightness;             // -0.5 to +0.5
    float saturation;             // 0.0 to 2.0
    float contrast;               // 0.5 to 2.0 (0.18 Mid-Gray Pivot)
    float sharpness;              // 0.0 to 1.0
    float gamma;                  // 0.4 to 2.0
    float hue;                    // -0.5 to +0.5
    float temperature;            // Kelvin (3000 to 9500)

    // Deep Glow & Flares
    float deepGlowIntensity;      // 0.0 to 1.5
    float deepGlowRadius;         // 0.1 to 1.0
    float deepGlowThreshold;      // 0.1 to 0.9
    float edgeGlowTint;           // 0:Neutral, 1:Gold, 2:Cyan, 3:Dark/Ink, 4:Crimson, 5:Violet
    float thinStreakIntensity;    // 0.0 to 1.0 (Anamorphic flare)
    float lineChromaStrength;     // 0.0 to 1.0 (Edge chromatic aberration)
    float volRaysLength;          // 0.0 to 1.0 (Sapphire S_EdgeRays)
    float volRaysDecay;           // 0.70 to 0.98

    // Tone & Detail
    float shadows;                // -1.0 to 1.0
    float highlights;             // -1.0 to 1.0
    float blackCrush;             // 0.0 to 0.5
    float vignette;               // 0.0 to 0.5 (Radial)
    float vignetteBoxed;          // 0.0 to 0.5 (Boxed)
    float edgeDarken;             // 0.0 to 1.0 (Interior line art shadow)
    float darkOutlines;           // 0.0 to 1.0 (Sobel line darkener)
    float denoise;                // 0.0 to 1.0 (Bilateral filter)
    float filmGrain;              // 0.0 to 0.3
    float flickerIntensity;       // 0.0 to 1.0
    float flickerSpeed;           // 1.0 to 10.0
    float halationRadius;         // 0.0 to 1.0
    float halationWarmth;         // 0.0 to 1.0
    float depthOfField;           // 0.0 to 1.0
    float dofFocus;               // 0.0 to 1.0
    float splitToning;            // 0.0 to 1.0
    float fourColorGradMix;       // 0.0 to 1.0

    // Master Catmull-Rom Spline Curve (P0..P4)
    float curveM0; float curveM1; float curveM2; float curveM3; float curveM4;

    // Per-Channel Curves (Red, Green, Blue)
    float curveR0; float curveR1; float curveR2; float curveR3; float curveR4;
    float curveG0; float curveG1; float curveG2; float curveG3; float curveG4;
    float curveB0; float curveB1; float curveB2; float curveB3; float curveB4;
};

layout(binding = 2) uniform UniformBlock {
    float u_time;
    float u_layerCount;
    float u_tonemapMode;          // 0: Off, 1: Reinhard, 2: ACES
    float u_imgWidth;
    float u_imgHeight;
    float pad0;
    float pad1;
    float pad2;
    LayerData layers[4];
};

vec4 unpackRGBA(uint val) {
    float r = float(val & 0xFFu) / 255.0;
    float g = float((val >> 8u) & 0xFFu) / 255.0;
    float b = float((val >> 16u) & 0xFFu) / 255.0;
    float a = float((val >> 24u) & 0xFFu) / 255.0;
    return vec4(r, g, b, a);
}

uint packRGBA(vec4 col) {
    uint r = uint(clamp(col.r * 255.0, 0.0, 255.0));
    uint g = uint(clamp(col.g * 255.0, 0.0, 255.0));
    uint b = uint(clamp(col.b * 255.0, 0.0, 255.0));
    uint a = uint(clamp(col.a * 255.0, 0.0, 255.0));
    return (a << 24u) | (b << 16u) | (g << 8u) | r;
}

float evalCatmullRom(float x, float p0, float p1, float p2, float p3, float p4) {
    x = clamp(x, 0.0, 1.0);
    float seg = x * 4.0;
    int idx = int(floor(seg));
    if (idx >= 4) return p4;
    float t = seg - float(idx);

    float cp0 = (idx == 0) ? p0 : (idx == 1) ? p0 : (idx == 2) ? p1 : p2;
    float cp1 = (idx == 0) ? p0 : (idx == 1) ? p1 : (idx == 2) ? p2 : p3;
    float cp2 = (idx == 0) ? p1 : (idx == 1) ? p2 : (idx == 2) ? p3 : p4;
    float cp3 = (idx == 0) ? p2 : (idx == 1) ? p3 : (idx == 2) ? p4 : p4;

    float m1 = 0.5 * (cp2 - cp0);
    float m2 = 0.5 * (cp3 - cp1);

    float t2 = t * t;
    float t3 = t2 * t;

    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;

    return clamp(h00 * cp1 + h10 * m1 + h01 * cp2 + h11 * m2, 0.0, 1.0);
}

float hash12(vec2 p) {
    vec3 p3  = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec3 tonemapACES(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

vec3 tonemapReinhardExtended(vec3 x) {
    float maxWhite = 3.0;
    return (x * (1.0 + (x / (maxWhite * maxWhite)))) / (1.0 + x);
}

vec3 colorTempToRGB(float kelvin) {
    if (kelvin < 1000.0) return vec3(1.0);
    float temp = kelvin / 100.0;
    float red, green, blue;

    if (temp <= 66.0) {
        red = 255.0;
        green = temp;
        green = 99.4708025861 * log(max(green, 1.0)) - 161.1195681661;
        if (temp <= 19.0) {
            blue = 0.0;
        } else {
            blue = temp - 10.0;
            blue = 138.5177312231 * log(max(blue, 1.0)) - 305.0447927307;
        }
    } else {
        red = temp - 60.0;
        red = 329.698727446 * pow(max(red, 1.0), -0.1332047592);
        green = temp - 60.0;
        green = 288.1221695283 * pow(max(green, 1.0), -0.0755148492);
        blue = 255.0;
    }

    return clamp(vec3(red, green, blue) / 255.0, 0.0, 1.0);
}

vec3 applyBlendMode(vec3 baseCol, vec3 blendCol, int mode, float opacity) {
    vec3 result = blendCol;
    if (mode == 1) {
        // Screen (Glows / Blooms)
        result = 1.0 - (1.0 - baseCol) * (1.0 - blendCol);
    } else if (mode == 2) {
        // Linear Add
        result = baseCol + blendCol;
    } else if (mode == 3) {
        // Overlay
        result = mix(2.0 * baseCol * blendCol, 1.0 - 2.0 * (1.0 - baseCol) * (1.0 - blendCol), step(vec3(0.5), baseCol));
    } else if (mode == 4) {
        // Soft Light
        result = (1.0 - 2.0 * blendCol) * baseCol * baseCol + 2.0 * blendCol * baseCol;
    } else if (mode == 5) {
        // Multiply
        result = baseCol * blendCol;
    }
    return clamp(mix(baseCol, result, clamp(opacity, 0.0, 1.0)), 0.0, 4.0);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    int width = int(u_imgWidth > 0.0 ? u_imgWidth : gl_NumWorkGroups.x * gl_WorkGroupSize.x);
    int height = int(u_imgHeight > 0.0 ? u_imgHeight : gl_NumWorkGroups.y * gl_WorkGroupSize.y);

    if (coord.x >= width || coord.y >= height) return;

    int pixelIndex = coord.y * width + coord.x;
    vec4 basePixel = unpackRGBA(in_pixels[pixelIndex]);
    vec3 currentComposite = basePixel.rgb;

    // Sobel line-art edge detection
    float gx = 0.0, gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 c = clamp(coord + ivec2(x, y), ivec2(0), ivec2(width - 1, height - 1));
            vec4 p = unpackRGBA(in_pixels[c.y * width + c.x]);
            float lum = dot(p.rgb, vec3(0.299, 0.587, 0.114));
            float kx = float(x) * ((y == 0) ? 2.0 : 1.0);
            float ky = float(y) * ((x == 0) ? 2.0 : 1.0);
            gx += lum * kx;
            gy += lum * ky;
        }
    }
    float lineEdge = sqrt(gx * gx + gy * gy);

    int totalLayers = int(clamp(u_layerCount, 1.0, 4.0));

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;

        vec3 layerColor = currentComposite;

        // 1. Line-Targeted Chromatic Aberration
        if (L.lineChromaStrength > 0.001) {
            float edgeFactor = smoothstep(0.05, 0.28, lineEdge);
            vec2 uv = (vec2(coord) / vec2(width, height)) - 0.5;
            float dist = length(uv);
            ivec2 shift = ivec2(uv * L.lineChromaStrength * 10.0 * (0.25 + dist) * edgeFactor);

            ivec2 rCoord = clamp(coord + shift, ivec2(0), ivec2(width - 1, height - 1));
            ivec2 bCoord = clamp(coord - shift, ivec2(0), ivec2(width - 1, height - 1));

            vec4 rPix = unpackRGBA(in_pixels[rCoord.y * width + rCoord.x]);
            vec4 bPix = unpackRGBA(in_pixels[bCoord.y * width + bCoord.x]);

            layerColor.r = mix(layerColor.r, rPix.r, edgeFactor);
            layerColor.b = mix(layerColor.b, bPix.b, edgeFactor);
        }

        // 2. Bilateral Denoise Filter
        if (L.denoise > 0.01) {
            vec3 avgCol = layerColor;
            int count = 1;
            ivec2 offsets[4] = ivec2[](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
            for (int k = 0; k < 4; k++) {
                ivec2 c = coord + offsets[k];
                if (c.x >= 0 && c.x < width && c.y >= 0 && c.y < height) {
                    vec4 nCol = unpackRGBA(in_pixels[c.y * width + c.x]);
                    if (distance(layerColor, nCol.rgb) < 0.15) {
                        avgCol += nCol.rgb;
                        count++;
                    }
                }
            }
            layerColor = mix(layerColor, avgCol / float(count), L.denoise * 0.85);
        }

        // 3. Micro-Sharpness
        if (L.sharpness > 0.01) {
            vec4 blur = vec4(0.0);
            blur += unpackRGBA(in_pixels[clamp(coord.y - 1, 0, height - 1) * width + coord.x]);
            blur += unpackRGBA(in_pixels[clamp(coord.y + 1, 0, height - 1) * width + coord.x]);
            blur += unpackRGBA(in_pixels[coord.y * width + clamp(coord.x - 1, 0, width - 1)]);
            blur += unpackRGBA(in_pixels[coord.y * width + clamp(coord.x + 1, 0, width - 1)]);
            blur *= 0.25;
            vec3 detail = layerColor - blur.rgb;
            layerColor += detail * L.sharpness * 1.5;
        }

        // 4. Sobel Dark Outlines
        if (L.darkOutlines > 0.01) {
            layerColor = mix(layerColor, vec3(0.0), clamp(lineEdge * L.darkOutlines * 0.8, 0.0, 1.0));
        }

        // 5. Line Art Edge Darken (Soft inward drop shadow on line boundaries)
        if (L.edgeDarken > 0.01) {
            float innerEdge = smoothstep(0.08, 0.35, lineEdge);
            layerColor *= (1.0 - innerEdge * L.edgeDarken * 0.40);
        }

        // 6. Color Temperature
        if (L.temperature > 1000.0 && abs(L.temperature - 6500.0) > 30.0) {
            vec3 tempColor = colorTempToRGB(L.temperature);
            layerColor *= tempColor / colorTempToRGB(6500.0);
        }

        // 7. Exposure, Contrast & Black Crush
        layerColor += vec3(L.brightness);
        layerColor = (layerColor - 0.18) * L.contrast + 0.18;

        if (L.blackCrush > 0.01) {
            layerColor = smoothstep(vec3(L.blackCrush * 0.12), vec3(1.0), layerColor);
        }

        float luma = dot(layerColor, vec3(0.299, 0.587, 0.114));
        layerColor += vec3(L.shadows * (1.0 - luma) * 0.35);
        layerColor += vec3(L.highlights * luma * 0.35);
        layerColor = pow(max(layerColor, vec3(0.0)), vec3(1.0 / max(L.gamma, 0.001)));

        // 8. Individual RGB Channel Spline Curves
        layerColor.r = evalCatmullRom(layerColor.r, L.curveR0, L.curveR1, L.curveR2, L.curveR3, L.curveR4);
        layerColor.g = evalCatmullRom(layerColor.g, L.curveG0, L.curveG1, L.curveG2, L.curveG3, L.curveG4);
        layerColor.b = evalCatmullRom(layerColor.b, L.curveB0, L.curveB1, L.curveB2, L.curveB3, L.curveB4);

        // 9. Master Spline Curve
        layerColor.r = evalCatmullRom(layerColor.r, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);
        layerColor.g = evalCatmullRom(layerColor.g, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);
        layerColor.b = evalCatmullRom(layerColor.b, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);

        // 10. Saturation & Hue Shift
        luma = dot(layerColor, vec3(0.299, 0.587, 0.114));
        layerColor = mix(vec3(luma), layerColor, L.saturation);

        if (abs(L.hue) > 0.001) {
            float angle = L.hue * 3.14159265;
            float cosA = cos(angle);
            float sinA = sin(angle);
            mat3 hueMat = mat3(
                vec3(0.213 + cosA*0.787 - sinA*0.213, 0.715 - cosA*0.715 - sinA*0.715, 0.072 - cosA*0.072 + sinA*0.928),
                vec3(0.213 - cosA*0.213 + sinA*0.143, 0.715 + cosA*0.285 + sinA*0.140, 0.072 - cosA*0.072 - sinA*0.283),
                vec3(0.213 - cosA*0.213 - sinA*0.787, 0.715 - cosA*0.715 + sinA*0.715, 0.072 + cosA*0.928 + sinA*0.072)
            );
            layerColor = clamp(hueMat * layerColor, 0.0, 1.0);
        }

        // 11. Split Toning
        if (L.splitToning > 0.01) {
            vec3 shadowTint = vec3(0.0, 0.03, 0.08) * (1.0 - luma);
            vec3 highlightTint = vec3(0.08, 0.04, 0.0) * luma;
            layerColor += (shadowTint + highlightTint) * L.splitToning;
        }

        // 12. Continuous Inverse-Square Deep Glow
        if (L.deepGlowIntensity > 0.01) {
            vec3 bloomTint = vec3(1.0);
            if (L.edgeGlowTint == 1.0) bloomTint = vec3(1.20, 1.05, 0.65);       // Gold/Holy
            else if (L.edgeGlowTint == 2.0) bloomTint = vec3(0.40, 1.15, 1.45);  // Infinity / Quincy Cyan
            else if (L.edgeGlowTint == 3.0) bloomTint = vec3(0.15, 0.15, 0.20);  // Dark / Ink
            else if (L.edgeGlowTint == 4.0) bloomTint = vec3(1.40, 0.35, 0.35);  // Malevolent Crimson
            else if (L.edgeGlowTint == 5.0) bloomTint = vec3(0.85, 0.45, 1.40);  // Shogun Violet

            vec3 bloomAcc = vec3(0.0);
            float totalWeight = 0.0;
            int maxRadius = int(clamp(L.deepGlowRadius * 24.0, 4.0, 24.0));
            float falloff = max(0.06, (1.0 - L.deepGlowRadius) * 0.18);

            for (int dy = -maxRadius; dy <= maxRadius; dy += 2) {
                for (int dx = -maxRadius; dx <= maxRadius; dx += 2) {
                    ivec2 sCoord = clamp(coord + ivec2(dx, dy), ivec2(0), ivec2(width - 1, height - 1));
                    vec4 sCol = unpackRGBA(in_pixels[sCoord.y * width + sCoord.x]);
                    float sLum = dot(sCol.rgb, vec3(0.299, 0.587, 0.114));

                    float pass = smoothstep(L.deepGlowThreshold - 0.15, L.deepGlowThreshold + 0.15, sLum);
                    float dist = length(vec2(dx, dy));
                    float weight = 1.0 / (1.0 + pow(dist * falloff, 1.9));

                    bloomAcc += sCol.rgb * pass * weight;
                    totalWeight += weight;
                }
            }
            vec3 finalBloom = (bloomAcc / max(totalWeight, 0.0001)) * (L.deepGlowIntensity * 1.35) * bloomTint;
            layerColor += finalBloom;
        }

        // 13. Anamorphic 1D Streak Flare
        if (L.thinStreakIntensity > 0.01) {
            vec3 flareAcc = vec3(0.0);
            int flareSpan = int(float(width) * 0.14);
            for (int dx = -flareSpan; dx <= flareSpan; dx += 4) {
                ivec2 fc = clamp(ivec2(coord.x + dx, coord.y), ivec2(0), ivec2(width - 1, height - 1));
                vec4 fp = unpackRGBA(in_pixels[fc.y * width + fc.x]);
                float fLum = dot(fp.rgb, vec3(0.299, 0.587, 0.114));
                if (fLum > 0.78) {
                    float falloff = 1.0 - (abs(float(dx)) / float(flareSpan));
                    flareAcc += fp.rgb * pow(falloff, 2.2);
                }
            }
            layerColor += flareAcc * vec3(0.35, 0.75, 1.30) * L.thinStreakIntensity * 0.08;
        }

        // 14. Volumetric Occluded Light Rays (Sapphire S_EdgeRays)
        if (L.volRaysLength > 0.01) {
            vec2 center = vec2(width, height) * 0.5;
            vec2 delta = (center - vec2(coord)) * (0.018 * L.volRaysLength);
            vec3 rayAcc = vec3(0.0);
            vec2 curCoord = vec2(coord);
            float decay = 1.0;
            for (int s = 0; s < 10; s++) {
                curCoord += delta;
                ivec2 sc = clamp(ivec2(curCoord), ivec2(0), ivec2(width - 1, height - 1));
                vec4 sp = unpackRGBA(in_pixels[sc.y * width + sc.x]);
                float sLum = dot(sp.rgb, vec3(0.299, 0.587, 0.114));
                float pass = smoothstep(0.70, 1.0, sLum);
                rayAcc += sp.rgb * pass * decay;
                decay *= L.volRaysDecay;
            }
            layerColor = 1.0 - (1.0 - layerColor) * (1.0 - clamp(rayAcc * L.volRaysLength * 0.14, 0.0, 0.95));
        }

        // 15. Depth of Field Blur
        if (L.depthOfField > 0.01) {
            float normY = float(coord.y) / float(height);
            float dofDist = abs(normY - L.dofFocus);
            if (dofDist > 0.15) {
                float blurAmount = (dofDist - 0.15) * L.depthOfField * 3.5;
                vec3 blurAcc = layerColor;
                int bRad = int(clamp(blurAmount, 1.0, 3.0));
                for (int by = -bRad; by <= bRad; by += 2) {
                    for (int bx = -bRad; bx <= bRad; bx += 2) {
                        ivec2 bc = clamp(coord + ivec2(bx, by), ivec2(0), ivec2(width - 1, height - 1));
                        blurAcc += unpackRGBA(in_pixels[bc.y * width + bc.x]).rgb;
                    }
                }
                layerColor = mix(layerColor, blurAcc / 5.0, clamp(blurAmount, 0.0, 1.0));
            }
        }

        // 16. Halation Bleed & Warmth
        if (L.halationRadius > 0.01) {
            float redBleed = smoothstep(0.50, 0.95, luma) * L.halationRadius * 0.35;
            layerColor.r += redBleed * (1.0 + L.halationWarmth * 0.5);
            layerColor.g += redBleed * (0.2 + L.halationWarmth * 0.15);
        }

        // 17. Film Grain
        if (L.filmGrain > 0.001) {
            float noise = (hash12(vec2(coord) + vec2(u_time * 17.13, u_time * 31.37)) - 0.5);
            layerColor += vec3(noise * L.filmGrain * 0.06);
        }

        // 18. Flicker
        if (L.flickerIntensity > 0.01) {
            float fWave = sin(u_time * max(L.flickerSpeed, 1.0) * 6.2831853) * 0.5 + 0.5;
            layerColor *= (1.0 + (fWave - 0.5) * L.flickerIntensity * 0.35);
        }

        // 19. 4-Corner Vignette Gradient Mix
        if (L.fourColorGradMix > 0.01) {
            vec2 uv = vec2(coord) / vec2(width, height);
            vec3 cTL = vec3(0.85, 0.92, 1.0);
            vec3 cTR = vec3(1.0, 0.85, 0.92);
            vec3 cBL = vec3(0.92, 1.0, 0.85);
            vec3 cBR = vec3(1.0, 0.95, 0.85);
            vec3 grad = mix(mix(cTL, cTR, uv.x), mix(cBL, cBR, uv.x), uv.y);
            layerColor = mix(layerColor, layerColor * grad, L.fourColorGradMix * 0.5);
        }

        // 20. Soft Radial Vignette
        if (L.vignette > 0.01) {
            vec2 uv = (vec2(coord) / vec2(width, height)) - 0.5;
            float dist = length(uv);
            float vig = smoothstep(0.70, 0.20, dist * (0.8 + L.vignette * 0.4));
            layerColor *= clamp(vig, 0.0, 1.0);
        }

        // 21. Boxed Vignette
        if (L.vignetteBoxed > 0.01) {
            vec2 uv = abs((vec2(coord) / vec2(width, height)) - 0.5) * 2.0;
            float boxDist = max(uv.x, uv.y);
            float boxVig = smoothstep(0.95, 0.40, boxDist * (0.8 + L.vignetteBoxed * 0.4));
            layerColor *= clamp(boxVig, 0.0, 1.0);
        }

        // Blend this layer onto the current composite
        currentComposite = applyBlendMode(currentComposite, layerColor, int(L.blendMode), L.opacity);
    }

    // Master Tonemapping
    if (u_tonemapMode == 1.0) {
        currentComposite = tonemapReinhardExtended(currentComposite);
    } else if (u_tonemapMode == 2.0) {
        currentComposite = tonemapACES(currentComposite);
    }

    out_pixels[pixelIndex] = packRGBA(vec4(currentComposite, basePixel.a));
}
