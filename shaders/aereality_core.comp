#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D inputImage;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D outputImage;

// Keep the uniform block so the layout doesn't change
layout(set = 0, binding = 2, std140) uniform Uniforms {
    vec2 resolution;
    float brightness;
    float saturation;
    float contrast;
    float sharpness;
    float gamma;
    float hue;
    float temperature;
    float glowIntensity;
    float lookMix;
    float vignette;
    float splitToning;
} u;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inputImage);
    if (pos.x >= size.x || pos.y >= size.y) return;

    vec4 color = imageLoad(inputImage, pos);

    // Passthrough
    vec3 finalColor = color.rgb;

    // Debug: draw a red square in the top-left corner (100x100 pixels)
    if (pos.x < 100 && pos.y < 100) {
        finalColor = vec3(1.0, 0.0, 0.0);
    }

    imageStore(outputImage, pos, vec4(finalColor, color.a));
}
