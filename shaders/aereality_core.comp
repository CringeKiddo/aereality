#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D inputImage;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outputImage;

// std140 uniform block (60 floats / 240 bytes)
layout(set = 0, binding = 2, std140) uniform Uniforms {
    vec2 resolution;          // offset 0..1 (8 bytes)
    float time;               // offset 2    (4 bytes)
    float brightness;         // offset 3    (4 bytes)
    float saturation;         // offset 4    (4 bytes)
    float contrast;           // offset 5    (4 bytes)
    float sharpness;          // offset 6    (4 bytes)
    float gamma;              // offset 7    (4 bytes)
    float hue;                // offset 8    (4 bytes)
    float temperature;        // offset 9    (4 bytes)
    float glowIntensity;      // offset 10   (4 bytes)
    float glowSpread;         // offset 11   (4 bytes)
    float edgeGlow;           // offset 12   (4 bytes)
    float edgeDarken;         // offset 13   (4 bytes)
    float vignette;           // offset 14   (4 bytes)
    float splitToning;        // offset 15   (4 bytes)
    float denoise;            // offset 16   (4 bytes)
    float darkOutlines;       // offset 17   (4 bytes)
    float blackCrush;         // offset 18   (4 bytes)
    float flickerIntensity;   // offset 19   (4 bytes)
    float flickerSpeed;       // offset 20   (4 bytes)
    float dustParticles;      // offset 21   (4 bytes)
    float dustIntensity;      // offset 22   (4 bytes)
    float dustSpeed;          // offset 23   (4 bytes)
    float godRays;            // offset 24   (4 bytes)
    float volumetricFog;      // offset 25   (4 bytes)
    float depthOfField;       // offset 26   (4 bytes)
    float edgeGlowColorMode;  // offset 27   (4 bytes) 0: White, 1: Gold, 2: Quincy Blue, 3: Cyan, 4: Crimson
    vec4 curveMasterA;        // offset 28..31
    vec4 curveMasterB;        // offset 32..35
    vec4 curveRedA;           // offset 36..39
    vec4 curveRedB;           // offset 40..43
    vec4 curveGreenA;         // offset 44..47
    vec4 curveGreenB;         // offset 48..51
    vec4 curveBlueA;          // offset 52..55
    vec4 curveBlueB;          // offset 56..59
} u;

vec3 srgbToLinear(vec3 srgb) {
    vec3 less = step(vec3(0.04045), srgb);
    return mix(srgb / 12.92, pow((srgb + 0.055) / 1.055, vec3(2.4)), less);
}

vec3 linearToSrgb(vec3 lin) {
    lin = max(lin, vec3(0.0));
    vec3 less = step(vec3(0.0031308), lin);
    return mix(lin * 12.92, pow(lin, vec3(1.0 / 2.4)) * 1.055 - 0.055, less);
}

float evalCurve5(float x, vec4 cA, float c4) {
    x = clamp(x, 0.0, 1.0);
    float p0 = cA.x, p1 = cA.y, p2 = cA.z, p3 = cA.w, p4 = c4;
    float segment = x * 4.0;
    int idx = int(floor(segment));
    if (idx >= 4) return p4;
    float t = fract(segment);
    float y0, y1, y2, y3;
    if (idx == 0) { y0 = p0; y1 = p0; y2 = p1; y3 = p2; }
    else if (idx == 1) { y0 = p0; y1 = p1; y2 = p2; y3 = p3; }
    else if (idx == 2) { y0 = p1; y1 = p2; y2 = p3; y3 = p4; }
    else { y0 = p2; y1 = p3; y2 = p4; y3 = p4; }

    float m1 = 0.5 * (y2 - y0);
    float m2 = 0.5 * (y3 - y1);
    float t2 = t * t;
    float t3 = t2 * t;
    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;
    return clamp(h00 * y1 + h10 * m1 + h01 * y2 + h11 * m2, 0.0, 1.0);
}

vec3 applyCurves(vec3 col) {
    vec3 outCol;
    outCol.r = evalCurve5(col.r, u.curveRedA, u.curveRedB.x);
    outCol.g = evalCurve5(col.g, u.curveGreenA, u.curveGreenB.x);
    outCol.b = evalCurve5(col.b, u.curveBlueA, u.curveBlueB.x);
    outCol.r = evalCurve5(outCol.r, u.curveMasterA, u.curveMasterB.x);
    outCol.g = evalCurve5(outCol.g, u.curveMasterA, u.curveMasterB.x);
    outCol.b = evalCurve5(outCol.b, u.curveMasterA, u.curveMasterB.x);
    return outCol;
}

vec3 adjustTemperature(vec3 color, float temp) {
    float r = color.r * (temp / 6500.0);
    float b = color.b * (6500.0 / temp);
    return vec3(r, color.g, b);
}

vec3 rotateHue(vec3 color, float angle) {
    float cosA = cos(angle * 3.14159265 / 180.0);
    float sinA = sin(angle * 3.14159265 / 180.0);
    mat3 rotMat = mat3(
        0.299 + 0.701 * cosA + 0.168 * sinA,
        0.587 - 0.587 * cosA + 0.330 * sinA,
        0.114 - 0.114 * cosA - 0.497 * sinA,
        0.299 - 0.299 * cosA - 0.328 * sinA,
        0.587 + 0.413 * cosA + 0.035 * sinA,
        0.114 - 0.114 * cosA + 0.293 * sinA,
        0.299 - 0.300 * cosA + 1.250 * sinA,
        0.587 - 0.588 * cosA - 1.050 * sinA,
        0.114 + 0.886 * cosA - 0.200 * sinA
    );
    return rotMat * color;
}

// True AE Optical Deep Glow with Inverse-Squared Falloff
vec3 deepGlowInverseSquare(ivec2 pos, ivec2 size, float intensity, float spread) {
    if (intensity <= 0.001) return vec3(0.0);
    const int SAMPLES = 32;
    float maxR = (30.0 + spread * 80.0);
    vec3 accum = vec3(0.0);
    float wTotal = 0.0;

    for (int i = 0; i < SAMPLES; i++) {
        float angle = float(i) * 6.2831853 / float(SAMPLES);
        float rFrac = sqrt(float(i + 1) / float(SAMPLES));
        float r = maxR * rFrac;
        ivec2 sPos = clamp(pos + ivec2(int(r * cos(angle)), int(r * sin(angle))), ivec2(0), size - 1);
        vec3 col = srgbToLinear(imageLoad(inputImage, sPos).rgb);
        float lum = dot(col, vec3(0.299, 0.587, 0.114));

        float threshold = max((lum - 0.75) / 0.25, 0.0);
        float dist = length(vec2(sPos - pos));
        float invSq = 1.0 / (1.0 + pow(dist / (maxR * 0.35 + 1.0), 2.0));
        float weight = invSq * threshold;

        vec3 glowTint = mix(vec3(1.0, 1.0, 1.0), vec3(1.15, 0.95, 0.75), 0.5);
        accum += col * glowTint * weight;
        wTotal += weight;
    }
    if (wTotal <= 0.0001) return vec3(0.0);
    return (accum / wTotal) * (intensity * 1.8);
}

// Edge Glow with Dynamic Palette (White, Gold, Quincy Blue, Cyan, Crimson)
vec3 calculateEdgeGlow(ivec2 pos, ivec2 size, float intensity, float colorMode) {
    if (intensity <= 0.001) return vec3(0.0);
    ivec2 pN = clamp(pos + ivec2(0, -2), ivec2(0), size - 1);
    ivec2 pS = clamp(pos + ivec2(0,  2), ivec2(0), size - 1);
    ivec2 pW = clamp(pos + ivec2(-2, 0), ivec2(0), size - 1);
    ivec2 pE = clamp(pos + ivec2( 2, 0), ivec2(0), size - 1);

    vec3 cN = srgbToLinear(imageLoad(inputImage, pN).rgb);
    vec3 cS = srgbToLinear(imageLoad(inputImage, pS).rgb);
    vec3 cW = srgbToLinear(imageLoad(inputImage, pW).rgb);
    vec3 cE = srgbToLinear(imageLoad(inputImage, pE).rgb);

    float lumN = dot(cN, vec3(0.299, 0.587, 0.114));
    float lumS = dot(cS, vec3(0.299, 0.587, 0.114));
    float lumW = dot(cW, vec3(0.299, 0.587, 0.114));
    float lumE = dot(cE, vec3(0.299, 0.587, 0.114));

    float edge = length(vec2(lumE - lumW, lumS - lumN));
    
    vec3 tint = vec3(1.0, 1.0, 1.0); // 0: White
    if (colorMode > 0.5 && colorMode < 1.5) tint = vec3(1.2, 0.95, 0.55); // 1: Gold
    else if (colorMode >= 1.5 && colorMode < 2.5) tint = vec3(0.5, 0.75, 1.3); // 2: Quincy Blue
    else if (colorMode >= 2.5 && colorMode < 3.5) tint = vec3(0.2, 1.1, 1.2); // 3: Cyan
    else if (colorMode >= 3.5) tint = vec3(1.3, 0.3, 0.4); // 4: Crimson

    return tint * smoothstep(0.10, 0.60, edge) * (intensity * 0.85);
}

// Manga / Anime Character Edge Darkening Blur
vec3 applyDarkEdgeBlur(vec3 col, ivec2 pos, ivec2 size, float amount) {
    if (amount <= 0.001) return col;
    ivec2 pN = clamp(pos + ivec2(0, -2), ivec2(0), size - 1);
    ivec2 pS = clamp(pos + ivec2(0,  2), ivec2(0), size - 1);
    ivec2 pW = clamp(pos + ivec2(-2, 0), ivec2(0), size - 1);
    ivec2 pE = clamp(pos + ivec2( 2, 0), ivec2(0), size - 1);

    float lN = dot(imageLoad(inputImage, pN).rgb, vec3(0.299, 0.587, 0.114));
    float lS = dot(imageLoad(inputImage, pS).rgb, vec3(0.299, 0.587, 0.114));
    float lW = dot(imageLoad(inputImage, pW).rgb, vec3(0.299, 0.587, 0.114));
    float lE = dot(imageLoad(inputImage, pE).rgb, vec3(0.299, 0.587, 0.114));

    float edgeGrad = length(vec2(lE - lW, lS - lN));
    float darkEdge = smoothstep(0.08, 0.55, edgeGrad) * amount;
    return mix(col, col * 0.45, darkEdge * 0.65);
}

// Unsharp Mask Edge Sharpness
vec3 applySharpness(vec3 center, ivec2 pos, ivec2 size, float amount) {
    if (amount <= 0.001) return center;
    ivec2 pN = clamp(pos + ivec2(0, -1), ivec2(0), size - 1);
    ivec2 pS = clamp(pos + ivec2(0,  1), ivec2(0), size - 1);
    ivec2 pW = clamp(pos + ivec2(-1, 0), ivec2(0), size - 1);
    ivec2 pE = clamp(pos + ivec2( 1, 0), ivec2(0), size - 1);

    vec3 cN = srgbToLinear(imageLoad(inputImage, pN).rgb);
    vec3 cS = srgbToLinear(imageLoad(inputImage, pS).rgb);
    vec3 cW = srgbToLinear(imageLoad(inputImage, pW).rgb);
    vec3 cE = srgbToLinear(imageLoad(inputImage, pE).rgb);

    vec3 laplacian = (cN + cS + cW + cE) * 0.25;
    vec3 highPass = center - laplacian;
    return center + highPass * (amount * 1.5);
}

// Anime Ink Line Darkener
vec3 applyDarkOutlines(vec3 col, ivec2 pos, ivec2 size, float amount) {
    if (amount <= 0.001) return col;
    float lum = dot(col, vec3(0.299, 0.587, 0.114));
    float isDark = 1.0 - smoothstep(0.02, 0.30, lum);
    return mix(col, vec3(0.0), isDark * (amount * 0.75));
}

// Real Shutter Strobe to Black
float calculateBlackFlicker(float intensity, float speed, float time) {
    if (intensity <= 0.001) return 1.0;
    float baseSpeed = max(speed, 0.1);
    float stepSeed = floor(time * baseSpeed * 12.0);
    float rnd = fract(sin(stepSeed * 78.233) * 43758.5453);
    if (rnd < (intensity * 0.35)) {
        return mix(1.0, 0.0, intensity * 0.95);
    }
    return 1.0;
}

// Volumetric RTX God Rays
vec3 calculateGodRays(vec2 uv, float amount, ivec2 inSize) {
    if (amount <= 0.001) return vec3(0.0);
    vec2 lightSource = vec2(0.5, 0.25);
    vec2 delta = (uv - lightSource) / 16.0;
    vec2 currentUv = uv;
    vec3 accum = vec3(0.0);
    float decay = 1.0;

    for (int i = 0; i < 16; i++) {
        currentUv -= delta;
        ivec2 sPos = clamp(ivec2(currentUv * vec2(inSize)), ivec2(0), inSize - 1);
        vec3 sCol = srgbToLinear(imageLoad(inputImage, sPos).rgb);
        float sLum = dot(sCol, vec3(0.299, 0.587, 0.114));
        if (sLum > 0.7) {
            accum += sCol * (sLum - 0.7) * decay;
        }
        decay *= 0.88;
    }
    return accum * (amount * 0.45);
}

// Centered Radial Vignette
float calculateVignette(vec2 uv, float amount) {
    if (amount <= 0.001) return 1.0;
    vec2 center = vec2(0.5, 0.5);
    float dist = distance(uv, center);
    float vig = smoothstep(0.8, 0.2, dist * (amount * 1.5 + 0.3));
    return clamp(vig, 0.0, 1.0);
}

// Split Toning
vec3 splitTone(vec3 color, float amount) {
    if (amount <= 0.001) return color;
    vec3 shadows = vec3(0.04, 0.10, 0.25);
    vec3 highlights = vec3(1.05, 0.85, 0.55);
    float lum = dot(color, vec3(0.299, 0.587, 0.114));
    vec3 tone = mix(shadows, highlights, clamp(lum, 0.0, 1.0));
    return mix(color, tone, amount * 0.45);
}

// Inky Black Crush
vec3 applyBlackCrush(vec3 col, float amount) {
    if (amount <= 0.001) return col;
    float threshold = amount * 0.18;
    col = max(col - vec3(threshold), vec3(0.0)) / (1.0 - threshold);
    return col;
}

// 3-Plane Floating Dust Motes
vec3 calculateDust(vec2 uv, float intensity, float speed, float time, vec2 res) {
    if (intensity <= 0.001) return vec3(0.0);
    float aspect = res.x / max(res.y, 1.0);
    vec2 pUv = uv * vec2(aspect, 1.0);
    vec3 accum = vec3(0.0);
    float t = time * max(speed, 0.05) * 0.35;

    for (int layer = 0; layer < 3; layer++) {
        float fL = float(layer);
        float scale = 8.0 + fL * 5.0;
        vec2 drift = vec2(sin(t * 0.5 + fL) * 0.05, -t * (0.3 + fL * 0.2));
        vec2 cellId = floor((pUv + drift) * scale);
        vec2 cellUv = fract((pUv + drift) * scale) - 0.5;

        float seed = dot(cellId + fL * 37.1, vec2(12.9898, 78.233));
        vec2 offset = vec2(fract(sin(seed) * 43758.5453) - 0.5, fract(sin(seed * 1.414) * 23421.63) - 0.5) * 0.7;
        float d = length(cellUv - offset);
        float p = smoothstep(0.04, 0.0, d) + smoothstep(0.12, 0.0, d) * 0.3;
        accum += vec3(1.2, 1.1, 0.9) * p * (0.7 + 0.3 * sin(time * 3.0 + seed));
    }
    return accum * (intensity * 0.6);
}

void main() {
    ivec2 outPos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = ivec2(u.resolution);
    ivec2 inSize = imageSize(inputImage);

    if (outPos.x >= outSize.x || outPos.y >= outSize.y) return;

    float scaleX = float(outSize.x) / float(inSize.x);
    float scaleY = float(outSize.y) / float(inSize.y);
    float scale = min(scaleX, scaleY);

    vec2 offset = (vec2(outSize) - vec2(inSize) * scale) * 0.5;
    vec2 uv = (vec2(outPos) - offset) / (vec2(inSize) * scale);

    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
        imageStore(outputImage, outPos, vec4(0.0));
        return;
    }

    ivec2 inPos = clamp(ivec2(uv * vec2(inSize)), ivec2(0), inSize - 1);
    vec4 srcColor = imageLoad(inputImage, inPos);
    vec3 linear = srgbToLinear(srcColor.rgb);

    // 1. Sharpness & Line Art
    linear = applySharpness(linear, inPos, inSize, u.sharpness);
    linear = applyDarkOutlines(linear, inPos, inSize, u.darkOutlines);
    linear = applyDarkEdgeBlur(linear, inPos, inSize, u.edgeDarken);

    // 2. Color & Tone
    float gain = pow(2.0, u.brightness);
    linear *= gain;
    linear = (linear - 0.5) * u.contrast + 0.5;
    linear = pow(max(linear, vec3(1e-4)), vec3(1.0 / max(u.gamma, 0.01)));
    float lum = dot(linear, vec3(0.299, 0.587, 0.114));
    linear = mix(vec3(lum), linear, u.saturation);
    linear = adjustTemperature(linear, u.temperature);
    linear = rotateHue(linear, u.hue);

    // 3. Curves
    linear = applyCurves(linear);

    // 4. Inky Black Crush
    linear = applyBlackCrush(linear, u.blackCrush);

    // 5. Deep Glow (Inverse Square) & Colored Edge Glow
    vec3 bloom = deepGlowInverseSquare(inPos, inSize, u.glowIntensity, u.glowSpread);
    vec3 eGlow = calculateEdgeGlow(inPos, inSize, u.edgeGlow, u.edgeGlowColorMode);
    linear += bloom + eGlow;

    // 6. Volumetric Rays & Dust
    linear += calculateGodRays(uv, u.godRays, inSize);
    if (u.dustParticles > 0.5) {
        linear += calculateDust(uv, u.dustIntensity, u.dustSpeed, u.time, u.resolution);
    }

    // 7. Vignette & Split Tone
    vec2 outUV = (vec2(outPos) + 0.5) / vec2(outSize);
    linear *= calculateVignette(outUV, u.vignette);
    linear = splitTone(linear, u.splitToning);

    // 8. Black Strobe
    linear *= calculateBlackFlicker(u.flickerIntensity, u.flickerSpeed, u.time);

    linear = clamp(linear, vec3(0.0), vec3(1.0));
    vec3 srgb = linearToSrgb(linear);

    imageStore(outputImage, outPos, vec4(srgb, srcColor.a));
}
