#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D inputImage;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D outputImage;

layout(set = 0, binding = 2, std140) uniform Uniforms {
    vec2 resolution;
    float brightness;
    float saturation;
    float contrast;
    float sharpness;
    float gamma;
    float hue;
    float temperature;
    float glowIntensity;
    float lookMix;
    float vignette;
    float splitToning;
} u;

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inputImage);
    if (pos.x >= size.x || pos.y >= size.y) return;

    vec4 color = imageLoad(inputImage, pos);

    // Just passthrough + split toning test
    vec3 linear = color.rgb;

    // Strong split tone: shadows -> blue, highlights -> orange
    float lum = dot(linear, vec3(0.299, 0.587, 0.114));
    vec3 shadows = vec3(0.1, 0.2, 0.8);   // blue
    vec3 highlights = vec3(0.9, 0.5, 0.1); // orange
    vec3 tone = mix(shadows, highlights, lum);
    vec3 result = mix(linear, tone * linear, 0.8); // 0.8 = very strong effect

    imageStore(outputImage, pos, vec4(result, color.a));
}
