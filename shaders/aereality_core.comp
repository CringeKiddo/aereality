#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// In/Out RGBA Frame Storage Buffers
layout(std430, binding = 0) readonly buffer InputBuffer {
    uint in_pixels[];
};

layout(std430, binding = 1) writeonly buffer OutputBuffer {
    uint out_pixels[];
};

// 66 Packed IEEE Floating-Point Uniforms matching Dart _packUniforms()
layout(binding = 2) uniform UniformBlock {
    float u_time;                 // [0]
    float u_brightness;           // [1]
    float u_saturation;           // [2]
    float u_contrast;             // [3]
    float u_sharpness;            // [4]
    float u_gamma;                // [5]
    float u_hue;                  // [6]
    float u_temperature;          // [7]

    float u_bloomIntensity;       // [8]
    float u_bloomSpread;          // [9]
    float u_bloomThreshold;       // [10]
    float u_bloomRadius;          // [11]
    float u_edgeGlowTint;         // [12] (0=Neutral, 1=Gold, 2=Cyan, 4=Crimson, 5=Ink Black)
    float u_anamorphicFlare;      // [13]
    float u_flareAmount;          // [14]
    float u_lightRays;            // [15]
    float u_lightRaysDecay;       // [16]

    float u_shadows;              // [17]
    float u_highlights;           // [18]
    float u_darkOutlines;         // [19]
    float u_edgeDarken;           // [20] Subtle line art soft contact shadow
    float u_vignette;             // [21] Radial Vignette
    float u_splitToning;          // [22]
    float u_denoise;              // [23]
    float u_blackCrush;           // [24]
    float u_flickerIntensity;     // [25]
    float u_flickerSpeed;         // [26]
    float u_depthOfField;         // [27]
    float u_dofFocus;             // [28]
    float u_dofAngle;             // [29]
    float u_mathOpsMode;          // [30]
    float u_sapphireBlendMix;     // [31]
    float u_filmConvertNitrate;   // [32]
    float u_fourColorGradMix;     // [33]

    // Catmull-Rom Spline Curve Master
    float u_curveM0; float u_curveM1; float u_curveM2; float u_curveM3; float u_curveM4; // [34..38]
    float u_filmGrain;            // [39]
    float u_tonemapMode;          // [40] (0=Off, 1=Reinhard, 2=ACES)
    float u_chromaticAberration;  // [41] Prism lens fringe

    // Red Curve
    float u_curveR0; float u_curveR1; float u_curveR2; float u_curveR3; float u_curveR4; // [42..46]
    float u_vignetteBoxed;        // [47] Boxed / Letterbox Vignette

    // Green Curve
    float pad1; float pad2;
    float u_curveG0; float u_curveG1; float u_curveG2; float u_curveG3; float u_curveG4; // [50..54]

    // Blue Curve
    float pad4; float pad5; float pad6;
    float u_curveB0; float u_curveB1; float u_curveB2; float u_curveB3; float u_curveB4; // [58..62]
};

// Unpack RGBA from 32-bit packed integer
vec4 unpackRGBA(uint val) {
    float r = float(val & 0xFFu) / 255.0;
    float g = float((val >> 8u) & 0xFFu) / 255.0;
    float b = float((val >> 16u) & 0xFFu) / 255.0;
    float a = float((val >> 24u) & 0xFFu) / 255.0;
    return vec4(r, g, b, a);
}

// Pack float RGBA to 32-bit integer
uint packRGBA(vec4 col) {
    uint r = uint(clamp(col.r * 255.0, 0.0, 255.0));
    uint g = uint(clamp(col.g * 255.0, 0.0, 255.0));
    uint b = uint(clamp(col.b * 255.0, 0.0, 255.0));
    uint a = uint(clamp(col.a * 255.0, 0.0, 255.0));
    return (a << 24u) | (b << 16u) | (g << 8u) | r;
}

// Catmull-Rom spline curve evaluator
float evalCatmullRom(float x, float p0, float p1, float p2, float p3, float p4) {
    x = clamp(x, 0.0, 1.0);
    float seg = x * 4.0;
    int idx = int(floor(seg));
    if (idx >= 4) return p4;
    float t = seg - float(idx);

    float cp0 = (idx == 0) ? p0 : (idx == 1) ? p0 : (idx == 2) ? p1 : p2;
    float cp1 = (idx == 0) ? p0 : (idx == 1) ? p1 : (idx == 2) ? p2 : p3;
    float cp2 = (idx == 0) ? p1 : (idx == 1) ? p2 : (idx == 2) ? p3 : p4;
    float cp3 = (idx == 0) ? p2 : (idx == 1) ? p3 : (idx == 2) ? p4 : p4;

    float m1 = 0.5 * (cp2 - cp0);
    float m2 = 0.5 * (cp3 - cp1);

    float t2 = t * t;
    float t3 = t2 * t;

    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;

    return clamp(h00 * cp1 + h10 * m1 + h01 * cp2 + h11 * m2, 0.0, 1.0);
}

// Pseudo-random noise hash
float hash12(vec2 p) {
    vec3 p3  = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

// ACES Filmic tonemapping
vec3 tonemapACES(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

// Color temperature conversion (Kelvin approximation)
vec3 colorTempToRGB(float kelvin) {
    float temp = kelvin / 100.0;
    float red, green, blue;

    if (temp <= 66.0) {
        red = 255.0;
        green = temp;
        green = 99.4708025861 * log(green) - 161.1195681661;
        if (temp <= 19.0) {
            blue = 0.0;
        } else {
            blue = temp - 10.0;
            blue = 138.5177312231 * log(blue) - 305.0447927307;
        }
    } else {
        red = temp - 60.0;
        red = 329.698727446 * pow(red, -0.1332047592);
        green = temp - 60.0;
        green = 288.1221695283 * pow(green, -0.0755148492);
        blue = 255.0;
    }

    return clamp(vec3(red, green, blue) / 255.0, 0.0, 1.0);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = ivec2(gl_NumWorkGroups.xy * gl_WorkGroupSize.xy);
    if (coord.x >= size.x || coord.y >= size.y) return;

    int pixelIndex = coord.y * size.x + coord.x;
    vec4 col = unpackRGBA(in_pixels[pixelIndex]);

    // -------------------------------------------------------------
    // 0. Chromatic Aberration (Prism Lens Fringe)
    // -------------------------------------------------------------
    if (u_chromaticAberration > 0.001) {
        vec2 uv = (vec2(coord) / vec2(size)) - 0.5;
        float dist = length(uv);
        ivec2 shift = ivec2(uv * u_chromaticAberration * 24.0 * dist);

        ivec2 rCoord = clamp(coord + shift, ivec2(0), size - ivec2(1));
        ivec2 bCoord = clamp(coord - shift, ivec2(0), size - ivec2(1));

        vec4 rPixel = unpackRGBA(in_pixels[rCoord.y * size.x + rCoord.x]);
        vec4 bPixel = unpackRGBA(in_pixels[bCoord.y * size.x + bCoord.x]);

        col.r = rPixel.r;
        col.b = bPixel.b;
    }

    // -------------------------------------------------------------
    // 1. Denoise (Bilateral approximation)
    // -------------------------------------------------------------
    if (u_denoise > 0.01) {
        vec4 avgCol = col;
        int count = 1;
        ivec2 offsets[4] = ivec2[](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
        for (int i = 0; i < 4; i++) {
            ivec2 c = coord + offsets[i];
            if (c.x >= 0 && c.x < size.x && c.y >= 0 && c.y < size.y) {
                vec4 nCol = unpackRGBA(in_pixels[c.y * size.x + c.x]);
                if (distance(col.rgb, nCol.rgb) < 0.18) {
                    avgCol += nCol;
                    count++;
                }
            }
        }
        col = mix(col, avgCol / float(count), u_denoise * 0.85);
    }

    // -------------------------------------------------------------
    // 2. Micro-Sharpness with Edge Halos
    // -------------------------------------------------------------
    if (u_sharpness > 0.01) {
        vec4 blur = vec4(0.0);
        blur += unpackRGBA(in_pixels[clamp(coord.y - 1, 0, size.y - 1) * size.x + coord.x]);
        blur += unpackRGBA(in_pixels[clamp(coord.y + 1, 0, size.y - 1) * size.x + coord.x]);
        blur += unpackRGBA(in_pixels[coord.y * size.x + clamp(coord.x - 1, 0, size.x - 1)]);
        blur += unpackRGBA(in_pixels[coord.y * size.x + clamp(coord.x + 1, 0, size.x - 1)]);
        blur *= 0.25;
        vec4 detail = col - blur;
        col.rgb += detail.rgb * u_sharpness * 2.2;
    }

    // -------------------------------------------------------------
    // 3. Sobel Edge Detection, Dark Outlines, & Soft EdgeDarken
    // -------------------------------------------------------------
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 c = clamp(coord + ivec2(x, y), ivec2(0), size - ivec2(1));
            vec4 p = unpackRGBA(in_pixels[c.y * size.x + c.x]);
            float lum = dot(p.rgb, vec3(0.299, 0.587, 0.114));
            float kx = float(x) * ((y == 0) ? 2.0 : 1.0);
            float ky = float(y) * ((x == 0) ? 2.0 : 1.0);
            gx += lum * kx;
            gy += lum * ky;
        }
    }
    float edge = sqrt(gx * gx + gy * gy);

    // Sobel hard ink line
    if (u_darkOutlines > 0.01) {
        col.rgb = mix(col.rgb, vec3(0.0), clamp(edge * u_darkOutlines * 1.5, 0.0, 1.0));
    }

    // Weak / fade line-art contact shadow (NOT Sobel comic stroke)
    if (u_edgeDarken > 0.01) {
        // Soft gradient falloff that gently deepens character borders
        float softEdge = smoothstep(0.08, 0.38, edge);
        float fadeShadow = softEdge * u_edgeDarken * 0.35;
        col.rgb = mix(col.rgb, col.rgb * 0.45, fadeShadow);
    }

    // -------------------------------------------------------------
    // 4. Color Temperature Adjustment
    // -------------------------------------------------------------
    if (abs(u_temperature - 6500.0) > 50.0) {
        vec3 tempColor = colorTempToRGB(u_temperature);
        col.rgb *= tempColor / colorTempToRGB(6500.0);
    }

    // -------------------------------------------------------------
    // 5. Exposure, Contrast, Black Crush, Shadows, & Highlights
    // -------------------------------------------------------------
    col.rgb += vec3(u_brightness);
    col.rgb = (col.rgb - 0.18) * u_contrast + 0.18;

    if (u_blackCrush > 0.01) {
        col.rgb = smoothstep(vec3(u_blackCrush * 0.25), vec3(1.0), col.rgb);
    }

    float luma = dot(col.rgb, vec3(0.299, 0.587, 0.114));
    col.rgb += vec3(u_shadows * (1.0 - luma) * 0.4);
    col.rgb += vec3(u_highlights * luma * 0.4);

    // Gamma Curve
    col.rgb = pow(max(col.rgb, vec3(0.0)), vec3(1.0 / max(u_gamma, 0.001)));

    // -------------------------------------------------------------
    // 6. Spline Curves (Per-channel RGB + Master)
    // -------------------------------------------------------------
    col.r = evalCatmullRom(col.r, u_curveR0, u_curveR1, u_curveR2, u_curveR3, u_curveR4);
    col.g = evalCatmullRom(col.g, u_curveG0, u_curveG1, u_curveG2, u_curveG3, u_curveG4);
    col.b = evalCatmullRom(col.b, u_curveB0, u_curveB1, u_curveB2, u_curveB3, u_curveB4);

    col.r = evalCatmullRom(col.r, u_curveM0, u_curveM1, u_curveM2, u_curveM3, u_curveM4);
    col.g = evalCatmullRom(col.g, u_curveM0, u_curveM1, u_curveM2, u_curveM3, u_curveM4);
    col.b = evalCatmullRom(col.b, u_curveM0, u_curveM1, u_curveM2, u_curveM3, u_curveM4);

    // -------------------------------------------------------------
    // 7. Saturation, Hue Shift, & Split Toning
    // -------------------------------------------------------------
    luma = dot(col.rgb, vec3(0.299, 0.587, 0.114));
    col.rgb = mix(vec3(luma), col.rgb, u_saturation);

    if (abs(u_hue) > 0.001) {
        float angle = u_hue * 3.14159265;
        float cosA = cos(angle);
        float sinA = sin(angle);
        mat3 hueMat = mat3(
            vec3(0.213 + cosA*0.787 - sinA*0.213, 0.715 - cosA*0.715 - sinA*0.715, 0.072 - cosA*0.072 + sinA*0.928),
            vec3(0.213 - cosA*0.213 + sinA*0.143, 0.715 + cosA*0.285 + sinA*0.140, 0.072 - cosA*0.072 - sinA*0.283),
            vec3(0.213 - cosA*0.213 - sinA*0.787, 0.715 - cosA*0.715 + sinA*0.715, 0.072 + cosA*0.928 + sinA*0.072)
        );
        col.rgb = clamp(hueMat * col.rgb, 0.0, 1.0);
    }

    if (u_splitToning > 0.01) {
        vec3 shadowTint = vec3(0.0, 0.04, 0.10) * (1.0 - luma);
        vec3 highlightTint = vec3(0.10, 0.05, 0.0) * luma;
        col.rgb += (shadowTint + highlightTint) * u_splitToning;
    }

    // -------------------------------------------------------------
    // 8. Continuous Ring-Free Gaussian Bloom & Ink Black Glow
    // -------------------------------------------------------------
    if (u_bloomIntensity > 0.01) {
        vec3 bloomTint = vec3(1.0);
        if (u_edgeGlowTint == 1.0) bloomTint = vec3(1.2, 0.95, 0.6);      // Gold/Warm
        else if (u_edgeGlowTint == 2.0) bloomTint = vec3(0.5, 1.1, 1.3); // Quincy Cyan
        else if (u_edgeGlowTint == 4.0) bloomTint = vec3(1.3, 0.4, 0.4); // Crimson
        else if (u_edgeGlowTint == 5.0) bloomTint = vec3(0.0);           // Black / Ink Shadow

        // Multi-tap Gaussian accumulation
        vec4 bloomAcc = vec4(0.0);
        float totalWeight = 0.0;
        int rad = int(max(1.0, u_bloomRadius * 4.0));
        for (int dy = -rad; dy <= rad; dy += 2) {
            for (int dx = -rad; dx <= rad; dx += 2) {
                ivec2 sampleCoord = clamp(coord + ivec2(dx, dy), ivec2(0), size - ivec2(1));
                vec4 sCol = unpackRGBA(in_pixels[sampleCoord.y * size.x + sampleCoord.x]);
                float sLum = dot(sCol.rgb, vec3(0.299, 0.587, 0.114));
                float pass = smoothstep(u_bloomThreshold, 1.0, sLum);
                float distSq = float(dx * dx + dy * dy);
                float weight = exp(-distSq / (2.0 * max(0.1, u_bloomSpread * 10.0)));
                bloomAcc += sCol * pass * weight;
                totalWeight += weight;
            }
        }
        vec3 finalBloom = (bloomAcc.rgb / max(totalWeight, 0.001)) * u_bloomIntensity;

        if (u_edgeGlowTint == 5.0) {
            col.rgb = mix(col.rgb, vec3(0.0), length(finalBloom) * 0.7);
        } else {
            col.rgb += finalBloom * bloomTint;
        }
    }

    // -------------------------------------------------------------
    // 9. Anamorphic 1D Flare
    // -------------------------------------------------------------
    if (u_anamorphicFlare > 0.01) {
        vec3 flareAcc = vec3(0.0);
        int flareSpan = int(size.x * u_flareAmount * 0.15);
        for (int dx = -flareSpan; dx <= flareSpan; dx += 4) {
            ivec2 fc = clamp(ivec2(coord.x + dx, coord.y), ivec2(0), size - ivec2(1));
            vec4 fp = unpackRGBA(in_pixels[fc.y * size.x + fc.x]);
            float fLum = dot(fp.rgb, vec3(0.299, 0.587, 0.114));
            if (fLum > 0.8) {
                flareAcc += fp.rgb * (1.0 - abs(float(dx)) / float(flareSpan));
            }
        }
        col.rgb += flareAcc * vec3(0.4, 0.7, 1.2) * u_anamorphicFlare * 0.05;
    }

    // -------------------------------------------------------------
    // 10. Light Rays / God Rays
    // -------------------------------------------------------------
    if (u_lightRays > 0.01) {
        vec2 center = vec2(size) * 0.5;
        vec2 delta = (center - vec2(coord)) * 0.02;
        vec3 rayAcc = vec3(0.0);
        vec2 curCoord = vec2(coord);
        float decay = 1.0;
        for (int s = 0; s < 8; s++) {
            curCoord += delta;
            ivec2 sc = clamp(ivec2(curCoord), ivec2(0), size - ivec2(1));
            vec4 sp = unpackRGBA(in_pixels[sc.y * size.x + sc.x]);
            float lum = dot(sp.rgb, vec3(0.299, 0.587, 0.114));
            if (lum > 0.75) {
                rayAcc += sp.rgb * decay;
            }
            decay *= u_lightRaysDecay;
        }
        col.rgb += rayAcc * u_lightRays * 0.12;
    }

    // -------------------------------------------------------------
    // 11. Tilt-Shift Depth of Field
    // -------------------------------------------------------------
    if (u_depthOfField > 0.01) {
        float normY = float(coord.y) / float(size.y);
        float dofDist = abs(normY - u_dofFocus);
        if (dofDist > 0.15) {
            float blurAmount = (dofDist - 0.15) * u_depthOfField * 4.0;
            vec4 blurAcc = col;
            int bRad = int(clamp(blurAmount, 1.0, 4.0));
            for (int by = -bRad; by <= bRad; by += 2) {
                for (int bx = -bRad; bx <= bRad; bx += 2) {
                    ivec2 bc = clamp(coord + ivec2(bx, by), ivec2(0), size - ivec2(1));
                    blurAcc += unpackRGBA(in_pixels[bc.y * size.x + bc.x]);
                }
            }
            col = mix(col, blurAcc / 5.0, clamp(blurAmount, 0.0, 1.0));
        }
    }

    // -------------------------------------------------------------
    // 12. Consistent Sinusoidal Flicker
    // -------------------------------------------------------------
    if (u_flickerIntensity > 0.01) {
        float fWave = sin(u_time * u_flickerSpeed * 6.28318) * 0.5 + 0.5;
        col.rgb *= (1.0 + (fWave - 0.5) * u_flickerIntensity * 0.35);
    }

    // -------------------------------------------------------------
    // 13. Film Grain & FilmConvert Nitrate
    // -------------------------------------------------------------
    if (u_filmGrain > 0.01 || u_filmConvertNitrate > 0.01) {
        float noise = (hash12(vec2(coord) + vec2(u_time * 13.37, u_time * 29.11)) - 0.5);
        float grainAmount = u_filmGrain * 0.25 + u_filmConvertNitrate * 0.18;
        col.rgb += vec3(noise * grainAmount);
    }

    // -------------------------------------------------------------
    // 14. Sapphire 4-Corner Gradient
    // -------------------------------------------------------------
    if (u_fourColorGradMix > 0.01) {
        vec2 uv = vec2(coord) / vec2(size);
        vec3 cTL = vec3(0.8, 0.9, 1.0);
        vec3 cTR = vec3(1.0, 0.8, 0.9);
        vec3 cBL = vec3(0.9, 1.0, 0.8);
        vec3 cBR = vec3(1.0, 0.9, 0.8);
        vec3 grad = mix(mix(cTL, cTR, uv.x), mix(cBL, cBR, uv.x), uv.y);
        col.rgb = mix(col.rgb, col.rgb * grad, u_fourColorGradMix);
    }

    // -------------------------------------------------------------
    // 15. Vignette (Radial & Boxed / Letterbox Shape)
    // -------------------------------------------------------------
    if (u_vignette > 0.01) {
        vec2 uv = (vec2(coord) / vec2(size)) - 0.5;
        float dist = length(uv);
        float vig = smoothstep(0.7, 0.2, dist * (1.0 + u_vignette * 1.5));
        col.rgb *= vig;
    }

    if (u_vignetteBoxed > 0.01) {
        vec2 uv = abs((vec2(coord) / vec2(size)) - 0.5) * 2.0;
        float boxDist = max(uv.x, uv.y); // Square / rectangular contour
        float boxVig = smoothstep(1.0, 0.3, boxDist * (0.8 + u_vignetteBoxed * 0.8));
        col.rgb *= boxVig;
    }

    // -------------------------------------------------------------
    // 16. HDR Tonemapping
    // -------------------------------------------------------------
    if (u_tonemapMode == 1.0) {
        // Reinhard Tonemapping
        col.rgb = col.rgb / (col.rgb + vec3(1.0));
    } else if (u_tonemapMode == 2.0) {
        // ACES Filmic Tonemapping
        col.rgb = tonemapACES(col.rgb);
    }

    out_pixels[pixelIndex] = packRGBA(col);
}
