#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D inputImage;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D outputImage;

layout(set = 0, binding = 2, std140) uniform Uniforms {
    vec2 resolution;
    float brightness;
    float saturation;
    float contrast;
    float sharpness;
    float gamma;
    float hue;
    float temperature;
    float glowIntensity;
    float lookMix;
    float vignette;
    float splitToning;
} u;

// ---------- HELPERS ----------
vec3 srgbToLinear(vec3 srgb) {
    vec3 less = step(vec3(0.04045), srgb);
    return mix(srgb / 12.92, pow((srgb + 0.055) / 1.055, vec3(2.4)), less);
}

vec3 linearToSrgb(vec3 lin) {
    vec3 less = step(vec3(0.0031308), lin);
    return mix(lin * 12.92, pow(lin, vec3(1.0 / 2.4)) * 1.055 - 0.055, less);
}

// ---------- 13x13 BOX BLUR (169 samples) ----------
vec3 boxBlur13x13(ivec2 pos, ivec2 size) {
    vec3 result = vec3(0.0);
    float total = 0.0;
    for (int dy = -6; dy <= 6; dy++) {
        for (int dx = -6; dx <= 6; dx++) {
            ivec2 samplePos = clamp(pos + ivec2(dx, dy), ivec2(0), size - 1);
            vec4 sampleColor = imageLoad(inputImage, samplePos);
            result += sampleColor.rgb;
            total += 1.0;
        }
    }
    return result / total;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inputImage);
    if (pos.x >= size.x || pos.y >= size.y) return;

    vec4 color = imageLoad(inputImage, pos);

    // ---------- FORCE BRIGHTNESS BOOST ----------
    vec3 boosted = color.rgb * 2.0;

    // ---------- BLOOM (PURE WHITE, NO TINT) ----------
    vec3 blurred = boxBlur13x13(pos, size);
    vec3 bloom = blurred * 2.5; // higher intensity

    // ⬇️ NO TINT – pure white bloom
    // bloom *= vec3(1.0, 1.0, 1.0); // (optional, but default is white)

    // Combine original with bloom
    vec3 finalColor = boosted + bloom;

    // Tone down to avoid clipping
    finalColor = finalColor / (1.0 + finalColor); // Reinhard tone mapping

    // Clamp
    finalColor = clamp(finalColor, 0.0, 1.0);

    imageStore(outputImage, pos, vec4(finalColor, color.a));
}
