#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputBuffer {
    uint in_pixels[];
};

layout(std430, binding = 1) writeonly buffer OutputBuffer {
    uint out_pixels[];
};

// 3D LUT Table: 32 x 32 x 32 = 32,768 RGB triplets (98,304 floats)
layout(std430, binding = 3) readonly buffer LutBuffer {
    float lut_table[];
};

// Perfectly 16-byte aligned struct (64 floats = 256 bytes per layer)
struct LayerData {
    // Offset 0..3 (16 bytes)
    float isEnabled;              // 0: Disabled, 1: Enabled
    float opacity;                // 0.0 to 1.0
    float blendMode;              // 0:Normal, 1:Screen, 2:Linear Add, 3:Overlay, 4:Soft Light, 5:Multiply
    float brightness;             // -0.5 to +0.5

    // Offset 4..7 (16 bytes)
    float saturation;             // 0.0 to 2.0
    float contrast;               // 0.5 to 2.0 (0.18 Mid-Gray Pivot)
    float sharpness;              // 0.0 to 1.0
    float gamma;                  // 0.4 to 2.0

    // Offset 8..11 (16 bytes)
    float hue;                    // -0.5 to +0.5
    float temperature;            // Kelvin (3000 to 9500)
    float deepGlowIntensity;      // 0.0 to 1.5
    float deepGlowRadius;         // 0.1 to 1.0

    // Offset 12..15 (16 bytes)
    float deepGlowThreshold;      // 0.1 to 0.9
    float edgeGlowTint;           // 0:Neutral, 1:Gold, 2:Cyan, 3:Dark/Ink, 4:Deep Blood Crimson, 5:Violet
    float thinStreakIntensity;    // 0.0 to 1.0
    float thinStreakWidth;        // 0.1 to 1.0 (Horizontal Flare Stretch)

    // Offset 16..19 (16 bytes)
    float lineChromaStrength;     // 0.0 to 1.0 (All-Edge Chromatic Aberration)
    float volRaysLength;          // 0.0 to 1.0 (Volumetric God Rays)
    float volRaysDecay;           // 0.70 to 0.98
    float shadows;                // -1.0 to 1.0

    // Offset 20..23 (16 bytes)
    float highlights;             // -1.0 to 1.0
    float blackCrush;             // 0.0 to 0.5
    float vignette;               // 0.0 to 1.0 (Radial)
    float vignetteBoxed;          // 0.0 to 1.0 (Boxed)

    // Offset 24..27 (16 bytes)
    float edgeDarken;             // 0.0 to 1.0 (Line Art Interior Shadow)
    float darkOutlines;           // 0.0 to 1.0 (Sobel Outline Darkener)
    float denoise;                // 0.0 to 1.0 (Bilateral Filter)
    float filmGrain;              // 0.0 to 0.3

    // Offset 28..31 (16 bytes)
    float flickerIntensity;       // 0.0 to 1.0
    float flickerSpeed;           // 1.0 to 20.0 (Hz)
    float halationRadius;         // 0.0 to 1.0
    float halationWarmth;         // 0.0 to 1.0

    // Offset 32..35 (16 bytes)
    float depthOfField;           // 0.0 to 1.0
    float dofFocus;               // 0.0 to 1.0 (Focal Plane Center Y)
    float dofAngle;               // 0.0 to 3.1415 (Directional Blur Angle)
    float unsharpRadius;          // 0.0 to 5.0

    // Offset 36..39 (16 bytes)
    float unsharpAmount;          // 0.0 to 2.0
    float unsharpThreshold;       // 0.0 to 0.5
    float curveM0;
    float curveM1;

    // Offset 40..43 (16 bytes)
    float curveM2;
    float curveM3;
    float curveM4;
    float curveR0;

    // Offset 44..47 (16 bytes)
    float curveR1;
    float curveR2;
    float curveR3;
    float curveR4;

    // Offset 48..51 (16 bytes)
    float curveG2;                // Green Midtone Pivot
    float curveB2;                // Blue Midtone Pivot
    float sapphireGlowWidth;      // 0.0 to 2.0
    float sapphireGlowThreshold;  // 0.0 to 1.0

    // Offset 52..55 (16 bytes)
    float thinStreakOpacity;      // 0.0 to 1.0 (Dedicated White Flare Opacity)
    float mblMojoTealOrange;      // 0.0 to 1.0 (Teal/Orange Split)
    float bslaGodRays;            // 0.0 to 1.0 (Screen-Space Volumetric Light Shafts)
    float bslaFogDensity;         // 0.0 to 1.0 (Atmospheric Fog Density)

    // Offset 56..59 (16 bytes)
    float bslaFogDepth;           // 0.0 to 1.0 (Fog Altitude & Distance Falloff)
    float bslaBloomHaze;          // 0.0 to 1.0 (Volumetric Atmospheric Mist Scatter)
    float bslFogScatter;          // 0.0 to 1.0 (Liminal Atmosphere Scattering)
    float pad0;

    // Offset 60..63 (16 bytes padding to 64 floats)
    float pad1;
    float pad2;
    float pad3;
    float pad4;
};

layout(std430, binding = 2) readonly buffer UniformBlock {
    float u_time;
    float u_layerCount;
    float u_tonemapMode;          // 0: Off, 1: Reinhard, 2: ACES
    float u_imgWidth;
    float u_imgHeight;
    float u_hasLut;               // 1.0 if a 3D LUT is bound to buffer 3, else 0.0
    float u_lutOpacity;           // 0.0 to 1.0
    float u_pad;
    LayerData layers[4];
};

vec4 unpackRGBA(uint val) {
    float r = float(val & 0xFFu) / 255.0;
    float g = float((val >> 8u) & 0xFFu) / 255.0;
    float b = float((val >> 16u) & 0xFFu) / 255.0;
    float a = float((val >> 24u) & 0xFFu) / 255.0;
    return vec4(r, g, b, a);
}

uint packRGBA(vec4 col) {
    uint r = uint(clamp(col.r * 255.0, 0.0, 255.0));
    uint g = uint(clamp(col.g * 255.0, 0.0, 255.0));
    uint b = uint(clamp(col.b * 255.0, 0.0, 255.0));
    uint a = uint(clamp(col.a * 255.0, 0.0, 255.0));
    return (a << 24u) | (b << 16u) | (g << 8u) | r;
}

vec3 sample3DLut(vec3 color, float opacity) {
    if (opacity <= 0.001) return color;

    vec3 coord = clamp(color, 0.0, 1.0) * 31.0;
    ivec3 c0 = clamp(ivec3(floor(coord)), ivec3(0), ivec3(31));
    ivec3 c1 = clamp(c0 + ivec3(1), ivec3(0), ivec3(31));
    vec3 f = fract(coord);

    #define LUT_IDX(r, g, b) (((b) * 1024 + (g) * 32 + (r)) * 3)

    int idx000 = LUT_IDX(c0.x, c0.y, c0.z);
    int idx100 = LUT_IDX(c1.x, c0.y, c0.z);
    int idx010 = LUT_IDX(c0.x, c1.y, c0.z);
    int idx110 = LUT_IDX(c1.x, c1.y, c0.z);

    int idx001 = LUT_IDX(c0.x, c0.y, c1.z);
    int idx101 = LUT_IDX(c1.x, c0.y, c1.z);
    int idx011 = LUT_IDX(c0.x, c1.y, c1.z);
    int idx111 = LUT_IDX(c1.x, c1.y, c1.z);

    vec3 s000 = vec3(lut_table[idx000], lut_table[idx000 + 1], lut_table[idx000 + 2]);
    vec3 s100 = vec3(lut_table[idx100], lut_table[idx100 + 1], lut_table[idx100 + 2]);
    vec3 s010 = vec3(lut_table[idx010], lut_table[idx010 + 1], lut_table[idx010 + 2]);
    vec3 s110 = vec3(lut_table[idx110], lut_table[idx110 + 1], lut_table[idx110 + 2]);

    vec3 s001 = vec3(lut_table[idx001], lut_table[idx001 + 1], lut_table[idx001 + 2]);
    vec3 s101 = vec3(lut_table[idx101], lut_table[idx101 + 1], lut_table[idx101 + 2]);
    vec3 s011 = vec3(lut_table[idx011], lut_table[idx011 + 1], lut_table[idx011 + 2]);
    vec3 s111 = vec3(lut_table[idx111], lut_table[idx111 + 1], lut_table[idx111 + 2]);

    vec3 s00 = mix(s000, s100, f.x);
    vec3 s01 = mix(s001, s101, f.x);
    vec3 s10 = mix(s010, s110, f.x);
    vec3 s11 = mix(s011, s111, f.x);

    vec3 s0 = mix(s00, s10, f.y);
    vec3 s1 = mix(s01, s11, f.y);

    vec3 lutColor = mix(s0, s1, f.z);
    return mix(color, lutColor, opacity);
}

float evalCatmullRom(float x, float p0, float p1, float p2, float p3, float p4) {
    x = clamp(x, 0.0, 1.0);
    float seg = x * 4.0;
    int idx = int(floor(seg));
    if (idx >= 4) return p4;
    float t = seg - float(idx);

    float cp0 = (idx == 0) ? p0 : (idx == 1) ? p0 : (idx == 2) ? p1 : p2;
    float cp1 = (idx == 0) ? p0 : (idx == 1) ? p1 : (idx == 2) ? p2 : p3;
    float cp2 = (idx == 0) ? p1 : (idx == 1) ? p2 : (idx == 2) ? p3 : p4;
    float cp3 = (idx == 0) ? p2 : (idx == 1) ? p3 : (idx == 2) ? p4 : p4;

    float m1 = 0.5 * (cp2 - cp0);
    float m2 = 0.5 * (cp3 - cp1);

    float t2 = t * t;
    float t3 = t2 * t;

    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;

    return clamp(h00 * cp1 + h10 * m1 + h01 * cp2 + h11 * m2, 0.0, 1.0);
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec3 tonemapACES(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / (x * (c * x + d) + e), 0.0, 1.0);
}

vec3 tonemapReinhardExtended(vec3 x) {
    float maxWhite = 4.5;
    return (x * (1.0 + (x / (maxWhite * maxWhite)))) / (1.0 + x);
}

vec3 colorTempToRGB(float kelvin) {
    if (kelvin < 1000.0) return vec3(1.0);
    float temp = kelvin / 100.0;
    float red, green, blue;

    if (temp <= 66.0) {
        red = 255.0;
        green = temp;
        green = 99.4708025861 * log(max(green, 1.0)) - 161.1195681661;
        if (temp <= 19.0) {
            blue = 0.0;
        } else {
            blue = temp - 10.0;
            blue = 138.5177312231 * log(max(blue, 1.0)) - 305.0447927307;
        }
    } else {
        red = temp - 60.0;
        red = 329.698727446 * pow(max(red, 1.0), -0.1332047592);
        green = temp - 60.0;
        green = 288.1221695283 * pow(max(green, 1.0), -0.0755148492);
        blue = 255.0;
    }

    return clamp(vec3(red, green, blue) / 255.0, 0.0, 1.0);
}

vec3 applyBlendMode(vec3 baseCol, vec3 blendCol, int mode, float opacity) {
    vec3 result = blendCol;
    if (mode == 1) {
        result = 1.0 - (1.0 - baseCol) * (1.0 - blendCol);
    } else if (mode == 2) {
        result = baseCol + blendCol;
    } else if (mode == 3) {
        result = mix(2.0 * baseCol * blendCol, 1.0 - 2.0 * (1.0 - baseCol) * (1.0 - blendCol), step(vec3(0.5), baseCol));
    } else if (mode == 4) {
        result = (1.0 - 2.0 * blendCol) * baseCol * baseCol + 2.0 * blendCol * baseCol;
    } else if (mode == 5) {
        result = baseCol * blendCol;
    }
    return clamp(mix(baseCol, result, clamp(opacity, 0.0, 1.0)), 0.0, 4.0);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    int width = int(u_imgWidth > 0.0 ? u_imgWidth : gl_NumWorkGroups.x * gl_WorkGroupSize.x);
    int height = int(u_imgHeight > 0.0 ? u_imgHeight : gl_NumWorkGroups.y * gl_WorkGroupSize.y);

    if (coord.x >= width || coord.y >= height) return;

    int pixelIndex = coord.y * width + coord.x;
    vec4 basePixel = unpackRGBA(in_pixels[pixelIndex]);
    vec3 currentComposite = basePixel.rgb;

    // Sobel line-art edge detection with sensitive range for all-edge coverage
    float gx = 0.0, gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 c = clamp(coord + ivec2(x, y), ivec2(0), ivec2(width - 1, height - 1));
            vec4 p = unpackRGBA(in_pixels[c.y * width + c.x]);
            float lum = dot(p.rgb, vec3(0.299, 0.587, 0.114));
            float kx = float(x) * ((y == 0) ? 2.0 : 1.0);
            float ky = float(y) * ((x == 0) ? 2.0 : 1.0);
            gx += lum * kx;
            gy += lum * ky;
        }
    }
    float lineEdge = sqrt(gx * gx + gy * gy);

    int totalLayers = int(clamp(u_layerCount, 0.0, 4.0));

    if (totalLayers <= 0) {
        if (u_hasLut > 0.5) {
            currentComposite = sample3DLut(currentComposite, u_lutOpacity);
        }
        out_pixels[pixelIndex] = packRGBA(vec4(currentComposite, basePixel.a));
        return;
    }

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;

        vec3 layerColor = currentComposite;

        // 1. All-Edge Lineart Chromatic Aberration
        if (L.lineChromaStrength > 0.001) {
            float edgeFactor = smoothstep(0.015, 0.18, lineEdge);
            vec2 uv = (vec2(coord) / vec2(width, height)) - 0.5;
            ivec2 shift = ivec2(normalize(uv + vec2(0.0001)) * (L.lineChromaStrength * 5.5) * edgeFactor);

            ivec2 rCoord = clamp(coord + shift, ivec2(0), ivec2(width - 1, height - 1));
            ivec2 bCoord = clamp(coord - shift, ivec2(0), ivec2(width - 1, height - 1));

            vec4 rPix = unpackRGBA(in_pixels[rCoord.y * width + rCoord.x]);
            vec4 bPix = unpackRGBA(in_pixels[bCoord.y * width + bCoord.x]);

            layerColor.r = mix(layerColor.r, rPix.r, edgeFactor * 0.85);
            layerColor.b = mix(layerColor.b, bPix.b, edgeFactor * 0.85);
        }

        // 2. Bilateral Denoise Filter
        if (L.denoise > 0.01) {
            vec3 avgCol = layerColor;
            int count = 1;
            ivec2 offsets[4] = ivec2[](ivec2(-1, 0), ivec2(1, 0), ivec2(0, -1), ivec2(0, 1));
            for (int k = 0; k < 4; k++) {
                ivec2 c = coord + offsets[k];
                if (c.x >= 0 && c.x < width && c.y >= 0 && c.y < height) {
                    vec4 nCol = unpackRGBA(in_pixels[c.y * width + c.x]);
                    if (distance(layerColor, nCol.rgb) < 0.15) {
                        avgCol += nCol.rgb;
                        count++;
                    }
                }
            }
            layerColor = mix(layerColor, avgCol / float(count), L.denoise * 0.85);
        }

        // 3. Unsharp Mask Engine
        if (L.unsharpAmount > 0.01) {
            int uRad = int(clamp(L.unsharpRadius, 1.0, 4.0));
            vec3 lowPass = vec3(0.0);
            float uWeightTotal = 0.0;
            for (int uy = -uRad; uy <= uRad; uy++) {
                for (int ux = -uRad; ux <= uRad; ux++) {
                    ivec2 uc = clamp(coord + ivec2(ux, uy), ivec2(0), ivec2(width - 1, height - 1));
                    lowPass += unpackRGBA(in_pixels[uc.y * width + uc.x]).rgb;
                    uWeightTotal += 1.0;
                }
            }
            lowPass /= max(uWeightTotal, 1.0);
            vec3 highPass = layerColor - lowPass;
            float diffLum = abs(dot(highPass, vec3(0.299, 0.587, 0.114)));
            if (diffLum >= L.unsharpThreshold) {
                layerColor += highPass * L.unsharpAmount;
            }
        }

        // 4. Micro-Sharpness
        if (L.sharpness > 0.01) {
            vec4 blur = vec4(0.0);
            blur += unpackRGBA(in_pixels[clamp(coord.y - 1, 0, height - 1) * width + coord.x]);
            blur += unpackRGBA(in_pixels[clamp(coord.y + 1, 0, height - 1) * width + coord.x]);
            blur += unpackRGBA(in_pixels[coord.y * width + clamp(coord.x - 1, 0, width - 1)]);
            blur += unpackRGBA(in_pixels[coord.y * width + clamp(coord.x + 1, 0, width - 1)]);
            blur *= 0.25;
            vec3 detail = layerColor - blur.rgb;
            layerColor += detail * L.sharpness * 1.5;
        }

        // 5. Sobel Dark Outlines
        if (L.darkOutlines > 0.01) {
            layerColor = mix(layerColor, vec3(0.0), clamp(lineEdge * L.darkOutlines * 0.85, 0.0, 1.0));
        }

        // 6. Line Art Edge Darken
        if (L.edgeDarken > 0.01) {
            float innerEdge = smoothstep(0.08, 0.35, lineEdge);
            layerColor *= (1.0 - innerEdge * L.edgeDarken * 0.40);
        }

        // 7. Color Temperature
        if (L.temperature > 1000.0 && abs(L.temperature - 6500.0) > 30.0) {
            vec3 tempColor = colorTempToRGB(L.temperature);
            layerColor *= tempColor / colorTempToRGB(6500.0);
        }

        // 8. Exposure, Contrast & Black Crush
        layerColor += vec3(L.brightness);
        layerColor = (layerColor - 0.18) * L.contrast + 0.18;

        if (L.blackCrush > 0.01) {
            layerColor = smoothstep(vec3(L.blackCrush * 0.12), vec3(1.0), layerColor);
        }

        // Isolated Highlights & Shadows
        float luma = dot(layerColor, vec3(0.2126, 0.7152, 0.0722));
        float sWeight = 1.0 - smoothstep(0.0, 0.52, luma);
        layerColor += layerColor * (L.shadows * sWeight * 0.50);

        float hWeight = smoothstep(0.48, 1.0, luma);
        layerColor += layerColor * (L.highlights * hWeight * 0.50);

        layerColor = pow(max(layerColor, vec3(0.0)), vec3(1.0 / max(L.gamma, 0.001)));

        // 9. Magic Bullet Mojo
        if (L.mblMojoTealOrange > 0.01) {
            float shadowMask = clamp(1.0 - luma * 1.6, 0.0, 1.0);
            float warmMask = clamp(luma * 1.4 - 0.2, 0.0, 1.0);
            vec3 tealTint = vec3(0.12, 0.85, 1.05);
            vec3 orangeTint = vec3(1.18, 0.88, 0.45);
            layerColor = mix(layerColor, layerColor * tealTint, shadowMask * L.mblMojoTealOrange * 0.40);
            layerColor = mix(layerColor, layerColor * orangeTint, warmMask * L.mblMojoTealOrange * 0.35);
        }

        // 10. Individual RGB Channel Spline Curves
        layerColor.r = evalCatmullRom(layerColor.r, L.curveR0, L.curveR1, L.curveR2, L.curveR3, L.curveR4);
        layerColor.g = mix(layerColor.g, L.curveG2, 0.15 * (L.curveG2 - 0.5));
        layerColor.b = mix(layerColor.b, L.curveB2, 0.15 * (L.curveB2 - 0.5));

        // 11. Master Spline Curve
        layerColor.r = evalCatmullRom(layerColor.r, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);
        layerColor.g = evalCatmullRom(layerColor.g, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);
        layerColor.b = evalCatmullRom(layerColor.b, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);

        // 12. Saturation & Hue Shift
        luma = dot(layerColor, vec3(0.299, 0.587, 0.114));
        layerColor = mix(vec3(luma), layerColor, L.saturation);

        if (abs(L.hue) > 0.001) {
            float angle = L.hue * 3.14159265;
            float cosA = cos(angle);
            float sinA = sin(angle);
            mat3 hueMat = mat3(
                vec3(0.213 + cosA*0.787 - sinA*0.213, 0.715 - cosA*0.715 - sinA*0.715, 0.072 - cosA*0.072 + sinA*0.928),
                vec3(0.213 - cosA*0.213 + sinA*0.143, 0.715 + cosA*0.285 + sinA*0.140, 0.072 - cosA*0.072 - sinA*0.283),
                vec3(0.213 - cosA*0.213 - sinA*0.787, 0.715 - cosA*0.715 + sinA*0.715, 0.072 + cosA*0.928 + sinA*0.072)
            );
            layerColor = clamp(hueMat * layerColor, 0.0, 1.0);
        }

        // 13. Deep Glow
        if (L.deepGlowIntensity > 0.01) {
            vec3 bloomTint = vec3(1.0);
            if (L.edgeGlowTint == 1.0) bloomTint = vec3(1.18, 1.05, 0.70);
            else if (L.edgeGlowTint == 2.0) bloomTint = vec3(0.40, 1.15, 1.45);
            else if (L.edgeGlowTint == 3.0) bloomTint = vec3(0.18, 0.18, 0.22);
            else if (L.edgeGlowTint == 4.0) bloomTint = vec3(1.15, 0.08, 0.08);
            else if (L.edgeGlowTint == 5.0) bloomTint = vec3(0.85, 0.45, 1.40);

            vec3 bloomAcc = vec3(0.0);
            float totalWeight = 0.0;
            int maxRadius = int(clamp(L.deepGlowRadius * 24.0, 4.0, 24.0));
            float falloff = max(0.06, (1.0 - L.deepGlowRadius) * 0.18);

            for (int dy = -maxRadius; dy <= maxRadius; dy += 2) {
                for (int dx = -maxRadius; dx <= maxRadius; dx += 2) {
                    ivec2 sCoord = clamp(coord + ivec2(dx, dy), ivec2(0), ivec2(width - 1, height - 1));
                    vec4 sCol = unpackRGBA(in_pixels[sCoord.y * width + sCoord.x]);
                    float sLum = dot(sCol.rgb, vec3(0.299, 0.587, 0.114));

                    float pass = smoothstep(L.deepGlowThreshold - 0.15, L.deepGlowThreshold + 0.15, sLum);
                    float dist = length(vec2(dx, dy));
                    float weight = 1.0 / (1.0 + pow(dist * falloff, 1.9));

                    bloomAcc += sCol.rgb * pass * weight;
                    totalWeight += weight;
                }
            }
            vec3 finalBloom = (bloomAcc / max(totalWeight, 0.0001)) * (L.deepGlowIntensity * 1.35) * bloomTint;
            layerColor += finalBloom;
        }

        // 14. Sapphire S_Glow Core
        if (L.sapphireGlowWidth > 0.01) {
            int sRad = int(clamp(L.sapphireGlowWidth * 12.0, 2.0, 16.0));
            vec3 sGlowAcc = vec3(0.0);
            float sWeight = 0.0;
            for (int sy = -sRad; sy <= sRad; sy += 2) {
                for (int sx = -sRad; sx <= sRad; sx += 2) {
                    ivec2 sc = clamp(coord + ivec2(sx, sy), ivec2(0), ivec2(width - 1, height - 1));
                    vec4 sp = unpackRGBA(in_pixels[sc.y * width + sc.x]);
                    float sl = dot(sp.rgb, vec3(0.299, 0.587, 0.114));
                    if (sl > L.sapphireGlowThreshold) {
                        float dist = float(sx * sx + sy * sy);
                        float w = exp(-dist / (2.0 * float(sRad * sRad)));
                        sGlowAcc += sp.rgb * w;
                        sWeight += w;
                    }
                }
            }
            if (sWeight > 0.0) {
                layerColor += (sGlowAcc / sWeight) * 0.55;
            }
        }

        // 15. Anamorphic Flares
        if (L.thinStreakIntensity > 0.01) {
            vec3 flareAcc = vec3(0.0);
            int flareSpan = int(float(width) * clamp(L.thinStreakWidth * 0.35, 0.10, 0.50));

            int cellX = coord.x / 96;
            int cellY = coord.y / 96;
            float cellHash = fract(sin(float(cellX * 127 + cellY * 311)) * 43758.5453);

            if (cellHash > 0.88) {
                int peakX = cellX * 96 + int(fract(cellHash * 17.13) * 64.0) + 16;
                int peakY = cellY * 96 + int(fract(cellHash * 31.37) * 64.0) + 16;
                ivec2 peakCoord = clamp(ivec2(peakX, peakY), ivec2(0), ivec2(width - 1, height - 1));

                vec4 peakPix = unpackRGBA(in_pixels[peakCoord.y * width + peakCoord.x]);
                float peakLum = dot(peakPix.rgb, vec3(0.299, 0.587, 0.114));

                if (peakLum > 0.65) {
                    int distY = abs(coord.y - peakCoord.y);
                    int distX = abs(coord.x - peakCoord.x);
                    if (distY <= 2 && distX <= flareSpan) {
                        float hFalloff = 1.0 - (float(distX) / float(flareSpan));
                        float vFalloff = (distY == 0) ? 1.0 : 0.45;
                        vec3 whiteStreak = vec3(1.0) * pow(hFalloff, 2.5) * vFalloff * peakLum;
                        flareAcc += whiteStreak * L.thinStreakIntensity * clamp(L.thinStreakOpacity, 0.0, 1.0);
                    }
                }
            }
            layerColor += flareAcc * 0.85;
        }

        // 16. BSLA Extreme: God Rays & Mist
        if (L.bslaGodRays > 0.01 || L.bslaFogDensity > 0.01) {
            vec2 uvCoord = vec2(coord) / vec2(width, height);
            if (L.bslaGodRays > 0.01) {
                vec2 lightSrc = vec2(float(width) * 0.5, float(height) * 0.18);
                vec2 rayDir = (lightSrc - vec2(coord)) / float(max(width, height));
                vec3 godRayAcc = vec3(0.0);
                vec2 curRayPos = vec2(coord);
                float stepSize = 14.0;
                float rayDecay = 1.0;

                for (int s = 0; s < 12; s++) {
                    curRayPos += rayDir * stepSize;
                    ivec2 rc = clamp(ivec2(curRayPos), ivec2(0), ivec2(width - 1, height - 1));
                    vec4 rPix = unpackRGBA(in_pixels[rc.y * width + rc.x]);
                    float rLum = dot(rPix.rgb, vec3(0.299, 0.587, 0.114));
                    godRayAcc += rPix.rgb * smoothstep(0.55, 0.98, rLum) * rayDecay;
                    rayDecay *= 0.88;
                }

                vec3 sunShaftTint = vec3(0.95, 0.98, 1.05);
                layerColor += (godRayAcc / 12.0) * sunShaftTint * (L.bslaGodRays * 0.65);
            }

            if (L.bslaFogDensity > 0.01) {
                float fogAlt = smoothstep(1.0 - L.bslaFogDepth, 0.0, uvCoord.y);
                float lumScatter = smoothstep(0.15, 0.85, luma) * L.bslaBloomHaze;
                vec3 liminalMist = vec3(0.56, 0.64, 0.72) + vec3(0.25, 0.28, 0.32) * lumScatter;
                float fogFactor = clamp(L.bslaFogDensity * (0.35 + 0.65 * fogAlt), 0.0, 0.85);
                layerColor = 1.0 - (1.0 - layerColor) * (1.0 - liminalMist * fogFactor);
            }
        }

        // 17. Volumetric Occluded Light Rays
        if (L.volRaysLength > 0.01) {
            vec2 center = vec2(width, height) * 0.5;
            vec2 delta = (center - vec2(coord)) * (0.018 * L.volRaysLength);
            vec3 rayAcc = vec3(0.0);
            vec2 curCoord = vec2(coord);
            float decay = 1.0;
            for (int s = 0; s < 10; s++) {
                curCoord += delta;
                ivec2 sc = clamp(ivec2(curCoord), ivec2(0), ivec2(width - 1, height - 1));
                vec4 sp = unpackRGBA(in_pixels[sc.y * width + sc.x]);
                float sLum = dot(sp.rgb, vec3(0.299, 0.587, 0.114));
                float pass = smoothstep(0.70, 1.0, sLum);
                rayAcc += sp.rgb * pass * decay;
                decay *= L.volRaysDecay;
            }
            layerColor = 1.0 - (1.0 - layerColor) * (1.0 - clamp(rayAcc * L.volRaysLength * 0.14, 0.0, 0.95));
        }

        // 18. Depth of Field
        if (L.depthOfField > 0.01) {
            float normY = float(coord.y) / float(height);
            float focusDist = abs(normY - L.dofFocus);
            if (focusDist > 0.12) {
                float blurAmount = smoothstep(0.12, 0.45, focusDist) * L.depthOfField * 4.0;
                vec2 dir = vec2(cos(L.dofAngle), sin(L.dofAngle));
                vec3 dofAcc = layerColor;
                int dSamples = int(clamp(blurAmount, 1.0, 5.0));
                for (int d = 1; d <= dSamples; d++) {
                    ivec2 dc1 = clamp(coord + ivec2(dir * float(d) * 2.0), ivec2(0), ivec2(width - 1, height - 1));
                    ivec2 dc2 = clamp(coord - ivec2(dir * float(d) * 2.0), ivec2(0), ivec2(width - 1, height - 1));
                    dofAcc += unpackRGBA(in_pixels[dc1.y * width + dc1.x]).rgb;
                    dofAcc += unpackRGBA(in_pixels[dc2.y * width + dc2.x]).rgb;
                }
                layerColor = dofAcc / float(1 + dSamples * 2);
            }
        }

        // 19. Halation
        if (L.halationRadius > 0.01) {
            float redBleed = smoothstep(0.50, 0.95, luma) * L.halationRadius * 0.35;
            layerColor.r += redBleed * (1.0 + L.halationWarmth * 0.5);
            layerColor.g += redBleed * (0.2 + L.halationWarmth * 0.15);
        }

        // 20. Film Grain
        if (L.filmGrain > 0.001) {
            float noise = (hash12(vec2(coord) + vec2(u_time * 17.13, u_time * 31.37)) - 0.5);
            layerColor += vec3(noise * L.filmGrain * 0.06);
        }

        // 21. Flicker
        if (L.flickerIntensity > 0.01) {
            float freq = max(L.flickerSpeed, 1.0) * 6.2831853;
            float fWave = sin(u_time * freq) * 0.5 + 0.5;
            layerColor *= (1.0 + (fWave - 0.5) * L.flickerIntensity * 0.50);
        }

        // 22. Vignettes
        if (L.vignette > 0.01) {
            vec2 uv = (vec2(coord) / vec2(width, height)) - 0.5;
            float dist = length(uv);
            float vig = smoothstep(0.75, 0.15, dist * (0.7 + L.vignette * 0.8));
            layerColor *= clamp(vig, 0.0, 1.0);
        }
        if (L.vignetteBoxed > 0.01) {
            vec2 uv = abs((vec2(coord) / vec2(width, height)) - 0.5) * 2.0;
            float boxDist = max(uv.x, uv.y);
            float boxVig = smoothstep(0.95, 0.20, boxDist * (0.7 + L.vignetteBoxed * 0.8));
            layerColor *= clamp(boxVig, 0.0, 1.0);
        }

        currentComposite = applyBlendMode(currentComposite, layerColor, int(L.blendMode), L.opacity);
    }

    // 24. 3D LUT TRILINEAR APPLICATION
    if (u_hasLut > 0.5) {
        currentComposite = sample3DLut(currentComposite, u_lutOpacity);
    }

    // Master Tonemapping
    if (u_tonemapMode == 1.0) {
        currentComposite = tonemapReinhardExtended(currentComposite);
    } else if (u_tonemapMode == 2.0) {
        currentComposite = tonemapACES(currentComposite);
    }

    out_pixels[pixelIndex] = packRGBA(vec4(currentComposite, basePixel.a));
}
