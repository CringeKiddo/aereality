#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D inputImage;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D outputImage;

layout(set = 0, binding = 2, std140) uniform Uniforms {
    vec2 resolution;
    float brightness;
    float saturation;
    float contrast;
    float sharpness;
    float gamma;
    float hue;
    float temperature;
    float glowIntensity;
    float lookMix;
    float vignette;
    float splitToning;
} u;

// ---------- 9x9 BOX BLUR ----------
vec3 boxBlur9x9(ivec2 pos, ivec2 size) {
    vec3 result = vec3(0.0);
    float total = 0.0;
    for (int dy = -4; dy <= 4; dy++) {
        for (int dx = -4; dx <= 4; dx++) {
            ivec2 samplePos = clamp(pos + ivec2(dx, dy), ivec2(0), size - 1);
            vec4 sampleColor = imageLoad(inputImage, samplePos);
            result += sampleColor.rgb;
            total += 1.0;
        }
    }
    return result / total;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inputImage);
    if (pos.x >= size.x || pos.y >= size.y) return;

    vec4 original = imageLoad(inputImage, pos);

    // 1. Get the blurred image (linear)
    vec3 blurred = boxBlur9x9(pos, size);

    // 2. Bloom: bright areas of the blurred image, added to original
    float lum = dot(original.rgb, vec3(0.299, 0.587, 0.114));
    float threshold = 0.2; // low so most things bloom
    float mask = smoothstep(threshold, 1.0, lum);

    float intensity = 2.0; // strong
    vec3 bloom = blurred * mask * intensity;

    // 3. Combine (no tonemap, no grading – just raw linear)
    vec3 finalLinear = original.rgb + bloom;

    // 4. Clamp to 0-1 (just in case)
    finalLinear = clamp(finalLinear, 0.0, 1.0);

    // 5. Output (no conversion to sRGB – keep linear for now)
    imageStore(outputImage, pos, vec4(finalLinear, original.a));
}
