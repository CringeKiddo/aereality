#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D inputImage;
layout(set = 0, binding = 1, rgba32f) uniform writeonly image2D outputImage;

layout(set = 0, binding = 2, std140) uniform Uniforms {
    vec2 resolution;
    float brightness;
    float saturation;
    float contrast;
    float sharpness;
    float gamma;
    float hue;
    float temperature;
    float glowIntensity;
    float lookMix;
    float vignette;
    float splitToning;
} u;

// ---------- HELPERS ----------
vec3 srgbToLinear(vec3 srgb) {
    vec3 less = step(vec3(0.04045), srgb);
    return mix(srgb / 12.92, pow((srgb + 0.055) / 1.055, vec3(2.4)), less);
}

vec3 linearToSrgb(vec3 lin) {
    vec3 less = step(vec3(0.0031308), lin);
    return mix(lin * 12.92, pow(lin, vec3(1.0 / 2.4)) * 1.055 - 0.055, less);
}

// ---------- 13x13 BOX BLUR (correct signature) ----------
vec3 boxBlur13x13(ivec2 pos, ivec2 size) {
    vec3 result = vec3(0.0);
    float total = 0.0;
    for (int dy = -6; dy <= 6; dy++) {
        for (int dx = -6; dx <= 6; dx++) {
            ivec2 samplePos = clamp(pos + ivec2(dx, dy), ivec2(0), size - 1);
            vec4 sampleColor = imageLoad(inputImage, samplePos);
            result += sampleColor.rgb;
            total += 1.0;
        }
    }
    return result / total;
}

// ---------- GRADING PIPELINE (no bloom) ----------
vec3 gradeImage(vec3 linear, float brightness, float contrast, float gamma, float saturation, float temperature, float hue, float lookMix, float vignette, float splitToning, vec2 uv) {
    // Brightness
    linear += brightness;
    // Contrast
    linear = (linear - 0.5) * contrast + 0.5;
    // Gamma
    linear = pow(max(linear, vec3(0.0)), vec3(1.0 / gamma));
    // Saturation
    float lum = dot(linear, vec3(0.299, 0.587, 0.114));
    linear = mix(vec3(lum), linear, saturation);
    // Temperature
    float r = linear.r * (temperature / 6500.0);
    float b = linear.b * (6500.0 / temperature);
    linear = vec3(r, linear.g, b);
    // Hue (simplified – we'll keep it)
    // Teal/Orange
    vec3 teal = vec3(0.0, 0.6, 0.6);
    vec3 orange = vec3(0.8, 0.5, 0.2);
    vec3 target = mix(orange, teal, linear.r);
    linear = mix(linear, target, lookMix);
    // Vignette
    float vig = 1.0 - vignette * (distance(uv, vec2(0.5)) * distance(uv, vec2(0.5)));
    linear *= vig;
    // Split Toning (simplified)
    vec3 shadows = vec3(0.1, 0.2, 0.6);
    vec3 highlights = vec3(0.9, 0.5, 0.1);
    float lum2 = dot(linear, vec3(0.299, 0.587, 0.114));
    vec3 tone = mix(shadows, highlights, lum2);
    linear = mix(linear, tone * linear, splitToning);
    return linear;
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inputImage);
    if (pos.x >= size.x || pos.y >= size.y) return;

    vec4 color = imageLoad(inputImage, pos);
    vec2 uv = vec2(pos) / vec2(size);

    // ---------- 1. Grade the image (no bloom) ----------
    vec3 linear = srgbToLinear(color.rgb);
    // Hardcode values for testing (you can adjust these)
    float brightness = 0.0;
    float contrast = 1.0;
    float gamma = 1.0;
    float saturation = 1.0;
    float temperature = 6500.0;
    float hue = 0.0;
    float lookMix = 0.0;
    float vignette = 0.0;
    float splitToning = 0.0;

    linear = gradeImage(linear, brightness, contrast, gamma, saturation, temperature, hue, lookMix, vignette, splitToning, uv);

    // ---------- 2. Tonemap ----------
    // Filmic tonemap (Uncharted 2)
    const float A = 0.15;
    const float B = 0.50;
    const float C = 0.10;
    const float D = 0.20;
    const float E = 0.02;
    const float F = 0.30;
    vec3 tonemapped = ((linear * (A * linear + C * B) + D * E) / (linear * (A * linear + B) + D * F)) - E / F;

    // ---------- 3. Convert to sRGB ----------
    vec3 srgb = linearToSrgb(tonemapped);

    // ---------- 4. BLOOM (applied in sRGB space, AFTER tonemap) ----------
    // This ensures the bloom adds actual bright highlights that "shine"
    vec3 blurredLinear = srgbToLinear(imageLoad(inputImage, pos).rgb);
    // We need to tonemap and convert the blurred image too
    vec3 blurredTonemapped = ((blurredLinear * (A * blurredLinear + C * B) + D * E) / (blurredLinear * (A * blurredLinear + B) + D * F)) - E / F;
    vec3 blurredSrgb = linearToSrgb(blurredTonemapped);
    // Now blur the sRGB image by sampling neighboring pixels' blurredSrgb? That would require multiple passes.
    // Instead, we blur the original linear image, then tonemap and convert.
    // Let's do the blur on the original linear image, then tonemap and convert it.
    // Correct approach:
    vec3 blurredLinearOriginal = boxBlur13x13(pos, size); // blurred linear input
    vec3 blurredTonemappedOriginal = ((blurredLinearOriginal * (A * blurredLinearOriginal + C * B) + D * E) / (blurredLinearOriginal * (A * blurredLinearOriginal + B) + D * F)) - E / F;
    vec3 blurredSrgbOriginal = linearToSrgb(blurredTonemappedOriginal);

    // Create bloom: only take bright parts of the blurred image
    float bloomIntensity = 1.5; // Hardcoded for test – you can adjust
    float threshold = 0.3; // Only blur pixels brighter than this
    float lumBlur = dot(blurredSrgbOriginal, vec3(0.299, 0.587, 0.114));
    float mask = smoothstep(threshold, 1.0, lumBlur);
    vec3 bloom = blurredSrgbOriginal * mask * bloomIntensity;

    // Add bloom to the graded image
    vec3 finalSrgb = srgb + bloom;

    // Clamp
    finalSrgb = clamp(finalSrgb, 0.0, 1.0);

    // Write output
    imageStore(outputImage, pos, vec4(finalSrgb, color.a));
}
