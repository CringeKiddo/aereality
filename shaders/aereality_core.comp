#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D inputImage;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outputImage;

// =======================================================================
// UNIFORM DEFINITION (66 floats = 264 bytes std140 block)
// =======================================================================
layout(set = 0, binding = 2, std140) uniform Uniforms {
    float time;               // 0
    float brightness;         // 1
    float saturation;         // 2
    float contrast;           // 3
    float sharpness;          // 4
    float gamma;              // 5
    float hue;                // 6
    float temperature;        // 7
    float bloomIntensity;     // 8
    float bloomSpread;        // 9
    float bloomThreshold;     // 10
    float bloomRadius;        // 11
    float edgeGlowTint;       // 12 (0=Neutral, 1=Gold, 2=Quincy Cyan, 3=Cyan, 4=Crimson)
    float anamorphicFlare;    // 13
    float flareAmount;        // 14
    float lightRays;          // 15
    float lightRaysDecay;     // 16
    float shadows;            // 17
    float highlights;         // 18
    float darkOutlines;       // 19
    float edgeDarken;         // 20
    float vignette;           // 21
    float splitToning;        // 22
    float denoise;            // 23
    float blackCrush;         // 24
    float flickerIntensity;   // 25
    float flickerSpeed;       // 26
    float depthOfField;       // 27
    float dofFocus;           // 28
    float dofAngle;           // 29
    float mathOpsMode;        // 30
    float mathOpsMix;         // 31
    float filmConvertNitrate; // 32
    float fourColorGradMix;   // 33

    // 5-Point Spline Curves (Master, Red, Green, Blue)
    vec4 curveMasterA;        // 34..37 (p0, p1, p2, p3)
    vec4 curveMasterB;        // 38..41 (p4, 0, 0, 0)
    vec4 curveRedA;           // 42..45
    vec4 curveRedB;           // 46..49
    vec4 curveGreenA;         // 50..53
    vec4 curveGreenB;         // 54..57
    vec4 curveBlueA;          // 58..61
    vec4 curveBlueB;          // 62..65
} u;

// =======================================================================
// UTILITY FUNCTIONS & SANITIZATION
// =======================================================================
bool isBad(float v) {
    return isnan(v) || isinf(v);
}

vec3 sanitize(vec3 v) {
    return vec3(
        isBad(v.r) ? 0.0 : clamp(v.r, 0.0, 16.0),
        isBad(v.g) ? 0.0 : clamp(v.g, 0.0, 16.0),
        isBad(v.b) ? 0.0 : clamp(v.b, 0.0, 16.0)
    );
}

float getLuminance(vec3 c) {
    return dot(c, vec3(0.2126, 0.7152, 0.0722));
}

vec3 linearToSrgb(vec3 lin) {
    lin = clamp(lin, 0.0, 1.0);
    vec3 less = step(vec3(0.0031308), lin);
    return mix(lin * 12.92, pow(max(lin, vec3(0.0)), vec3(1.0 / 2.4)) * 1.055 - 0.055, less);
}

vec3 srgbToLinear(vec3 s) {
    s = clamp(s, 0.0, 1.0);
    vec3 less = step(vec3(0.04045), s);
    return mix(s / 12.92, pow((s + 0.055) / 1.055, vec3(2.4)), less);
}

// Triangular Probability Density Function (TPDF) Dither
float getTPDFDither(vec2 coord) {
    float r1 = fract(sin(dot(coord, vec2(12.9898, 78.233))) * 43758.5453);
    float r2 = fract(sin(dot(coord + vec2(0.5, 0.5), vec2(39.346, 11.135))) * 23421.631);
    return (r1 + r2 - 1.0);
}

// High-precision Bilinear Sampling
vec3 sampleInputLinear(vec2 uv, ivec2 inSize) {
    vec2 pos = uv * vec2(inSize) - 0.5;
    ivec2 p00 = clamp(ivec2(floor(pos)), ivec2(0), inSize - 1);
    ivec2 p11 = clamp(p00 + ivec2(1), ivec2(0), inSize - 1);
    vec2 f = fract(pos);

    vec3 c00 = imageLoad(inputImage, ivec2(p00.x, p00.y)).rgb;
    vec3 c10 = imageLoad(inputImage, ivec2(p11.x, p00.y)).rgb;
    vec3 c01 = imageLoad(inputImage, ivec2(p00.x, p11.y)).rgb;
    vec3 c11 = imageLoad(inputImage, ivec2(p11.x, p11.y)).rgb;

    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

// Bright-Pass Knee Extractor
vec3 brightPassExtract(vec3 color, float threshold, float knee) {
    float lum = getLuminance(color);
    float t = smoothstep(threshold - knee, threshold + knee, lum);
    float contribution = t * lum / max(lum, 1e-5);
    return color * clamp(contribution, 0.0, 10.0);
}

// =======================================================================
// CATMULL-ROM 5-POINT SPLINE EVALUATION
// =======================================================================
float evalCurve5(float x, vec4 cA, float c4) {
    x = clamp(x, 0.0, 1.0);
    float p0 = cA.x, p1 = cA.y, p2 = cA.z, p3 = cA.w, p4 = c4;
    float segment = x * 4.0;
    int idx = int(floor(segment));
    if (idx >= 4) return p4;
    float t = fract(segment);
    float y0, y1, y2, y3;
    if (idx == 0) { y0 = p0; y1 = p0; y2 = p1; y3 = p2; }
    else if (idx == 1) { y0 = p0; y1 = p1; y2 = p2; y3 = p3; }
    else if (idx == 2) { y0 = p1; y1 = p2; y2 = p3; y3 = p4; }
    else { y0 = p2; y1 = p3; y2 = p4; y3 = p4; }

    float m1 = 0.5 * (y2 - y0);
    float m2 = 0.5 * (y3 - y1);
    float t2 = t * t;
    float t3 = t2 * t;
    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;
    return clamp(h00 * y1 + h10 * m1 + h01 * y2 + h11 * m2, 0.0, 1.0);
}

// =======================================================================
// MAGIC BULLET: COSMO II (BILATERAL SKIN SMOOTHING)
// =======================================================================
vec3 applyCosmoSkinSmooth(vec3 centerColor, vec2 uv, ivec2 inSize, float strength) {
    if (strength <= 0.001) return centerColor;

    // Detect skin tones in YCbCr color space
    float Y = dot(centerColor, vec3(0.299, 0.587, 0.114));
    float Cb = -0.168736 * centerColor.r - 0.331264 * centerColor.g + 0.5 * centerColor.b;
    float Cr = 0.5 * centerColor.r - 0.418688 * centerColor.g - 0.081312 * centerColor.b;
    
    // Anime and photographic skin tone range
    float skinWeight = smoothstep(-0.25, -0.05, Cb) * (1.0 - smoothstep(0.05, 0.25, Cb)) *
                       smoothstep(0.05, 0.15, Cr) * (1.0 - smoothstep(0.30, 0.45, Cr));
    skinWeight *= smoothstep(0.15, 0.85, Y);

    if (skinWeight <= 0.01) return centerColor;

    vec2 texel = 1.0 / vec2(inSize);
    vec3 filtered = vec3(0.0);
    float totalW = 0.0;
    float spatialSigma = 3.5;
    float colorSigma = 0.12;

    for (int y = -2; y <= 2; y++) {
        for (int x = -2; x <= 2; x++) {
            vec2 offset = vec2(float(x), float(y)) * texel * 1.5;
            vec3 sCol = sampleInputLinear(clamp(uv + offset, 0.0, 1.0), inSize);
            float distSpatial = float(x * x + y * y);
            float distColor = length(sCol - centerColor);
            float w = exp(-distSpatial / (2.0 * spatialSigma * spatialSigma)) *
                      exp(-distColor / (2.0 * colorSigma * colorSigma));
            filtered += sCol * w;
            totalW += w;
        }
    }

    vec3 smoothed = filtered / max(totalW, 1e-5);
    return mix(centerColor, smoothed, skinWeight * strength * 0.85);
}

// =======================================================================
// MAGIC BULLET: RENOIR (35MM EDGE HALATION & FILM GRAIN)
// =======================================================================
vec3 applyRenoirHalation(vec3 color, vec2 uv, ivec2 inSize, float intensity) {
    if (intensity <= 0.001) return color;

    vec2 texel = 1.0 / vec2(inSize);
    vec3 redBleed = vec3(0.0);
    float totalW = 0.0;
    const int radius = 4;

    for (int y = -radius; y <= radius; y++) {
        for (int x = -radius; x <= radius; x++) {
            vec2 offset = vec2(float(x), float(y)) * texel * 2.8;
            vec3 s = sampleInputLinear(clamp(uv + offset, 0.0, 1.0), inSize);
            float lum = getLuminance(s);
            float w = exp(-float(x * x + y * y) / 12.0) * smoothstep(0.55, 0.95, lum);
            redBleed += s * w;
            totalW += w;
        }
    }

    vec3 halationColor = vec3(1.4, 0.25, 0.05) * (redBleed / max(totalW, 1e-5));
    return color + halationColor * (intensity * 0.45);
}

// =======================================================================
// MAGIC BULLET: MOJO II (TEAL / ORANGE CONTRAST HARMONY)
// =======================================================================
vec3 applyMojoTealOrange(vec3 color, float strength) {
    if (strength <= 0.001) return color;

    float lum = getLuminance(color);
    vec3 coolTeal = vec3(0.05, 0.85, 1.15);
    vec3 warmOrange = vec3(1.25, 0.80, 0.35);

    vec3 split = mix(coolTeal * color, warmOrange * color, smoothstep(0.25, 0.75, lum));
    return mix(color, split, strength * 0.65);
}

// =======================================================================
// RING-FREE MULTI-OCTAVE GAUSSIAN BLOOM
// =======================================================================
vec3 calculateSmoothBloom(vec2 uv, ivec2 inSize, float intensity, float spread, float threshold, float tintMode) {
    if (intensity <= 0.001) return vec3(0.0);

    float knee = max(threshold * 0.3, 0.05);
    const int kernelSize = 5;
    float sigma = clamp(spread * 22.0 + 3.0, 2.0, 32.0);
    vec2 texel = 1.0 / vec2(inSize);
    float twoSigmaSq = 2.0 * sigma * sigma;

    vec3 accum = vec3(0.0);
    float totalWeight = 0.0;

    for (int y = -kernelSize; y <= kernelSize; y++) {
        for (int x = -kernelSize; x <= kernelSize; x++) {
            vec2 offset = vec2(float(x), float(y)) * texel * sigma * 0.40;
            vec2 sampleUV = clamp(uv + offset, 0.0, 1.0);
            vec3 sampleColor = sampleInputLinear(sampleUV, inSize);
            vec3 bright = brightPassExtract(sampleColor, threshold, knee);

            float distSq = float(x * x + y * y);
            float weight = exp(-distSq / twoSigmaSq);
            weight *= 0.5 + 0.5 * getLuminance(bright);

            accum += bright * weight;
            totalWeight += weight;
        }
    }

    if (totalWeight < 1e-5) return vec3(0.0);

    vec3 tint = vec3(1.0);
    if (tintMode > 0.5 && tintMode < 1.5) tint = vec3(1.3, 1.05, 0.65);      // Gold / Warm
    else if (tintMode >= 1.5 && tintMode < 2.5) tint = vec3(0.7, 1.1, 1.6);  // Quincy Cyan
    else if (tintMode >= 2.5 && tintMode < 3.5) tint = vec3(0.4, 1.3, 1.5);  // Cyan
    else if (tintMode >= 3.5) tint = vec3(1.6, 0.5, 0.6);                    // Crimson

    return (accum / totalWeight) * intensity * 0.85 * tint;
}

// =======================================================================
// 1D ANAMORPHIC FLARE (HORIZONTAL STRETCH & CHROMATIC DISPERSION)
// =======================================================================
vec3 calculateSmoothFlares(vec2 uv, ivec2 inSize, float intensity, float spread, float threshold) {
    if (intensity <= 0.001) return vec3(0.0);

    float knee = max(threshold * 0.3, 0.05);
    const int taps = 14;
    float sigma = spread * 35.0 + 8.0;
    vec2 texel = 1.0 / vec2(inSize);
    float twoSigmaSq = 2.0 * sigma * sigma;
    vec3 accum = vec3(0.0);
    float totalWeight = 0.0;

    for (int i = -taps; i <= taps; i++) {
        float x = float(i);
        vec2 offset = vec2(x * texel.x * sigma * 0.28, 0.0);
        vec2 sampleUV = clamp(uv + offset, 0.0, 1.0);
        vec3 sampleColor = sampleInputLinear(sampleUV, inSize);
        vec3 bright = brightPassExtract(sampleColor, threshold, knee);

        float weight = exp(-(x * x) / twoSigmaSq);
        vec3 dispersion = vec3(1.0 + x * 0.015, 1.0, 1.0 - x * 0.015);
        accum += bright * weight * dispersion;
        totalWeight += weight;
    }

    if (totalWeight < 1e-5) return vec3(0.0);
    return (accum / totalWeight) * intensity * 0.7;
}

// =======================================================================
// DIRECTIONAL GOD RAYS / LIGHT RAYS
// =======================================================================
vec3 calculateLightRays(vec2 uv, ivec2 inSize, float intensity, float decay) {
    if (intensity <= 0.001) return vec3(0.0);

    vec2 lightPos = vec2(0.5, 0.15);
    vec2 delta = (uv - lightPos);
    const int numSamples = 20;
    delta *= 1.0 / float(numSamples);

    vec2 currentUV = uv;
    float illuminationDecay = 1.0;
    vec3 rayColor = vec3(0.0);

    for (int i = 0; i < numSamples; i++) {
        currentUV -= delta;
        vec3 s = sampleInputLinear(clamp(currentUV, 0.0, 1.0), inSize);
        float lum = getLuminance(s);
        if (lum > 0.65) {
            s *= illuminationDecay;
            rayColor += s;
        }
        illuminationDecay *= clamp(decay, 0.7, 0.98);
    }

    return (rayColor / float(numSamples)) * intensity * 1.5;
}

// =======================================================================
// CLEAN MID-GRAY (0.18) CONTRAST PIVOT & HEADROOM SATURATION
// =======================================================================
vec3 applyCleanContrast(vec3 color, float contrast, float blackCrush) {
    const float midGray = 0.18;
    vec3 contrasted = (color - vec3(midGray)) * contrast + vec3(midGray);
    contrasted = max(contrasted, vec3(0.0));

    if (blackCrush > 0.001) {
        float crush = blackCrush * 0.08;
        contrasted = max(contrasted - vec3(crush), vec3(0.0));
        contrasted = pow(contrasted + vec3(1e-5), vec3(1.0 + blackCrush * 0.4));
    }
    return contrasted;
}

vec3 applySaturationSafe(vec3 color, float saturation) {
    float lum = getLuminance(color);
    float headroom = 1.0 - smoothstep(0.7, 1.3, lum);
    float effectiveSat = mix(1.0, saturation, headroom);
    return mix(vec3(lum), color, effectiveSat);
}

// =======================================================================
// ANIME INK LINES (SOBEL FILTER)
// =======================================================================
vec3 applySobelLineArt(vec3 color, ivec2 pos, ivec2 inSize, float intensity) {
    if (intensity <= 0.001) return color;
    ivec2 pN = clamp(pos + ivec2(0, -1), ivec2(0), inSize - 1);
    ivec2 pS = clamp(pos + ivec2(0,  1), ivec2(0), inSize - 1);
    ivec2 pW = clamp(pos + ivec2(-1, 0), ivec2(0), inSize - 1);
    ivec2 pE = clamp(pos + ivec2( 1, 0), ivec2(0), inSize - 1);

    float lumN = getLuminance(imageLoad(inputImage, pN).rgb);
    float lumS = getLuminance(imageLoad(inputImage, pS).rgb);
    float lumW = getLuminance(imageLoad(inputImage, pW).rgb);
    float lumE = getLuminance(imageLoad(inputImage, pE).rgb);
    float lumC = getLuminance(color);

    float edgeMag = abs(lumE - lumW) + abs(lumS - lumN);
    float darkMask = 1.0 - smoothstep(0.04, 0.75, lumC);
    float lineBoost = pow(edgeMag * 4.5, 1.25) * darkMask * (intensity * 1.8);
    return color * max(1.0 - lineBoost, 0.0);
}

// =======================================================================
// DEPTH OF FIELD (TILT-SHIFT & BOKEH)
// =======================================================================
vec3 applyDepthOfField(vec3 color, vec2 uv, ivec2 inSize, float dof, float focus, float angle) {
    if (dof <= 0.001) return color;

    // Angle rotation for tilt-shift
    float rad = radians(angle);
    vec2 rotUV = vec2(
        cos(rad) * (uv.x - 0.5) - sin(rad) * (uv.y - 0.5) + 0.5,
        sin(rad) * (uv.x - 0.5) + cos(rad) * (uv.y - 0.5) + 0.5
    );

    float distFromFocus = abs(rotUV.y - focus);
    float blurAmount = smoothstep(0.05, 0.40, distFromFocus) * dof * 4.0;
    if (blurAmount <= 0.01) return color;

    vec2 texel = 1.0 / vec2(inSize);
    vec3 blurred = vec3(0.0);
    float totalW = 0.0;
    const int dofSamples = 8;

    for (int i = 0; i < dofSamples; i++) {
        float theta = float(i) * 6.28318 / float(dofSamples);
        vec2 offset = vec2(cos(theta), sin(theta)) * texel * blurAmount * 3.0;
        vec3 s = sampleInputLinear(clamp(uv + offset, 0.0, 1.0), inSize);
        blurred += s;
        totalW += 1.0;
    }

    return mix(color, blurred / totalW, clamp(blurAmount, 0.0, 1.0));
}

// =======================================================================
// ACES FILMIC TONE MAPPING
// =======================================================================
vec3 filmicTonemap(vec3 x) {
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    return clamp((x * (a * x + b)) / max(x * (c * x + d) + e, vec3(1e-4)), 0.0, 1.0);
}

// =======================================================================
// MAIN COMPUTE INVOCATION (PIPELINE DISPATCH)
// =======================================================================
void main() {
    ivec2 outPos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = imageSize(outputImage);
    ivec2 inSize = imageSize(inputImage);

    if (outPos.x >= outSize.x || outPos.y >= outSize.y) return;

    float scaleX = float(outSize.x) / float(inSize.x);
    float scaleY = float(outSize.y) / float(inSize.y);
    float scale = max(scaleX, scaleY);
    vec2 offset = (vec2(outSize) - vec2(inSize) * scale) * 0.5;
    vec2 uv = (vec2(outPos) - offset) / (vec2(inSize) * scale);
    uv = clamp(uv, 0.0, 1.0);

    ivec2 inPos = clamp(ivec2(uv * vec2(inSize)), ivec2(0), inSize - 1);
    vec3 linear = imageLoad(inputImage, inPos).rgb;
    linear = sanitize(linear);

    // 1. Unsharp Mask Sharpness
    if (u.sharpness > 0.01) {
        ivec2 pN = clamp(inPos + ivec2(0, -1), ivec2(0), inSize - 1);
        ivec2 pS = clamp(inPos + ivec2(0,  1), ivec2(0), inSize - 1);
        ivec2 pW = clamp(inPos + ivec2(-1, 0), ivec2(0), inSize - 1);
        ivec2 pE = clamp(inPos + ivec2( 1, 0), ivec2(0), inSize - 1);
        vec3 lap = (imageLoad(inputImage, pN).rgb + imageLoad(inputImage, pS).rgb + imageLoad(inputImage, pW).rgb + imageLoad(inputImage, pE).rgb) * 0.25;
        linear = max(linear + clamp((linear - lap) * (u.sharpness * 1.35), -0.45, 0.45), vec3(0.0));
    }

    // 2. Anime Ink Lines (Sobel)
    linear = applySobelLineArt(linear, inPos, inSize, u.darkOutlines);

    // 3. Cosmo II Skin Smoothing
    linear = applyCosmoSkinSmooth(linear, uv, inSize, u.denoise);

    // 4. Exposure / Brightness
    linear *= pow(2.0, clamp(u.brightness, -3.0, 3.0));

    // 5. Clean Mid-Gray Contrast (0.18 pivot)
    linear = applyCleanContrast(linear, u.contrast, u.blackCrush);

    // 6. Gamma
    float safeGamma = max(u.gamma, 0.1);
    linear = pow(max(linear, vec3(1e-4)), vec3(1.0 / safeGamma));

    // 7. Saturation (Headroom safe)
    linear = applySaturationSafe(linear, u.saturation);

    // 8. 5-Point Spline Curves (Master, R, G, B)
    linear.r = evalCurve5(linear.r, u.curveMasterA, u.curveMasterB.x);
    linear.g = evalCurve5(linear.g, u.curveMasterA, u.curveMasterB.x);
    linear.b = evalCurve5(linear.b, u.curveMasterA, u.curveMasterB.x);

    linear.r = evalCurve5(linear.r, u.curveRedA, u.curveRedB.x);
    linear.g = evalCurve5(linear.g, u.curveGreenA, u.curveGreenB.x);
    linear.b = evalCurve5(linear.b, u.curveBlueA, u.curveBlueB.x);

    // 9. Mojo II Teal/Orange Split Toning
    linear = applyMojoTealOrange(linear, u.splitToning);

    // 10. Renoir 35mm Halation
    linear = applyRenoirHalation(linear, uv, inSize, u.filmConvertNitrate);

    // 11. Continuous Ring-Free Gaussian Bloom
    float threshold = u.bloomThreshold > 0.001 ? u.bloomThreshold : 0.45;
    vec3 bloom = calculateSmoothBloom(uv, inSize, u.bloomIntensity, u.bloomSpread, threshold, u.edgeGlowTint);
    linear += bloom;

    // 12. Anamorphic 1D Flare
    vec3 flares = calculateSmoothFlares(uv, inSize, u.anamorphicFlare, u.flareAmount, threshold);
    linear += flares;

    // 13. Directional Light Rays
    vec3 rays = calculateLightRays(uv, inSize, u.lightRays, u.lightRaysDecay);
    linear += rays;

    // 14. Depth of Field Tilt-Shift
    linear = applyDepthOfField(linear, uv, inSize, u.depthOfField, u.dofFocus, u.dofAngle);

    // 15. Vignette
    if (u.vignette > 0.01) {
        vec2 d = (uv - 0.5) * vec2(1.1, 0.9);
        float dist = dot(d, d);
        float vig = clamp(1.0 - smoothstep(0.10, 0.95, dist * (1.0 + u.vignette * 2.8)) * (u.vignette * 1.3), 0.0, 1.0);
        linear *= vig;
    }

    // 16. ACES Tonemap
    linear = filmicTonemap(sanitize(linear));

    // 17. Linear to sRGB with Dither
    vec3 srgb = linearToSrgb(linear);
    float dither = getTPDFDither(vec2(outPos)) * (1.0 / 255.0);
    srgb = clamp(srgb + vec3(dither), vec3(0.0), vec3(1.0));

    imageStore(outputImage, outPos, vec4(srgb, 1.0));
}
