#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image2D inputImage;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D outputImage;

layout(set = 0, binding = 2, std140) uniform Uniforms {
    vec2 resolution;
    float brightness;
    float saturation;
    float contrast;
    float sharpness;
    float gamma;
    float hue;
    float temperature;
    float glowIntensity;
    float lookMix;
    float vignette;
    float splitToning;
} u;

// ------------------- HELPER FUNCTIONS (all in float) -------------------
float srgb_to_linear(float v) {
    if (v <= 0.04045) return v / 12.92;
    return pow((v + 0.055) / 1.055, 2.4);
}

float linear_to_srgb(float v) {
    if (v <= 0.0031308) return v * 12.92;
    return pow(v, 1.0 / 2.4) * 1.055 - 0.055;
}

vec3 srgb_to_linear_vec3(vec3 c) {
    return vec3(srgb_to_linear(c.r), srgb_to_linear(c.g), srgb_to_linear(c.b));
}

vec3 rgb2hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0/3.0, 2.0/3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

vec3 hsv2rgb(vec3 c) {
    vec4 K = vec4(1.0, 2.0/3.0, 1.0/3.0, 3.0);
    vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www);
    return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

vec3 temperature_shift(float kelvin) {
    float t = clamp((kelvin - 2000.0) / 10000.0, 0.0, 1.0);
    float r = 1.0 + (t * 0.3);
    float g = 1.0 + (t * 0.1) - ((1.0 - t) * 0.1);
    float b = 1.0 + ((1.0 - t) * 0.3);
    return vec3(r, g, b);
}

vec3 filmic_tonemap(vec3 color) {
    vec3 x = max(vec3(0.0), color - 0.004);
    vec3 result = (x * (6.2 * x + 0.5)) / (x * (6.2 * x + 1.7) + 0.06);
    return pow(result, vec3(1.0 / 2.2));
}

vec3 teal_orange(vec3 color, float mixAmount) {
    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
    vec3 teal = vec3(0.0, 0.6, 0.6);
    vec3 orange = vec3(1.0, 0.6, 0.1);
    vec3 graded = mix(teal, orange, luma);
    vec3 result = mix(color, color * graded, 0.7);
    return mix(color, result, mixAmount);
}

float dither(vec2 coord) {
    float n = dot(coord, vec2(0.06711056, 0.00583715));
    return fract(n);
}

void main() {
    ivec2 pos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(inputImage);
    if (pos.x >= size.x || pos.y >= size.y) return;

    // 1. Read input (sRGB)
    vec4 srgb = imageLoad(inputImage, pos);
    vec3 color = srgb.rgb;

    // 2. BGR fix (if needed)
    color = color.bgr;

    // 3. Convert to Linear (float)
    color = srgb_to_linear_vec3(color);

    // 4. Sharpening (float)
    if (u.sharpness > 0.005) {
        ivec2 texel = pos;
        vec3 left   = srgb_to_linear_vec3(imageLoad(inputImage, texel + ivec2(-1, 0)).rgb);
        vec3 right  = srgb_to_linear_vec3(imageLoad(inputImage, texel + ivec2(1, 0)).rgb);
        vec3 up     = srgb_to_linear_vec3(imageLoad(inputImage, texel + ivec2(0, -1)).rgb);
        vec3 down   = srgb_to_linear_vec3(imageLoad(inputImage, texel + ivec2(0, 1)).rgb);
        vec3 laplacian = 4.0 * color - (left + right + up + down);
        color += laplacian * u.sharpness * 0.15;
    }

    // 5. Temperature (float)
    vec3 tempGain = temperature_shift(u.temperature);
    color *= tempGain;

    // 6. Hue (float)
    if (abs(u.hue) > 0.5) {
        vec3 hsv = rgb2hsv(color);
        hsv.x = fract(hsv.x + (u.hue / 360.0));
        color = hsv2rgb(hsv);
    }

    // 7. Saturation (float)
    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
    color = mix(vec3(luma), color, u.saturation);

    // 8. Contrast (float)
    color = (color - 0.5) * u.contrast + 0.5;

    // 9. Brightness (float)
    color += u.brightness;

    // 10. Gamma (float)
    float invGamma = 1.0 / max(u.gamma, 0.1);
    color = pow(max(vec3(0.0), color), vec3(invGamma));

    // 11. Teal & Orange (float)
    color = teal_orange(color, u.lookMix);

    // 12. Vignette (float)
    vec2 uv = vec2(pos) / vec2(size);
    vec2 vigUV = uv - 0.5;
    float vigDist = length(vigUV);
    float vignetteAmount = 1.0 - (vigDist * u.vignette * 1.5);
    color *= vignetteAmount;

    // 13. Split Toning (float)
    float lumaSplit = dot(color, vec3(0.2126, 0.7152, 0.0722));
    vec3 shadowTint = vec3(0.1, 0.2, 0.6);
    vec3 highlightTint = vec3(1.0, 0.5, 0.1);
    vec3 tonedColor = mix(shadowTint, highlightTint, lumaSplit);
    color = mix(color, color * tonedColor, u.splitToning * 0.4);

    // 14. Glow (float)
    if (u.glowIntensity > 0.005) {
        vec3 blur = vec3(0.0);
        for (int ky = -1; ky <= 1; ky++) {
            for (int kx = -1; kx <= 1; kx++) {
                vec3 col = srgb_to_linear_vec3(imageLoad(inputImage, pos + ivec2(kx, ky)).rgb);
                blur += col;
            }
        }
        blur /= 9.0;
        float lumaBlur = dot(blur, vec3(0.2126, 0.7152, 0.0722));
        float glowMask = smoothstep(0.3, 0.8, lumaBlur);
        vec3 glow = blur * glowMask * u.glowIntensity * 0.6;
        color += glow;
    }

    // 15. Filmic Tonemap (float)
    color = filmic_tonemap(color);

    // 16. Linear → sRGB (float → 8-bit)
    color = vec3(
        linear_to_srgb(color.r),
        linear_to_srgb(color.g),
        linear_to_srgb(color.b)
    );

    // 17. Dither (float)
    float noise = (dither(vec2(pos)) - 0.5) / 255.0;
    color += noise;

    // 18. Final clamp (float → 0-1)
    color = clamp(color, 0.0, 1.0);

    // 19. Write output to RGBA8 texture (conversion happens automatically)
    imageStore(outputImage, pos, vec4(color, 1.0));
}
