#version 460

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly image2D inputImage;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outputImage;

layout(set = 0, binding = 2, std140) uniform Uniforms {
    vec2 resolution;          // output canvas size (width, height)
    float brightness;
    float saturation;
    float contrast;
    float sharpness;
    float gamma;
    float hue;
    float temperature;
    float glowIntensity;
    float lookMix;
    float vignette;
    float splitToning;
    float edgeDarken;
    float denoise;
    float cellShading;
    float colourCrush;
    float cellThickness;
} u;

// ---------- HELPERS ----------
vec3 srgbToLinear(vec3 srgb) {
    vec3 less = step(vec3(0.04045), srgb);
    return mix(srgb / 12.92, pow((srgb + 0.055) / 1.055, vec3(2.4)), less);
}

vec3 linearToSrgb(vec3 lin) {
    lin = max(lin, vec3(0.0));
    vec3 less = step(vec3(0.0031308), lin);
    return mix(lin * 12.92, pow(lin, vec3(1.0 / 2.4)) * 1.055 - 0.055, less);
}

vec3 adjustTemperature(vec3 color, float temp) {
    float r = color.r * (temp / 6500.0);
    float b = color.b * (6500.0 / temp);
    return vec3(r, color.g, b);
}

vec3 rotateHue(vec3 color, float angle) {
    float cosA = cos(angle * 3.14159 / 180.0);
    float sinA = sin(angle * 3.14159 / 180.0);
    mat3 rotMat = mat3(
        0.299 + 0.701 * cosA + 0.168 * sinA,
        0.587 - 0.587 * cosA + 0.330 * sinA,
        0.114 - 0.114 * cosA - 0.497 * sinA,
        0.299 - 0.299 * cosA - 0.328 * sinA,
        0.587 + 0.413 * cosA + 0.035 * sinA,
        0.114 - 0.114 * cosA + 0.293 * sinA,
        0.299 - 0.300 * cosA + 1.250 * sinA,
        0.587 - 0.588 * cosA - 1.050 * sinA,
        0.114 + 0.886 * cosA - 0.200 * sinA
    );
    return rotMat * color;
}

vec3 tealOrange(vec3 color, float mixAmount) {
    vec3 teal = vec3(0.0, 0.6, 0.6);
    vec3 orange = vec3(0.8, 0.5, 0.2);
    vec3 target = mix(orange, teal, color.r);
    return mix(color, target, mixAmount);
}

vec3 filmicTonemap(vec3 color) {
    const float A = 0.15;
    const float B = 0.50;
    const float C = 0.10;
    const float D = 0.20;
    const float E = 0.02;
    const float F = 0.30;
    float eps = 1e-6;
    return ((color * (A * color + C * B) + D * E) / (color * (A * color + B) + D * F + eps)) - E / F;
}

float vignetteEffect(vec2 uv, float amount) {
    float dist = distance(uv, vec2(0.5));
    float vig = 1.0 - amount * 2.0 * (dist * dist);
    return clamp(vig, 0.0, 1.0);
}

vec3 splitTone(vec3 color, float amount) {
    if (amount <= 0.0) return color;
    vec3 shadows = vec3(0.05, 0.12, 0.4);
    vec3 highlights = vec3(0.95, 0.5, 0.15);
    float lum = dot(color, vec3(0.299, 0.587, 0.114));
    vec3 tone = mix(shadows, highlights, clamp((lum - 0.0) / 1.0, 0.0, 1.0));
    return mix(color, tone, amount * 0.7);
}

vec3 bloomGlow(ivec2 pos, ivec2 size, float threshold, float intensity) {
    if (intensity <= 0.0) return vec3(0.0);
    const int samples = 64;
    const float radius = 60.0;
    vec3 accum = vec3(0.0);
    float wsum = 0.0;
    for (int i = 0; i < samples; ++i) {
        float angle = float(i) * 6.28318530718 / float(samples);
        float r = radius * (0.25 + 0.75 * fract(sin(float(i) * 12.9898 + 0.5) * 43758.5453));
        ivec2 samplePos = clamp(pos + ivec2(int(r * cos(angle)), int(r * sin(angle))), ivec2(0), size - 1);
        vec3 s = imageLoad(inputImage, samplePos).rgb;
        float lum = dot(s, vec3(0.299, 0.587, 0.114));
        float bright = max((lum - threshold) / (1.0 - threshold), 0.0);
        float dist = length(vec2(samplePos - pos));
        float weight = 1.0 / (1.0 + dist * dist / (radius * radius * 0.5));
        weight *= (0.5 + 0.5 * bright);
        accum += s * weight;
        wsum += weight;
    }
    if (wsum <= 0.0) return vec3(0.0);
    vec3 bloom = accum / wsum;
    float scale = intensity * 20.0;
    return clamp(bloom * scale, vec3(0.0), vec3(12.0));
}

vec3 denoise3x3(ivec2 pos, ivec2 size) {
    vec3 result = vec3(0.0);
    float total = 0.0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            ivec2 samplePos = clamp(pos + ivec2(dx, dy), ivec2(0), size - 1);
            result += imageLoad(inputImage, samplePos).rgb;
            total += 1.0;
        }
    }
    return result / total;
}

float thickEdge(ivec2 pos, ivec2 size, float thickness) {
    int radius = int(ceil(thickness * 3.0));
    float maxEdge = 0.0;
    for (int dy = -radius; dy <= radius; dy++) {
        for (int dx = -radius; dx <= radius; dx++) {
            ivec2 samplePos = clamp(pos + ivec2(dx, dy), ivec2(0), size - 1);
            float lum = dot(imageLoad(inputImage, samplePos).rgb, vec3(0.299, 0.587, 0.114));
            float gx = 0.0, gy = 0.0;
            for (int sy = -1; sy <= 1; sy++) {
                for (int sx = -1; sx <= 1; sx++) {
                    ivec2 p = clamp(samplePos + ivec2(sx, sy), ivec2(0), size - 1);
                    float l = dot(imageLoad(inputImage, p).rgb, vec3(0.299, 0.587, 0.114));
                    float kx = (sx == -1 ? -1 : (sx == 1 ? 1 : 0)) * (sy == -1 ? 1 : (sy == 0 ? 2 : 1));
                    float ky = (sy == -1 ? -1 : (sy == 1 ? 1 : 0)) * (sx == -1 ? 1 : (sx == 0 ? 2 : 1));
                    gx += l * kx;
                    gy += l * ky;
                }
            }
            float edge = sqrt(gx*gx + gy*gy);
            maxEdge = max(maxEdge, edge);
        }
    }
    return maxEdge;
}

float dither(vec2 pos) {
    float d = dot(pos, vec2(12.9898, 78.233));
    return fract(sin(d) * 43758.5453);
}

// ---------- MAIN ----------
void main() {
    ivec2 outPos = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outSize = ivec2(u.resolution);   // output canvas size from uniform
    ivec2 inSize = imageSize(inputImage);  // input video size

    if (outPos.x >= outSize.x || outPos.y >= outSize.y) return;

    // Compute scaling to fit input inside output (letterbox)
    float scaleX = float(outSize.x) / float(inSize.x);
    float scaleY = float(outSize.y) / float(inSize.y);
    float scale = min(scaleX, scaleY);  // 'fit' – use max() for crop

    vec2 offset = (vec2(outSize) - vec2(inSize) * scale) * 0.5;
    vec2 uv = (vec2(outPos) - offset) / (vec2(inSize) * scale);

    // Check for black borders
    if (uv.x < 0.0 || uv.x > 1.0 || uv.y < 0.0 || uv.y > 1.0) {
        imageStore(outputImage, outPos, vec4(0.0));
        return;
    }

    // Nearest-neighbor sampling (could be replaced with bilinear)
    ivec2 inPos = ivec2(uv * vec2(inSize));
    inPos = clamp(inPos, ivec2(0), inSize - 1);
    vec4 color = imageLoad(inputImage, inPos);

    // ----- Grading (same as before) -----
    vec3 linear = srgbToLinear(color.rgb);

    if (u.denoise > 0.0) {
        vec3 blurred = denoise3x3(inPos, inSize); // use input pos for denoise
        linear = mix(linear, blurred, u.denoise);
    }

    float gain = pow(2.0, u.brightness);
    linear *= gain;
    linear = (linear - 0.5) * u.contrast + 0.5;
    // gamma: clamp to positive to avoid pow issues
    float gammaClamped = max(u.gamma, 0.01);
    linear = pow(max(linear, vec3(1e-4)), vec3(1.0 / gammaClamped));
    float lum = dot(linear, vec3(0.299, 0.587, 0.114));
    linear = mix(vec3(lum), linear, u.saturation);
    linear = adjustTemperature(linear, u.temperature);
    linear = rotateHue(linear, u.hue);
    linear = tealOrange(linear, u.lookMix);

    // Glow (bloom) using input image – we use input pos for consistency
    float bloomThreshold = mix(0.8, 0.2, clamp(u.vignette, 0.0, 1.0));
    vec3 bloom = bloomGlow(inPos, inSize, bloomThreshold, u.glowIntensity);
    linear += bloom;

    vec3 tonemapped = filmicTonemap(linear);
    float exposure = max(max(linear.r, linear.g), linear.b);
    float tmBlend = clamp((exposure - 0.9) / (2.0 - 0.9), 0.0, 1.0);
    linear = mix(linear, tonemapped, tmBlend);

    // Vignette uses output UV (canvas space)
    vec2 outUV = (vec2(outPos) + 0.5) / vec2(outSize);
    float vig = vignetteEffect(outUV, u.vignette);
    linear *= vig;

    // Edge Darken also on output UV
    float edge = 1.0 - u.edgeDarken * smoothstep(0.3, 0.9, distance(outUV, vec2(0.5)));
    linear *= edge;

    linear = splitTone(linear, u.splitToning);

    // Cell Shading – use input image for edge detection
    if (u.cellShading > 0.0) {
        float edgeStrength = thickEdge(inPos, inSize, u.cellThickness);
        float threshold = mix(0.8, 0.2, u.cellShading);
        float line = 1.0 - smoothstep(threshold, threshold + 0.1, edgeStrength);
        linear = mix(linear, vec3(0.0), line * u.cellShading * 0.8);
    }

    // Colour Crush – clamp the value to 0.5 max
    float crushAmount = clamp(u.colourCrush, 0.0, 0.5);
    if (crushAmount > 0.0) {
        float steps = mix(256.0, 4.0, crushAmount);
        linear = floor(linear * steps) / steps;
    }

    linear = clamp(linear, vec3(0.0), vec3(1.0));
    vec3 srgb = linearToSrgb(linear);

    // Dither with increased amplitude (0.02 ≈ 5 quantization steps)
    float d = (dither(vec2(outPos)) - 0.5) * 0.02;
    srgb += d;
    srgb = clamp(srgb, vec3(0.0), vec3(1.0));

    imageStore(outputImage, outPos, vec4(srgb, color.a));
}
