// =============================================================================
// GRADIENT MAP (per layer, 48 floats, stored AFTER the 10 LayerData blocks: float index 1952 + l * 48)
// Runs inside the layer loop, so the layer's blend mode / opacity apply to it, and it always happens before the LUT.
// =============================================================================
struct GMapData {
    float enabled;      // 0
    float type;         // 1  see gradientMapField()
    float strength;     // 2  0..0.65 (hard capped in the shader)
    float angle;        // 3  radians
    float scale;        // 4
    float centerX;      // 5
    float centerY;      // 6
    float invert;       // 7
    float stopCount;    // 8  2..6
    float bands;        // 9  posterize steps
    float patternSize;  // 10 0..1 -> 4..64 px cells
    float edgeWidth;    // 11 edge width / split softness
    float lumaKeep;     // 12 0..1 keeps the original luminance (prevents flat / over-contrasty looks)
    float curve;        // 13 exponent on t
    float rangeLo;      // 14
    float rangeHi;      // 15
    float stopCol[6];   // 16..21 packed 0xRRGGBB (sRGB)
    float stopPos[6];   // 22..27
    float pad[20];      // 28..47
};

// -----------------------------------------------------------------------------
// FX BLOCK (batch 4, per layer, 72 floats, float index 2432 + l * 72) - per-effect opacity / custom blend and the new effects.
// Slot map is mirrored by class Fx in models.dart. Opacity slots default to 1, everything else to 0 (duoMid = -1 = unset).
// -----------------------------------------------------------------------------
struct FxData { float f[72]; };
// BATCH 6 per-layer blocks (64 floats each): VFX bubbles / rain / particles and Sapphire (S_Glint + S_LightLeak). See class Vfx / Sap in vfx_slots.dart.
struct VfxData { float v[64]; };
struct SapData { float s[64]; };
// CURVE BLOCK (batch 4, per layer, 72 floats, float index 3152 + l * 72): 4 channels (0 RGB, 1 R, 2 G, 3 B) x 18 floats
// = [pointCount, x0, y0, x1, y1 ... x7, y7]. pointCount 0 = identity (skipped).
struct CurveData { float c[72]; };

layout(std430, binding = 2) readonly buffer UniformBlock {
    float u_time;                  // 0
    float u_layerCount;            // 1
    float u_tonemapMode;           // 2: 0 Linear, 1 AgX, 2 Khronos Neutral+, 3 Aurora Depth, 4 Sakura Silk, 5 Prism Blend, 6 Obsidian Cel
    float u_imgWidth;              // 3
    float u_imgHeight;             // 4
    float u_hasLut;                // 5
    float u_lutOpacity;            // 6
    float u_copiedChromaShift_unused; // 7
    float u_copiedEdgeRays_unused; // 8
    float u_copiedProMist_unused;  // 9
    float u_copiedStarGlint_unused;// 10
    float u_horizontalRamp_unused; // 11
    float u_ditherStrength;        // 12
    float u_textSuiteEnabled;      // 13
    float u_textBoxX;              // 14
    float u_textBoxY;              // 15
    float u_textBoxW;              // 16
    float u_textBoxH;              // 17
    float u_textBevelDepth;        // 18
    float u_textChromeIntensity;   // 19
    float u_g20; float u_g21; float u_g22; float u_g23;
    float u_g24; float u_g25; float u_g26; float u_g27;   // 20..27 (legacy, now per-layer)
    float u_bitDepthMode;          // 28: 0 = 8-bit, 1 = 10-bit, 2 = 16-bit
    float u_g29; float u_g30; float u_g31;                // 29..31 (legacy, now per-layer)
    LayerData layers[10];          // 32 + l * 192
    GMapData gmaps[10];            // 1952 + l * 48
    FxData fx[10];                 // 2432 + l * 72
    CurveData cv[10];              // 3152 + l * 72
    float tx[224];                 // 3872 + i: text suite personal block (batch 5), tx[0] = 1 when the app packed it
    VfxData vx[10];                // 4096 + l * 64: VFX bubbles / rain / particles (batch 6)
    SapData sx[10];                // 4736 + l * 64: Sapphire S_Glint + S_LightLeak (batch 6)
    float motionS[1024];           // 5376..6399: MOTION S (batch 9), slot map = class MotionS in motion_slots.dart
    float timeSlice[1024];         // 6400..7423: TIME SLICE (batch 12), slot map = class TimeSlice in time_slice_slots.dart (per-layer 64 floats at 6400 + layer*64, per-frame state 7040..7423). Per-layer blocks are read by pass 22 (step C1); per-frame state 7040.. see the TS_STATE map above executeTimeSlice(). Buffer ends at float 8192: 7424..8191 is free headroom (not declared here)
    float bevel[160];              // 7424..7583: METALLIC BEVEL (batch 13), 16 floats per layer at 7424 + layer * 16, slot map = class Bevel in vfx_slots.dart (read by pass 26 only). 7584..8191 stays free headroom (not declared here)
    float mathops[160];            // 7584..7743: MATHOPS (batch 14), 16 floats per layer at 7584 + layer * 16, slot map = class MathOps in vfx_slots.dart (read by pass 27 only)
    float grad4[160];              // 7744..7903: 4-WAY GRADIENT (batch 14), 16 floats per layer at 7744 + layer * 16, slot map = class Gradient4Way in vfx_slots.dart (read by pass 28 only). 7904..8191 stays free headroom (not declared here)
};

// Per-dispatch globals
int gW;
int gH;
float gBit;
float gRes;
int gEdgeStep;

// =============================================================================
// COLOR UTILITIES
// =============================================================================
float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

vec3 sanitize(vec3 c) {
    if (any(isnan(c)) || any(isinf(c))) return vec3(0.0);
    return clamp(c, vec3(0.0), vec3(60000.0));
}

float srgbToLinear(float c) {
    return (c <= 0.04045) ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4);
}
vec3 srgbToLinear(vec3 c) {
    return vec3(srgbToLinear(c.r), srgbToLinear(c.g), srgbToLinear(c.b));
}
float linearToSrgb(float c) {
    c = clamp(c, 0.0, 1.0);
    return (c <= 0.0031308) ? (c * 12.92) : (1.055 * pow(c, 1.0 / 2.4) - 0.055);
}
vec3 linearToSrgb(vec3 c) {
    return vec3(linearToSrgb(c.r), linearToSrgb(c.g), linearToSrgb(c.b));
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float hashInt12(ivec2 p) {
    uvec2 q = uvec2(p);
    q = q * uvec2(1597334677u, 3812015801u);
    uint n = (q.x ^ q.y) * 1597334677u;
    return float(n) * (1.0 / 4294967296.0);
}

float vnoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash12(i);
    float b = hash12(i + vec2(1.0, 0.0));
    float c = hash12(i + vec2(0.0, 1.0));
    float d = hash12(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
        v += a * vnoise(p);
        p = p * 2.03 + vec2(17.1, 9.2);
        a *= 0.5;
    }
    return v / 0.9375;
}

vec3 hueToRGB(float h) {
    float r = abs(h * 6.0 - 3.0) - 1.0;
    float g = 2.0 - abs(h * 6.0 - 2.0);
    float b = 2.0 - abs(h * 6.0 - 4.0);
    return clamp(vec3(r, g, b), 0.0, 1.0);
}

vec3 colorTempToRGB(float kelvin) {
    if (kelvin < 1000.0) return vec3(1.0);
    float temp = kelvin / 100.0;
    float red, green, blue;
    if (temp <= 66.0) {
        red = 255.0;
        green = 99.4708025861 * log(max(temp, 1.0)) - 161.1195681661;
        if (temp <= 19.0) blue = 0.0;
        else blue = 138.5177312231 * log(max(temp - 10.0, 1.0)) - 305.0447927307;
    } else {
        red = 329.698727446 * pow(max(temp - 60.0, 1.0), -0.1332047592);
        green = 288.1221695283 * pow(max(temp - 60.0, 1.0), -0.0755148492);
        blue = 255.0;
    }
    return srgbToLinear(clamp(vec3(red, green, blue) / 255.0, 0.0, 1.0));
}

float karisWeight(vec3 color) {
    return 1.0 / (1.0 + luma(color) * 0.5);
}

// =============================================================================
// OKLAB with chroma-reduction gamut mapping
// =============================================================================
vec3 linearRgbToOklab(vec3 c) {
    c = max(vec3(0.0), c);
    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
    float l_ = pow(max(0.0, l), 1.0 / 3.0);
    float m_ = pow(max(0.0, m), 1.0 / 3.0);
    float s_ = pow(max(0.0, s), 1.0 / 3.0);
    return vec3(
        0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
    );
}

vec3 oklabToLinearRgbRaw(vec3 lab) {
    float l_ = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z;
    float m_ = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;
    float s_ = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;
    float l = l_ * l_ * l_;
    float m = m_ * m_ * m_;
    float s = s_ * s_ * s_;
    return vec3(
        +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
    );
}

// Keeps lightness + hue, pulls chroma in until no channel is negative.
// This is what stops grades turning into random green / purple / cyan.
vec3 oklabToLinearRgb(vec3 lab) {
    lab.x = max(lab.x, 0.0);
    vec3 rgb = oklabToLinearRgbRaw(lab);
    if (min(rgb.r, min(rgb.g, rgb.b)) >= -0.00005) return max(rgb, vec3(0.0));
    float lo = 0.0;
    float hi = 1.0;
    for (int i = 0; i < 9; i++) {
        float mid = 0.5 * (lo + hi);
        vec3 t = oklabToLinearRgbRaw(vec3(lab.x, lab.y * mid, lab.z * mid));
        if (min(t.r, min(t.g, t.b)) >= -0.00005) lo = mid; else hi = mid;
    }
    return max(oklabToLinearRgbRaw(vec3(lab.x, lab.y * lo, lab.z * lo)), vec3(0.0));
}

vec2 oklabRotateHue(vec2 ab, float angleRadians) {
    float cosA = cos(angleRadians * 0.45);
    float sinA = sin(angleRadians * 0.45);
    return vec2(ab.x * cosA - ab.y * sinA, ab.x * sinA + ab.y * cosA);
}

// Colour wheel vector (x right, y up, |v| <= 1) -> zero-mean RGB push. Angle = hue (0 = red),
// radius = amount, so the centre is neutral. Zero-mean means the wheel never changes brightness.
vec3 wheelTint(vec2 w) {
    float m = min(length(w), 1.0);
    if (m < 1e-4) return vec3(0.0);
    float hue = fract(atan(w.y, w.x) / 6.28318530718);
    vec3 c = hueToRGB(hue);
    c -= vec3((c.r + c.g + c.b) * (1.0 / 3.0));
    return c * (1.5 * m);
}

// =============================================================================
// C1-CONTINUOUS MONOTONE CUBIC (PCHIP) 5-POINT CURVE - no slope breaks, no ridges
// =============================================================================
float evalCurve5(float x, float p0, float p1, float p2, float p3, float p4) {
    x = clamp(x, 0.0, 1.0);
    // Guard: points are forced to be non-decreasing so a curve can never fold back / invert,
    // even if an old preset or a drag left a point below its neighbour.
    p0 = clamp(p0, 0.0, 1.0);
    p1 = clamp(max(p1, p0), 0.0, 1.0);
    p2 = clamp(max(p2, p1), 0.0, 1.0);
    p3 = clamp(max(p3, p2), 0.0, 1.0);
    p4 = clamp(max(p4, p3), 0.0, 1.0);
    float p[5] = float[5](p0, p1, p2, p3, p4);
    float d[4];
    for (int i = 0; i < 4; i++) d[i] = (p[i + 1] - p[i]) * 4.0;
    float m[5];
    m[0] = d[0];
    m[4] = d[3];
    for (int i = 1; i < 4; i++) {
        float prod = d[i - 1] * d[i];
        m[i] = (prod <= 0.0) ? 0.0 : (2.0 * prod / (d[i - 1] + d[i]));
    }
    float seg = x * 4.0;
    int idx = min(int(floor(seg)), 3);
    float t = seg - float(idx);
    float t2 = t * t;
    float t3 = t2 * t;
    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;
    float y = h00 * p[idx] + h10 * 0.25 * m[idx] + h01 * p[idx + 1] + h11 * 0.25 * m[idx + 1];
    return clamp(y, 0.0, 1.0);
}

bool curveIsIdentity(float p0, float p1, float p2, float p3, float p4) {
    return abs(p0) < 0.0005 && abs(p1 - 0.25) < 0.0005 && abs(p2 - 0.5) < 0.0005 &&
           abs(p3 - 0.75) < 0.0005 && abs(p4 - 1.0) < 0.0005;
}

// =============================================================================
// PIXEL STORAGE
// =============================================================================
vec4 unpackRGBA_Dynamic(int pixelIndex, float bitMode) {
    if (bitMode > 1.5) {
        uint word0 = in_pixels[pixelIndex * 2];
        uint word1 = in_pixels[pixelIndex * 2 + 1];
        return vec4(float(word0 & 0xFFFFu), float((word0 >> 16u) & 0xFFFFu),
                    float(word1 & 0xFFFFu), float((word1 >> 16u) & 0xFFFFu)) / 65535.0;
    }
    uint val = in_pixels[pixelIndex];
    return vec4(float(val & 0xFFu), float((val >> 8u) & 0xFFu),
                float((val >> 16u) & 0xFFu), float((val >> 24u) & 0xFFu)) / 255.0;
}

vec3 srcSrgb(ivec2 c) {
    c = clamp(c, ivec2(0), ivec2(gW - 1, gH - 1));
    return unpackRGBA_Dynamic(c.y * gW + c.x, gBit).rgb;
}
vec3 srcLin(ivec2 c) { return srgbToLinear(srcSrgb(c)); }

// "Is this pixel part of the (bright) text?" - used by the text suite only
float gTextThr = 0.65;
float gTextLo = 0.14;    // soft range below the threshold (Personal > Range Low)
float gTextHi = 0.08;    // soft range above the threshold (Personal > Range High)
float gTextCutS = 0.0;   // gamma-space channel max at or below which the text mask is exactly 0 (set where gTextThr is set)
float textFillAt(ivec2 p) {
    vec3 sg = srcSrgb(p);
    // v = 0.5*luma + 0.5*max <= max(linear channel); smoothstep is exactly 0 once v <= thr - 0.14, and sRGB->linear is
    // monotonic, so a pixel whose brightest gamma channel is at or below the matching gamma value cannot be text.
    if (max(sg.r, max(sg.g, sg.b)) <= gTextCutS) return 0.0;
    vec3 c = srgbToLinear(sg);
    float v = 0.5 * luma(c) + 0.5 * max(c.r, max(c.g, c.b));
    return smoothstep(gTextThr - gTextLo, gTextThr + gTextHi, v);
}

// Same mask, but also returns the linear colour so callers do not fetch the pixel twice (rgb = colour, a = fill)
vec4 textSampleAt(ivec2 p) {
    vec3 c = srcLin(p);
    float v = 0.5 * luma(c) + 0.5 * max(c.r, max(c.g, c.b));
    return vec4(c, smoothstep(gTextThr - gTextLo, gTextThr + gTextHi, v));
}

// Distance (px) from this pixel to the edge of the letter along a direction. Geometric search then
// 4 bisection steps, so it is sub-pixel smooth (no stepped bands in the chrome).
float textEdgeDist(ivec2 coord, vec2 dir, float smax) {
    float prev = 0.0;
    for (int k = 1; k <= 14; k++) {
        float sp = smax * pow(float(k) / 14.0, 1.8);
        if (textFillAt(coord + ivec2(round(dir * sp))) < 0.5) {
            float lo = prev;
            float hi = sp;
            for (int b = 0; b < 4; b++) {
                float mid = 0.5 * (lo + hi);
                if (textFillAt(coord + ivec2(round(dir * mid))) < 0.5) hi = mid; else lo = mid;
            }
            return 0.5 * (lo + hi);
        }
        prev = sp;
    }
    return smax;
}

vec4 unpackComposite(int idx) {
    return vec4(unpackHalf2x16(temp_composite[idx * 2]), unpackHalf2x16(temp_composite[idx * 2 + 1]));
}
void packComposite(int idx, vec4 c) {
    c.rgb = sanitize(c.rgb);
    temp_composite[idx * 2] = packHalf2x16(c.rg);
    temp_composite[idx * 2 + 1] = packHalf2x16(c.ba);
}
vec3 compAt(ivec2 c, int w, int h) {
    c = clamp(c, ivec2(0), ivec2(w - 1, h - 1));
    return unpackComposite(c.y * w + c.x).rgb;
}

void packFinalDisplay(int pixelIndex, vec4 col, float bitMode) {
    if (bitMode > 1.5) {
        uint r = uint(clamp(col.r * 65535.0 + 0.5, 0.0, 65535.0));
        uint g = uint(clamp(col.g * 65535.0 + 0.5, 0.0, 65535.0));
        uint b = uint(clamp(col.b * 65535.0 + 0.5, 0.0, 65535.0));
        uint a = uint(clamp(col.a * 65535.0 + 0.5, 0.0, 65535.0));
        out_pixels[pixelIndex * 2] = (g << 16u) | r;
        out_pixels[pixelIndex * 2 + 1] = (a << 16u) | b;
    } else {
        uint r = uint(clamp(col.r * 255.0 + 0.5, 0.0, 255.0));
        uint g = uint(clamp(col.g * 255.0 + 0.5, 0.0, 255.0));
        uint b = uint(clamp(col.b * 255.0 + 0.5, 0.0, 255.0));
        uint a = uint(clamp(col.a * 255.0 + 0.5, 0.0, 255.0));
        out_pixels[pixelIndex] = (a << 24u) | (b << 16u) | (g << 8u) | r;
    }
}

// Bloom storage (fp16 RGBA)
vec4 bloomLoad(int level, int idx) {
    uvec2 u;
    if (level == 0)      u = uvec2(bloom_l0[idx * 2], bloom_l0[idx * 2 + 1]);
    else if (level == 1) u = uvec2(bloom_l1[idx * 2], bloom_l1[idx * 2 + 1]);
    else if (level == 2) u = uvec2(bloom_l2[idx * 2], bloom_l2[idx * 2 + 1]);
    else if (level == 3) u = uvec2(bloom_l3[idx * 2], bloom_l3[idx * 2 + 1]);
    else                 u = uvec2(bloom_l4[idx * 2], bloom_l4[idx * 2 + 1]);
    return vec4(unpackHalf2x16(u.x), unpackHalf2x16(u.y));
}
void bloomStore(int level, int idx, vec4 v) {
    v = clamp(v, vec4(0.0), vec4(60000.0));
    if (any(isnan(v))) v = vec4(0.0);
    uint a = packHalf2x16(v.rg);
    uint b = packHalf2x16(v.ba);
    if (level == 0)      { bloom_l0[idx * 2] = a; bloom_l0[idx * 2 + 1] = b; }
    else if (level == 1) { bloom_l1[idx * 2] = a; bloom_l1[idx * 2 + 1] = b; }
    else if (level == 2) { bloom_l2[idx * 2] = a; bloom_l2[idx * 2 + 1] = b; }
    else if (level == 3) { bloom_l3[idx * 2] = a; bloom_l3[idx * 2 + 1] = b; }
    else                 { bloom_l4[idx * 2] = a; bloom_l4[idx * 2 + 1] = b; }
}

vec4 sampleBloom(int level, vec2 uv, int w, int h) {
    vec2 pos = clamp(uv * vec2(w, h) - 0.5, vec2(0.0), vec2(w - 1, h - 1));
    ivec2 p0 = ivec2(floor(pos));
    ivec2 p1 = clamp(p0 + ivec2(1), ivec2(0), ivec2(w - 1, h - 1));
    vec2 f = fract(pos);
    vec4 c00 = bloomLoad(level, p0.y * w + p0.x);
    vec4 c10 = bloomLoad(level, p0.y * w + p1.x);
    vec4 c01 = bloomLoad(level, p1.y * w + p0.x);
    vec4 c11 = bloomLoad(level, p1.y * w + p1.x);
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

// Fractional pyramid level (1..4): blends two levels so a streak never pops between them.
vec3 sampleBloomLevelF(float lvlF, vec2 uv, int width, int height) {
    int lo = int(floor(lvlF));
    int hi = min(lo + 1, 4);
    float f = lvlF - float(lo);
    vec3 a = sampleBloom(lo, uv, max(width >> (lo + 1), 1), max(height >> (lo + 1), 1)).rgb;
    if (hi == lo || f < 0.001) return a;
    vec3 b = sampleBloom(hi, uv, max(width >> (hi + 1), 1), max(height >> (hi + 1), 1)).rgb;
    return mix(a, b, f);
}

// =============================================================================
// TONEMAPPERS
// =============================================================================
vec3 agxCore(vec3 c, float sat) {
    // GLSL mat3(vec3, vec3, vec3) is COLUMN-major. toRec2020 / outset / toSrgb below were already
    // listed as columns. The AgX *inset* was listed row-by-row (transposed), so neutral greys were
    // pushed off-axis - that was the pink, dark cast. It is now written as columns too.
    const mat3 toRec2020 = mat3(vec3(0.6274, 0.0691, 0.0164), vec3(0.3293, 0.9195, 0.0880), vec3(0.0433, 0.0113, 0.8956));
    const mat3 inset = mat3(
        vec3(0.856627153315983, 0.137318972929847, 0.11189821299995),
        vec3(0.0951212405381588, 0.761241990602591, 0.0767994186031903),
        vec3(0.0482516061458583, 0.101439036467562, 0.811302368396859));
    const mat3 outset = mat3(
        vec3(1.1271005818144368, -0.1413297634984383, -0.14132976349843826),
        vec3(-0.11060664309660323, 1.157823702216272, -0.11060664309660294),
        vec3(-0.016493938717834573, -0.016493938717834257, 1.2519364065950405));
    const mat3 toSrgb = mat3(vec3(1.6605, -0.1246, -0.0182), vec3(-0.5876, 1.1329, -0.1006), vec3(-0.0728, -0.0083, 1.1187));

    c = max(c, vec3(0.0));
    c = inset * (toRec2020 * c);
    c = log2(max(c, vec3(1e-10)));
    c = clamp((c - (-12.47393)) / (4.026069 + 12.47393), 0.0, 1.0);

    // Troy Sobotka's 6th-order contrast approximation (AgX base look)
    vec3 x2 = c * c;
    vec3 x4 = x2 * x2;
    c = 15.5 * x4 * x2 - 40.14 * x4 * c + 31.96 * x4 - 6.868 * x2 * c + 0.4298 * x2 + 0.1191 * c - 0.00232;
    c = clamp(c, 0.0, 1.0);

    // gentle chroma restore (AgX desaturates highlights by design)
    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
    c = mix(vec3(l), c, sat);

    c = outset * c;
    c = pow(max(c, vec3(0.0)), vec3(2.2));
    c = toSrgb * c;
    return max(c, vec3(0.0));
}

// Khronos PBR Neutral, retuned for video: no black-level subtraction (that was the "brightness
// drop"), a real shoulder that maps SDR white back to ~white, hue-preserving peak compression,
// highlight desaturation, and a very light display-space contrast curve.
vec3 tonemapNeutralPlus(vec3 color) {
    color = max(color, vec3(0.0));
    const float startCompression = 0.72;
    const float desaturation = 0.25;
    const float kShoulder = 2.0;
    // Shoulder is C1: slope exactly 1.0 at the knee (no kink, no expansion above it). The input that reaches 1.0
    // follows from the slope condition: whitePoint = start + d * k / (1 - exp(-k)).
    float d = 1.0 - startCompression;
    float whitePoint = startCompression + d * kShoulder / (1.0 - exp(-kShoulder));

    float peak = max(color.r, max(color.g, color.b));
    if (peak > startCompression) {
        float t = (peak - startCompression) / (whitePoint - startCompression);
        float newPeak = startCompression + d * (1.0 - exp(-kShoulder * t)) / (1.0 - exp(-kShoulder));
        newPeak = min(newPeak, 1.0);
        color *= newPeak / peak;
        float g = max(1.0 - 1.0 / (desaturation * max(peak - newPeak, 0.0) + 1.0), 0.0);
        color = mix(color, vec3(newPeak), g);
    }
    color = clamp(color, 0.0, 1.0);

    vec3 e = linearToSrgb(color);
    e = e + 0.12 * (e * e * (3.0 - 2.0 * e) - e);
    return srgbToLinear(e);
}

// "Linear" mode, de-slopped: values up to the knee pass through UNCHANGED (so the grade looks exactly
// like plain linear), then the PEAK channel is rolled off smoothly towards 1.0 and the other channels
// are scaled with it. Hue is preserved instead of every channel hard-clipping to flat white, and a
// touch of highlight desaturation stops over-driven colours going neon.
vec3 tonemapLinearSoft(vec3 c) {
    c = max(c, vec3(0.0));
    const float knee = 0.92;      // linear light (~sRGB 0.96): nothing below this is touched
    const float whiteIn = 1.60;   // input peak that reaches 1.0
    const float kS = 8.5;         // gives slope 1.0 at the knee (C1-continuous, no visible kink)
    float peak = max(c.r, max(c.g, c.b));
    if (peak <= knee) return c;
    float d = 1.0 - knee;
    float t = clamp((peak - knee) / (whiteIn - knee), 0.0, 1.0);
    float newPeak = knee + d * (1.0 - exp(-kS * t)) / (1.0 - exp(-kS));
    c *= newPeak / peak;
    // batch 4 (pipeline pop): was 0.20. The shoulder pulled every over-bright pixel hard toward white (pastel highlights);
    // 0.07 keeps hue and saturation in glow cores and bright light while still rolling off without clipping.
    float g = 1.0 - 1.0 / (0.07 * max(peak - newPeak, 0.0) + 1.0);
    return clamp(mix(c, vec3(newPeak), g), 0.0, 1.0);
}


// =============================================================================
// NEW ANIME TONEMAPPERS (modes 3..6)  - depth-preserving, hue-safe, skin-protected
// -----------------------------------------------------------------------------
// Shared design rules for all four:
//   * Everything the SDR frame already contains below the knee is left alone (no flattening, no grey-out).
//   * Compression only ever happens at the TOP (exponential shoulder, C1, asymptote 1.0, never a hard clip).
//   * Depth comes from a perceptual (Oklab lightness) curve, and chroma FOLLOWS lightness, so colours get
//     deeper instead of greyer / neon.
//   * Skin hues (Oklab mask) get an earlier, softer shoulder and a weaker highlight lift -> faces never blow out.
//   * Anything still > 1.0 is brought into gamut by moving toward its OWN luma (hue-preserving), never per-channel clip.
// =============================================================================
float tmMax3(vec3 c) { return max(c.r, max(c.g, c.b)); }

// C1-continuous exponential shoulder: identity below k, slope 1 at k, asymptotically approaches 1.0.
float tmShoulder(float x, float k) {
    if (x <= k) return x;
    float d = 1.0 - k;
    return k + d * (1.0 - exp(-(x - k) / d));
}

// Pull a colour that exceeds 1.0 toward its own luma until the brightest channel fits (keeps hue).
vec3 tmFitToGamut(vec3 c) {
    c = max(c, vec3(0.0));
    float pk = tmMax3(c);
    if (pk <= 1.0) return c;
    float l = min(luma(c), 0.9999);
    float t = (1.0 - l) / max(pk - l, 1e-5);
    return clamp(mix(vec3(l), c, t), 0.0, 1.0);
}

// ---- 1: AgX (display-referred) ---------------------------------------------
// agxCore() is the real AgX transform (inset -> log2 -> 6th-order sigmoid -> outset). Raw AgX tops out near 0.59 for
// SDR white, so the result is lifted so that input 1.0 lands at 0.965. Everything ABOVE white is then rolled off with
// the same hue-preserving shoulder the other tonemappers use, and gamut-fitted - the old version clipped every channel
// at 1.0, which flattened glows / pushed exposure and swung skin toward yellow.
vec3 tonemapAgx(vec3 c) {
    const float AGX_SAT = 1.20;
    const float WHITE_OUT = 0.965;
    vec3 raw = agxCore(c, AGX_SAT);
    float whiteEnc = linearToSrgb(luma(agxCore(vec3(1.0), AGX_SAT)));
    float gain = WHITE_OUT / whiteEnc;
    vec3 e = linearToSrgb(raw);
    float ye = luma(e);
    float lift = (ye >= whiteEnc) ? gain : 1.0 + (gain - 1.0) * smoothstep(0.42, whiteEnc, ye);
    e *= lift;
    float pk = tmMax3(e);
    if (pk > 0.93) e *= tmShoulder(pk, 0.93) / pk;
    return srgbToLinear(tmFitToGamut(e));
}

// Oklab skin mask (same hue / chroma / lightness window the anime skin smoother uses).
float tmSkinMask(vec3 lab) {
    float ch = length(lab.yz);
    float h = atan(lab.z, lab.y);
    return smoothstep(0.30, 0.55, h) * (1.0 - smoothstep(1.20, 1.50, h))
         * smoothstep(0.015, 0.040, ch) * (1.0 - smoothstep(0.13, 0.19, ch))
         * smoothstep(0.42, 0.62, lab.x);
}

// Perceptual depth curve on Oklab L (0 and 1 are fixed points, curve is smooth and monotone for amt <= ~0.5).
// Below the pivot it deepens, above it adds separation. The highlight lift is reduced on skin.
float tmDepthCurve(float L, float amt, float pivot, float skin) {
    float x = clamp(L, 0.0, 1.0);
    float p = x * (1.0 - x) * (x - pivot) * 2.4;
    if (p > 0.0) p *= (1.0 - 0.85 * skin);
    return L + amt * p;
}

// Rebuild a colour from Oklab with a new lightness. Chroma follows lightness (constant *saturation*, so darker
// stays rich and lighter does not grey out); chromaMul adds or removes richness on top. Gamut-mapped by chroma reduction.
vec3 tmRebuild(vec3 lab, float Lnew, float chromaMul) {
    float r = clamp(Lnew / max(lab.x, 1e-4), 0.0, 1.25);
    float cm = mix(1.0, r, 0.85) * chromaMul;
    return oklabToLinearRgb(vec3(Lnew, lab.yz * cm));
}

// The lightness-curve modes cannot carry colour above white (L > 1 has no chroma), so once a pixel is over-driven
// (glow cores, pushed exposure) they hand over smoothly to a hue-preserving shoulder + light desaturation. Over-driven
// orange stays a hot orange-gold instead of snapping to flat white.
vec3 tmHdrBlend(vec3 labPath, vec3 c) {
    float pk = tmMax3(c);
    float w = smoothstep(0.85, 1.25, pk);
    if (w <= 0.0) return labPath;
    float fp = tmShoulder(pk, 0.95);
    vec3 H = c * (fp / max(pk, 1e-5));
    float g = 1.0 - 1.0 / (0.35 * max(pk - fp, 0.0) + 1.0);
    H = tmFitToGamut(mix(H, vec3(luma(H)), g));
    return mix(labPath, H, w);
}

// ---- 3: AURORA DEPTH -------------------------------------------------------
// Pure lightness tonemapper: the S-curve lives in Oklab L, colour direction is never touched, so nothing shifts
// hue and nothing flattens. Deeper toe, midtone separation, smooth top shoulder, tiny richness lift in the mids.
vec3 tonemapAuroraDepth(vec3 c) {
    c = max(c, vec3(0.0));
    vec3 lab = linearRgbToOklab(c);
    float L = lab.x;
    float skin = tmSkinMask(lab);

    float Ld = tmDepthCurve(L, mix(0.20, 0.12, skin), 0.60, skin);
    float Lo = tmShoulder(Ld, mix(0.985, 0.90, skin));

    // richness only goes to colours that are not already vivid (no gamut-edge neon), never to skin
    float midBand = smoothstep(0.08, 0.35, L) * (1.0 - smoothstep(0.55, 0.95, L));
    float notVivid = 1.0 - smoothstep(0.10, 0.24, length(lab.yz));
    float rich = 1.0 + 0.10 * midBand * notVivid * (1.0 - 0.70 * skin);

    return tmHdrBlend(tmFitToGamut(tmRebuild(lab, Lo, rich)), c);
}

// ---- 4: SAKURA SILK --------------------------------------------------------
// Skin-first, hue-preserving RGB tonemapper. Scales the whole RGB triplet by the shoulder ratio (so hue and
// saturation of the frame are untouched), starts the shoulder much earlier on skin so faces roll off softly
// instead of clipping to flat pink/white, keeps warmth in the roll-off, then adds a soft depth curve.
vec3 tonemapSakuraSilk(vec3 c) {
    c = max(c, vec3(0.0));
    vec3 lab = linearRgbToOklab(c);
    float skin = tmSkinMask(lab);

    float n = mix(tmMax3(c), luma(c), 0.30);        // vivid colours are not over-compressed (no dulling)
    float k = mix(0.95, 0.76, skin);
    float fn = tmShoulder(n, k);
    vec3 o = c * (fn / max(n, 1e-5));

    // desaturate only the genuinely over-driven part, and much less on skin (skin must not go chalky)
    float over = max(n - fn, 0.0);
    float g = (1.0 - 1.0 / (0.35 * over + 1.0)) * (1.0 - 0.60 * skin);
    o = mix(o, vec3(luma(o)), g);
    o = tmFitToGamut(o);

    vec3 lab2 = linearRgbToOklab(o);
    float Ld = tmDepthCurve(lab2.x, mix(0.16, 0.08, skin), 0.62, skin);
    return tmFitToGamut(tmRebuild(lab2, Ld, 1.0 + 0.05 * skin));
}

// ---- 5: PRISM BLEND --------------------------------------------------------
// Colour-blending tonemapper. Two roll-offs are mixed: a hue-preserving one and a per-channel "dye" one.
// In the highlights the per-channel path lets saturated colours drift toward lighter tints of themselves
// (orange -> warm gold -> cream, cyan -> ice, magenta -> pearl) instead of clipping, which is what makes
// glows and light edges blend beautifully. An Oklab chroma-recovery stage then gives back any colour that the
// blend took away in the shadows/mids, so the picture neither under- nor over-saturates.
vec3 tonemapPrismBlend(vec3 c) {
    c = max(c, vec3(0.0));
    vec3 labIn = linearRgbToOklab(c);
    float skin = tmSkinMask(labIn);
    float pk = tmMax3(c);

    float fA = tmShoulder(pk, 0.93);
    vec3 A = c * (fA / max(pk, 1e-5));                                    // hue-preserving path
    vec3 B = vec3(tmShoulder(c.r, 0.90), tmShoulder(c.g, 0.90), tmShoulder(c.b, 0.90));   // dye path
    float w = 0.55 * smoothstep(0.55, 1.10, pk) * (1.0 - 0.50 * skin);
    vec3 o = mix(A, B, w);

    vec3 labO = linearRgbToOklab(o);
    float Cin = length(labIn.yz);
    float Co = length(labO.yz);
    float lr = clamp(labO.x / max(labIn.x, 1e-4), 0.0, 1.20);
    float target = Cin * lr;                                              // same saturation at the new lightness
    float keep = 0.70 * (1.0 - smoothstep(0.80, 1.30, pk));               // fades out in the highlights so they can blend
    float Cn = mix(Co, max(Co, target), keep);
    labO.yz *= Cn / max(Co, 1e-5);

    float Ld = tmDepthCurve(labO.x, 0.14, 0.60, skin);
    return tmFitToGamut(tmRebuild(labO, Ld, 1.0));
}

// ---- 6: OBSIDIAN CEL -------------------------------------------------------
// Cel-shaded depth: pushes the shadows deeper and richer (jewel-toned, never grey or crushed flat), leaves the
// midtones and highlights where the artist put them, and rolls off only at the very top.
vec3 tonemapObsidianCel(vec3 c) {
    c = max(c, vec3(0.0));
    vec3 lab = linearRgbToOklab(c);
    float L = lab.x;
    float skin = tmSkinMask(lab);

    float toe = 1.0 - smoothstep(0.0, 0.62, L);
    float Ld = L - mix(0.22, 0.10, skin) * toe * min(L, 1.0);
    float Lo = tmShoulder(Ld, mix(0.985, 0.90, skin));

    float shadowBand = smoothstep(0.02, 0.14, L) * (1.0 - smoothstep(0.15, 0.60, L));
    float notVivid = 1.0 - smoothstep(0.10, 0.24, length(lab.yz));
    float rich = 1.0 + 0.18 * shadowBand * (0.4 + 0.6 * notVivid) * (1.0 - 0.50 * skin);

    return tmHdrBlend(tmFitToGamut(tmRebuild(lab, Lo, rich)), c);
}

vec3 applyToneMapping(vec3 linearCol, float mode) {
    if (mode > 5.5) return tonemapObsidianCel(linearCol);
    if (mode > 4.5) return tonemapPrismBlend(linearCol);
    if (mode > 3.5) return tonemapSakuraSilk(linearCol);
    if (mode > 2.5) return tonemapAuroraDepth(linearCol);
    if (mode > 1.5) return tonemapNeutralPlus(linearCol);
    if (mode > 0.5) return tonemapAgx(linearCol);
    return tonemapLinearSoft(linearCol);
}

// =============================================================================
// LUT (display-referred: input/outputs are sRGB-encoded 0..1)
// =============================================================================
vec3 sample3DLutDisplay(vec3 srgb, float opacity) {
    if (opacity <= 0.001) return srgb;
    vec3 c = clamp(srgb, 0.0, 1.0);
    vec3 lutCoord = (c * 31.0 + 0.5) / 32.0;
    vec3 graded = textureLod(u_lutTexture, lutCoord, 0.0).rgb;   // compute shader: no implicit derivatives, so sample LOD 0 explicitly
    return mix(srgb, clamp(graded, 0.0, 1.0), clamp(opacity, 0.0, 1.0));
}

// =============================================================================
// BLEND MODES (gamma space by default = After Effects behaviour)
// =============================================================================
vec3 softLightW3C(vec3 a, vec3 b) {
    vec3 dA = mix(sqrt(a), ((16.0 * a - 12.0) * a + 4.0) * a, step(a, vec3(0.25)));
    vec3 low  = a - (1.0 - 2.0 * b) * a * (1.0 - a);
    vec3 high = a + (2.0 * b - 1.0) * (dA - a);
    return mix(low, high, step(vec3(0.5), b));
}

// ---- non-separable helpers (W3C compositing spec) ----
float bLum(vec3 c) { return dot(c, vec3(0.3, 0.59, 0.11)); }
vec3 bClipColor(vec3 c) {
    float l = bLum(c);
    float n = min(c.r, min(c.g, c.b));
    float x = max(c.r, max(c.g, c.b));
    if (n < 0.0) c = l + (c - l) * l / max(l - n, 1e-5);
    if (x > 1.0) c = l + (c - l) * (1.0 - l) / max(x - l, 1e-5);
    return c;
}
vec3 bSetLum(vec3 c, float l) { return bClipColor(c + (l - bLum(c))); }
float bSat(vec3 c) { return max(c.r, max(c.g, c.b)) - min(c.r, min(c.g, c.b)); }
vec3 bSetSat(vec3 c, float s) {
    float mn = min(c.r, min(c.g, c.b));
    float mx = max(c.r, max(c.g, c.b));
    if (mx <= mn) return vec3(0.0);
    return (c - mn) * s / (mx - mn);
}

// Modes: 0 Normal, 1 Screen, 2 Linear Add, 3 Overlay, 4 Soft Light, 5 Multiply, 6 Add, 7 Linear Dodge (= Linear Add),
//        8 Darken, 9 Lighten, 10 Color Dodge, 11 Color Burn, 12 Hard Light, 13 Difference, 14 Exclusion,
//        15 Hue, 16 Saturation, 17 Color, 18 Luminosity, 19 Linear Burn, 20 Subtract
// a = base, b = blend layer, both in the blend space (gamma or linear). Inputs above 1.0 (HDR) are clamped inside the
// formulas and the excess of the base is kept by the caller.
vec3 blendCore(vec3 a, vec3 b, int mode) {
    vec3 ca = clamp(a, 0.0, 1.0);
    vec3 cb = clamp(b, 0.0, 1.0);
    if (mode == 1) return ca + cb - ca * cb;                                   // Screen
    if (mode == 3) return mix(2.0 * ca * cb, 1.0 - 2.0 * (1.0 - ca) * (1.0 - cb), step(vec3(0.5), ca)); // Overlay
    if (mode == 4) return softLightW3C(ca, cb);                                // Soft Light
    if (mode == 5) return ca * cb;                                             // Multiply
    if (mode == 6) return a + b;                                               // Add
    if (mode == 8) return min(ca, cb);                                         // Darken
    if (mode == 9) return max(ca, cb);                                         // Lighten
    if (mode == 10) return mix(min(vec3(1.0), ca / max(1.0 - cb, vec3(1e-4))), vec3(0.0), step(ca, vec3(0.0)));   // Color Dodge
    if (mode == 11) return mix(1.0 - min(vec3(1.0), (1.0 - ca) / max(cb, vec3(1e-4))), vec3(1.0), step(vec3(1.0), ca)); // Color Burn
    if (mode == 12) return mix(2.0 * ca * cb, 1.0 - 2.0 * (1.0 - ca) * (1.0 - cb), step(vec3(0.5), cb)); // Hard Light
    if (mode == 13) return abs(ca - cb);                                       // Difference
    if (mode == 14) return ca + cb - 2.0 * ca * cb;                            // Exclusion
    if (mode == 15) return bSetLum(bSetSat(cb, bSat(ca)), bLum(ca));           // Hue
    if (mode == 16) return bSetLum(bSetSat(ca, bSat(cb)), bLum(ca));           // Saturation
    if (mode == 17) return bSetLum(cb, bLum(ca));                              // Color
    if (mode == 18) return bSetLum(ca, bLum(cb));                              // Luminosity
    if (mode == 19) return max(ca + cb - 1.0, 0.0);                            // Linear Burn
    if (mode == 20) return max(a - b, 0.0);                                    // Subtract
    return b;                                                                  // Normal
}

// true  = layer blend is RELATIVE to what the layer changed: blend(base, layer) - blend(base, base) is added to the base.
//         A layer that changes nothing changes nothing in every mode (Multiply stops squaring the image, Screen stops
//         blowing it out). Only the modes that blend the image with a copy of itself use this (see blendIsRelative).
// false = old behaviour (plain blend of the image with the layer result). Flip this one constant to revert.
const bool BLEND_RELATIVE = true;

bool blendIsRelative(int mode) {
    return mode == 1 || mode == 3 || mode == 4 || mode == 5 || mode == 10 || mode == 11 || mode == 12 || mode == 19;
}

// HDR-safe sRGB transfer for the blend space: exact sRGB curve up to 1.0, linear continuation above, so highlights
// above 1.0 survive the round trip instead of being clipped.
vec3 blendEnc(vec3 c) {
    c = max(c, vec3(0.0));
    vec3 lo = mix(c * 12.92, 1.055 * pow(max(c, vec3(1e-6)), vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
    return mix(lo, 1.0 + (c - 1.0) * 0.4, step(vec3(1.0), c));
}
vec3 blendDec(vec3 g) {
    g = max(g, vec3(0.0));
    vec3 lo = mix(g / 12.92, pow((g + 0.055) / 1.055, vec3(2.4)), step(vec3(0.04045), g));
    return mix(lo, 1.0 + (g - 1.0) / 0.4, step(vec3(1.0), g));
}

vec3 blendFull(vec3 a, vec3 b, int mode) {
    vec3 r = blendCore(a, b, mode);
    if (BLEND_RELATIVE && blendIsRelative(mode)) {
        r = a + (r - blendCore(a, a, mode));
    }
    return max(r, vec3(0.0));
}

vec3 applyBlendMode(vec3 baseCol, vec3 blendCol, int mode, float opacity, bool linearSpace) {
    opacity = clamp(opacity, 0.0, 1.0);
    if (mode == 2 || mode == 7) {          // Linear Add / Linear Dodge: always linear light
        return mix(baseCol, baseCol + blendCol, opacity);
    }
    if (mode == 0 && opacity >= 0.9999) return blendCol;
    if (linearSpace) {
        return mix(baseCol, blendFull(baseCol, blendCol, mode), opacity);
    }
    vec3 ga = blendEnc(baseCol);
    vec3 gb = blendEnc(blendCol);
    vec3 gr = mix(ga, blendFull(ga, gb, mode), opacity);
    return blendDec(gr);
}

// Per-effect opacity + optional custom blend. cb: 0 = effect's own default compositing, n>0 = LayerBlendMode index (n - 1).
// pre = the colour before the effect, post = after. Uses the same blend maths as the layer blend modes.
vec3 fxMix(vec3 pre, vec3 post, float op, float cb) {
    op = clamp(op, 0.0, 1.0);
    if (cb < 0.5) return mix(pre, post, op);
    return applyBlendMode(pre, max(post, vec3(0.0)), int(cb - 0.5), op, false);
}
vec3 fxUnpackCol(float f) {
    uint v = uint(f + 0.5);
    return srgbToLinear(vec3(float((v >> 16u) & 255u), float((v >> 8u) & 255u), float(v & 255u)) / 255.0);
}

vec3 tintFor(float id) {
    if (id == 1.0) return vec3(1.20, 1.05, 0.65);
    if (id == 2.0) return vec3(0.40, 1.10, 1.45);
    if (id == 3.0) return vec3(1.25, 0.85, 0.40);
    if (id == 4.0) return vec3(1.30, 0.25, 0.30);
    if (id == 5.0) return vec3(1.00, 0.55, 1.45);
    if (id == 6.0) return vec3(1.35, 0.65, 0.95);
    return vec3(1.0);
}

vec3 saturateColor(vec3 c, float s) {
    float l = luma(c);
    return max(mix(vec3(l), c, s), vec3(0.0));
}

// Lowest highlight threshold any enabled glow needs (shared bloom extraction)
float glowExtractThreshold() {
    float t = 1.0;
    bool any_ = false;
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int i = 0; i < total; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;
        if (L.deepGlowIntensity > 0.01 || L.kawaseGlowIntensity > 0.01) { t = min(t, L.deepGlowThreshold); any_ = true; }
        if (L.diffuseSpGlowIntensity > 0.01) { t = min(t, L.diffuseSpGlowThreshold); any_ = true; }
        if (L.shaderlyGlowIntensity > 0.01)  { t = min(t, L.shaderlyGlowThreshold);  any_ = true; }
        if (L.lightWrapIntensity > 0.01 && L.lightWrapWidth > 0.01) { t = min(t, L.lightWrapThreshold); any_ = true; }
        if (L.thinStreakIntensity > 0.01)    { t = min(t, 0.20); any_ = true; }
        if (L.halationRadius > 0.01 && L.halationStrength > 0.01) { t = min(t, clamp(L.halationThreshold, 0.25, 0.95)); any_ = true; }
        if (L.copiedProMist > 0.01 || L.bslaBloomHaze > 0.01 || L.bslFogScatter > 0.01) { t = min(t, 0.40); any_ = true; }
    }
    return any_ ? clamp(t, 0.05, 0.95) : 0.60;
}

float edgeSensitivity() {
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int i = 0; i < total; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;
        if (L.sapphireGlowWidth > 0.01 || L.copiedEdgeRays > 0.01 || L.edgeHaloRadius > 0.01)
            return clamp(L.sapphireGlowThreshold, 0.1, 0.99);
    }
    return 0.70;
}

vec3 gateGlow(vec3 g, float th, float exMin) {
    float rel = th - exMin;
    if (rel <= 0.03) return g;
    float l = luma(g);
    return g * smoothstep(rel * 0.15, rel * 0.15 + 0.12, l);
}

// =============================================================================
// v2.7 CLEAN GLOW FIELD (Deep, Kawase, Shaderly, Diffuse core, Light Wrap, Halation)
//
// Pyramid levels hold the SAME extracted highlights blurred ever wider, and every downsample is an average, so each
// level carries the same energy. Adding them with equal weight gives a 1/d^2 tail (inverse-square); a smooth cut-off at
// reach R fades the levels wider than R out. Level 0 and 1 are never used here: the pyramid keeps 45% of the raw mask
// in them (see v2.7 notes) and that is what showed up as a ghost copy.
//   R: reach in pyramid levels (2 = level 2 only, 6 = a virtual level 6 that is roughly 12% of the frame height wide)
//   th / exMin: the effect's own threshold and the shared extraction threshold
// =============================================================================
#define GLOW_SMOOTH 1   // 1 = cubic B-spline reads of the low-res levels (4x the loads, no blocky lumps); 0 = plain bilinear

vec4 sampleBloomSmooth(int level, vec2 uv, int w, int h) {
#if GLOW_SMOOTH
    vec2 sz = vec2(float(w), float(h));
    vec2 pos = uv * sz - 0.5;
    vec2 ip = floor(pos);
    vec2 f = pos - ip;
    vec2 f2 = f * f;
    vec2 f3 = f2 * f;
    vec2 bw0 = (1.0 - 3.0 * f + 3.0 * f2 - f3) / 6.0;
    vec2 bw1 = (4.0 - 6.0 * f2 + 3.0 * f3) / 6.0;
    vec2 bw2 = (1.0 + 3.0 * f + 3.0 * f2 - 3.0 * f3) / 6.0;
    vec2 bw3 = f3 / 6.0;
    vec2 s0 = bw0 + bw1;
    vec2 s1 = bw2 + bw3;
    vec2 o0 = ip - 1.0 + bw1 / s0 + 0.5;
    vec2 o1 = ip + 1.0 + bw3 / s1 + 0.5;
    vec4 a = sampleBloom(level, vec2(o0.x, o0.y) / sz, w, h);
    vec4 b = sampleBloom(level, vec2(o1.x, o0.y) / sz, w, h);
    vec4 c = sampleBloom(level, vec2(o0.x, o1.y) / sz, w, h);
    vec4 d = sampleBloom(level, vec2(o1.x, o1.y) / sz, w, h);
    vec4 top = a * s0.x + b * s1.x;
    vec4 bot = c * s0.x + d * s1.x;
    return top * s0.y + bot * s1.y;
#else
    return sampleBloom(level, uv, w, h);
#endif
}

float gfBinom(int k, int n) {
    int a = abs(k);
    if (n == 1) return (a == 0) ? 2.0 : 1.0;
    return (a == 0) ? 6.0 : ((a == 1) ? 4.0 : 1.0);
}

// Virtual wider levels: binomial gather from the tiny 1/32 level (cache-hot). Spacing in level-4 texels.
vec3 gfWideTaps(vec2 uv, int w4, int h4, float spacing, int n) {
    vec2 st = vec2(spacing) / vec2(float(w4), float(h4));
    vec3 acc = vec3(0.0);
    float ws = 0.0;
    for (int j = -n; j <= n; j++) {
        for (int i = -n; i <= n; i++) {
            float wgt = gfBinom(i, n) * gfBinom(j, n);
            acc += sampleBloom(4, uv + vec2(float(i), float(j)) * st, w4, h4).rgb * wgt;
            ws += wgt;
        }
    }
    return acc / ws;
}

// Threshold on the SOURCE brightness. dil = share of a typical highlight (about 3.5% of the frame height) that is
// still left after that level's blur, so the same threshold means the same source at every level.
vec3 gfGate(vec3 s, float th, float exMin, float dil) {
    if (th - exMin <= 0.03) return s;                    // this effect set the extraction threshold itself
    float t = (th / (1.0 + 0.5 * th)) * dil;             // the extraction stores Karis-weighted values
    return s * smoothstep(t * 0.70, t * 1.15, luma(s));
}

vec3 glowField(vec2 uv, int width, int height, float R, float th, float exMin) {
    int w2 = max(width >> 3, 1);  int h2 = max(height >> 3, 1);
    int w3 = max(width >> 4, 1);  int h3 = max(height >> 4, 1);
    int w4 = max(width >> 5, 1);  int h4 = max(height >> 5, 1);
    float c2 = 1.0 / (1.0 + exp2(4.0 * (2.0 - R)));
    float k3 = (1.0 / (1.0 + exp2(4.0 * (3.0 - R)))) / c2;
    float k4 = (1.0 / (1.0 + exp2(4.0 * (4.0 - R)))) / c2;
    float k5 = (1.0 / (1.0 + exp2(4.0 * (5.0 - R)))) / c2;
    float k6 = (1.0 / (1.0 + exp2(4.0 * (6.0 - R)))) / c2;
    vec3 f = gfGate(sampleBloomSmooth(2, uv, w2, h2).rgb, th, exMin, 0.89);
    if (k3 > 0.004) f += gfGate(sampleBloomSmooth(3, uv, w3, h3).rgb, th, exMin, 0.68) * k3;
    if (k4 > 0.004) f += gfGate(sampleBloomSmooth(4, uv, w4, h4).rgb, th, exMin, 0.37) * k4;
    if (k5 > 0.010) f += gfGate(gfWideTaps(uv, w4, h4, 1.6, 1), th, exMin, 0.18) * k5;
    if (k6 > 0.010) f += gfGate(gfWideTaps(uv, w4, h4, 2.0, 2), th, exMin, 0.077) * k6;
    return f;
}

// =============================================================================
// PASS 1: HIGHLIGHT + EDGE EXTRACTION -> Bloom L0
// =============================================================================
void executeHighlightExtraction(ivec2 coord, int l0W, int l0H, int srcW, int srcH) {
    vec2 centerUV = (vec2(coord) + 0.5) / vec2(l0W, l0H);
    ivec2 srcC = clamp(ivec2(centerUV * vec2(srcW, srcH)), ivec2(0), ivec2(srcW - 1, srcH - 1));

    vec3 col = unpackComposite(srcC.y * srcW + srcC.x).rgb;
    float l = luma(col);

    float threshold = glowExtractThreshold();
    float knee = smoothstep(threshold, threshold + 0.20, l);
    vec3 isolated = col * knee;
    isolated *= karisWeight(isolated);

    // Edge mask (perceptual-luma Sobel, 2px step because L0 is half-res)
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec3 pc = compAt(srcC + ivec2(x, y) * 2, srcW, srcH);
            float lp = sqrt(max(luma(pc), 0.0));
            gx += lp * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lp * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float grad = sqrt(gx * gx + gy * gy);
    float sens = edgeSensitivity();
    float edge = smoothstep(sens * 0.12, sens * 0.12 + 0.16, grad);

    bloomStore(0, coord.y * l0W + coord.x, vec4(isolated, edge));
}

// PASS 2, 3, 7, 8: 13-tap anti-grid downsample (2: L0->L1, 3: L1->L2, 7: L2->L3, 8: L3->L4)
void executeBloomDownsample(int passIdx, ivec2 coord, int width, int height, float radius) {
    int srcLevel = (passIdx == 2) ? 0 : ((passIdx == 3) ? 1 : ((passIdx == 7) ? 2 : 3));
    // The parent level is built with integer shifts (w >> n), so it is NOT always 2x the child
    // (e.g. 819 -> 409). Using width*2 read the parent with the wrong row stride at odd sizes and
    // sheared the whole bloom pyramid into ghost copies. The host now passes the exact parent size.
    int srcW = (u_srcW > 0) ? u_srcW : width * 2;
    int srcH = (u_srcH > 0) ? u_srcH : height * 2;
    vec2 uv = (vec2(coord) + 0.5) / vec2(width, height);
    vec2 texel = (1.0 / vec2(srcW, srcH)) * max(radius, 0.6);
    float x = texel.x;
    float y = texel.y;

    vec4 a = sampleBloom(srcLevel, uv + vec2(-2.0 * x,  2.0 * y), srcW, srcH);
    vec4 b = sampleBloom(srcLevel, uv + vec2( 0.0,      2.0 * y), srcW, srcH);
    vec4 c = sampleBloom(srcLevel, uv + vec2( 2.0 * x,  2.0 * y), srcW, srcH);
    vec4 d = sampleBloom(srcLevel, uv + vec2(-2.0 * x,  0.0), srcW, srcH);
    vec4 e = sampleBloom(srcLevel, uv, srcW, srcH);
    vec4 f = sampleBloom(srcLevel, uv + vec2( 2.0 * x,  0.0), srcW, srcH);
    vec4 g = sampleBloom(srcLevel, uv + vec2(-2.0 * x, -2.0 * y), srcW, srcH);
    vec4 h = sampleBloom(srcLevel, uv + vec2( 0.0,     -2.0 * y), srcW, srcH);
    vec4 i = sampleBloom(srcLevel, uv + vec2( 2.0 * x, -2.0 * y), srcW, srcH);
    vec4 j = sampleBloom(srcLevel, uv + vec2(-x,  y), srcW, srcH);
    vec4 k = sampleBloom(srcLevel, uv + vec2( x,  y), srcW, srcH);
    vec4 l = sampleBloom(srcLevel, uv + vec2(-x, -y), srcW, srcH);
    vec4 m = sampleBloom(srcLevel, uv + vec2( x, -y), srcW, srcH);

    vec4 downsample = (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (e + j + k + l + m) * 0.125;
    bloomStore(srcLevel + 1, coord.y * width + coord.x, downsample);
}

// PASS 4, 5, 9: tent upsample (4: L2->L1, 5: L1->L0, 9: L4->L3)
void executeBloomUpsample(int passIdx, ivec2 coord, int w, int h, float radius) {
    int srcLevel = (passIdx == 4) ? 2 : ((passIdx == 5) ? 1 : 4);
    int srcW = w / 2;
    int srcH = h / 2;
    vec2 uv = (vec2(coord) + 0.5) / vec2(w, h);
    vec2 texel = (1.0 / vec2(srcW, srcH)) * max(radius, 0.6);

    vec4 sum = vec4(0.0);
    sum += sampleBloom(srcLevel, uv + vec2(-texel.x, 0.0), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2( texel.x, 0.0), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2(0.0, -texel.y), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2(0.0,  texel.y), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2(-texel.x, -texel.y), srcW, srcH);
    sum += sampleBloom(srcLevel, uv + vec2( texel.x, -texel.y), srcW, srcH);
    sum += sampleBloom(srcLevel, uv + vec2(-texel.x,  texel.y), srcW, srcH);
    sum += sampleBloom(srcLevel, uv + vec2( texel.x,  texel.y), srcW, srcH);
    sum /= 12.0;

    int dstLevel = srcLevel - 1;
    int dstIdx = coord.y * w + coord.x;
    vec4 existing = bloomLoad(dstLevel, dstIdx);
    bloomStore(dstLevel, dstIdx, mix(existing, sum, 0.55));
}

// =============================================================================
// SCENE-COLOUR HELPERS (glows / flares inherit the background instead of going white)
// =============================================================================
vec3 sampleAmbientColor(ivec2 coord, int width, int height, float radiusPx) {
    vec3 acc = vec3(0.0);
    float wsum = 0.0;
    const int AMB_TAPS = 16;
    // Fixed pattern (no per-pixel random rotation = no grain) and each tap is a 4-point box blur,
    // so neighbouring pixels see nearly the same colour and the result is smooth.
    int foot = int(max(round(radiusPx * 0.11), 1.0));
    for (int k = 0; k < AMB_TAPS; k++) {
        float fr = (float(k) + 0.5) / float(AMB_TAPS);
        float rr = sqrt(fr) * radiusPx;
        float ang = float(k) * 2.39996323;
        ivec2 c0 = coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr));
        vec3 s = 0.25 * (compAt(c0 + ivec2(foot, foot), width, height) + compAt(c0 + ivec2(-foot, foot), width, height)
                       + compAt(c0 + ivec2(foot, -foot), width, height) + compAt(c0 + ivec2(-foot, -foot), width, height));
        float w = smoothstep(0.015, 0.12, luma(s)) + 0.03;   // ignore ink / near-black
        acc += s * w;
        wsum += w;
    }
    return acc / max(wsum, 1e-4);
}

// Glows built from highlight extraction tend to be near-white. Where a glow has little chroma,
// re-tint it with the surrounding scene colour (luminance of the glow is preserved).
vec3 colorizeGlow(vec3 g, vec3 ambient, float amount) {
    float lg = luma(g);
    if (lg < 1e-5) return g;
    float mx = max(g.r, max(g.g, g.b));
    float mn = min(g.r, min(g.g, g.b));
    float chroma = (mx - mn) / max(mx, 1e-5);
    float whiteness = 1.0 - clamp(chroma * 2.5, 0.0, 1.0);
    float la = luma(ambient);
    vec3 hue = (la > 1e-4) ? clamp(ambient / la, vec3(0.05), vec3(4.0)) : vec3(1.0);
    hue = saturateColor(hue, 1.5);
    hue /= max(luma(hue), 1e-4);
    return mix(g, hue * lg, clamp(whiteness * amount, 0.0, 1.0));
}

// Flare beam profile along the streak. at = 0 at the source, 1 at the end of the reach.
// pw/pk come from the softness slider: low = peaked spike, high = flat plateau with a soft shoulder.
float flareProfile(float at, float pk, float pw) {
    return exp(-pk * pow(clamp(at, 0.0, 1.0), pw)) * (1.0 - smoothstep(0.80, 1.0, at));
}

float gaussBand(float x, float w) {
    float t = x / w;
    return exp(-t * t);
}

// Multi-band chrome reflection. v: 0 = top of the text, 1 = bottom. Horizon sits just under the
// middle: bright sky -> dark band -> thin bright horizon line -> dark ground -> lit lower band.
vec3 chromeBands(float v, vec3 skyRef, vec3 gndRef) {
    const float HZ = 0.52;
    vec3 top = mix(skyRef * 1.25, skyRef * 0.28, smoothstep(0.0, HZ - 0.04, v));
    top *= 1.0 - 0.60 * gaussBand(v - (HZ - 0.07), 0.05);
    vec3 warm = vec3(1.0, 0.72, 0.45);
    vec3 bot = mix(gndRef * 0.22, gndRef * 1.15 + warm * 0.10, smoothstep(HZ, 0.92, v));
    bot += (gndRef * 0.6 + warm * 0.08) * gaussBand(v - 0.83, 0.06);
    vec3 col = mix(top, bot, smoothstep(HZ - 0.012, HZ + 0.012, v));
    col += mix(vec3(1.0), skyRef, 0.35) * gaussBand(v - HZ, 0.012) * 1.4;
    return col;
}

// Light satin-metal tone for the text faces. v: 0 = top of the letter, 1 = bottom.
// Small brightness multiplier (~0.88 .. 1.12) with one crisp horizon line - it must never flatten the artwork.
float silkProfile(float v) {
    float p = mix(1.10, 0.93, smoothstep(0.0, 0.5, v));
    p += 0.10 * gaussBand(v - 0.52, 0.03);
    p -= 0.10 * smoothstep(0.60, 0.78, v);
    p += 0.08 * gaussBand(v - 0.92, 0.05);
    return p;
}

// =============================================================================
// FINAL COMPOSITE HELPERS
// =============================================================================
vec3 applyFxaa(ivec2 coord, int width, int height) {
    vec3 rgbM = compAt(coord, width, height);
    float lumaM = luma(rgbM);
    vec3 cU = compAt(coord + ivec2(0, -1), width, height);
    vec3 cD = compAt(coord + ivec2(0,  1), width, height);
    vec3 cL = compAt(coord + ivec2(-1, 0), width, height);
    vec3 cR = compAt(coord + ivec2( 1, 0), width, height);
    float lU = luma(cU); float lD = luma(cD); float lL = luma(cL); float lR = luma(cR);
    float lumaMin = min(lumaM, min(min(lU, lD), min(lL, lR)));
    float lumaMax = max(lumaM, max(max(lU, lD), max(lL, lR)));
    if ((lumaMax - lumaMin) < max(0.04, lumaMax * 0.12)) return rgbM;
    return mix(rgbM, (cU + cD + cL + cR) * 0.25, 0.30);
}

// =============================================================================
// DOMINANT LIGHT SOURCE (used by Diffuse SP)
// One 16x16 workgroup scans the 1/8-res highlight pyramid level on a 16x16 lattice (4 sub-taps per
// cell so small suns are not missed) and reduces it in shared memory to a luminance^3-weighted
// centroid. That is the "where would the sun / brightest source be" point. Cost: ~1 load/pixel.
// =============================================================================
shared vec4 s_lightA[256];   // rgb * w, w
shared vec2 s_lightB[256];   // uv  * w
vec2  gLightUV = vec2(0.5, 0.10);
vec3  gLightCol = vec3(1.0);
float gLightStrength = 0.0;

bool diffuseLayerActive() {
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int i = 0; i < total; i++) {
        if (layers[i].isEnabled > 0.5 && layers[i].diffuseSpGlowIntensity > 0.01) return true;
    }
    return false;
}

// MUST be called from uniform control flow (before any early return) because it uses barrier().
void detectDominantLight(int width, int height) {
    uint lid = gl_LocalInvocationIndex;
    ivec2 cell = ivec2(int(lid & 15u), int(lid >> 4u));
    int w8 = max(width / 8, 1);
    int h8 = max(height / 8, 1);
    vec4 acc = vec4(0.0);
    vec2 accUV = vec2(0.0);
    for (int k = 0; k < 4; k++) {
        vec2 sub = vec2(float(k & 1), float(k >> 1)) * 0.5 + 0.25;
        vec2 cuv = (vec2(cell) + sub) / 16.0;
        vec3 c = sampleBloom(2, cuv, w8, h8).rgb;
        float l = luma(c);
        float w = l * l * l;
        acc += vec4(c * w, w);
        accUV += cuv * w;
    }
    s_lightA[lid] = acc;
    s_lightB[lid] = accUV;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (lid < st) {
            s_lightA[lid] += s_lightA[lid + st];
            s_lightB[lid] += s_lightB[lid + st];
        }
        barrier();
    }
    float wt = s_lightA[0].w;
    if (wt > 1e-7) {
        gLightUV = s_lightB[0] / wt;
        vec3 lc = s_lightA[0].rgb / wt;
        float ll = max(luma(lc), 1e-4);
        gLightCol = clamp(lc / ll, vec3(0.3), vec3(3.0));          // hue only (luma = 1)
        gLightStrength = smoothstep(0.02, 0.35, ll);
    }
}

// =============================================================================
// PASS 6: GLOWS, LIGHT WRAP, ATMOSPHERE, TONEMAP, LUT, TPDF DITHER
// =============================================================================
// -----------------------------------------------------------------------------
// Anamorphic flare beam (v4 maths, moved verbatim out of executeFinalComposite so it can also run at half resolution).
// Returns the beam after the filmic shoulder, BEFORE intensity / opacity / layer opacity are applied.
// -----------------------------------------------------------------------------
vec3 flareBeam(int li, vec2 uv, int width, int height, vec3 ambientCol, vec3 ambientNear, vec3 glowTint) {
    LayerData L = layers[li];
            const int NT = 56;
            float origin = clamp(L.thinStreakEdgeMode, 0.0, 1.0);
            float soft = clamp(L.thinStreakSoftness, 0.0, 1.0);
            float reach = clamp(L.thinStreakWidth, 0.05, 2.0) * 0.5;         // frame widths per side / inward from the edge
            // v2.7: the old mapping topped out at 0.20 while a real highlight measures 0.5..3 here, so at ANY slider value
            // every highlight flared. 0 -> 0.01, 0.25 -> ~0.07 (about the old default look), 0.5 -> 0.37, 1 -> 2.2.
            float tFrac = clamp(L.flareThreshold, 0.0, 1.0);
            float thrV = mix(0.01, 2.2, pow(tFrac, 2.6));
            float spaceN = clamp(L.flareSpacing, 0.0, 0.5);
            float thick = clamp(L.flareThickness, 0.0, 1.0);
            float fall = clamp(L.flareFalloff, 0.0, 1.0);
            float pk = mix(2.2, 6.5, fall);
            const float pw = 1.25;
            bool needEdge = origin > 0.02;
            bool needLocal = origin < 0.98;

            float sxA = needEdge ? 0.0 : max(uv.x - reach, 0.0);
            float sxB = needEdge ? 1.0 : min(uv.x + reach, 1.0);
            float spacingPx = max((sxB - sxA) * float(width) / float(NT), 1.0);
            float bodyPx = max(float(height) * mix(0.004, 0.032, thick), 2.0);
            float lvlSp = clamp(log2(max(spacingPx, 2.0) / 2.0) + 0.6, 0.0, 4.0);   // blur >= 1.5x tap spacing: no beads
            float lvlBody = clamp(log2(bodyPx / 2.0), 0.0, 4.0);
            float lvl = max(lvlSp, lvlBody);
            float texPx = 2.0 * exp2(lvl);
            float normK = min(spacingPx / texPx, 1.0);
            // Source strength is normalised for the blur level (a small bright point keeps the same strength at any
            // thickness), thrV is the minimum strength a source needs to flare.
            float boost = pow(texPx * 0.125, 1.85);
            float bodyUv = bodyPx / float(height);
            float edgeW = mix(0.04, 0.38, soft);                             // hard: crisp edge, soft: wide blurred edge
            // Soft mode: each tap also looks softO above and below its row, so the beam really spreads out vertically.
            const float softMaxSpread = 0.08;                                // fraction of frame height at softness 1
            float softO = soft * softMaxSpread;
            bool useSoft = soft > 0.02;
            float softMixK = smoothstep(0.05, 0.75, soft);                   // crisp -> feathered shape blend
            float prStep = bodyUv * 0.75 + softO * 0.6;                      // local-peak search step (wider when soft)
            int l2W = max(width >> 3, 1);
            int l2H = max(height >> 3, 1);
            int l4W = max(width >> 5, 1);
            int l4H = max(height >> 5, 1);

            vec3 lSum = vec3(0.0);
            vec3 lMax = vec3(0.0);
            vec3 eSum = vec3(0.0);
            vec3 eMax = vec3(0.0);
            for (int k = 0; k < NT; k++) {
                float sx = mix(sxA, sxB, (float(k) + 0.5) / float(NT));
                float at = abs(sx - uv.x) / reach;
                float wLocal = needLocal ? flareProfile(at, pk, pw) : 0.0;
                if (!needEdge && wLocal < 0.003) continue;

                vec2 tapUv = vec2(sx, uv.y);
                vec3 sm = sampleBloomLevelF(lvl, tapUv, width, height);
                float sl = luma(sm);
                float sN = sl * boost;
                vec3 smH = sm;          // colour used for the hue direction
                float sNw = sN;         // vertically smeared strength (soft mode only)
                if (useSoft) {
                    vec3 smU = sampleBloomLevelF(lvl, vec2(sx, uv.y + softO), width, height);
                    vec3 smD = sampleBloomLevelF(lvl, vec2(sx, uv.y - softO), width, height);
                    vec3 smW = sm * 0.5 + (smU + smD) * 0.25;
                    sNw = luma(smW) * boost;
                    smH = mix(sm, smW, soft);
                }
                if (max(sN, sNw) < thrV * 0.35) continue;

                // compact sources only: a big bright area (hair, sky, a lit wall) is NOT a flare source
                float f2 = luma(sampleBloom(2, tapUv, l2W, l2H).rgb);
                float f4 = luma(sampleBloom(4, tapUv, l4W, l4H).rgb);
                float compact = smoothstep(0.45, 0.80, 1.0 - f4 / max(f2, 1e-5));
                if (useSoft) {
                    // rows in the soft skirt are not on the source itself: accept the compactness of the rows around them
                    for (int q = 0; q < 2; q++) {
                        float oq = (q == 0) ? softO : -softO;
                        vec2 tq = vec2(sx, uv.y + oq);
                        float g2 = luma(sampleBloom(2, tq, l2W, l2H).rgb);
                        float g4 = luma(sampleBloom(4, tq, l4W, l4H).rgb);
                        compact = max(compact, smoothstep(0.45, 0.80, 1.0 - g4 / max(g2, 1e-5)));
                    }
                }
                if (compact < 0.01) continue;

                // local peak of this source's vertical profile -> band edge is placed relative to it
                float pr = sN;
                for (int j = 1; j <= 2; j++) {
                    float o = prStep * float(j);
                    pr = max(pr, luma(sampleBloomLevelF(lvl, vec2(sx, uv.y + o), width, height)) * boost);
                    pr = max(pr, luma(sampleBloomLevelF(lvl, vec2(sx, uv.y - o), width, height)) * boost);
                }
                if (pr < thrV) continue;
                float v = sN / pr;
                float s = smoothstep(0.45 - edgeW, 0.45 + edgeW, v) * smoothstep(thrV, thrV * 1.8, pr) * compact;
                if (useSoft) {
                    // Feathered shape: strength follows the smeared profile relative to the local peak, so it fades out
                    // gradually over the whole spread instead of being cut at a threshold edge.
                    float sSoft = smoothstep(0.02, 0.65, sNw / max(pr, 1e-5)) * smoothstep(thrV, thrV * 1.8, pr) * compact;
                    s = mix(s, sSoft, softMixK);
                }
                if (s < 0.004) continue;

                if (spaceN > 0.02) {
                    // strongest source within +-Spacing of this row? (soft non-maximum suppression)
                    float nb = 0.0;
                    for (int j = 1; j <= 3; j++) {
                        float o = spaceN * float(j) * 0.3333;
                        nb = max(nb, luma(sampleBloomLevelF(lvl, vec2(sx, uv.y + o), width, height)) * boost);
                        nb = max(nb, luma(sampleBloomLevelF(lvl, vec2(sx, uv.y - o), width, height)) * boost);
                    }
                    s *= smoothstep(0.55, 0.85, pr / max(pr, nb));
                    if (s < 0.004) continue;
                }

                if (tFrac > 0.04) {
                    // Threshold also RANKS the sources: at high settings a source must reach a share of the strongest one
                    // within about +-22% of the frame height at this x, so only the dominant flares survive and the count
                    // keeps dropping (also in "from edges" mode, where one row used to flare for every highlight on it).
                    float rk = pr;
                    for (int j = 1; j <= 4; j++) {
                        float o = 0.055 * float(j);
                        rk = max(rk, luma(sampleBloomLevelF(lvl, vec2(sx, uv.y + o), width, height)) * boost);
                        rk = max(rk, luma(sampleBloomLevelF(lvl, vec2(sx, uv.y - o), width, height)) * boost);
                    }
                    float need = 0.80 * smoothstep(0.10, 1.0, tFrac);
                    s *= smoothstep(need * 0.80, need * 0.80 + 0.12, pr / max(rk, 1e-5));
                    if (s < 0.004) continue;
                }

                vec3 hueC = smH / max(luma(smH), 1e-4);                        // colour direction of the source
                float level = mix(1.0, clamp(pr / (thrV * 2.5), 0.6, 1.8), 0.25 + 0.5 * soft);
                vec3 c = hueC * (level * s);
                vec3 spectral = mix(vec3(0.85, 0.97, 1.15), vec3(1.15, 0.92, 0.75), clamp(at, 0.0, 1.0));
                if (needLocal) {
                    vec3 cl = c * mix(vec3(1.0), spectral, 0.20) * wLocal;
                    lSum += cl;
                    lMax = max(lMax, cl);
                }
                if (needEdge) {
                    eSum += c;
                    eMax = max(eMax, c);
                }
            }

            vec3 beamL = mix(lSum * normK, lMax, 0.50);
            float dE = min(uv.x, 1.0 - uv.x) / reach;
            vec3 beamE = mix(eSum * normK * 0.5, eMax, 0.75) * flareProfile(dE, pk, pw);
            vec3 beam = beamL;
            if (needEdge) beam = needLocal ? mix(beamL, beamE, origin) : beamE;

            vec3 st = beam;
            float lst = luma(st);
            if (lst > 1e-5) {
                // COLOUR RESPECT (flareSceneTint): low = transparent haze, a pale white-ish veil with only a whisper of the
                // source hue; high = a solid flare coloured by the video underneath (nearby scene colour).
                float rc = clamp(L.flareSceneTint, 0.0, 1.0);
                vec3 ah = clamp(ambientNear / max(luma(ambientNear), 1e-4), vec3(0.30), vec3(3.0));
                ah = saturateColor(ah, 1.35);
                ah /= max(luma(ah), 1e-4);
                vec3 sceneC = mix(colorizeGlow(st, ambientCol, 1.0), ah * lst, 0.70);
                vec3 hazeC = mix(vec3(lst), st, 0.15) * vec3(1.03, 1.00, 0.96);
                float kc = smoothstep(0.0, 1.0, rc);
                st = mix(hazeC, sceneC, kc);
                st = saturateColor(st, mix(0.85, 1.20, kc));
                st *= mix(0.45, 1.0, smoothstep(0.0, 0.80, rc));               // haze is see-through, coloured flares are solid
                float core = clamp(L.flareCoreWhite, 0.0, 1.0) * smoothstep(0.50, 1.40, lst);
                st = mix(st, vec3(luma(st)), core * 0.75);
            }
            st *= mix(vec3(1.0), glowTint, 0.65);
            st = vec3(1.0) - exp(-st);                                         // filmic shoulder

    return st;
}

vec4 flareLoad(int idx) {
    uvec2 u = uvec2(flare_half[idx * 2], flare_half[idx * 2 + 1]);
    return vec4(unpackHalf2x16(u.x), unpackHalf2x16(u.y));
}

// Bilinear read of the half-resolution flare beam (same texel convention as sampleBloom).
vec3 sampleFlareHalf(vec2 uv, int width, int height) {
    int w = max(width >> 1, 1);
    int h = max(height >> 1, 1);
    vec2 pos = clamp(uv * vec2(w, h) - 0.5, vec2(0.0), vec2(w - 1, h - 1));
    ivec2 p0 = ivec2(floor(pos));
    ivec2 p1 = clamp(p0 + ivec2(1), ivec2(0), ivec2(w - 1, h - 1));
    vec2 f = fract(pos);
    vec3 c00 = flareLoad(p0.y * w + p0.x).rgb;
    vec3 c10 = flareLoad(p0.y * w + p1.x).rgb;
    vec3 c01 = flareLoad(p1.y * w + p0.x).rgb;
    vec3 c11 = flareLoad(p1.y * w + p1.x).rgb;
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

// PASS 10: one half-resolution texel of the flare beam of layer u_flareLayer. hw/hh = half-res size, u_srcW/u_srcH = full size.
void executeFlareHalf(ivec2 hc, int hw, int hh) {
    int li = u_flareLayer;
    if (li < 0) return;
    int fullW = max(u_srcW, 1);
    int fullH = max(u_srcH, 1);
    vec2 uv = (vec2(hc) + 0.5) / vec2(hw, hh);
    ivec2 fc = clamp(hc * 2 + ivec2(1), ivec2(0), ivec2(fullW - 1, fullH - 1));
    float maxDim = float(max(fullW, fullH));
    vec3 ambientCol = sampleAmbientColor(fc, fullW, fullH, 0.045 * maxDim);
    vec3 ambientNear = sampleAmbientColor(fc, fullW, fullH, 0.012 * maxDim);
    vec3 glowTint = tintFor(layers[li].edgeGlowTint);
    vec3 st = clamp(flareBeam(li, uv, fullW, fullH, ambientCol, ambientNear, glowTint), vec3(0.0), vec3(60000.0));
    if (any(isnan(st))) st = vec3(0.0);
    int idx = hc.y * hw + hc.x;
    flare_half[idx * 2] = packHalf2x16(st.rg);
    flare_half[idx * 2 + 1] = packHalf2x16(vec2(st.b, 1.0));
}

void executeFinalComposite(ivec2 coord, int width, int height) {
    int pixelIndex = coord.y * width + coord.x;

    vec4 compPx = unpackComposite(pixelIndex);
    vec3 linearBase = applyFxaa(coord, width, height);
    float centerLuma = luma(linearBase);
    vec2 uv = (vec2(coord) + 0.5) / vec2(width, height);

    vec4 tightS = sampleBloom(0, uv, max(width / 2, 1), max(height / 2, 1));
    vec4 midS   = sampleBloom(1, uv, max(width / 4, 1), max(height / 4, 1));
    vec4 wideS  = sampleBloom(2, uv, max(width / 8, 1), max(height / 8, 1));
    vec3 tightGlow = tightS.rgb;
    vec3 midGlow   = midS.rgb;
    vec3 wideGlow  = wideS.rgb;

    // line-art edge gradient (used to protect ink lines)
    float resScale = gRes;
    int edgeStep = gEdgeStep;
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float lum = luma(compAt(coord + ivec2(x * edgeStep, y * edgeStep), width, height));
            gx += lum * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lum * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);

    float exMin = glowExtractThreshold();
    int totalLayers = int(clamp(u_layerCount, 1.0, 10.0));

    // Scene colour context shared by every glow / flare (only paid for when one is active)
    bool anyGlow = false;
    for (int i = 0; i < totalLayers; i++) {
        LayerData Lg = layers[i];
        if (Lg.isEnabled < 0.5) continue;
        if (Lg.deepGlowIntensity > 0.01 || Lg.kawaseGlowIntensity > 0.01 || Lg.diffuseSpGlowIntensity > 0.01 ||
            Lg.shaderlyGlowIntensity > 0.01 || Lg.copiedEdgeRays > 0.01 || Lg.sapphireGlowWidth > 0.01 ||
            Lg.edgeHaloRadius > 0.01 || Lg.thinStreakIntensity > 0.01) { anyGlow = true; }
    }
    float maxDim = float(max(width, height));
    vec3 ambientCol = vec3(0.5);
    vec3 ambientNear = vec3(0.5);
    if (anyGlow) {
        ambientCol  = sampleAmbientColor(coord, width, height, 0.045 * maxDim);
        ambientNear = sampleAmbientColor(coord, width, height, 0.012 * maxDim);
    }

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;
        float op = clamp(L.opacity, 0.0, 1.0);
        vec3 glowTint = tintFor(L.edgeGlowTint);

        vec3 fxPreLw = linearBase;
        // ---- S_LightWrap: blurred BACKGROUND light wrapping into the darker foreground edge ----
        // v2.2: no more tap ring. The old version gathered a fixed ring of raw taps (a literal copy of
        // the clip at a fixed offset = the "duplicated ring"). Now the wrap source is the already
        // blurred highlight pyramid, so it is a smooth gradient that is strong at the silhouette and
        // dies off inward, exactly like a real light wrap.
        if (L.lightWrapIntensity > 0.01 && L.lightWrapWidth > 0.01) {
            float wv = clamp(L.lightWrapWidth, 0.0, 1.0);
            vec3 field = glowField(uv, width, height, mix(1.8, 4.4, wv), L.lightWrapThreshold, exMin) * 0.85;   // v2.7 clean field
            float lumaP = luma(linearBase);
            float lf = luma(field);
            // the pixel only receives light if it is darker than the light spilling onto it
            float receive = clamp((lf - lumaP * 0.85) / max(lf, 1e-4), 0.0, 1.0);
            receive = receive * receive * (3.0 - 2.0 * receive);
            // hug the silhouette: strongest where the blurred edge mask is high
            float nearEdge = clamp(max(tightS.a, midS.a * 0.8) * 1.6, 0.0, 1.0);
            float edgeGate = mix(0.15, 1.0, nearEdge);
            vec3 wrap = saturateColor(field, 1.10) * receive * edgeGate * L.lightWrapIntensity * 1.35;
            float lw = luma(wrap);
            if (lw > 1e-5) wrap *= (1.0 - exp(-lw * 1.3)) / lw;   // soft-limit: never slams to pure white
            // INNER EDGE DEPTH: bright subject pixels right at the silhouette (they receive no wrap) go
            // deeper and richer: darker, with their own colour pushed (skin -> warm rose, not grey).
            float innerEdge = nearEdge * (1.0 - receive) * smoothstep(0.15, 0.60, lumaP) * smoothstep(0.02, 0.18, lf);   // v2.7: only where wrap light exists
            vec3 deepEdge = saturateColor(linearBase, 1.45) * 0.72;
            linearBase = mix(linearBase, deepEdge, clamp(innerEdge * L.lightWrapIntensity * 0.55, 0.0, 0.7) * op);
            if (L.lightWrapBlendMode > 0.5) linearBase += wrap * op;
            else {
                vec3 cb = clamp(linearBase, 0.0, 1.0);
                linearBase = mix(linearBase, cb + wrap - cb * wrap + max(linearBase - 1.0, 0.0), op);
            }
        }

        linearBase = fxMix(fxPreLw, linearBase, fx[i].f[14], 0.0);
        vec3 fxPreDg = linearBase;
        // ---- 1. Deep Glow: inverse-square falloff, ONE continuous field (v2.7) ----
        // Equal energy per pyramid octave = 1/d^2 tail. Radius = how far the tail reaches (level 1.8 .. a virtual level 6.6,
        // roughly 1% .. 15% of the frame height). Raising it ADDS tail, the core is never dimmed. Only the clean levels are
        // read, so there are no stacked copies and no ring.
        if (L.deepGlowIntensity > 0.01) {
            float r = clamp(L.deepGlowRadius, 0.0, 1.0);
            float Rg = mix(1.8, 6.6, r);
            vec3 g = glowField(uv, width, height, Rg, L.deepGlowThreshold, exMin) * 0.70;
            g = colorizeGlow(g, ambientCol, 0.85);
            g = saturateColor(g, 1.15) * mix(vec3(1.0), glowTint, 0.80);
            // Deep Glow signature: a hot core. Where the field is strong the light burns towards white, the outer
            // falloff keeps the scene colour.
            float hotAmt = smoothstep(0.30, 1.10, luma(g) * (1.25 - 0.6 * r) * 1.1);
            g = mix(g, vec3(luma(g)) * vec3(1.00, 0.96, 0.90) * 1.20, hotAmt * 0.35);
            g *= (1.0 - lineEdge * 0.15);
            // bright pixels (skin highlights) receive less added light so their colour variation survives
            float dgRecv = mix(0.40, 1.0, 1.0 - smoothstep(0.50, 1.10, luma(linearBase)));
            linearBase += g * (L.deepGlowIntensity * 1.9) * dgRecv * op;
        }

        linearBase = fxMix(fxPreDg, linearBase, fx[i].f[8], fx[i].f[18]);
        vec3 fxPreKw = linearBase;
        // ---- 2. Kawase glow: softer / shorter reach version of the same clean field ----
        if (L.kawaseGlowIntensity > 0.01) {
            float r = clamp(L.kawaseGlowRadius, 0.0, 1.0);
            vec3 g = glowField(uv, width, height, mix(1.8, 4.8, r), L.deepGlowThreshold, exMin) * 0.70;
            g = colorizeGlow(g, ambientCol, 0.80);
            linearBase += g * glowTint * (L.kawaseGlowIntensity * 1.6) * op;
        }

        linearBase = fxMix(fxPreKw, linearBase, fx[i].f[9], 0.0);
        // ---- 3. Diffuse SP: light-source simulation + prismatic dispersion bloom ----
        // Finds the dominant light (sun / brightest source), then every pixel gathers the highlight
        // field ALONG THE RAY towards that light, so the light visibly travels onto the subject
        // instead of just blooming in place. The R/G/B gathers use radially scaled offsets about the
        // light (R furthest, B least) = prismatic screen-space dispersion with radial chromatic
        // aberration that grows with distance from the source. Strength falls off with distance to
        // the light, and pixels that are already bright receive less.
        if (L.diffuseSpGlowIntensity > 0.01) {
            float r = clamp(L.diffuseSpGlowRadius, 0.0, 1.0);
            float aspect = float(width) / float(height);
            vec2 toL = (gLightUV - uv) * vec2(aspect, 1.0);
            float dL = length(toL);
            vec2 dirUv = (toL / max(dL, 1e-4)) * vec2(1.0 / aspect, 1.0);   // unit direction, in uv space
            float dispAmt = (0.006 + r * 0.040) * (0.35 + dL);               // dispersion grows with distance
            float reachLen = dL * (0.45 + 0.55 * r);                          // how far along the ray we gather
            int mw = max(width / 8, 1); int mh = max(height / 8, 1);
            int ww = max(width / 16, 1); int wh = max(height / 16, 1);
            float jit = hashInt12(coord * 7 + ivec2(3, 29));
            const int DN = 6;
            vec3 prism = vec3(0.0);
            float wsum = 0.0;
            for (int k = 0; k < DN; k++) {
                float t = (float(k) + jit) / float(DN);                       // 0..1 along the ray
                float wk = exp(-t * 1.8);
                vec2 base = uv + dirUv * reachLen * t;
                int lv = (t < 0.5) ? 2 : 3;   // v2.7: levels 2 / 3 (level 1 carries a raw copy of the highlights)
                int lw_ = (lv == 2) ? mw : ww;
                int lh_ = (lv == 2) ? mh : wh;
                float sR = sampleBloom(lv, base + dirUv * dispAmt * 1.00, lw_, lh_).r;
                float sG = sampleBloom(lv, base + dirUv * dispAmt * 0.60, lw_, lh_).g;
                float sB = sampleBloom(lv, base + dirUv * dispAmt * 0.22, lw_, lh_).b;
                prism += vec3(sR, sG, sB) * wk;
                wsum += wk;
            }
            prism /= max(wsum, 1e-3);
            vec3 core = glowField(uv, width, height, 2.4, 0.0, 1.0) * 0.55 * vec3(1.06, 1.00, 0.92);
            vec3 g = prism * 1.15 + core * 0.30;
            g = gateGlow(g, L.diffuseSpGlowThreshold, exMin);
            g = colorizeGlow(g, ambientCol, 0.55);
            g *= mix(vec3(1.0), gLightCol, 0.35);                              // inherit the light's own colour
            float prox = 1.0 / (1.0 + dL * dL * mix(14.0, 3.0, r));            // closer to the light = stronger
            float receiveD = 1.0 - smoothstep(0.55, 1.15, luma(linearBase));    // already-bright pixels receive less
            float gain = mix(0.30, 1.0, prox) * mix(0.55, 1.0, gLightStrength);
            linearBase += g * (L.diffuseSpGlowIntensity * 1.5) * gain * receiveD * (1.0 - lineEdge * 0.25) * op;
        }

        // ---- 4a. Sapphire edge glow: glow that comes FROM the detected edges ----
        // v2.7: the glow field is the blurred edge mask of the CLEAN levels (2..4, inverse-square mix, reach = Width), read
        // with a saturating curve. The old version read the raw half-res mask for small widths, which IS the line art
        // (a 45% copy of it), and cut it with a hard smoothstep, so it looked like the lines themselves glowing. Edges
        // whose lit side is dark do not glow. The line art pixels stay masked out.
        {
            float sapInt = 0.0;
            if (L.copiedEdgeRays > 0.01) sapInt = L.copiedEdgeRays;
            else if (L.sapphireGlowWidth > 0.01) sapInt = 0.8;
            if (sapInt > 0.01) {
                float widthN = clamp(L.sapphireGlowWidth * 0.5, 0.0, 1.0);          // 0..1 (slider is 0..2)
                float sens = clamp(L.sapphireGlowThreshold, 0.1, 0.99);
                float lo = sens * 0.30;
                float crisp = smoothstep(lo, lo + 0.18, lineEdge);                   // = the line art / contour itself
                int ss = max(3, edgeStep * 3);
                vec3 n0 = compAt(coord + ivec2( ss, 0), width, height);
                vec3 n1 = compAt(coord + ivec2(-ss, 0), width, height);
                vec3 n2 = compAt(coord + ivec2(0,  ss), width, height);
                vec3 n3 = compAt(coord + ivec2(0, -ss), width, height);
                vec3 lit = n0;
                if (luma(n1) > luma(lit)) lit = n1;
                if (luma(n2) > luma(lit)) lit = n2;
                if (luma(n3) > luma(lit)) lit = n3;
                float ll = max(luma(lit), 1e-4);
                vec3 hueL = saturateColor(clamp(lit / ll, vec3(0.05), vec3(4.0)), 1.45);
                hueL /= max(luma(hueL), 1e-4);
                float lvl = clamp(ll * 1.5 + 0.25, 0.30, 1.60);
                vec3 edgeCol = hueL * lvl + ambientNear * 0.15;
                edgeCol = mix(edgeCol, edgeCol * glowTint + glowTint * 0.10 * luma(edgeCol), step(0.5, L.edgeGlowTint) * 0.65);
                float litGate = smoothstep(0.06, 0.40, ll);                          // edges on the dark side stay dark
                int e2w = max(width >> 3, 1);  int e2h = max(height >> 3, 1);
                int e3w = max(width >> 4, 1);  int e3h = max(height >> 4, 1);
                int e4w = max(width >> 5, 1);  int e4h = max(height >> 5, 1);
                float eR = mix(2.0, 4.6, widthN);
                float ec2 = 1.0 / (1.0 + exp2(4.0 * (2.0 - eR)));
                float ek3 = (1.0 / (1.0 + exp2(4.0 * (3.0 - eR)))) / ec2;
                float ek4 = (1.0 / (1.0 + exp2(4.0 * (4.0 - eR)))) / ec2;
                // edge density of a thin line falls as 1/blur size, so wider levels are scaled back up (x2, x4)
                float eF = sampleBloomSmooth(2, uv, e2w, e2h).a;
                if (ek3 > 0.004) eF += sampleBloomSmooth(3, uv, e3w, e3h).a * ek3 * 2.0;
                if (ek4 > 0.004) eF += sampleBloomSmooth(4, uv, e4w, e4h).a * ek4 * 4.0;
                float eBlur = 1.0 - exp(-eF * 3.0);
                float offLine = 1.0 - crisp * 0.92;                                  // never brighten the line art itself
                float field = eBlur * offLine * litGate * (1.0 + widthN * 0.6);
                linearBase += edgeCol * field * sapInt * 0.85 * op;
            }
        }

        // ---- 4b. Edge Halo: a wide, soft AURA that spills OUTWARD from silhouettes ----
        // Opposite of Sapphire: no contour at all (it is masked off the line itself), very wide, built
        // from the coarse edge mask, tinted by the surrounding ambient light, and it prefers the darker
        // side of an edge so it reads as light bleeding out into the background.
        if (L.edgeHaloRadius > 0.01) {
            float hs = clamp(L.edgeHaloRadius / 1.5, 0.0, 1.0);
            // The raw edge mask is speckly (it is a Sobel of a noisy / 8-bit source), and the old
            // 1 - exp(-k*mask) curve amplified every tiny speckle into grain. Now: gather the mask
            // with a fixed 16-tap gaussian spiral from the 1/8-res level (bilinear = smooth), then
            // gate out the low-level noise floor before shaping the aura.
            int hw = max(width / 8, 1);
            int hh = max(height / 8, 1);
            float spread = mix(1.6, 5.0, hs);
            float eAcc = 0.0;
            float eWt = 0.0;
            for (int hk = 0; hk < 16; hk++) {
                float hfr = (float(hk) + 0.5) / 16.0;
                float hr = sqrt(hfr) * spread;
                float ha = float(hk) * 2.39996323;
                vec2 hoff = vec2(cos(ha), sin(ha)) * hr / vec2(float(hw), float(hh));
                float hwgt = exp(-hfr * 1.4);
                eAcc += sampleBloom(2, uv + hoff, hw, hh).a * hwgt;
                eWt += hwgt;
            }
            float eWide = eAcc / eWt;
            float eH = smoothstep(0.025, 0.50, eWide);
            eH = eH * eH * (3.0 - 2.0 * eH);
            float la = luma(ambientCol);
            float lp = luma(wideGlow) * 0.5 + luma(linearBase) * 0.5;
            float outward = smoothstep(-0.2, 0.60, (la - lp) / (la + 0.05));
            float sideGate = mix(0.45, 1.0, outward);
            vec3 haloCol = saturateColor(ambientCol * 1.15 + wideGlow * 1.4 + midGlow * 0.4, 1.25);
            haloCol *= mix(vec3(1.0), glowTint, 0.70);
            linearBase += haloCol * eH * sideGate * L.edgeHaloRadius * 0.60 * (1.0 - lineEdge * 0.30) * op;
        }

        // ---- 5. Anamorphic flare v4 ----
        // The old flare treated almost the whole image as a source (the shared bloom extraction threshold for flares is
        // 0.20), so most rows lit up and the beams merged into full-width white bars, and "from edge" just multiplied
        // that by a left/right fade. Now:
        // * Sources are only strong LOCAL PEAKS above a Threshold slider.
        // * Spacing: a source only flares if it is the strongest one within +-Spacing of its row (vertical non-maximum
        //   suppression), so flares are separate bands, not a wall.
        // * Thickness sets the band height. Softness: low = flat-topped with a crisp edge, high = the beam is smeared
        //   vertically (up to ~8% of the frame height each way) into a wide, feathered glow that fades out gradually.
        // * Origin: 0 = beam grows out of each highlight, 1 = beam enters from the left / right frame edge on the
        //   source's row and runs inward (Length = how far in). In-between mixes both.
        // * Colour: source colour, blended toward the scene colour, with an optional hot white core.
        if (L.thinStreakIntensity > 0.01 && L.thinStreakOpacity > 0.01) {
            vec3 st;
            if (u_flareLayer == i) st = sampleFlareHalf(uv, width, height);   // pre-computed at half res by pass 10
            else st = flareBeam(i, uv, width, height, ambientCol, ambientNear, glowTint);
            linearBase += st * L.thinStreakIntensity * 1.1 * L.thinStreakOpacity * op;
        }

        // ---- 6a. Pro-Mist: soft diffusion veil. Colour of the scene is kept (no tint), highlights bleed softly into
        //          the surroundings and contrast eases a little. Not an additive glow.
        if (L.copiedProMist > 0.01) {
            vec3 mist = mix(midGlow, wideGlow, 0.60);
            mist = gateGlow(mist, 0.40, exMin);
            vec3 veil = vec3(1.0) - exp(-mist * (L.copiedProMist * 1.1));
            vec3 cb = clamp(linearBase, 0.0, 1.0);
            vec3 screened = cb + veil * 0.55 - cb * veil * 0.55 + max(linearBase - 1.0, vec3(0.0));
            linearBase = mix(linearBase, screened, op * (1.0 - lineEdge * 0.65));
            float l0 = luma(linearBase);
            linearBase = mix(linearBase, vec3(l0) + (linearBase - vec3(l0)) * 0.97, clamp(L.copiedProMist * 0.5, 0.0, 0.5));
        }

        vec3 fxPreHal = linearBase;
        // ---- 6b. TRUE HALATION. Light from bright highlights passes through the film, reflects off the film base
        //          and re-exposes the emulsion from behind. The red layer is exposed most, green a little, blue
        //          almost not at all, so the spill is a red-orange fringe that is WIDE and sits OUTSIDE the
        //          highlight edge. Channels spread by different amounts (red widest). It is never a white
        //          luminance glow and the highlight cores themselves are left alone.
        if (L.halationRadius > 0.01 && L.halationStrength > 0.01) {
            float hr = clamp(L.halationRadius / 1.5, 0.0, 1.0);
            float th = clamp(L.halationThreshold, 0.25, 0.95);
            // v2.7 DEPTH: red and green are separate continuous inverse-square fields. Green reaches 1.5 levels less far, so
            // the fringe is orange-red right next to the highlight and fades through deep red to nothing far out.
            float Rr = mix(2.2, 5.6, hr);
            float spillR = luma(glowField(uv, width, height, Rr, th, exMin)) * 0.62;
            float spillG = luma(glowField(uv, width, height, Rr - 1.5, th, exMin)) * 0.62;
            float warm = clamp(L.halationWarmth / 1.5, 0.0, 1.0);   // 0 = deep red, 1 = orange
            vec3 halRGB = vec3(spillR * 1.00, spillG * mix(0.10, 0.34, warm), spillG * mix(0.0, 0.03, warm));
            // fringe sits outside the highlight: bright pixels receive little, dark neighbours receive the most
            float halRecv = 1.0 - smoothstep(0.50, 1.00, luma(linearBase));
            float hl = L.halationStrength * 1.4;
            linearBase += halRGB * hl * mix(0.10, 1.0, halRecv) * (1.0 - lineEdge * 0.6) * op;
        }

        linearBase = fxMix(fxPreHal, linearBase, fx[i].f[11], fx[i].f[16]);
        // ---- 7. Atmosphere haze / scatter (glow-driven) ----
        if (L.bslaBloomHaze > 0.01) {
            vec3 hz = mix(wideGlow, vec3(luma(wideGlow)) * vec3(0.78, 0.90, 1.10), 0.35);
            linearBase += hz * L.bslaBloomHaze * 1.2 * op;
        }
        if (L.bslFogScatter > 0.01) {
            vec3 sc = mix(midGlow, wideGlow, 0.6) * vec3(1.05, 1.0, 0.92);
            linearBase += sc * L.bslFogScatter * 1.1 * op;
        }
    }

    // ---- OPTICAL DIFFUSION + PRO MIST v2 (batch 4) ----
    // Optical Diffusion: highlight-gated softening. A clean multi-octave highlight field (no raw copy) is screened back in,
    // and a tiny highlight-gated ring blur removes digital edge sharpness only where light is hot. Nothing is blurred in the
    // shadows / mids, so the picture stays crisp but gains a filmic, atmospheric roll-off. "Mix" = how much of the original
    // sharp frame is kept.
    // Pro Mist: physical Black Pro-Mist style - WIDE tinted halation-flavoured bloom, milky black lift, and a gentle contrast
    // drop. Different from Optical Diffusion on purpose (tinted + lifted blacks + wider vs. neutral + crisp + local).
    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;
        float dAmt = clamp(fx[i].f[23], 0.0, 1.0);
        if (dAmt > 0.01) {
            vec3 pre = linearBase;
            float r = clamp(fx[i].f[25], 0.0, 1.0);
            vec3 fieldD = glowField(uv, width, height, mix(1.6, 5.0, r), clamp(fx[i].f[24], 0.0, 1.5), exMin) * 0.75;
            float warm = clamp(fx[i].f[27], -1.0, 1.0);
            fieldD *= vec3(1.0 + 0.10 * warm, 1.0, 1.0 - 0.10 * warm);
            // highlight-gated micro softening (ring of 8 taps, radius ~1-3 px)
            float rr = (0.8 + r * 2.4) * gRes;
            vec3 ring = vec3(0.0);
            for (int k = 0; k < 8; k++) {
                float a = (float(k) + 0.5) * 0.78539816;
                ring += compAt(coord + ivec2(round(vec2(cos(a), sin(a)) * rr)), width, height);
            }
            ring *= 0.125;
            float hiW = smoothstep(clamp(fx[i].f[24], 0.0, 1.5) * 0.6, clamp(fx[i].f[24], 0.0, 1.5) * 0.6 + 0.45, luma(linearBase));
            vec3 soft = mix(linearBase, 0.5 * (ring + linearBase), hiW * dAmt);
            vec3 cbD = clamp(soft, 0.0, 1.0);
            vec3 gl = vec3(1.0) - exp(-fieldD * (dAmt * 2.2));
            vec3 diffused = cbD + gl - cbD * gl + max(soft - 1.0, vec3(0.0));
            vec3 processed = mix(diffused, pre, clamp(fx[i].f[26], 0.0, 1.0));   // keep some of the original sharp frame
            linearBase = fxMix(pre, processed, fx[i].f[3], fx[i].f[21]);
        }
        float mAmt = clamp(fx[i].f[28], 0.0, 1.0);
        if (mAmt > 0.01) {
            vec3 pre = linearBase;
            float r = clamp(fx[i].f[30], 0.0, 1.0);
            vec3 fieldM = glowField(uv, width, height, mix(3.0, 6.4, r), clamp(fx[i].f[29], 0.0, 1.5), exMin) * 0.9;
            vec3 tintM = mix(vec3(1.0), vec3(1.0, 0.46, 0.24), clamp(fx[i].f[31], 0.0, 1.0));   // halation tint: 0 neutral .. 1 red-orange
            vec3 bloom = fieldM * tintM;
            vec3 glM = vec3(1.0) - exp(-bloom * (mAmt * 2.0));
            vec3 cbM = clamp(linearBase, 0.0, 1.0);
            vec3 out_ = cbM + glM - cbM * glM + max(linearBase - 1.0, vec3(0.0));
            float lift = clamp(fx[i].f[32], 0.0, 1.0) * 0.06 * mAmt;
            out_ = out_ + (vec3(1.0) - clamp(out_, 0.0, 1.0)) * lift * 2.0;                 // milky blacks
            out_ = mix(vec3(0.18), out_, 1.0 - 0.18 * mAmt);                                   // gentle contrast drop toward mid grey
            linearBase = fxMix(pre, out_, fx[i].f[4], fx[i].f[22]);
        }
    }

    // ---- Shaderly Glow: OVERALL glow (AE "Glow" effect) ----
    // Whole-frame, threshold-driven, always has a strong wide component and is SCREEN-blended (like AE's
    // Glow), so it lifts and softens the entire image rather than adding hot spots like Deep Glow.
    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5 || L.shaderlyGlowIntensity <= 0.01) continue;
        float r = clamp(L.shaderlyGlowRadius, 0.0, 1.0);
        // v2.7: clean continuous field. Radius = reach (level 1.8 .. 6.0), Threshold = per-level source gate, colour comes from
        // the media (colorizeGlow below). The old radius slider only re-weighted three fixed levels, one of which was the raw copy.
        float Rs = mix(1.8, 6.0, r);
        vec3 g = glowField(uv, width, height, Rs, L.shaderlyGlowThreshold, exMin) * 0.55;
        g = colorizeGlow(g, ambientCol, 0.90);
        g = saturateColor(g, 1.30);
        if (L.shaderlyGlowTint > 0.01) {
            vec3 tint = srgbToLinear(hueToRGB(fract(L.shaderlyGlowTint)));
            g = mix(g, tint * luma(g) * 2.2, 0.55);
        }
        // exposure-style shoulder, then Screen against the image (never clips highlights)
        vec3 gl = vec3(1.0) - exp(-g * (L.shaderlyGlowIntensity * 2.4));
        vec3 cb = clamp(linearBase, 0.0, 1.0);
        vec3 screened = cb + gl - cb * gl + max(linearBase - 1.0, vec3(0.0));
        vec3 fxPreSg = linearBase;
        linearBase = mix(linearBase, screened, clamp(L.opacity, 0.0, 1.0) * (1.0 - lineEdge * 0.30));
        linearBase = fxMix(fxPreSg, linearBase, fx[i].f[10], fx[i].f[17]);
    }

    // ---- Master tonemap -> sRGB ----
    vec3 finalLinear = applyToneMapping(linearBase, u_tonemapMode);
    vec3 finalDisplay = linearToSrgb(finalLinear);

    // ---- LUT: display-referred. The LUT gets a NEUTRAL display transform (identity below the knee, soft
    //      shoulder above), NOT the AgX / Neutral look. Feeding a creative LUT an already flattened AgX image is what
    //      made every LUT look washed out. LUT Opacity blends between the tonemapped look and the LUT look. ----
    if (u_hasLut > 0.5) {
        vec3 lutIn = linearToSrgb(tonemapLinearSoft(linearBase));
        vec3 lutOut = sample3DLutDisplay(lutIn, 1.0);
        finalDisplay = mix(finalDisplay, lutOut, clamp(u_lutOpacity, 0.0, 1.0));
    }

    // ---- Batch 12 step B: the dither + quantise moved to pass 23 (executeDitherQuantise). Pass 6 stores the finished display-referred
    //      image as float32 (lossless), so pass 22 (Time Slice, step C) can run between the two and dither still happens exactly once. ----
    display_px[pixelIndex] = vec4(finalDisplay, 1.0);
}

// =============================================================================
// PASS 23: TPDF dither + quantise (batch 12 step B). Reads the float display image written by pass 6 and writes out_pixels.
// The dither expression, constants, coordinate and u_time shift are COPIED UNCHANGED from the end of the old pass 6.
// =============================================================================
void executeDitherQuantise(ivec2 coord, int width, int height) {
    int pixelIndex = coord.y * width + coord.x;
    float bitMode = gBit;
    vec3 finalDisplay = display_px[pixelIndex].rgb;

    float lsb = (bitMode > 1.5) ? (1.0 / 65535.0) : (1.0 / 255.0);
    float amt = mix(0.50, 1.00, clamp(u_ditherStrength, 0.0, 1.0));   // 1.0 = exact +-1 LSB triangular
    ivec2 shift = ivec2(int(fract(u_time * 0.1371) * 997.0), int(fract(u_time * 0.0713) * 991.0));
    float n1 = hashInt12(coord + shift);
    float n2 = hashInt12(coord + shift + ivec2(41, 17));
    float tpdf = (n1 + n2) - 1.0;
    vec3 chroma = vec3(tpdf, (hashInt12(coord + shift + ivec2(7, 91)) + hashInt12(coord + shift + ivec2(113, 3)) - 1.0),
                       (hashInt12(coord + shift + ivec2(59, 29)) + hashInt12(coord + shift + ivec2(5, 211)) - 1.0));
    finalDisplay = clamp(finalDisplay + mix(vec3(tpdf), chroma, 0.35) * lsb * amt, 0.0, 1.0);

    packFinalDisplay(pixelIndex, vec4(finalDisplay, 1.0), bitMode);
}

// =============================================================================
// PASS 24 (batch 12 step C1): TIME SLICE STORE. Copies the finished (pre-dither) display image into ring slot u_srcW. No maths, nothing is changed.
// =============================================================================
// C2: two ring formats, chosen by the host in timeSlice[645] (floats 7045): 0 = float32 (C1, one vec4 per pixel per slot), 1 = PACKED (8-bit output path).
// PACKED = 2 words per pixel (half a vec4): word A = R15 | G15 << 15, word B = B15 | A15 << 15, 15-bit unorm (max error 1.5e-5, far below one 8-bit step).
// Bits 30 and 31 of every word stay 0, so the word can never look like a NaN / Inf float and no GPU can canonicalise it. Only single components are written
// (display_px[v].x = ...), never .xy, so two neighbouring pixels sharing one vec4 cannot overwrite each other.
// Layout (vec4 units, P = width * height, Q = (P + 1) / 2): slot 0 = working image at 0, ring slot j at P + j * Q.
const float TS_Q = 32767.0;
uint tsQ(float v) { return uint(clamp(v, 0.0, 1.0) * TS_Q + 0.5); }

void tsStorePacked(int slotBase, int i, vec4 c) {
    int vi = slotBase + (i >> 1);
    float a = uintBitsToFloat(tsQ(c.r) | (tsQ(c.g) << 15));
    float b = uintBitsToFloat(tsQ(c.b) | (tsQ(c.a) << 15));
    if ((i & 1) == 0) { display_px[vi].x = a; display_px[vi].y = b; }
    else              { display_px[vi].z = a; display_px[vi].w = b; }
}

vec4 tsLoadPacked(int slotBase, int i) {
    int vi = slotBase + (i >> 1);
    uint a, b;
    if ((i & 1) == 0) { a = floatBitsToUint(display_px[vi].x); b = floatBitsToUint(display_px[vi].y); }
    else              { a = floatBitsToUint(display_px[vi].z); b = floatBitsToUint(display_px[vi].w); }
    return vec4(float(a & 0x7FFFu), float((a >> 15) & 0x7FFFu), float(b & 0x7FFFu), float((b >> 15) & 0x7FFFu)) / TS_Q;
}

void executeTimeSliceStore(ivec2 coord, int width, int height) {
    int P = width * height;
    int pixelIndex = coord.y * width + coord.x;
    if (timeSlice[645] > 0.5) {
        int Q = (P + 1) / 2;
        tsStorePacked(P + u_srcW * Q, pixelIndex, display_px[pixelIndex]);
    } else {
        display_px[(1 + u_srcW) * P + pixelIndex] = display_px[pixelIndex];
    }
}

// =============================================================================
// PASS 22 (batch 12 step C1): TIME SLICE. Runs between pass 6 and pass 23, reads ring slots, writes display_px slot 0. NO dither here.
//
// PER-FRAME STATE (written by Dart, floats 7040.. = timeSlice[640 + i]) = TS_STATE:
//   0 (7040) active        1 = a wipe is running this frame (the host only dispatches pass 22 when it is)
//   1 (7041) progress p    wipe progress 0..1 (hard on at 0, hard off at 1; the cut frame sits at p = cutPoint, default 0.40)
//   2 (7042) cutPoint      informational for the shader (Dart derives p and n from it)
//   3 (7043) n             output frame number relative to the cut frame (n < 0 = A frames, n >= 0 = B frames)
//   4 (7044) R             ring half width: ring slot j holds the frame at offset j - R, j = 0 .. 2R
//   5 (7045) ring mode     written by the NATIVE side (0 = float32 ring, 1 = packed 15-bit ring), never by Dart
//   6 (7046) layer         index of the layer whose TimeSlice settings block (6400 + layer * 64) is used
// SETTINGS used (class TimeSlice): direction 2, sliceCount 3, frameOffset 4, interpFrames 5, feather 6, mix 7, opacity 8.
//
// LOOK [ASSUMED]: a band of width TS_BAND (fraction of the frame along the slice direction) sweeps across the frame. Behind the band the picture
// is the B shot, ahead of it the A shot. Inside the band the frame is cut into sliceCount slices; slice k shows a time between the B and A frame
// (levels (k+1)/(N+1)). Interp ON blends the two nearest frames of that time (silky), OFF takes the nearest frame (visible steps). Feather
// softens the borders between slices (and between slice and shot). At p = 0 the band is off the frame (all A), at p = 1 it has left it (all B),
// so the first and last wipe frame equal plain video: no ramp, no fade, no black, nothing pops.
// =============================================================================
const float TS_BAND = 0.35;   // default band width; the real value is the per-layer setting bandWidth (slot 23), 0.35 when it is 0 (old presets)

vec3 tsRing(int j, int P, int pixelIndex) {
    if (timeSlice[645] > 0.5) return tsLoadPacked(P + j * ((P + 1) / 2), pixelIndex).rgb;
    return display_px[(1 + j) * P + pixelIndex].rgb;
}

void executeTimeSlice(ivec2 coord, int width, int height) {
    int P = width * height;
    int pixelIndex = coord.y * width + coord.x;
    int R = max(int(timeSlice[644] + 0.5), 1);
    int maxSlot = 2 * R;
    int lay = clamp(int(timeSlice[646] + 0.5), 0, 9);
    int sb = lay * 64;
    float p = clamp(timeSlice[641], 0.0, 1.0);
    float n = timeSlice[643];

    float ang = radians(timeSlice[sb + 2]);
    vec2 d = vec2(cos(ang), sin(ang));
    vec2 pc = vec2(coord) + vec2(0.5) - 0.5 * vec2(float(width), float(height));
    float extent = abs(d.x) * float(width) + abs(d.y) * float(height);
    float s = 0.5 + dot(pc, d) / max(extent, 1.0);

    float band = timeSlice[sb + 23];
    band = (band < 0.05) ? TS_BAND : min(band, 1.0);
    float f = p * (1.0 + band) - band;            // band = [f, f + band] along s
    float u = (s - f) / band;                      // < 0 behind the band (B), > 1 ahead of it (A)
    float qB = max(n, 0.0);                        // B shot plays normally after the cut, holds its first frame before it
    float qA = min(n, -1.0);                       // A shot plays normally before the cut, holds its last frame after it

    float N = max(floor(timeSlice[sb + 3] + 0.5), 1.0);
    float feather = clamp(timeSlice[sb + 6], 0.0, 1.0);
    float level = 0.0;
    if (u >= 1.0) {
        level = 1.0;
    } else if (u > 0.0) {
        float x = u * N;
        float k = min(floor(x), N - 1.0);
        float fr = x - k;
        float lk = (k + 1.0) / (N + 1.0);
        float edge = 0.5 * feather;
        float ln = lk;
        float wgt = 0.0;
        if (edge > 0.0001) {
            if (fr < edge) {
                ln = k / (N + 1.0);
                wgt = 0.5 * (1.0 - smoothstep(0.0, edge, fr));
            } else if (fr > 1.0 - edge) {
                ln = (k + 2.0) / (N + 1.0);
                wgt = 0.5 * smoothstep(1.0 - edge, 1.0, fr);
            }
        }
        level = mix(lk, ln, wgt);
    }

    float q = mix(qB, qA, level);
    q += timeSlice[sb + 4] * 4.0 * level * (1.0 - level);   // frameOffset: shifts the slice times, zero at both band borders
    q = clamp(q, float(-R), float(R));
    float qs = q + float(R);

    vec3 col;
    if (timeSlice[sb + 5] >= 0.5) {
        float q0 = floor(qs);
        float fq = qs - q0;
        int s0 = clamp(int(q0), 0, maxSlot);
        int s1 = clamp(int(q0) + 1, 0, maxSlot);
        col = mix(tsRing(s0, P, pixelIndex), tsRing(s1, P, pixelIndex), fq);
    } else {
        col = tsRing(clamp(int(floor(qs + 0.5)), 0, maxSlot), P, pixelIndex);
    }

    float amount = clamp(timeSlice[sb + 7], 0.0, 1.0) * clamp(timeSlice[sb + 8], 0.0, 1.0);
    if (amount < 0.9999) {
        vec3 base = tsRing(clamp(int(floor(n + 0.5)) + R, 0, maxSlot), P, pixelIndex);
        col = mix(base, col, amount);
    }
    display_px[pixelIndex] = vec4(col, 1.0);
}

// =============================================================================
// PASS 25 + PASS 26 (batch 13): GLOBAL METALLIC BEVEL ("Send-Off" effect)
//
// Runs on the FINISHED display-referred image (display_px slot 0), after pass 6 / pass 22 and BEFORE pass 23 (dither), so dither still happens
// exactly once and the Time Slice ring (stored by pass 24, pre-bevel) is never bevelled twice.
//
// Why two passes: the bevel needs the 3x3 neighbourhood of every pixel and writes the result back into the same display image. Doing both in one
// pass would let a pixel read neighbours another invocation has already overwritten (race). So:
//   PASS 25  one fetch per pixel: luma of display_px -> one float per pixel into out_pixels (scratch, same trick as passes 11 / 13 / 16; pass 23 overwrites it).
//   PASS 26  reads ONLY the luma plane for the neighbours (a 4-byte plane, cache friendly) and its own display_px pixel, writes its own display_px pixel.
// Fetch budget per pixel in pass 26: 8 luma reads (3x3 Sobel, the centre tap has weight 0 so it is skipped) + 1 RGB read. No nested loops, no per-tap
// luma maths, no texture sampling.
//
// MATH (per layer block, floats 7424 + layer * 16, shader: bevel[layer * 16 + i]):
//   0 On   1 Bevel Intensity   2 Gloss Strength   3 Shininess   4 Light X   5 Light Y   6 Mix   7..15 reserved
//   height H = luma;  Sobel(H) -> dH/dX, dH/dY;  N = normalize(-dH/dX * intensity, -dH/dY * intensity, 1)
//   L = normalize(lightX, lightY, 0.7);  diffuse = max(dot(N, L), 0.5);  H = normalize(L + V), V = (0, 0, 1)
//   specular = pow(max(dot(N, H), 0), shininess);  out = base * diffuse + specular * gloss;  result = mix(base, out, Mix)
//
// [ASSUMED] Sobel is scaled by BV_SOBEL_NORM = 1/4 so a full black-to-white step reads as slope 1.0 before Bevel Intensity (raw Sobel would be 4.0 and
//           the default intensity 2.5 would make every hard edge a near-vertical wall).
// [ASSUMED] Light Y is "up on screen" (+ = light from the top): image rows grow downward, so the shader flips its sign. Default (-0.3, 0.4) = light from the top left.
// [ASSUMED] Tap spacing is gEdgeStep pixels (1 at 720p-ish, 2 at 1080p) like the other edge effects, so the bevel keeps the same visual width at any resolution.
// [ASSUMED] One bevel per frame: the first enabled layer whose On slot is 1 (chosen on the host, passed in u_srcW). Later layers' bevel blocks are ignored.
//
// FLAT-AREA NOTE (spec behaviour, kept): with N = (0, 0, 1) the formulas give diffuse = L.z (0.81 at the defaults) and specular ~0.096 * gloss, so a
// completely flat area is ~19 % darker and gets ~+0.19 white at the defaults. The two constants below switch that off (1.0) if the owner wants untouched
// areas to stay exactly as they are. 0.0 = the formulas exactly as specified.
// =============================================================================
const float BV_SOBEL_NORM = 0.25;
const float BV_FLAT_DIFFUSE_COMP = 0.0;   // 1.0 = divide diffuse by its flat-surface value (flat areas keep their brightness)
const float BV_FLAT_SPEC_COMP = 0.0;      // 1.0 = subtract the flat-surface specular (flat areas get no gloss)

void executeBevelLuma(ivec2 coord, int width, int height) {
    int pixelIndex = coord.y * width + coord.x;
    out_pixels[pixelIndex] = floatBitsToUint(luma(display_px[pixelIndex].rgb));
}

float bevelLuma(ivec2 c, int width, int height) {
    c = clamp(c, ivec2(0), ivec2(width - 1, height - 1));
    return uintBitsToFloat(out_pixels[c.y * width + c.x]);
}

void executeMetallicBevel(ivec2 coord, int width, int height) {
    int pixelIndex = coord.y * width + coord.x;
    int bb = clamp(u_srcW, 0, 9) * 16;
    float mixAmt = clamp(bevel[bb + 6], 0.0, 1.0);
    if (bevel[bb] < 0.5 || mixAmt <= 0.0001) return;   // dispatch-uniform for the whole frame: the host only runs this pass when a layer has it on

    float intensity = clamp(bevel[bb + 1], 0.0, 10.0);
    float gloss = clamp(bevel[bb + 2], 0.0, 8.0);
    float shininess = clamp(bevel[bb + 3], 1.0, 256.0);
    vec2 lightXY = clamp(vec2(bevel[bb + 4], bevel[bb + 5]), vec2(-1.0), vec2(1.0));

    // 3x3 grid, luma only (centre tap has Sobel weight 0)
    int st = max(gEdgeStep, 1);
    float tl = bevelLuma(coord + ivec2(-st, -st), width, height);
    float tc = bevelLuma(coord + ivec2( 0, -st), width, height);
    float tr = bevelLuma(coord + ivec2( st, -st), width, height);
    float ml = bevelLuma(coord + ivec2(-st,  0), width, height);
    float mr = bevelLuma(coord + ivec2( st,  0), width, height);
    float bl = bevelLuma(coord + ivec2(-st,  st), width, height);
    float bc = bevelLuma(coord + ivec2( 0,  st), width, height);
    float br = bevelLuma(coord + ivec2( st,  st), width, height);

    float dH_dX = ((tr + 2.0 * mr + br) - (tl + 2.0 * ml + bl)) * BV_SOBEL_NORM;
    float dH_dY = ((bl + 2.0 * bc + br) - (tl + 2.0 * tc + tr)) * BV_SOBEL_NORM;   // rows grow downward

    vec3 N = normalize(vec3(-dH_dX * intensity, -dH_dY * intensity, 1.0));
    vec3 Ldir = normalize(vec3(lightXY.x, -lightXY.y, 0.7));                        // +Light Y = light from the top of the screen
    vec3 Hdir = normalize(Ldir + vec3(0.0, 0.0, 1.0));

    float diffuse = max(dot(N, Ldir), 0.5);
    diffuse /= mix(1.0, max(Ldir.z, 0.5), BV_FLAT_DIFFUSE_COMP);
    float spec = pow(max(dot(N, Hdir), 0.0), shininess);
    spec = max(spec - BV_FLAT_SPEC_COMP * pow(max(Hdir.z, 0.0), shininess), 0.0);

    vec3 base = display_px[pixelIndex].rgb;
    vec3 lit = base * diffuse + vec3(spec * gloss);
    display_px[pixelIndex] = vec4(clamp(mix(base, lit, mixAmt), 0.0, 1.0), 1.0);
}

// =============================================================================
// PASS 27 + PASS 28 (batch 14): MATHOPS and 4-WAY GRADIENT
//
// Both are pure per-pixel effects on the FINISHED display-referred image (display_px slot 0): each pixel reads and writes only itself, so they work
// in place in ONE pass each (no neighbours, no race, no scratch). Order: ... Time Slice (22) -> Bevel (25, 26) -> MathOps (27) -> 4-Way Gradient (28) -> Dither (23).
// If several layers have the effect on they are applied in LAYER ORDER (0 .. 9, disabled layers skipped), each on the result of the one before.
//
// PASS 27 MATHOPS, per layer block at mathops[layer * 16 + i]: 0 On, 1 Operation, 2 Value, 3 Channel, 4 Mix.
//   op 0 Add (c + v), 1 Subtract (c - v), 2 Multiply (c * v), 3 Divide (c / v), 4 Min, 5 Max, 6 Screen (1 - (1-c)(1-v)); result clamped to [0, 1];
//   channel 0 RGB, 1 R only, 2 G only, 3 B only (the other channels stay untouched); Mix blends the result with the input.
//   [ASSUMED] Divide uses max(v, 1e-4) so Value 0 gives white instead of a divide by zero.
//
// PASS 28 4-WAY GRADIENT, per layer block at grad4[layer * 16 + i]: 0 On, 1/2 P1 X/Y, 3 P1 colour (packed 0xRRGGBB as a float), 4/5/6 P2, 7/8/9 P3, 10/11/12 P4, 13 Mix.
//   INVERSE DISTANCE WEIGHTING: w_k = 1 / (distance_k + epsilon), colour = sum(w_k * colour_k) / sum(w_k), then mix(base, gradient, Mix).
//   [ASSUMED] distance is measured in UV space with the X difference multiplied by width / height (G4_ASPECT = 1.0), so the falloff is circular on a
//             16:9 frame instead of stretched. Set G4_ASPECT to 0.0 for the plain UV distance.
//   [ASSUMED] epsilon = 0.002 (G4_EPS): close to a control point the colour is almost exactly that point's colour, without a divide by zero.
//   [ASSUMED] UV (0, 0) is the TOP-LEFT of the frame (image rows grow downward). Colours are used as given in display space (no gamma conversion).
// =============================================================================
const float MO_EPS = 0.0001;
const float G4_EPS = 0.002;
const float G4_ASPECT = 1.0;

float mathOpsApply(int op, float c, float v) {
    if (op == 0) return c + v;
    if (op == 1) return c - v;
    if (op == 2) return c * v;
    if (op == 3) return c / max(v, MO_EPS);
    if (op == 4) return min(c, v);
    if (op == 5) return max(c, v);
    return 1.0 - (1.0 - c) * (1.0 - v);
}

void executeMathOps(ivec2 coord, int width, int height) {
    int pixelIndex = coord.y * width + coord.x;
    vec3 col = display_px[pixelIndex].rgb;
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int l = 0; l < total; l++) {
        if (layers[l].isEnabled < 0.5) continue;
        int mb = l * 16;
        if (mathops[mb] < 0.5) continue;
        float mixAmt = clamp(mathops[mb + 4], 0.0, 1.0);
        if (mixAmt <= 0.0001) continue;
        int op = clamp(int(mathops[mb + 1] + 0.5), 0, 6);
        float v = clamp(mathops[mb + 2], 0.0, 2.0);
        int ch = clamp(int(mathops[mb + 3] + 0.5), 0, 3);
        vec3 r = clamp(vec3(mathOpsApply(op, col.r, v), mathOpsApply(op, col.g, v), mathOpsApply(op, col.b, v)), vec3(0.0), vec3(1.0));
        if (ch == 1) r = vec3(r.r, col.g, col.b);
        else if (ch == 2) r = vec3(col.r, r.g, col.b);
        else if (ch == 3) r = vec3(col.r, col.g, r.b);
        col = mix(col, r, mixAmt);
    }
    display_px[pixelIndex] = vec4(col, 1.0);
}

vec3 g4Color(float packedRgb) {
    uint c = uint(clamp(packedRgb, 0.0, 16777215.0) + 0.5);
    return vec3(float((c >> 16u) & 255u), float((c >> 8u) & 255u), float(c & 255u)) / 255.0;
}

void executeGradient4(ivec2 coord, int width, int height) {
    int pixelIndex = coord.y * width + coord.x;
    vec3 col = display_px[pixelIndex].rgb;
    vec2 uv = (vec2(coord) + 0.5) / vec2(float(width), float(height));
    float aspect = mix(1.0, float(width) / float(max(height, 1)), G4_ASPECT);
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int l = 0; l < total; l++) {
        if (layers[l].isEnabled < 0.5) continue;
        int gb = l * 16;
        if (grad4[gb] < 0.5) continue;
        float mixAmt = clamp(grad4[gb + 13], 0.0, 1.0);
        if (mixAmt <= 0.0001) continue;
        vec3 sum = vec3(0.0);
        float wsum = 0.0;
        for (int k = 0; k < 4; k++) {
            int pb = gb + 1 + k * 3;
            vec2 dv = uv - clamp(vec2(grad4[pb], grad4[pb + 1]), vec2(0.0), vec2(1.0));
            dv.x *= aspect;
            float w = 1.0 / (length(dv) + G4_EPS);
            sum += g4Color(grad4[pb + 2]) * w;
            wsum += w;
        }
        col = mix(col, sum / wsum, mixAmt);
    }
    display_px[pixelIndex] = vec4(clamp(col, 0.0, 1.0), 1.0);
}

// =============================================================================
// v2.4 helpers (pass 0)
// =============================================================================
vec3 srcLinBilinear(vec2 p) {
    vec2 q = p - 0.5;
    ivec2 i0 = ivec2(floor(q));
    vec2 f = q - vec2(i0);
    vec3 a = srcLin(i0);
    vec3 b = srcLin(i0 + ivec2(1, 0));
    vec3 c = srcLin(i0 + ivec2(0, 1));
    vec3 d = srcLin(i0 + ivec2(1, 1));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Oklab hue/chroma/lightness skin-tone mask (same range the anime skin smoother uses)
float skinMaskOf(vec3 lin) {
    vec3 lab = linearRgbToOklab(lin);
    float ch = length(lab.yz);
    float h = atan(lab.z, lab.y);
    return smoothstep(0.30, 0.55, h) * (1.0 - smoothstep(1.20, 1.50, h))
         * smoothstep(0.015, 0.040, ch) * (1.0 - smoothstep(0.13, 0.19, ch))
         * smoothstep(0.42, 0.62, lab.x);
}

// =============================================================================
// BATCH 4 HELPERS (pass 0): curves v2, duotone, overall blend, edge softness, fog v2
// =============================================================================

// ---- CURVES v2: up to 8 free points per channel, monotone cubic (PCHIP) through them, so it can never overshoot,
//      fold back or invert. Channel 0 = RGB composite, 1 = R, 2 = G, 3 = B.
float cvX(int li, int ch, int k) { return cv[li].c[ch * 18 + 1 + 2 * k]; }
float cvY(int li, int ch, int k) { return cv[li].c[ch * 18 + 2 + 2 * k]; }
float cvSlope(int li, int ch, int k, int n) {
    if (k == 0) return (cvY(li, ch, 1) - cvY(li, ch, 0)) / max(cvX(li, ch, 1) - cvX(li, ch, 0), 1e-4);
    if (k == n - 1) return (cvY(li, ch, k) - cvY(li, ch, k - 1)) / max(cvX(li, ch, k) - cvX(li, ch, k - 1), 1e-4);
    float h0 = max(cvX(li, ch, k) - cvX(li, ch, k - 1), 1e-4);
    float h1 = max(cvX(li, ch, k + 1) - cvX(li, ch, k), 1e-4);
    float d0 = (cvY(li, ch, k) - cvY(li, ch, k - 1)) / h0;
    float d1 = (cvY(li, ch, k + 1) - cvY(li, ch, k)) / h1;
    if (d0 * d1 <= 0.0) return 0.0;
    float w1 = 2.0 * h1 + h0;
    float w2 = h1 + 2.0 * h0;
    return (w1 + w2) / (w1 / d0 + w2 / d1);
}
float cvEval(int li, int ch, float x) {
    x = clamp(x, 0.0, 1.0);
    int n = clamp(int(cv[li].c[ch * 18] + 0.5), 0, 8);
    if (n < 2) return x;
    int seg = 0;
    for (int k = 0; k < 7; k++) {
        if (k + 1 < n && x >= cvX(li, ch, k + 1)) seg = k + 1;
    }
    seg = min(seg, n - 2);
    float x0 = cvX(li, ch, seg);
    float x1 = cvX(li, ch, seg + 1);
    float h = max(x1 - x0, 1e-4);
    float t = clamp((x - x0) / h, 0.0, 1.0);
    float y0 = cvY(li, ch, seg);
    float y1 = cvY(li, ch, seg + 1);
    float m0 = cvSlope(li, ch, seg, n) * h;
    float m1 = cvSlope(li, ch, seg + 1, n) * h;
    float t2 = t * t;
    float t3 = t2 * t;
    float y = (2.0 * t3 - 3.0 * t2 + 1.0) * y0 + (t3 - 2.0 * t2 + t) * m0 + (-2.0 * t3 + 3.0 * t2) * y1 + (t3 - t2) * m1;
    return clamp(y, 0.0, 1.0);
}
// Applied in display (sRGB) space like After Effects. Values above 1.0 (HDR) are carried over untouched, so a curve
// never clips highlights that the grade pushed beyond white.
vec3 fxCurves(vec3 col, int li) {
    bool mOn = cv[li].c[0] > 1.5;
    bool rOn = cv[li].c[18] > 1.5;
    bool gOn = cv[li].c[36] > 1.5;
    bool bOn = cv[li].c[54] > 1.5;
    if (!(mOn || rOn || gOn || bOn)) return col;
    vec3 over = max(col - 1.0, vec3(0.0));
    vec3 e = linearToSrgb(clamp(col, 0.0, 1.0));
    if (mOn) e = vec3(cvEval(li, 0, e.r), cvEval(li, 0, e.g), cvEval(li, 0, e.b));
    if (rOn) e.r = cvEval(li, 1, e.r);
    if (gOn) e.g = cvEval(li, 2, e.g);
    if (bOn) e.b = cvEval(li, 3, e.b);
    return srgbToLinear(e) + over;
}

// ---- DUOTONE: luminance (or Oklab lightness / brightest channel) -> shadow / [mid] / highlight ramp, built in Oklab so
//      the ramp is a clean perceptual gradient (no muddy midpoint), with contrast, gamma, posterise, invert, keep-lightness, mix.
vec3 fxDuotone(vec3 col, int li) {
    float mode = fx[li].f[41];
    vec3 over = max(col - 1.0, vec3(0.0));
    vec3 c = clamp(col, 0.0, 1.0);
    vec3 labO = linearRgbToOklab(c);
    float t;
    if (mode < 0.5) t = linearToSrgb(luma(c));
    else if (mode < 1.5) t = clamp(labO.x, 0.0, 1.0);
    else t = linearToSrgb(max(c.r, max(c.g, c.b)));
    float k = clamp(fx[li].f[38], -1.0, 1.0);
    float cf = (k >= 0.0) ? (1.0 + k * 2.0) : (1.0 + k * 0.8);
    t = clamp((t - 0.5) * cf + 0.5, 0.0, 1.0);
    t = pow(t, 1.0 / max(fx[li].f[39], 0.05));
    float bands = fx[li].f[44];
    if (bands > 1.5) t = floor(t * bands + 0.5) / bands;
    if (fx[li].f[43] > 0.5) t = 1.0 - t;
    vec3 ls = linearRgbToOklab(fxUnpackCol(fx[li].f[34]));
    vec3 lh = linearRgbToOklab(fxUnpackCol(fx[li].f[35]));
    vec3 lab;
    if (fx[li].f[36] >= 0.0) {
        vec3 lm = linearRgbToOklab(fxUnpackCol(fx[li].f[36]));
        float mp = clamp(fx[li].f[37], 0.05, 0.95);
        lab = (t < mp) ? mix(ls, lm, t / mp) : mix(lm, lh, (t - mp) / (1.0 - mp));
    } else {
        lab = mix(ls, lh, t);
    }
    lab.x = mix(lab.x, labO.x, clamp(fx[li].f[42], 0.0, 1.0));
    vec3 outc = max(oklabToLinearRgb(lab), vec3(0.0));
    float gain = clamp(luma(col) / max(luma(c), 1e-4), 1.0, 8.0);
    return mix(col, outc * gain, clamp(fx[li].f[40], 0.0, 1.0));
}

// ---- OVERALL BLEND (two colour regions -> one coherent look). Regions are picked by HUE (two hue centres + width).
//      Mode 0 UNIFY: both regions are pulled to the shared in-between hue.
//      Mode 1 GRADIENT: each pixel is pulled to the LOCAL average hue of the regions around it, so the border between
//      e.g. a red side and a blue side melts into a smooth purple transition instead of a hard seam.
vec3 fxRgb2Hsv(vec3 c) {
    vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g));
    vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r));
    float d = q.x - min(q.w, q.y);
    return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + 1e-10)), d / (q.x + 1e-10), q.x);
}
vec3 fxHsv2Rgb(vec3 c) {
    vec3 p = abs(fract(c.xxx + vec3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return c.z * mix(vec3(1.0), clamp(p - 1.0, 0.0, 1.0), c.y);
}
float fxHueDiff(float a, float b) { return fract(a - b + 0.5) - 0.5; }
float fxRegionW(vec3 hsv, float hA, float hB, float wid, float soft) {
    float inner = wid * (1.0 - clamp(soft, 0.0, 0.95));
    float wA = 1.0 - smoothstep(inner, wid, abs(fxHueDiff(hsv.x, hA)));
    float wB = 1.0 - smoothstep(inner, wid, abs(fxHueDiff(hsv.x, hB)));
    return max(wA, wB) * smoothstep(0.04, 0.22, hsv.y) * smoothstep(0.02, 0.12, hsv.z);
}
vec3 fxOverallBlend(vec3 col, int li, ivec2 coord, int height) {
    float str = clamp(fx[li].f[45], 0.0, 1.0);
    float hA = fx[li].f[46];
    float hB = fx[li].f[47];
    float wid = clamp(fx[li].f[48], 0.02, 0.5);
    float soft = clamp(fx[li].f[50], 0.0, 1.0);
    vec3 over = max(col - 1.0, vec3(0.0));
    vec3 c = clamp(col, 0.0, 1.0);
    vec3 hsv = fxRgb2Hsv(linearToSrgb(c));
    float w = fxRegionW(hsv, hA, hB, wid, soft);
    if (w < 0.002) return col;
    float hT;
    if (fx[li].f[49] < 0.5) {
        hT = hA + 0.5 * fxHueDiff(hB, hA);                       // circular mean of the two region hues
    } else {
        float rad = (0.012 + soft * 0.09) * float(height) * 0.5;
        float rot = hash12(vec2(coord) + 5.3) * 6.2831853;
        vec2 acc = vec2(0.0);
        float wsum = 0.0;
        for (int k = 0; k < 16; k++) {
            float fr = (float(k) + 0.5) / 16.0;
            float ang = rot + float(k) * 2.39996323;
            vec2 o = vec2(cos(ang), sin(ang)) * sqrt(fr) * rad;
            vec3 sc = clamp(srcLinBilinear(vec2(coord) + 0.5 + o), 0.0, 1.0);
            vec3 sh = fxRgb2Hsv(linearToSrgb(sc));
            float sw = fxRegionW(sh, hA, hB, wid, soft);
            acc += vec2(cos(sh.x * 6.2831853), sin(sh.x * 6.2831853)) * sw;
            wsum += sw;
        }
        float hAvg = (wsum > 0.05) ? atan(acc.y, acc.x) / 6.2831853 : hsv.x;
        hT = hAvg;
    }
    float k = str * w;
    vec3 o = hsv;
    o.x = fract(hsv.x + fxHueDiff(hT, hsv.x) * k + 1.0);
    o.y = clamp(hsv.y * mix(1.0, max(fx[li].f[52], 0.0), k), 0.0, 1.0);
    vec3 outc = srgbToLinear(fxHsv2Rgb(o));
    float keep = clamp(fx[li].f[51], 0.0, 1.0);
    outc *= mix(1.0, luma(c) / max(luma(outc), 1e-4), keep);
    return mix(col, outc + over, 1.0);
}

// ---- EDGE SOFTNESS: softens the transition at edges only (edge mask from the source gradient), with a direction.
//      X / Y shift the soft kernel along that axis (so the softening leans to one side of every edge), Z is a depth bias
//      (+ = bright / near areas soften more, - = dark / far areas), width = kernel size, falloff = how selective the edge
//      mask is, each axis has its own on / off toggle.
vec3 fxEdgeSoftness(vec3 col, int li, ivec2 coord, float edgeMask, float resScale) {
    float amt = clamp(fx[li].f[60], 0.0, 1.0);
    if (amt < 0.01) return col;
    vec2 dir = vec2(fx[li].f[61] * step(0.5, fx[li].f[65]), fx[li].f[62] * step(0.5, fx[li].f[66]));
    float z = fx[li].f[63] * step(0.5, fx[li].f[67]);
    float fall = clamp(fx[li].f[64], 0.0, 1.0);
    float width = max(fx[li].f[68], 0.05);
    float m = pow(smoothstep(0.02, 0.35, edgeMask), 1.0 + fall * 2.5);
    float lum = luma(col);
    m *= clamp(1.0 + z * (smoothstep(0.1, 1.0, lum) * 2.0 - 1.0), 0.0, 2.0);
    if (m < 0.01) return col;
    float rad = (1.0 + width * 7.0) * resScale;
    vec2 shift = dir * rad * 0.8;
    vec3 acc = vec3(0.0);
    float ws = 0.0;
    float rot = hash12(vec2(coord) + 9.1) * 6.2831853;
    for (int k = 0; k < 14; k++) {
        float fr = (float(k) + 0.5) / 14.0;
        float ang = rot + float(k) * 2.39996323;
        vec2 o = vec2(cos(ang), sin(ang)) * sqrt(fr) * rad + shift;
        float w = 1.0 - 0.5 * fr;
        acc += srcLinBilinear(vec2(coord) + 0.5 + o) * w;
        ws += w;
    }
    vec3 soft = acc / ws;
    return mix(col, soft, clamp(m * amt, 0.0, 1.0));
}

// ---- FOG v2: real volumetric-style fog. Optical depth = density x (domain-warped fbm cloud) x (height profile) with
//      per-channel Beer-Lambert extinction; light scatters INTO the fog from the bright parts of the scene (spiral
//      gather, radius = spread) so fog visibly spreads out of highlights; colour = chosen tint blended with the scene's
//      own scattered light; optional reaction to image brightness (bright sources punch through the fog).
vec3 fxFog(vec3 col, int li, ivec2 coord, vec2 uvN, int width, int height) {
    float dens = clamp(fx[li].f[53], 0.0, 1.0);
    if (dens < 0.01) return col;
    float spread = clamp(fx[li].f[54], 0.0, 1.0);
    float react = clamp(fx[li].f[56], 0.0, 1.0);
    float scaleN = clamp(fx[li].f[57], 0.0, 1.0);
    float hb = clamp(fx[li].f[58], 0.0, 1.0);
    float drift = fx[li].f[59];
    float asp = float(width) / float(max(height, 1));
    vec2 p = vec2(uvN.x * asp, uvN.y) * mix(1.4, 6.5, scaleN) + vec2(u_time * 0.03 * drift, u_time * 0.011 * drift);
    vec2 wv = vec2(fbm(p + 3.1), fbm(p + 7.7));
    float n = smoothstep(0.22, 0.88, fbm(p + 1.9 * (wv - 0.5)));
    float ground = smoothstep(0.05, 1.0, uvN.y);
    float sky = 1.0 - smoothstep(0.0, 0.95, uvN.y);
    float prof = (hb < 0.5) ? mix(1.0, ground, (0.5 - hb) * 2.0) : mix(1.0, sky, (hb - 0.5) * 2.0);
    float lumC = luma(clamp(col, 0.0, 4.0));
    float punch = 1.0 - react * 0.65 * smoothstep(0.35, 1.1, lumC);
    float tau = dens * 3.2 * (0.30 + 1.25 * n) * (0.25 + 0.75 * prof) * punch;
    vec3 T = exp(-tau * vec3(1.0, 1.03, 1.08));
    float rad = (0.01 + spread * 0.20) * float(height);
    vec3 sc = vec3(0.0);
    float rot = hash12(vec2(coord) + 2.2) * 6.2831853;
    for (int k = 0; k < 14; k++) {
        float fr = (float(k) + 0.5) / 14.0;
        float ang = rot + float(k) * 2.39996323;
        vec2 o = vec2(cos(ang), sin(ang)) * sqrt(fr) * rad;
        sc += srcLinBilinear(vec2(coord) + 0.5 + o);
    }
    sc /= 14.0;
    vec3 userCol = fxUnpackCol(fx[li].f[55]);
    float scL = luma(sc);
    vec3 inscatter = mix(userCol, sc * (userCol / max(luma(userCol), 1e-3)), 0.35) * (0.30 + 0.95 * smoothstep(0.0, 0.9, scL)) + userCol * 0.15;
    return col * T + inscatter * (vec3(1.0) - T);
}

// =============================================================================
// MAIN
// =============================================================================

// =============================================================================
// GRADIENT MAP FUNCTIONS
// =============================================================================
vec3 gmapUnpack(float f) {
    uint v = uint(f + 0.5);
    return vec3(float((v >> 16u) & 255u), float((v >> 8u) & 255u), float(v & 255u)) / 255.0;
}

vec3 gmapRamp(GMapData G, float t) {
    int n = int(clamp(G.stopCount + 0.5, 2.0, 6.0));
    t = clamp(t, 0.0, 1.0);
    vec3 c = gmapUnpack(G.stopCol[0]);
    if (t <= G.stopPos[0]) return c;
    for (int k = 1; k < 6; k++) {
        if (k >= n) break;
        float p0 = G.stopPos[k - 1];
        float p1 = G.stopPos[k];
        vec3 c1 = gmapUnpack(G.stopCol[k]);
        if (t <= p1) {
            vec3 c0 = gmapUnpack(G.stopCol[k - 1]);
            return mix(c0, c1, clamp((t - p0) / max(p1 - p0, 1e-4), 0.0, 1.0));
        }
        c = c1;
    }
    return c;
}

float gmapLumaAt(ivec2 c) {
    return linearToSrgb(luma(srcLin(c)));
}

// Types: 0 Luma, 1 Linear, 2 Corner (top-right -> bottom-left), 3 Radial, 4 Angular, 5 Edge, 6 Split Tone,
//        7 Posterized, 8 Checker, 9 Stripes, 10 Halftone, 11 Noise, 12 Luma + Linear
float gradientMapField(GMapData G, ivec2 coord, vec2 uvN, int width, int height, float lumaG) {
    int type = int(G.type + 0.5);
    float aspect = float(width) / float(max(height, 1));
    vec2 p = uvN - 0.5;
    float cellPx = max(2.0, mix(4.0, 64.0, clamp(G.patternSize, 0.0, 1.0)) * max(gRes, 1.0));
    float t = lumaG;

    if (type == 1 || type == 2 || type == 12) {
        float a = (type == 2) ? 2.3561945 : G.angle;
        vec2 dir = vec2(cos(a), sin(a));
        float lin = dot(p, dir) / max(abs(dir.x) + abs(dir.y), 1e-4) * G.scale + 0.5;
        t = (type == 12) ? (lumaG * 0.5 + clamp(lin, 0.0, 1.0) * 0.5) : lin;
    } else if (type == 3) {
        vec2 dd = uvN - vec2(G.centerX, G.centerY);
        dd.x *= aspect;
        t = length(dd) * G.scale * 1.4;
    } else if (type == 4) {
        vec2 dd = uvN - vec2(G.centerX, G.centerY);
        dd.x *= aspect;
        t = fract(atan(dd.y, dd.x) / 6.2831853 + 0.5 + G.angle / 6.2831853);
    } else if (type == 5) {
        int st = max(1, int(round(mix(1.0, 4.0, clamp(G.edgeWidth, 0.0, 1.0)) * gRes)));
        float gx = gmapLumaAt(coord + ivec2(st, 0)) - gmapLumaAt(coord - ivec2(st, 0));
        float gy = gmapLumaAt(coord + ivec2(0, st)) - gmapLumaAt(coord - ivec2(0, st));
        t = clamp(length(vec2(gx, gy)) * 3.0 * G.scale, 0.0, 1.0);
    } else if (type == 6) {
        float soft = mix(0.03, 0.5, clamp(G.edgeWidth, 0.0, 1.0));
        t = smoothstep(0.5 - soft, 0.5 + soft, lumaG);
    } else if (type == 7) {
        float nb = max(G.bands, 2.0);
        t = floor(clamp(lumaG, 0.0, 0.999) * nb) / (nb - 1.0);
    } else if (type == 8) {
        vec2 cell = floor(vec2(coord) / cellPx);
        float chk = mod(cell.x + cell.y, 2.0);
        t = clamp(lumaG * 0.7 + chk * 0.3, 0.0, 1.0);
    } else if (type == 9) {
        vec2 dir = vec2(cos(G.angle), sin(G.angle));
        float proj = dot(vec2(coord), dir) / cellPx;
        float tri = abs(fract(proj) * 2.0 - 1.0);
        t = clamp(lumaG * 0.7 + tri * 0.3, 0.0, 1.0);
    } else if (type == 10) {
        vec2 f = fract(vec2(coord) / cellPx) - 0.5;
        float d = length(f) * 2.0;
        float dotv = smoothstep(0.12, -0.12, d - sqrt(clamp(lumaG, 0.0, 1.0)) * 1.15);
        t = mix(lumaG, dotv, 0.6);
    } else if (type == 11) {
        vec2 q = vec2(coord) / cellPx;
        vec2 i = floor(q);
        vec2 f = fract(q);
        f = f * f * (3.0 - 2.0 * f);
        float n = mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), f.x),
                      mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), f.x), f.y);
        t = clamp(lumaG * 0.6 + n * 0.4, 0.0, 1.0);
    }

    if (G.invert > 0.5) t = 1.0 - t;
    t = pow(clamp(t, 0.0, 1.0), max(G.curve, 0.05));
    t = clamp((t - G.rangeLo) / max(G.rangeHi - G.rangeLo, 1e-3), 0.0, 1.0);
    return t;
}

vec3 gradientMapApply(vec3 col, GMapData G, ivec2 coord, vec2 uvN, int width, int height) {
    float lumaG = linearToSrgb(luma(col));
    float t = gradientMapField(G, coord, uvN, width, height, lumaG);
    // v4: a real overlay. The ramp colour (hue + chroma) replaces the image colour in Oklab; Luma Keep only decides how much of
    // the ORIGINAL lightness survives (1 = pure colourise that keeps every detail, 0 = full tonal remap through the gradient).
    // The old version scaled the ramp by a luma ratio and capped strength at 0.65, which is what made it read as a tint.
    vec3 over = max(col - 1.0, vec3(0.0));
    vec3 cc = clamp(col, 0.0, 1.0);
    vec3 mapped = srgbToLinear(gmapRamp(G, t));
    vec3 labM = linearRgbToOklab(mapped);
    vec3 labC = linearRgbToOklab(cc);
    labM.x = mix(labM.x, labC.x, clamp(G.lumaKeep, 0.0, 1.0));
    mapped = max(oklabToLinearRgb(labM), vec3(0.0));
    mapped *= clamp(luma(col) / max(luma(cc), 1e-4), 1.0, 8.0);   // keep HDR highlights the grade pushed above white
    return mix(col, mapped, clamp(G.strength, 0.0, 1.0));
}


// =============================================================================
// TEXT SUITE (batch 5) - personal block, soft mask, continuous glow, real-reflection metal / silk, vector warp
// =============================================================================
float tfx(int i, float d) { return (tx[0] > 0.5) ? tx[i] : d; }

// Letter coverage with an optional 5-tap softener: removes ragged / aliased edges. soften 0 = raw mask.
float textFillSoft(ivec2 p, float soften, float tpx) {
    float c0 = textFillAt(p);
    if (soften < 0.02) return c0;
    int st = int(max(1.0, round((0.6 + 1.6 * soften) * tpx)));
    float sum = c0 * 2.0
              + textFillAt(p + ivec2(st, 0)) + textFillAt(p - ivec2(st, 0))
              + textFillAt(p + ivec2(0, st)) + textFillAt(p - ivec2(0, st));
    return mix(c0, sum / 6.0, clamp(soften * 1.4, 0.0, 1.0));
}

// Glow field of the letter mask = weighted mean of the mask over a disk. Taps follow a golden-angle (Vogel) spiral with an
// inverse-square style weight, so the result is ONE continuous smooth falloff: there are no rings and no offset copies.
// "fat" taps average a small cross so a wide, sparse disk stays smooth on thin strokes.
float textGlowDisk(ivec2 p, vec2 off, float radiusPx, int taps, float profK, float rot, bool fat) {
    float acc = 0.0;
    float accW = 0.0;
    const float GA = 2.39996323;
    for (int i = 0; i < taps; i++) {
        float fi = (float(i) + 0.5) / float(taps);
        float x = sqrt(fi);
        float r = radiusPx * x;
        float a = float(i) * GA + rot;
        vec2 c = vec2(p) - off + vec2(cos(a), sin(a)) * r;
        float w = 1.0 / (1.0 + profK * x * x * 6.0);
        float m;
        if (fat) {
            float sp = max(1.0, r * 0.32);
            m = 0.25 * (textFillAt(ivec2(round(c + vec2(sp, 0.0)))) + textFillAt(ivec2(round(c - vec2(sp, 0.0))))
                      + textFillAt(ivec2(round(c + vec2(0.0, sp)))) + textFillAt(ivec2(round(c - vec2(0.0, sp)))));
        } else {
            m = textFillAt(ivec2(round(c)));
        }
        acc += w * m;
        accW += w;
    }
    return acc / max(accW, 1e-4);
}

// Procedural fill pattern, 0..1. type 1 pixel mosaic, 2 scanlines, 3 checker, 4 halftone dots, 5 grain
float textPattern(vec2 pxPos, float type, float cell, float angle) {
    float ca = cos(angle);
    float sa = sin(angle);
    vec2 q = vec2(ca * pxPos.x + sa * pxPos.y, -sa * pxPos.x + ca * pxPos.y) / max(cell, 1.0);
    if (type < 1.5) {
        return hash12(floor(q));
    } else if (type < 2.5) {
        return 0.5 + 0.5 * sin(q.y * 6.2831853);
    } else if (type < 3.5) {
        vec2 f = floor(q);
        return mod(f.x + f.y, 2.0);
    } else if (type < 4.5) {
        return 1.0 - smoothstep(0.28, 0.42, length(fract(q) - 0.5));
    }
    return hash12(floor(pxPos));
}

// Metal / silk face from REAL reflection maths: a pseudo surface normal (rounded tube across the stroke + the bevel slope at
// the letter edge) is reflected into a sky / horizon / ground environment, weighted by a Schlick-style Fresnel, plus
// directional highlight bands, a dark diffuse body and a soft ambient reflection. Silk widens the environment blur and adds a
// Kajiya-Kay anisotropic sheen along the brush direction. q = position inside the box, 0..1 on both axes.
vec3 textMetalFace(float vText, vec2 outN, float edgeness, vec2 q, vec3 skyRef, vec3 gndRef,
                   vec3 tintHi, vec3 bodyCol, float style, float roundK, float bands, float bandAng,
                   float bandSoft, float bandStr, float aniso, float bodyDark, float ambient, float fres) {
    vec2 nxy = outN * clamp(edgeness, 0.0, 1.0) * 0.95;
    nxy.y += (vText * 2.0 - 1.0) * roundK * 0.75;
    vec3 N = normalize(vec3(nxy, 1.0));
    float cosT = N.z;                                          // N . V with the view straight on
    vec3 R = vec3(2.0 * cosT * N.xy, 2.0 * cosT * cosT - 1.0); // reflect(-V, N)
    float v = clamp(0.5 + 0.5 * R.y, 0.0, 1.0);                // 0 = sky (up), 1 = ground (down)
    float blurW = mix(0.0, 0.16, style) + 0.08 * clamp(bandSoft, 0.0, 1.0);
    vec3 env = (chromeBands(clamp(v - blurW, 0.0, 1.0), skyRef, gndRef)
              + 2.0 * chromeBands(v, skyRef, gndRef)
              + chromeBands(clamp(v + blurW, 0.0, 1.0), skyRef, gndRef)) * 0.25;
    float F = 0.55 + 0.45 * clamp(fres, 0.0, 1.0) * pow(clamp(1.0 - cosT, 0.0, 1.0), 4.0);

    float ca = cos(bandAng);
    float sa = sin(bandAng);
    float along = dot(q, vec2(ca, sa));
    float phase = along * max(bands, 0.1) + (vText - 0.5) * 0.45 * roundK;
    float wv = 0.5 + 0.5 * cos(6.2831853 * phase);
    float band = pow(wv, mix(16.0, 1.4, clamp(bandSoft, 0.0, 1.0)));

    vec3 Lh = normalize(vec3(-0.45, -0.60, 0.65));
    vec3 H = normalize(Lh + vec3(0.0, 0.0, 1.0));
    vec3 Hn = normalize(vec3(H.xy + N.xy * 0.9, H.z));
    float th = dot(vec3(-sa, ca, 0.0), Hn);                    // brush runs perpendicular to the band sweep
    float kk = pow(sqrt(max(1.0 - th * th, 0.0)), mix(48.0, 7.0, clamp(bandSoft, 0.0, 1.0)));

    vec3 refl = mix(vec3(1.0), tintHi, 0.9);
    vec3 bandCol = mix(tintHi, vec3(1.0), 0.55);
    vec3 col = bodyCol * (1.0 - clamp(bodyDark, 0.0, 1.0)) * 0.30;               // darker body
    col += env * refl * F * (0.75 + 0.5 * (1.0 - style));                        // reflection
    col += skyRef * refl * clamp(ambient, 0.0, 1.0) * 0.30 * (1.0 - F);          // soft ambient reflection
    col += bandCol * band * clamp(bandStr, 0.0, 2.0) * mix(0.85, 0.45, style);   // directional highlight bands
    col += bandCol * kk * clamp(aniso, 0.0, 1.0) * style * 0.80;                 // silk sheen
    return col;
}

// ---- vector mode: smooth displacement field from up to 16 control points (rest + current, in box units) ----
vec2 textWarpDisp(vec2 u, float aspect, float sigma, float amount, int count) {
    vec2 acc = vec2(0.0);
    float wsum = 0.0;
    for (int i = 0; i < 16; i++) {
        if (i >= count) break;
        int b = 48 + i * 4;
        vec2 r = vec2(tx[b], tx[b + 1]);
        vec2 c = vec2(tx[b + 2], tx[b + 3]);
        vec2 dd = (u - r) * vec2(aspect, 1.0);
        float w = exp(-dot(dd, dd) / (2.0 * sigma * sigma));
        acc += w * (c - r);
        wsum += w;
    }
    return amount * acc / max(wsum, 1.0);   // far from every point the weight sum drops below 1 and the warp fades to nothing
}

vec4 compBilinear(vec2 posPx, int w, int h) {
    vec2 p = posPx - 0.5;
    vec2 f = fract(p);
    ivec2 i0 = ivec2(floor(p));
    ivec2 mx = ivec2(w - 1, h - 1);
    ivec2 a = clamp(i0, ivec2(0), mx);
    ivec2 b = clamp(i0 + ivec2(1, 0), ivec2(0), mx);
    ivec2 c = clamp(i0 + ivec2(0, 1), ivec2(0), mx);
    ivec2 d = clamp(i0 + ivec2(1, 1), ivec2(0), mx);
    vec4 v00 = unpackComposite(a.y * w + a.x);
    vec4 v10 = unpackComposite(b.y * w + b.x);
    vec4 v01 = unpackComposite(c.y * w + c.x);
    vec4 v11 = unpackComposite(d.y * w + d.x);
    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y);
}

// PASS 11: backward-warps the graded composite (text, its bevel and its glow travel together, nothing is left behind).
// Reads temp_composite, writes the result into out_pixels (scratch: pass 6 overwrites every pixel of it later).
void executeTextWarp(ivec2 coord, int width, int height) {
    int idx = coord.y * width + coord.x;
    vec4 res = unpackComposite(idx);
    if (u_textSuiteEnabled > 0.5 && tx[0] > 0.5 && tx[40] > 0.5 && tx[41] > 0.5) {
        vec2 boxMin = vec2(u_textBoxX, u_textBoxY);
        vec2 boxSize = max(vec2(u_textBoxW, u_textBoxH), vec2(1e-3));
        vec2 whPx = vec2(float(width), float(height));
        float aspect = (boxSize.x * whPx.x) / max(boxSize.y * whPx.y, 1.0);
        float sigma = clamp(tx[42], 0.04, 2.0);
        float amount = clamp(tx[43], 0.0, 2.0);
        int count = int(clamp(tx[41], 0.0, 16.0));
        vec2 uvP = (vec2(coord) + 0.5) / whPx;
        float tMargin = max(0.03, 0.22 * boxSize.y);                // same margin the native row band uses
        vec2 qd = max(abs(uvP - (boxMin + boxSize * 0.5)) - boxSize * 0.5, vec2(0.0));
        float fade = 1.0 - smoothstep(0.0, tMargin, length(qd));
        if (fade > 0.0) {
            vec2 uq = uvP;
            for (int it = 0; it < 4; it++) {                         // invert q + D(q) = p by fixed-point iteration
                vec2 ub = (uq - boxMin) / boxSize;
                uq = uvP - textWarpDisp(ub, aspect, sigma, amount, count) * boxSize * fade;
            }
            res = compBilinear(uq * whPx, width, height);
        }
    }
    res.rgb = sanitize(res.rgb);
    out_pixels[idx * 2] = packHalf2x16(res.rg);
    out_pixels[idx * 2 + 1] = packHalf2x16(res.ba);
}

// PASS 12: scratch -> composite (separate pass so a band never reads rows that were already warped)
void executeTextWarpCopy(ivec2 coord, int width, int height) {
    int idx = coord.y * width + coord.x;
    temp_composite[idx * 2] = out_pixels[idx * 2];
    temp_composite[idx * 2 + 1] = out_pixels[idx * 2 + 1];
}

// =============================================================================
// BATCH 6 - VFX (bubbles / rain / particles) and SAPPHIRE (S_Glint, S_LightLeak)
//
//   PASS 13  VFX shade        composite -> out scratch   (full res, banded)
//   PASS 14  VFX copy-back    out scratch -> composite
//   PASS 15  S_Glint map      composite -> bloom L1 (1/4 res box-averaged highlight excess; only when a glint is on)
//   PASS 16  Sapphire gather  composite + bloom L1 -> out scratch (S_Glint rays + S_LightLeak)
//   PASS 17  Sapphire copy    out scratch -> composite
//   They run after the text warp (11/12) and BEFORE the bloom pyramid, so pass 1..9 / 6 start from a composite that
//   already contains bubbles / glints (glows, tonemap, LUT and dither then treat them like any other picture content).
//   Per-layer parameter blocks: vx[layer].v[i] (floats 4096 + l*64) and sx[layer].s[i] (floats 4736 + l*64).
//   Slot numbers match class Vfx / class Sap in vfx_slots.dart.
//   Per-effect opacity + custom blend follow the batch 4 pattern (fxMix / applyBlendMode, cb = LayerBlendMode index + 1).
//   Nothing here calls textGlowDisk or any text helper; glows are small analytic halos computed inside this block.
// =============================================================================

#define VXF(i) vx[li].v[i]
#define SXF(i) sx[li].s[i]

vec4 vfxRnd(vec2 c, float salt) {
    vec2 s = c + vec2(salt * 17.13, salt * 5.77);
    return vec4(hash12(s), hash12(s + vec2(31.7, 9.1)), hash12(s + vec2(71.3, 47.9)), hash12(s + vec2(113.9, 83.3)));
}

// Layer colour `layer` (already shaded) laid over `under` with coverage `a`. cb = 0: plain over; cb > 0: custom blend mode.
vec3 vfxBlend(vec3 under, vec3 layer, float a, float cb) {
    a = clamp(a, 0.0, 1.0);
    if (cb < 0.5) return mix(under, layer, a);
    return mix(under, applyBlendMode(under, max(layer, vec3(0.0)), int(cb - 0.5), 1.0, false), a);
}

// Light layer (glint / leak) over the picture. cb = 0: additive (defScreen = 0) or highlight-safe screen (defScreen = 1).
vec3 vfxLightMix(vec3 pre, vec3 layer, float op, float cb, float defScreen) {
    op = clamp(op, 0.0, 1.0);
    layer = max(layer, vec3(0.0));
    float cover = clamp(max(layer.r, max(layer.g, layer.b)), 0.0, 1.0);
    if (cb < 0.5) {
        vec3 post = (defScreen > 0.5) ? pre + layer * (1.0 - clamp(pre, vec3(0.0), vec3(1.0))) : pre + layer;
        return mix(pre, post, op);
    }
    return mix(pre, applyBlendMode(pre, layer, int(cb - 0.5), 1.0, false), cover * op);
}

// -----------------------------------------------------------------------------
// VFX: one layer. mode 1 = bubbles, 2 = rain, 3 = particles.
// Bubbles / particles live on a scrolling jittered grid (cells of 2.6 radii, <= 2 per cell, 3x3 cells tested per pixel),
// so there is no per-bubble loop over the whole frame and nothing depends on frame history: it is fully procedural.
// -----------------------------------------------------------------------------
vec3 vfxLayer(vec3 base, int li, ivec2 coord, int w, int h, float opEff) {
    float mode = VXF(0);
    float cb = VXF(2);
    float hpx = float(h);
    vec2 pP = vec2(coord) + 0.5;
    vec2 p = pP / hpx;                                   // frame-height units (resolution independent)
    float seed = VXF(13);
    float quality = clamp(VXF(12), 0.0, 1.0);
    int nLayers = 1 + ((quality > 0.34) ? 1 : 0) + ((quality > 0.67) ? 1 : 0);
    int nSlots = (quality > 0.5) ? 2 : 1;
    bool hiQ = quality > 0.5;
    float T = u_time * VXF(6) * 0.3 + VXF(7) * 20.0;
    float dens = clamp(VXF(5), 0.0, 1.0) * 0.9;
    float scaleV = clamp(VXF(4), 0.0, 1.0);
    float wander = clamp(VXF(11), 0.0, 1.0);
    float hard = clamp(VXF(14), 0.0, 1.0);
    float rough = clamp(VXF(15), 0.0, 1.0);
    float shA = VXF(16);
    float gA = VXF(19);
    float tintA = clamp(VXF(22), 0.0, 1.0);
    vec3 tintC = fxUnpackCol(VXF(21));
    float refr = clamp(VXF(23), 0.0, 1.0);
    float R0 = mix(0.010, 0.10, clamp(VXF(3), 0.0, 1.0));
    bool isRain = (mode > 1.5 && mode < 2.5);
    bool isPart = (mode > 2.5);
    float ang = radians(isRain ? VXF(30) : VXF(8));
    vec2 dirV = vec2(cos(ang), -sin(ang));               // screen direction (y down); 0 deg = right, 90 deg = up
    float axisM = VXF(10);
    if (axisM > 0.5 && axisM < 1.5) dirV = vec2((dirV.x >= 0.0) ? 1.0 : -1.0, 0.0);
    else if (axisM > 1.5) dirV = vec2(0.0, (dirV.y >= 0.0) ? 1.0 : -1.0);
    float dirM = VXF(9);                                 // 0 forward, 1 reverse, 2 orbit (circle in place)
    float travel = (dirM > 1.5) ? 0.0 : ((dirM > 0.5) ? -1.0 : 1.0);
    float sAng = radians(VXF(18));
    vec2 sdir = vec2(cos(sAng), -sin(sAng));             // direction the shadow falls
    vec2 ldir = -sdir;                                   // direction towards the light
    float maskMode = VXF(44);
    float maskThr = VXF(45);
    float maskSf = max(VXF(46) * 0.5, 0.01);
    float pickup = clamp(VXF(47), 0.0, 1.0);
    float gr = 0.12 + clamp(VXF(20), 0.0, 1.0) * 0.85;   // glow halo size in radii
    vec3 col = base;

    for (int L = 0; L < 3; L++) {
        if (L >= nLayers) break;
        float lf = float(L);
        float lsc = (L == 0) ? 1.0 : ((L == 1) ? 0.62 : 0.40);
        float lspd = (L == 0) ? 1.0 : ((L == 1) ? 0.75 : 0.55);
        float lseed = seed + lf * 37.0;
        float farAmt = lf * 0.5;                          // 0, 0.5, 1
        float layerA = isRain ? (1.0 - clamp(VXF(32), 0.0, 1.0) * 0.55 * farAmt) : (1.0 - 0.25 * farAmt);
        float dfo = (isRain ? clamp(VXF(32), 0.0, 1.0) * 0.30 : clamp(VXF(28), 0.0, 1.0) * 0.9) * farAmt;
        float edge = mix(0.30, 0.025, hard) + dfo * 0.35;   // edge softness in radii

        if (!isRain) {
            // ---------------------------- bubbles + particles ----------------------------
            float R = R0 * lsc;
            float cs = R * 2.6;
            vec2 shift = dirV * (T * lspd * travel);
            vec2 q = p - shift;
            vec2 cell0 = floor(q / cs);
            for (int dy = -1; dy <= 1; dy++) {
                for (int dx = -1; dx <= 1; dx++) {
                    vec2 cid = cell0 + vec2(float(dx), float(dy));
                    for (int s = 0; s < 2; s++) {
                        if (s >= nSlots) break;
                        vec4 rn = vfxRnd(cid, lseed + float(s) * 101.0);
                        if (rn.x > dens) continue;
                        float sz = fract(rn.w * 5.31 + rn.x * 3.7);
                        float r = R * mix(1.0, 0.3 + 0.7 * sz, scaleV);
                        vec2 cen = (cid + vec2(0.22) + rn.yz * 0.56) * cs;
                        float wr = wander * 0.20 * cs * (0.4 + 0.6 * rn.w) * ((dirM > 1.5) ? 1.6 : 1.0);
                        float ph = fract(rn.x * 12.9898 + rn.w) * 6.2831853
                                 + T * (3.0 + 5.0 * rn.w) * ((rn.y > 0.5) ? 1.0 : -1.0);
                        vec2 wo = vec2(cos(ph), sin(ph)) * wr;
                        if (axisM > 0.5 && axisM < 1.5) wo.y = 0.0;
                        else if (axisM > 1.5) wo.x = 0.0;
                        cen += wo;
                        vec2 dq = q - cen;
                        if (dot(dq, dq) > r * r * 9.0) continue;           // farther than 3 radii: nothing to draw

                        vec2 cenP = (cen + shift) * hpx;                  // centre in pixels
                        vec3 cC = compAt(ivec2(cenP), w, h);             // what is under the centre (media reaction)
                        float lg = luma(linearToSrgb(max(cC, vec3(0.0))));
                        float rv = (VXF(39) > 0.5) ? 1.0 - lg : lg;
                        if (isPart) r *= mix(1.0, 0.35 + 1.15 * rv, clamp(VXF(38), 0.0, 1.0));

                        float m = layerA;                                // media mask (Everywhere / Bright / Dark)
                        if (maskMode > 0.5) {
                            float on = smoothstep(maskThr - maskSf, maskThr + maskSf, lg);
                            m *= (maskMode < 1.5) ? on : (1.0 - on);
                        }
                        if (m <= 0.001) continue;

                        vec2 v = dq / r;
                        float dRaw = length(v);
                        float d = dRaw;
                        if (rough > 0.001) {                              // wobbly outline, continuous around the circle
                            vec2 nd = v / max(dRaw, 1e-4);
                            d *= 1.0 + rough * 0.25 * (vnoise(nd * 1.6 + rn.xy * 13.0 + vec2(T * 0.5)) - 0.5);
                        }
                        float a = 1.0 - smoothstep(1.0 - edge, 1.0 + edge * 0.15, d);
                        vec3 lightCol = mix(vec3(1.0), cC / max(max(cC.r, max(cC.g, cC.b)), 0.05), pickup);

                        // soft shadow on the picture beside the shape
                        if (shA > 0.001) {
                            vec2 sc = v - sdir * (0.12 + clamp(VXF(17), 0.0, 1.0) * 0.75);
                            float sm = (1.0 - smoothstep(0.30, 1.5, length(sc))) * (1.0 - a);
                            col *= 1.0 - sm * clamp(shA, 0.0, 1.5) * 0.6 * m * opEff;
                        }

                        vec3 pc = vec3(1.0);
                        if (isPart) {
                            float srcM = VXF(35);
                            if (srcM < 0.5) pc = fxUnpackCol(VXF(36));
                            else if (srcM < 1.5) pc = clamp(cC / max(max(cC.r, max(cC.g, cC.b)), 0.05), vec3(0.0), vec3(1.0));
                            else pc = fxUnpackCol(VXF(36)) * (0.4 + 1.6 * lg);
                            pc *= VXF(37);
                        }

                        // soft glow halo outside the shape
                        if (gA > 0.001) {
                            float gm = exp(-pow(max(d - 0.9, 0.0) / gr, 1.4)) * (1.0 - a);
                            vec3 gcol = isPart ? mix(lightCol, pc, 0.7) : mix(lightCol, tintC * 1.4, tintA);
                            col += gcol * (gm * clamp(gA, 0.0, 2.0) * 0.22 * m * opEff);
                        }
                        if (a <= 0.001) continue;

                        if (isPart) {
                            float vis = smoothstep(VXF(40) - 0.1, VXF(40) + 0.1, rv);
                            float aa = a * mix(1.0, vis, clamp(VXF(38), 0.0, 1.0));
                            aa *= 1.0 - clamp(VXF(42), 0.0, 1.0) * 0.6 * (0.5 + 0.5 * sin(u_time * (2.0 + 4.0 * rn.w) + rn.x * 40.0));
                            vec3 outc = pc * (1.12 - 0.22 * d);
                            col = vfxBlend(col, outc, aa * m * opEff, cb);
                        } else {
                            // glass bubble: magnified / bent view of the picture + rim + specular
                            float k = 1.0 - refr * (0.55 * (1.0 - d * d)) + refr * 0.5 * pow(clamp(d, 0.0, 1.2), 6.0);
                            vec2 dpx = pP - cenP;
                            vec3 refrC;
                            if (hiQ) {
                                float disp = clamp(VXF(27), 0.0, 1.0) * 0.06;
                                refrC = vec3(compBilinear(cenP + dpx * (k * (1.0 + disp)), w, h).r,
                                             compBilinear(cenP + dpx * k, w, h).g,
                                             compBilinear(cenP + dpx * (k * (1.0 - disp)), w, h).b);
                            } else {
                                refrC = compBilinear(cenP + dpx * k, w, h).rgb;
                            }
                            vec2 nv = v / max(dRaw, 1e-4);
                            float rimBand = smoothstep(0.55, 1.0, d);
                            float lit = max(dot(nv, ldir), 0.0);
                            float unlit = max(dot(nv, -ldir), 0.0);
                            float rimLight = rimBand * (0.25 + 0.75 * lit * lit);
                            float rimDark = rimBand * pow(unlit, 1.5);
                            float spec = exp(-pow(length(v - ldir * 0.50) / 0.17, 2.0));
                            float spec2 = exp(-pow(length(v + ldir * 0.55) / 0.30, 2.0)) * 0.25;
                            float inL = clamp(VXF(26), 0.0, 1.0);
                            vec3 inside = refrC;
                            inside = mix(inside, inside * (tintC * 1.6 + 0.2), tintA);
                            inside = inside * (1.0 + inL * 0.6 * (1.0 - d)) + tintC * (inL * 0.05 * (1.0 - d));
                            inside *= 1.0 - 0.55 * rimDark * clamp(VXF(24), 0.0, 1.0);
                            inside += lightCol * (rimLight * clamp(VXF(24), 0.0, 1.5) * 0.9
                                                + (spec + spec2) * clamp(VXF(25), 0.0, 1.5) * 1.6);
                            col = vfxBlend(col, inside, a * m * opEff, cb);
                        }
                    }
                }
            }
        } else {
            // ---------------------------- rain ----------------------------
            vec2 fall = dirV;
            vec2 perp = vec2(-fall.y, fall.x);
            float width = R0 * 0.28 * lsc;
            float Lr = R0 * (1.0 + clamp(VXF(29), 0.0, 1.0) * 9.0) * lsc;
            float csv = width * 5.5;
            float csu = Lr * 2.6;
            vec2 pu = vec2(dot(p, fall), dot(p, perp));         // u along the fall, v across it
            float vcell = floor(pu.y / csv);
            for (int dv = -1; dv <= 1; dv++) {
                float cvid = vcell + float(dv);
                float cr = hash12(vec2(cvid, lseed * 0.37 + 5.1));
                float ps = 1.0 + (cr - 0.5) * clamp(VXF(31), 0.0, 1.0) * 1.8;   // every column falls at its own speed
                float ushift = T * travel * lspd * ps * 3.0;
                float qu = pu.x - ushift;
                float ucell = floor(qu / csu);
                for (int du = -1; du <= 1; du++) {
                    vec2 cid = vec2(ucell + float(du), cvid);
                    vec4 rn = vfxRnd(cid, lseed);
                    if (rn.x > dens) continue;
                    float hl = 0.5 * Lr * (0.6 + 0.4 * rn.w);
                    float cu = (cid.x + 0.25 + 0.5 * rn.y) * csu;
                    float cv = (cvid + 0.2 + 0.6 * rn.z) * csv;
                    vec2 dd = vec2(qu - cu, pu.y - cv);
                    float t = clamp(dd.x / hl, -1.0, 1.0);          // +1 = leading head, -1 = tail
                    float wt = width * (0.30 + 0.70 * smoothstep(-1.0, 0.75, t));
                    vec2 e = vec2(max(abs(dd.x) - hl, 0.0), dd.y);
                    float dist = length(e) / wt;
                    if (dist > 4.0) continue;

                    vec2 cenP = (fall * (cu + ushift) + perp * cv) * hpx;
                    vec3 cC = compAt(ivec2(cenP), w, h);
                    float lg = luma(linearToSrgb(max(cC, vec3(0.0))));
                    float m = layerA;
                    if (maskMode > 0.5) {
                        float on = smoothstep(maskThr - maskSf, maskThr + maskSf, lg);
                        m *= (maskMode < 1.5) ? on : (1.0 - on);
                    }
                    if (m <= 0.001) continue;

                    float a = 1.0 - smoothstep(1.0 - edge, 1.0, dist);
                    vec3 lightCol = mix(vec3(1.0), cC / max(max(cC.r, max(cC.g, cC.b)), 0.05), pickup);

                    if (shA > 0.001) {
                        vec2 sUV = vec2(dot(sdir, fall), dot(sdir, perp));
                        vec2 d2 = dd - sUV * wt * (0.6 + clamp(VXF(17), 0.0, 1.0) * 2.0);
                        vec2 e2 = vec2(max(abs(d2.x) - hl, 0.0), d2.y);
                        float sm = (1.0 - smoothstep(0.5, 2.6, length(e2) / wt)) * (1.0 - a);
                        col *= 1.0 - sm * clamp(shA, 0.0, 1.5) * 0.5 * m * opEff;
                    }
                    if (gA > 0.001) {
                        float gm = exp(-pow(max(dist - 0.9, 0.0) / gr, 1.4)) * (1.0 - a);
                        col += mix(lightCol, tintC * 1.4, tintA) * (gm * clamp(gA, 0.0, 2.0) * 0.22 * m * opEff);
                    }
                    if (a <= 0.001) continue;

                    vec2 smp = pP + perp * ((dd.y / wt) * width * hpx * (-0.9 * refr));
                    vec3 rc = compBilinear(smp, w, h).rgb * (1.0 + 0.25 * refr);
                    float prof = pow(0.5 + 0.5 * t, 1.6);
                    rc = mix(rc, rc * (tintC * 1.5 + 0.2), tintA);
                    rc += lightCol * (clamp(VXF(33), 0.0, 2.0) * (0.12 + 0.88 * prof) * (1.0 - 0.5 * dist * dist));
                    col = vfxBlend(col, rc, a * m * opEff, cb);
                }
            }
        }
    }
    return col;
}

// PASS 13: VFX shade (composite -> out scratch)
void executeVfx(ivec2 coord, int width, int height) {
    int idx = coord.y * width + coord.x;
    vec4 base = unpackComposite(idx);
    vec3 col = base.rgb;
    int totalL = int(clamp(u_layerCount, 1.0, 10.0));
    for (int li = 0; li < 10; li++) {
        if (li >= totalL) break;
        if (layers[li].isEnabled < 0.5 || vx[li].v[0] < 0.5) continue;
        float op = clamp(vx[li].v[1], 0.0, 1.0) * clamp(layers[li].opacity, 0.0, 1.0);
        if (op <= 0.001) continue;
        col = vfxLayer(col, li, coord, width, height, op);
    }
    col = sanitize(col);
    out_pixels[idx * 2] = packHalf2x16(col.rg);
    out_pixels[idx * 2 + 1] = packHalf2x16(vec2(col.b, base.a));
}

// PASS 14 / 17: scratch -> composite (separate pass so a band never reads rows that were already replaced)
void executeScratchCopy(ivec2 coord, int width, int height) {
    int idx = coord.y * width + coord.x;
    temp_composite[idx * 2] = out_pixels[idx * 2];
    temp_composite[idx * 2 + 1] = out_pixels[idx * 2 + 1];
}

// -----------------------------------------------------------------------------
// SAPPHIRE
// -----------------------------------------------------------------------------
// S_Glint is evaluated for the FIRST enabled layer that has it on (same rule as the anamorphic flare); S_LightLeak for every layer.
int sapGlintLayer() {
    int totalL = int(clamp(u_layerCount, 1.0, 10.0));
    for (int li = 0; li < 10; li++) {
        if (li >= totalL) break;
        if (layers[li].isEnabled > 0.5 && sx[li].s[0] > 0.5 && sx[li].s[1] > 0.001 && sx[li].s[15] > 0.001) return li;
    }
    return -1;
}

// PASS 15: highlight map at 1/4 res (hc = texel, mw/mh = map size, u_srcW/u_srcH = full size). Hue-preserving excess above the threshold,
// soft-compressed so one HDR hot-spot cannot flood a whole ray, averaged over the 4x4 block it covers.
void executeSapMap(ivec2 hc, int mw, int mh) {
    int li = sapGlintLayer();
    if (li < 0) return;
    int fw = max(u_srcW, 1);
    int fh = max(u_srcH, 1);
    float thrL = srgbToLinear(clamp(SXF(2), 0.0, 0.99));
    ivec2 b0 = hc * 4;
    vec3 acc = vec3(0.0);
    for (int y = 0; y < 4; y++) {
        for (int x = 0; x < 4; x++) {
            vec3 c = compAt(b0 + ivec2(x, y), fw, fh);
            float lm = max(c.r, max(c.g, c.b));
            if (lm > thrL) {
                vec3 e = c * ((lm - thrL) / max(lm, 1e-4));
                acc += e / (1.0 + max(e.r, max(e.g, e.b)));
            }
        }
    }
    bloomStore(1, hc.y * mw + hc.x, vec4(acc * (1.0 / 16.0), 1.0));
}

// S_Glint: star rays gathered along `lines` through each pixel (both directions), from the highlight map.
vec3 sapGlintAt(int li, vec2 pc, int w, int h) {
    float hpx = float(h);
    int mw = max(w / 4, 1);
    int mh = max(h / 4, 1);
    vec2 inv = vec2(1.0) / vec2(float(w), float(h));
    float q = clamp(SXF(18), 0.0, 1.0);
    int K = int(mix(8.0, 22.0, q) + 0.5);
    int rayN = int(clamp(SXF(4) + 0.5, 1.0, 12.0));
    int lines = (rayN + 1) / 2;
    float len = mix(0.05, 0.55, clamp(SXF(5), 0.0, 1.0)) * mix(0.35, 1.6, clamp(SXF(3), 0.0, 1.0)) * hpx;
    float ds = len / float(K);
    float rot = radians(SXF(7));
    float fallP = 1.0 + clamp(SXF(6), 0.0, 1.0) * 5.0;
    float dens = clamp(SXF(8), 0.0, 1.0);
    float lenVar = clamp(SXF(17), 0.0, 1.0);
    float shim = clamp(SXF(14), 0.0, 1.0);
    float rainbow = clamp(SXF(19), 0.0, 1.0);
    float seed = SXF(20);
    float cellPx = max(10.0, 0.022 * hpx);
    float wOff = clamp(SXF(13), 0.0, 1.0) * 0.012 * hpx;
    int wtaps = (q > 0.85 && wOff > 1.0) ? 3 : 1;
    vec3 acc = vec3(0.0);
    for (int i = 0; i < 6; i++) {
        if (i >= lines) break;
        float a = rot + float(i) * 3.14159265 / float(lines);
        vec2 dir = vec2(cos(a), sin(a));
        vec2 nrm = vec2(-dir.y, dir.x);
        for (int sd = 0; sd < 2; sd++) {
            if (sd == 1 && (rayN & 1) == 1 && i == lines - 1) break;      // odd ray count: the last line has a single spoke
            float sgn = (sd == 0) ? 1.0 : -1.0;
            for (int k = 0; k < 22; k++) {
                if (k >= K) break;
                float s = (float(k) + 0.5) * ds;
                vec2 sp = pc + dir * (sgn * s);
                vec2 cid = floor(sp / cellPx) + vec2(seed * 3.1, seed * 1.7);
                float hg = hash12(cid);
                if (hg > dens) continue;                                     // density: only some highlights get a glint
                float sn = s / (len * (1.0 - lenVar * hash12(cid + vec2(9.1, 4.3))));
                if (sn >= 1.0) continue;
                vec3 ex = vec3(0.0);
                for (int tp = 0; tp < 3; tp++) {
                    if (tp >= wtaps) break;
                    float po = (wtaps == 3) ? float(tp - 1) : 0.0;
                    ex += sampleBloom(1, (sp + nrm * (po * wOff)) * inv, mw, mh).rgb;
                }
                ex *= 1.0 / float(wtaps);
                if (max(ex.r, max(ex.g, ex.b)) < 0.002) continue;
                float wgt = pow(1.0 - sn, fallP);
                float tw = 1.0 - shim * 0.5 * (0.5 + 0.5 * sin(u_time * 5.0 + hg * 25.0));
                vec3 rb = mix(vec3(1.0), hueToRGB(fract(sn * 0.9 + float(i) * 0.17)) * 1.4, rainbow);
                acc += ex * (wgt * tw) * rb;
            }
        }
    }
    acc *= ds / (9.0 * gRes);

    // hot-spot core: small own glow around the highlight (does not use any shared / text glow)
    float coreR = mix(3.0, 46.0, clamp(SXF(12), 0.0, 1.0)) * gRes;
    vec3 core = sampleBloom(1, pc * inv, mw, mh).rgb;
    for (int j = 1; j < 7; j++) {
        float cang = float(j) * 1.0471976 + 0.5;
        core += sampleBloom(1, (pc + vec2(cos(cang), sin(cang)) * coreR) * inv, mw, mh).rgb * 0.8;
    }
    core *= (1.0 / 6.0) * min(dens * 4.0, 1.0);

    vec3 rayTint = fxUnpackCol(SXF(9));
    float mixC = clamp(SXF(10), 0.0, 1.0);
    float am = max(acc.r, max(acc.g, acc.b));
    vec3 rayCol = mix(acc, vec3(am) * rayTint, mixC);
    float cm = max(core.r, max(core.g, core.b));
    vec3 coreCol = mix(core, vec3(cm) * mix(vec3(1.0), rayTint, 0.5), mixC);
    float inten = max(SXF(1), 0.0);
    return rayCol * inten + coreCol * (clamp(SXF(11), 0.0, 2.0) * inten * 1.5);
}

float sapLeakEnv(float t, float nn, int li, float seedN) {
    float start = SXF(40);
    float endp = max(SXF(41), start + 0.02);
    float soft = clamp(SXF(43), 0.0, 1.0);
    float lenN = max(SXF(35), 0.02);
    float u = t - start;
    float fall = pow(clamp(1.0 - u / lenN, 0.0, 1.0), 0.6 + clamp(SXF(42), 0.0, 1.0) * 3.4);
    float edgeIn = smoothstep(-0.02 - soft * 0.25, soft * 0.30, u);
    float edgeOut = 1.0 - smoothstep(endp - 0.02 - soft * 0.2, endp + 0.001, t);
    float wide = clamp(SXF(44), 0.0, 1.0);
    float cv = fbm(vec2(nn * mix(6.0, 1.5, wide) + seedN * 3.1, t * 1.3 + u_time * 0.05 * SXF(47)));
    float band = mix(1.0, smoothstep(0.2, 0.8, cv), 0.75);
    float st = vnoise(vec2(nn * 55.0 + seedN, t * 2.0));
    float streak = mix(1.0, 0.35 + 1.3 * st, clamp(SXF(49), 0.0, 1.0));
    return fall * edgeIn * edgeOut * band * streak;
}

// S_LightLeak: directional light bleeding in from the `start` side, fading over `length`, colour gradient along the leak axis.
vec3 sapLeak(int li, vec2 uvN, int w, int h, float lumPre) {
    float aspect = float(w) / float(h);
    float seedN = SXF(52);
    float ang = radians(SXF(34));
    vec2 dir = vec2(cos(ang), -sin(ang));
    vec2 c = (uvN - 0.5) * vec2(aspect, 1.0);
    float ext = max(abs(dir.x) * aspect + abs(dir.y), 1e-3);
    float t = dot(c, dir) / ext + 0.5;
    float nn = dot(c, vec2(-dir.y, dir.x)) / ext;
    t += clamp(SXF(48), 0.0, 1.0) * 0.12 * sin(u_time * 0.7 + seedN) + clamp(SXF(47), 0.0, 1.0) * 0.10 * sin(u_time * 0.5 + seedN * 2.0);
    float env = sapLeakEnv(t, nn, li, seedN);
    if (SXF(53) > 0.5) env = max(env, sapLeakEnv(1.0 - t, -nn + 3.7, li, seedN + 11.0));
    float start = SXF(40);
    float endp = max(SXF(41), start + 0.02);
    float tr = clamp((t - start) / max(endp - start, 0.05), 0.0, 1.0);
    vec3 cA = fxUnpackCol(SXF(36));
    vec3 cB = fxUnpackCol(SXF(37));
    vec3 cC = fxUnpackCol(SXF(38));
    vec3 lc = (SXF(39) > 0.5) ? ((tr < 0.5) ? mix(cA, cB, tr * 2.0) : mix(cB, cC, tr * 2.0 - 1.0)) : cA;
    float flick = 1.0 + clamp(SXF(50), 0.0, 1.0) * (vnoise(vec2(u_time * 9.0, seedN)) - 0.5) * 1.2;
    vec3 leak = lc * (env * max(SXF(33), 0.0) * 1.4 * flick);
    leak *= mix(1.0, 1.0 - smoothstep(0.4, 1.4, lumPre), clamp(SXF(51), 0.0, 1.0));   // strongest over shadows, lighter over highlights
    return leak / (vec3(1.0) + leak);                                                    // soft-compressed so it never clips to flat white
}

// PASS 16: Sapphire gather (composite -> out scratch)
void executeSapphire(ivec2 coord, int width, int height) {
    int idx = coord.y * width + coord.x;
    vec4 basePx = unpackComposite(idx);
    vec3 col = basePx.rgb;
    vec2 uvN = (vec2(coord) + 0.5) / vec2(float(width), float(height));
    int totalL = int(clamp(u_layerCount, 1.0, 10.0));
    for (int li = 0; li < 10; li++) {
        if (li >= totalL) break;
        if (layers[li].isEnabled < 0.5 || sx[li].s[32] < 0.5) continue;
        float op = clamp(sx[li].s[45], 0.0, 1.0) * clamp(layers[li].opacity, 0.0, 1.0);
        if (op <= 0.001 || sx[li].s[33] <= 0.001) continue;
        vec3 leak = sapLeak(li, uvN, width, height, luma(col));
        col = vfxLightMix(col, leak, op, sx[li].s[46], 1.0);
    }
    int gli = sapGlintLayer();
    if (gli >= 0) {
        float op = clamp(sx[gli].s[15], 0.0, 1.0) * clamp(layers[gli].opacity, 0.0, 1.0);
        vec3 gl = sapGlintAt(gli, vec2(coord) + 0.5, width, height);
        col = vfxLightMix(col, gl, op, sx[gli].s[16], 0.0);
    }
    col = sanitize(col);
    out_pixels[idx * 2] = packHalf2x16(col.rg);
    out_pixels[idx * 2 + 1] = packHalf2x16(vec2(col.b, basePx.a));
}

// =============================================================================
// MOTION S (batch 9, Smear rewritten later): Smear / Duplicate + Glitch Edge.   Passes 18..21.  (Main / motion blur was removed.)
//   18 MotionFlow    (grid)  block-matching residual on top of the global similarity transform estimated by the native side
//   19 MotionSmooth  (grid)  confidence / similarity weighted 3x3 smoothing
//   20 MotionDilate  (grid)  reach-limited neighbourhood max (lets a trail leave the moving edge)
//   21 MotionRender  (full)  Smear / Duplicate (+ Glitch Edge) -> out_pixels (8-bit RGBA).  Smear no longer uses passes 18..20 (no flow); only Duplicate drift / ghost smear and Glitch Edge gating do.
//   Parameters: motionS[i] (floats 5376..6399), slot numbers mirror class MotionS in motion_slots.dart.
//   Frames: mo_frames (binding 11, N packed 8-bit RGBA frames), flow: mo_flow (binding 12, 3 planes x cells x 8 floats).
//   Nothing here reads bloom L0..L4 / flare / temp composite, so the S_Glint scratch rule (L1, pass 15 .. pass 2) cannot be hit.
//   Per-effect opacity + custom blend follow the batch 4 pattern (fxMix, cb = LayerBlendMode index + 1).
// =============================================================================
#define MOS(i) motionS[i]

const int MO_TPREV = 128;   // global similarity transform current -> previous frame (written by the native side)
const int MO_TNEXT = 136;   // current -> next frame

bool moLin = true;
float moRef[36];

uint moLoadU(int slot, ivec2 p, int w, int h) {
    p = clamp(p, ivec2(0), ivec2(w - 1, h - 1));
    return mo_frames[uint(slot) * uint(w * h) + uint(p.y * w + p.x)];
}
vec3 moRgb(uint v) {
    return vec3(float(v & 255u), float((v >> 8u) & 255u), float((v >> 16u) & 255u)) * (1.0 / 255.0);
}
// fast sRGB -> linear (error < 0.4 %), only used inside the sample loops
vec3 moToLin(vec3 c) { return c * (c * (c * 0.305306011 + 0.682171111) + 0.012522878); }
vec3 moIn(vec3 c) { return moLin ? moToLin(c) : c; }
vec3 moOut(vec3 c) { return moLin ? linearToSrgb(max(c, vec3(0.0))) : clamp(c, vec3(0.0), vec3(1.0)); }

vec3 moSample(int slot, vec2 pos, int w, int h) {
    vec2 f = pos - 0.5;
    ivec2 i0 = ivec2(floor(f));
    vec2 t = f - vec2(i0);
    vec3 a = moIn(moRgb(moLoadU(slot, i0, w, h)));
    vec3 b = moIn(moRgb(moLoadU(slot, i0 + ivec2(1, 0), w, h)));
    vec3 c = moIn(moRgb(moLoadU(slot, i0 + ivec2(0, 1), w, h)));
    vec3 d = moIn(moRgb(moLoadU(slot, i0 + ivec2(1, 1), w, h)));
    return mix(mix(a, b, t.x), mix(c, d, t.x), t.y);
}

float moGLum(int slot, ivec2 p, int w, int h) {
    return dot(moRgb(moLoadU(slot, p, w, h)), vec3(0.2126, 0.7152, 0.0722));
}
float moGLumBi(int slot, vec2 pos, int w, int h) {
    vec2 f = pos - 0.5;
    ivec2 i0 = ivec2(floor(f));
    vec2 t = f - vec2(i0);
    float a = moGLum(slot, i0, w, h);
    float b = moGLum(slot, i0 + ivec2(1, 0), w, h);
    float c = moGLum(slot, i0 + ivec2(0, 1), w, h);
    float d = moGLum(slot, i0 + ivec2(1, 1), w, h);
    return mix(mix(a, b, t.x), mix(c, d, t.x), t.y);
}

float moIGN(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }

// ---- global similarity transform (translation, rotation, zoom about c) -----------------------------------------
struct MoT { vec2 c; vec2 t; float s; float cs; float sn; bool ok; };

MoT moLoadT(int base) {
    MoT m;
    m.ok = MOS(base) > 0.5;
    m.c = vec2(MOS(base + 5), MOS(base + 6));
    m.t = vec2(MOS(base + 1), MOS(base + 2));
    m.s = exp(MOS(base + 4));
    float th = MOS(base + 3);
    m.cs = cos(th);
    m.sn = sin(th);
    return m;
}
vec2 moMapT(MoT m, vec2 p) {
    if (!m.ok) return p;
    vec2 d = p - m.c;
    return m.c + m.s * vec2(m.cs * d.x - m.sn * d.y, m.sn * d.x + m.cs * d.y) + m.t;
}

// ---- flow planes: 0 raw, 1 smoothed, 2 dilated.  8 floats per cell: B(x, y, conf, 0), F(x, y, conf, 0) ------------------
vec3 moCellFlow(int plane, ivec2 c, int gw, int gh, int k) {
    c = clamp(c, ivec2(0), ivec2(gw - 1, gh - 1));
    int b = ((plane * gw * gh) + c.y * gw + c.x) * 8 + k;
    return vec3(mo_flow[b], mo_flow[b + 1], mo_flow[b + 2]);
}
vec3 moFlowAt(int plane, vec2 q, int gw, int gh, int C, int k) {
    if (MOS(9) < 0.5) return vec3(0.0);
    vec2 g = q / float(C) - 0.5;
    ivec2 i0 = ivec2(floor(g));
    vec2 t = g - vec2(i0);
    vec3 a = moCellFlow(plane, i0, gw, gh, k);
    vec3 b = moCellFlow(plane, i0 + ivec2(1, 0), gw, gh, k);
    vec3 c = moCellFlow(plane, i0 + ivec2(0, 1), gw, gh, k);
    vec3 d = moCellFlow(plane, i0 + ivec2(1, 1), gw, gh, k);
    return mix(mix(a, b, t.x), mix(c, d, t.x), t.y);
}
void moWrite(int plane, ivec2 c, int gw, int gh, vec3 B, vec3 F) {
    int b = ((plane * gw * gh) + c.y * gw + c.x) * 8;
    mo_flow[b] = B.x;
    mo_flow[b + 1] = B.y;
    mo_flow[b + 2] = B.z;
    mo_flow[b + 3] = 0.0;
    mo_flow[b + 4] = F.x;
    mo_flow[b + 5] = F.y;
    mo_flow[b + 6] = F.z;
    mo_flow[b + 7] = 0.0;
}

// ---- PASS 18: residual block matching around the global prediction ----------------------------------------------
float moBlockSad(int nSlot, MoT T, vec2 pc, vec2 d, int w, int h) {
    float s = 0.0;
    for (int j = 0; j < 6; j++) {
        for (int i = 0; i < 6; i++) {
            vec2 o = (vec2(float(i), float(j)) - 2.5) * 3.0;
            vec2 p = moMapT(T, pc + o) + d;
            s += abs(moRef[j * 6 + i] - moGLumBi(nSlot, p, w, h));
        }
    }
    return s * (1.0 / 36.0);
}

void executeMotionFlow(ivec2 cell, int gw, int gh, int w, int h) {
    int C = max(int(MOS(12)), 4);
    int cur = int(MOS(6));
    vec2 pc = min((vec2(cell) + 0.5) * float(C), vec2(float(w - 1), float(h - 1)));
    float mean = 0.0;
    for (int j = 0; j < 6; j++) {
        for (int i = 0; i < 6; i++) {
            vec2 o = (vec2(float(i), float(j)) - 2.5) * 3.0;
            float v = moGLumBi(cur, pc + o, w, h);
            moRef[j * 6 + i] = v;
            mean += v;
        }
    }
    mean /= 36.0;
    float tex = 0.0;
    for (int k = 0; k < 36; k++) tex += abs(moRef[k] - mean);
    tex /= 36.0;

    vec3 outB = vec3(0.0);
    vec3 outF = vec3(0.0);
    int R = clamp(int(MOS(13)), 0, 16);
    for (int dirI = 0; dirI < 2; dirI++) {
        int nSlot = (dirI == 0) ? int(MOS(7)) : int(MOS(8));
        if (nSlot < 0) continue;
        if (dirI == 1 && MOS(10) < 0.5) continue;
        MoT T = moLoadT(dirI == 0 ? MO_TPREV : MO_TNEXT);
        vec2 g0 = moMapT(T, pc) - pc;
        float s0 = moBlockSad(nSlot, T, pc, vec2(0.0), w, h);
        float bestS = s0;
        vec2 bestD = vec2(0.0);
        for (int dy = -R; dy <= R; dy += 4) {
            for (int dx = -R; dx <= R; dx += 4) {
                if (dx == 0 && dy == 0) continue;
                vec2 d = vec2(float(dx), float(dy));
                float s = moBlockSad(nSlot, T, pc, d, w, h);
                if (s < bestS) { bestS = s; bestD = d; }
            }
        }
        for (int stepI = 0; stepI < 2; stepI++) {
            float st = (stepI == 0) ? 2.0 : 1.0;
            vec2 c0 = bestD;
            for (int dy = -1; dy <= 1; dy++) {
                for (int dx = -1; dx <= 1; dx++) {
                    if (dx == 0 && dy == 0) continue;
                    vec2 d = c0 + vec2(float(dx), float(dy)) * st;
                    float s = moBlockSad(nSlot, T, pc, d, w, h);
                    if (s < bestS) { bestS = s; bestD = d; }
                }
            }
        }
        // no residual when the block has no texture or the gain over "just the global motion" is small
        if (tex < 0.012 || bestS > 0.9 * s0) { bestD = vec2(0.0); bestS = s0; }
        float conf = clamp(1.0 - bestS / (tex + 0.02), 0.0, 1.0);
        if (dirI == 0) outB = vec3(g0 + bestD, conf); else outF = vec3(g0 + bestD, conf);
    }
    moWrite(0, cell, gw, gh, outB, outF);
}

// ---- PASS 19 ------------------------------------------------------------------------------------------------------
void executeMotionSmooth(ivec2 cell, int gw, int gh) {
    vec3 cB = moCellFlow(0, cell, gw, gh, 0);
    vec3 cF = moCellFlow(0, cell, gw, gh, 4);
    vec3 aB = vec3(0.0);
    vec3 aF = vec3(0.0);
    float wB = 0.0;
    float wF = 0.0;
    for (int dy = -1; dy <= 1; dy++) {
        for (int dx = -1; dx <= 1; dx++) {
            float self = (dx == 0 && dy == 0) ? 1.5 : 1.0;
            vec3 nB = moCellFlow(0, cell + ivec2(dx, dy), gw, gh, 0);
            float sigB = 1.5 + 0.15 * length(cB.xy);
            float dB = length(nB.xy - cB.xy);
            float tB = exp(-(dB * dB) / (2.0 * sigB * sigB)) * (0.35 + 0.65 * nB.z) * self;
            aB += nB * tB;
            wB += tB;
            vec3 nF = moCellFlow(0, cell + ivec2(dx, dy), gw, gh, 4);
            float sigF = 1.5 + 0.15 * length(cF.xy);
            float dF = length(nF.xy - cF.xy);
            float tF = exp(-(dF * dF) / (2.0 * sigF * sigF)) * (0.35 + 0.65 * nF.z) * self;
            aF += nF * tF;
            wF += tF;
        }
    }
    moWrite(1, cell, gw, gh, aB / max(wB, 1e-4), aF / max(wF, 1e-4));
}

// ---- PASS 20: a neighbour's vector wins when it is faster AND its trail could reach this cell -------------------------
void executeMotionDilate(ivec2 cell, int gw, int gh) {
    int C = max(int(MOS(12)), 4);
    int Rc = clamp(int(MOS(23)), 0, 6);
    vec3 bestB = moCellFlow(1, cell, gw, gh, 0);
    vec3 bestF = moCellFlow(1, cell, gw, gh, 4);
    float mB = length(bestB.xy);
    float mF = length(bestF.xy);
    for (int dy = -Rc; dy <= Rc; dy++) {
        for (int dx = -Rc; dx <= Rc; dx++) {
            if (dx == 0 && dy == 0) continue;
            float dist = length(vec2(float(dx), float(dy))) * float(C);
            vec3 nB = moCellFlow(1, cell + ivec2(dx, dy), gw, gh, 0);
            float m = length(nB.xy);
            if (m > mB && m + 0.5 * float(C) >= dist) { bestB = nB; mB = m; }
            vec3 nF = moCellFlow(1, cell + ivec2(dx, dy), gw, gh, 4);
            float mf = length(nF.xy);
            if (mf > mF && mf + 0.5 * float(C) >= dist) { bestF = nF; mF = mf; }
        }
    }
    moWrite(2, cell, gw, gh, bestB, bestF);
}

// ---- SMEAR (rewritten): directional ACCUMULATION smear of the current frame ----------------------------------------
// No flow, no frame differencing, no neighbour frames: the trail comes from the user's angle / length (or from the frame centre in radial mode),
// so it is identical on every frame of the clip and cannot flicker or pop. Every pixel walks Seff steps along the trail, collects the picture
// there and keeps the BRIGHTEST value per channel (lighten / max), which leaves solid, sharp light streaks instead of an averaged soup.
//   linear : path(s) = q - dir * L * s                      dir = (cos a, -sin a)  (0 = right, 90 = up), the trail grows towards +dir
//   radial : path(s) = c + Rot(-spin * m * s) * (q - c) * (1 - zoom * m * s)    c = frame centre, m = 2 * length
//            zoom = cos a, spin = sin a  ->  a = 0 pure zoom burst (outward), 90 pure spin, in between = spiral.
//            The trail length grows with the distance from the centre (m * r), exactly like a real zoom / spin, so the centre stays sharp.
// s runs 0 (at the pixel) .. 1 (end of the trail).
// Chromatic dispersion: R walks to s * (1 + d), B to s * (1 - d), G to s, so the colours part more and more towards the tail.
// Highlight threshold: samples below the luma gate only leave a faint (15 %) trail, samples above it leave the full one.
// [ASSUMED] below-gate share 15 %, gate softness +-0.08, sample spacing capped at 2.5..5 px (see moSmear), 160 steps maximum.
float moTrailW(float s, float fe, float tailW) {
    float v = max(1.0 - s, 0.0);
    return pow(v, fe) * smoothstep(0.0, tailW, v);
}

float moGate(vec3 c, float thr) {
    if (thr <= 0.001) return 1.0;
    float l = luma(c);
    float lg = moLin ? sqrt(max(l, 0.0)) : l;   // the threshold is in display (perceptual) brightness
    return mix(0.15, 1.0, smoothstep(thr - 0.08, thr + 0.08, lg));
}

// bilinear fetch with an optional sharpened weight: t is pulled towards 0 / 1, which is what a negative LOD bias does to a bilinear texture fetch
// (crisper edges, still no stair-steps). The frames live in a storage buffer (binding 11), so there is no hardware sampler / LOD to bias.
vec3 moSampleSharp(int slot, vec2 pos, int w, int h, float sharp) {
    vec2 f = pos - 0.5;
    ivec2 i0 = ivec2(floor(f));
    vec2 t = f - vec2(i0);
    t = mix(t, t * t * (3.0 - 2.0 * t), sharp);
    vec3 a = moIn(moRgb(moLoadU(slot, i0, w, h)));
    vec3 b = moIn(moRgb(moLoadU(slot, i0 + ivec2(1, 0), w, h)));
    vec3 c = moIn(moRgb(moLoadU(slot, i0 + ivec2(0, 1), w, h)));
    vec3 d = moIn(moRgb(moLoadU(slot, i0 + ivec2(1, 1), w, h)));
    return mix(mix(a, b, t.x), mix(c, d, t.x), t.y);
}

// position on the trail at s. lin = dir * L (px), zoomK / spinK = radial strengths (already multiplied by m)
vec2 moSmPos(vec2 q, float s, bool radial, vec2 lin, vec2 ctr, float zoomK, float spinK) {
    if (!radial) return q - lin * s;
    vec2 rv = q - ctr;
    float sc = max(1.0 - zoomK * s, 0.02);
    float th = -spinK * s;
    float cs = cos(th);
    float sn = sin(th);
    return ctr + vec2(cs * rv.x - sn * rv.y, sn * rv.x + cs * rv.y) * sc;
}

vec3 moSmear(vec2 q, vec3 pre, int cur, int w, int h, float diag, float jit) {
    float lenFrac = max(MOS(37), 0.0);
    bool radial = MOS(38) > 0.5;
    float ang = radians(MOS(32));
    vec2 ctr = vec2(float(w), float(h)) * 0.5;
    vec2 lin = vec2(0.0);
    float zoomK = 0.0;
    float spinK = 0.0;
    float Lpx;
    if (radial) {
        float m = 2.0 * lenFrac;
        zoomK = cos(ang) * m;
        spinK = sin(ang) * m;
        Lpx = m * length(q - ctr);
    } else {
        Lpx = lenFrac * diag;
        lin = vec2(cos(ang), -sin(ang)) * Lpx;
    }
    if (Lpx < 0.75) return pre;

    float sharp = clamp(MOS(24), 0.0, 1.0);
    float disp = clamp(MOS(40), 0.0, 0.6);
    float thr = clamp(MOS(39), 0.0, 1.0);
    float fe = mix(0.4, 4.0, clamp(MOS(34), 0.0, 1.0));
    float gain = max(MOS(16), 0.0);
    int S = clamp(int(MOS(22)), 4, 96);
    // "Trailing samples" is the minimum. A long trail also gets extra steps so that two neighbouring steps are never further apart than a few
    // pixels: with a max blend a wider gap shows up as separate ghost copies of the picture ("popping textures"), not as a streak.
    float gap = mix(5.0, 2.5, sharp);
    int Seff = clamp(max(S, int(ceil(Lpx / gap))), 4, 160);
    float tailW = mix(0.30, 0.03, sharp);   // soft end of the trail at low sharpness, a clean cut at high sharpness
    float j = mix(jit, 0.5, sharp);          // per-pixel step jitter only while the lines are soft
    float invS = 1.0 / float(Seff);
    bool split = disp > 0.001;

    vec3 acc = pre;
    for (int i = 0; i < Seff; i++) {
        float s = (float(i) + j) * invS;
        if (!split) {
            vec3 c = moSampleSharp(cur, moSmPos(q, s, radial, lin, ctr, zoomK, spinK), w, h, sharp);
            acc = max(acc, c * (gain * moTrailW(s, fe, tailW) * moGate(c, thr)));
        } else {
            float sr = s * (1.0 + disp);
            float sb = s * (1.0 - disp);
            vec3 cr = moSampleSharp(cur, moSmPos(q, sr, radial, lin, ctr, zoomK, spinK), w, h, sharp);
            vec3 cg = moSampleSharp(cur, moSmPos(q, s, radial, lin, ctr, zoomK, spinK), w, h, sharp);
            vec3 cb = moSampleSharp(cur, moSmPos(q, sb, radial, lin, ctr, zoomK, spinK), w, h, sharp);
            vec3 wgt = vec3(moTrailW(sr, fe, tailW) * moGate(cr, thr),
                            moTrailW(s, fe, tailW) * moGate(cg, thr),
                            moTrailW(sb, fe, tailW) * moGate(cb, thr)) * gain;
            acc = max(acc, vec3(cr.r, cg.g, cb.b) * wgt);
        }
    }
    float head = clamp(MOS(35), 0.0, 1.0);   // how much of the untouched picture stays on top of the trail
    return mix(acc, pre, head);
}

// ---- DUPLICATE: real echo frames with falloff, operator, tint, optional motion-path drift / smear -------------------
vec3 moDup(vec2 q, vec3 pre, int w, int h, int gw, int gh, int C) {
    int N = clamp(int(MOS(64)), 0, 16);
    if (N == 0) return pre;
    float startOp = clamp(MOS(73), 0.0, 1.0);
    float decay = mix(0.92, 0.45, clamp(MOS(66), 0.0, 1.0));
    float drift = MOS(72);
    float dsmear = clamp(MOS(71), 0.0, 1.0);
    int op = int(MOS(68) + 0.5);
    float tintAmt = clamp(MOS(70), 0.0, 1.0);
    vec3 tint = fxUnpackCol(MOS(69));
    bool useFlow = MOS(9) > 0.5;
    vec2 B = vec2(0.0);
    vec2 F = vec2(0.0);
    if (useFlow) {
        B = moFlowAt(1, q, gw, gh, C, 0).xy;
        F = (MOS(10) > 0.5) ? moFlowAt(1, q, gw, gh, C, 4).xy : -B;
    }
    vec3 acc = pre;
    float wsum = 1.0;
    for (int kk = N; kk >= 1; kk--) {
        int slot = int(MOS(96 + kk - 1));
        if (slot < 0) continue;
        float tau = MOS(112 + kk - 1);
        float a = startOp * pow(decay, float(kk - 1));
        vec2 shift = vec2(0.0);
        if (useFlow) shift = (tau < 0.0) ? (B * (-tau)) : (F * tau);
        vec2 pos = q + shift * drift;
        vec3 c;
        if (dsmear > 0.001 && length(shift) > 0.75) {
            c = vec3(0.0);
            for (int i = 0; i < 5; i++) {
                float u = (float(i) / 4.0 - 0.5) * dsmear;
                c += moSample(slot, pos + shift * u, w, h);
            }
            c *= 0.2;
        } else {
            c = moSample(slot, pos, w, h);
        }
        if (tintAmt > 0.001) {
            float gprog = float(kk) / float(N);
            c = mix(c, c * tint * 1.6, tintAmt * gprog);
        }
        if (op == 0) {            // Screen
            vec3 ca = clamp(c * a, vec3(0.0), vec3(1.0));
            acc = acc + ca * (vec3(1.0) - clamp(acc, vec3(0.0), vec3(1.0)));
        } else if (op == 1) {     // Add
            acc = acc + c * a;
        } else if (op == 2) {     // Lighten
            acc = mix(acc, max(acc, c), a);
        } else if (op == 3) {     // Blend (weighted average)
            acc = (acc * wsum + c * a) / (wsum + a);
            wsum += a;
        } else {                  // Over (ghost in front)
            acc = mix(acc, c, a);
        }
    }
    return acc;
}

// ---- PASS 21 ------------------------------------------------------------------------------------------------------
void executeMotionRender(ivec2 coord, int w, int h) {
    moLin = MOS(11) > 0.5;
    int C = max(int(MOS(12)), 4);
    int gw = (w + C - 1) / C;
    int gh = (h + C - 1) / C;
    int cur = int(MOS(6));
    int mode = int(MOS(0) + 0.5);
    float diag = length(vec2(float(w), float(h)));
    vec2 q0 = vec2(coord) + 0.5;
    vec2 q = q0;
    int slot = cur;

    // Glitch Edge (own effect): per-band horizontal tear + frame hold, gated by the motion (or the motion's edges)
    if (MOS(80) > 0.5) {
        float bandH = max(2.0, MOS(83) * float(h));
        float bi = floor(q0.y / bandH);
        float stp = floor(u_time * max(MOS(84), 0.0) * 12.0);
        float sd = MOS(85) * 7.13;
        if (hash12(vec2(bi, stp + sd)) < clamp(MOS(88), 0.0, 1.0)) {
            float gate = 1.0;
            if (MOS(9) > 0.5) {
                float m0 = length(moFlowAt(1, q0, gw, gh, C, 0).xy);
                float d = float(C) * 1.5;
                float e = abs(length(moFlowAt(1, q0 + vec2(d, 0.0), gw, gh, C, 0).xy) - length(moFlowAt(1, q0 - vec2(d, 0.0), gw, gh, C, 0).xy))
                        + abs(length(moFlowAt(1, q0 + vec2(0.0, d), gw, gh, C, 0).xy) - length(moFlowAt(1, q0 - vec2(0.0, d), gw, gh, C, 0).xy));
                gate = mix(smoothstep(0.25, 1.5, m0), smoothstep(0.3, 2.5, e), clamp(MOS(87), 0.0, 1.0));
            }
            float off = (hash12(vec2(bi + 11.0, stp + sd)) - 0.5) * 2.0 * MOS(81) * 0.12 * float(w) * gate;
            q.x += off;
            if (hash12(vec2(bi + 3.0, stp + sd * 1.7)) < clamp(MOS(86), 0.0, 1.0) * gate) {
                int ps = int(MOS(7));
                if (ps >= 0) slot = ps;
            }
        }
    }

    vec3 pre0 = moIn(moRgb(moLoadU(cur, coord, w, h)));
    vec3 pre = (slot == cur && q == q0) ? pre0 : moSample(slot, q, w, h);
    float jit = moIGN(q0 + fract(u_time * 1.7) * 91.0);

    vec3 res = pre;
    if (mode == 1 || mode == 2) {   // mode 2 (the removed Main / motion blur mode) in an old save now renders as Smear
        res = moSmear(q, pre, slot, w, h, diag, jit);
    } else if (mode == 3) {
        res = moDup(q, pre, w, h, gw, gh, C);
    }

    // per-effect opacity + custom blend (batch 4 pattern), then "blend with original"
    vec3 col = fxMix(pre0, res, MOS(1), MOS(2));
    col = mix(col, pre0, clamp(MOS(3), 0.0, 1.0));

    // detail protect: keeps the original where the picture has strong local contrast (line art, text)
    float prot = clamp(MOS(4), 0.0, 1.0);
    if (prot > 0.001) {
        float lc = luma(pre0);
        float ln = 0.25 * (luma(moIn(moRgb(moLoadU(cur, coord + ivec2(2, 0), w, h)))) + luma(moIn(moRgb(moLoadU(cur, coord - ivec2(2, 0), w, h))))
                         + luma(moIn(moRgb(moLoadU(cur, coord + ivec2(0, 2), w, h)))) + luma(moIn(moRgb(moLoadU(cur, coord - ivec2(0, 2), w, h)))));
        col = mix(col, pre0, prot * smoothstep(0.02, 0.18, abs(lc - ln)));
    }

    // TPDF-style dither at the final quantise: smooth smears in dark scenes must not band
    vec3 o = moOut(col);
    float n = hash12(vec2(coord) + fract(u_time * 0.37) * 211.0) + hash12(vec2(coord) * 1.37 + 17.0 + fract(u_time * 0.91) * 137.0) - 1.0;
    o = clamp(o + vec3(n * (1.0 / 255.0)), vec3(0.0), vec3(1.0));
    uint aPx = (moLoadU(cur, coord, w, h) >> 24u) & 255u;
    uint r = uint(o.r * 255.0 + 0.5);
    uint g = uint(o.g * 255.0 + 0.5);
    uint b = uint(o.b * 255.0 + 0.5);
    out_pixels[coord.y * w + coord.x] = (aPx << 24u) | (b << 16u) | (g << 8u) | r;
}

void executeMotionPass(ivec2 coord, int width, int height) {
    if (u_passIndex == 21) { executeMotionRender(coord, width, height); return; }
    int w = u_srcW;
    int h = u_srcH;
    if (u_passIndex == 18) { executeMotionFlow(coord, width, height, w, h); return; }
    if (u_passIndex == 19) { executeMotionSmooth(coord, width, height); return; }
    executeMotionDilate(coord, width, height);
}

// =============================================================================
// PASS 29 (batch 18B): RGB -> YCbCr 4:2:0 (NV12) for the video export. Runs AFTER pass 23, only when the host asks for it (process_image_nv12).
//   Reads the finished RGBA8 image that pass 23 wrote to out_pixels[0 .. P) (P = imgW * imgH words) and writes the NV12 planes BEHIND it in the same
//   buffer (the output buffer is 8 bytes per pixel, the RGBA8 image uses 4, NV12 needs 1.5 more):
//        Y plane  : words [P, P + P/4)          (imgW bytes per row, 4 pixels per word)
//        UV plane : words [P + P/4, P + 3P/8)   (interleaved U V, imgW bytes per row, one pair per 2x2 pixels)
//   Colour: BT.709 matrix, LIMITED (tv) range, i.e. Y 16..235 and Cb / Cr 16..240, the same thing the export tags in the file (-colorspace bt709
//   -color_range tv). Chroma is the average of the four pixels' Cb / Cr (box filter, what swscale does by default).
//   Dispatch grid = (imgW / 4) x (imgH / 2): one invocation = a 4 x 2 block, so every word it writes is written by exactly ONE invocation
//   (no atomics, no races). The host guarantees imgW % 4 == 0 and imgH % 2 == 0. u_passWidth / u_passHeight = the GRID, u_srcW / u_srcH = the image.
// =============================================================================
vec3 yccFromPacked709(uint p) {
    vec3 c = vec3(float(p & 255u), float((p >> 8u) & 255u), float((p >> 16u) & 255u)) * (1.0 / 255.0);
    float yl = dot(c, vec3(0.2126, 0.7152, 0.0722));
    return vec3(16.0 + 219.0 * yl,
                128.0 + 224.0 * (c.b - yl) / 1.8556,
                128.0 + 224.0 * (c.r - yl) / 1.5748);
}

uint yccByte(float v) { return uint(clamp(v + 0.5, 0.0, 255.0)); }

void executeYuvPack(ivec2 coord, int imgW, int imgH) {
    int x0 = coord.x * 4;
    int y0 = coord.y * 2;
    int total = imgW * imgH;
    int yBase = total;
    int uvBase = total + (total >> 2);
    int rowWords = imgW >> 2;

    vec3 v[8];
    for (int r = 0; r < 2; r++) {
        uint yw = 0u;
        for (int k = 0; k < 4; k++) {
            vec3 t = yccFromPacked709(out_pixels[(y0 + r) * imgW + x0 + k]);
            v[r * 4 + k] = t;
            yw |= yccByte(t.x) << uint(8 * k);
        }
        out_pixels[yBase + (y0 + r) * rowWords + coord.x] = yw;
    }

    uint uvw = 0u;
    for (int j = 0; j < 2; j++) {
        int a = 2 * j;
        float cb = 0.25 * (v[a].y + v[a + 1].y + v[4 + a].y + v[4 + a + 1].y);
        float cr = 0.25 * (v[a].z + v[a + 1].z + v[4 + a].z + v[4 + a + 1].z);
        uvw |= yccByte(cb) << uint(16 * j);
        uvw |= yccByte(cr) << uint(16 * j + 8);
    }
    out_pixels[uvBase + coord.y * rowWords + coord.x] = uvw;
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy) + ivec2(0, u_bandY);
    int width = u_passWidth;
    int height = u_passHeight;

    // Dominant-light scan uses shared memory + barrier(), so it must run before the bounds return.
    // Both conditions are dispatch-uniform, so every invocation in the group takes the same path.
    if (u_passIndex == 6 && diffuseLayerActive()) {
        detectDominantLight(width, height);
    }

    if (coord.x >= width || coord.y >= height) return;

    // Batch 18B: NV12 pack for the video export (reads out_pixels, writes behind it; never touches the grade globals below)
    if (u_passIndex == 29) {
        executeYuvPack(coord, u_srcW, u_srcH);
        return;
    }

    // Motion S (batch 9): passes 18..21 never touch the grade globals below
    if (u_passIndex >= 18 && u_passIndex <= 21) {
        executeMotionPass(coord, width, height);
        return;
    }

    gW = int(round(u_imgWidth)) > 0 ? width : width;
    gH = height;
    gBit = u_bitDepthMode;
    gRes = float(max(width, height)) / 720.0;
    gEdgeStep = max(1, int(round(gRes)));

    if (u_passIndex == 1) {
        executeHighlightExtraction(coord, width, height, int(u_imgWidth), int(u_imgHeight));
        return;
    } else if (u_passIndex == 2 || u_passIndex == 3 || u_passIndex == 7 || u_passIndex == 8) {
        executeBloomDownsample(u_passIndex, coord, width, height, u_passRadius);
        return;
    } else if (u_passIndex == 4 || u_passIndex == 5 || u_passIndex == 9) {
        executeBloomUpsample(u_passIndex, coord, width, height, u_passRadius);
        return;
    } else if (u_passIndex == 10) {
        executeFlareHalf(coord, width, height);
        return;
    } else if (u_passIndex == 11) {
        executeTextWarp(coord, width, height);
        return;
    } else if (u_passIndex == 12) {
        executeTextWarpCopy(coord, width, height);
        return;
    } else if (u_passIndex == 13) {
        executeVfx(coord, width, height);
        return;
    } else if (u_passIndex == 14 || u_passIndex == 17) {
        executeScratchCopy(coord, width, height);
        return;
    } else if (u_passIndex == 15) {
        executeSapMap(coord, width, height);
        return;
    } else if (u_passIndex == 16) {
        executeSapphire(coord, width, height);
        return;
    } else if (u_passIndex == 6) {
        executeFinalComposite(coord, width, height);
        return;
    } else if (u_passIndex == 23) {
        executeDitherQuantise(coord, width, height);
        return;
    } else if (u_passIndex == 25) {
        executeBevelLuma(coord, width, height);
        return;
    } else if (u_passIndex == 26) {
        executeMetallicBevel(coord, width, height);
        return;
    } else if (u_passIndex == 27) {
        executeMathOps(coord, width, height);
        return;
    } else if (u_passIndex == 28) {
        executeGradient4(coord, width, height);
        return;
    } else if (u_passIndex == 22) {
        executeTimeSlice(coord, width, height);
        return;
    } else if (u_passIndex == 24) {
        executeTimeSliceStore(coord, width, height);
        return;
    }

    // =========================================================================
    // PASS 0: PRIMARY GRADE -> HDR half-float composite
    // =========================================================================
    int pixelIndex = coord.y * width + coord.x;
    vec4 rawPixel = unpackRGBA_Dynamic(pixelIndex, gBit);
    float resScale = gRes;
    int edgeStep = gEdgeStep;
    vec2 uvN = (vec2(coord) + 0.5) / vec2(width, height);

    // ---- STAGE 1: DEBAND (works in gamma space, restores 8-bit source gradients) ----
    vec3 srcS = rawPixel.rgb;
    {
        float dRad = 0.0;
        float dThr = 0.02;
        int totalL = int(clamp(u_layerCount, 1.0, 10.0));
        for (int i = 0; i < totalL; i++) {
            if (layers[i].isEnabled > 0.5 && layers[i].debandRadius > dRad) {
                dRad = layers[i].debandRadius;
                dThr = layers[i].debandThreshold;
            }
        }
        if (dRad > 0.01) {
            float radius = max(1.5, dRad * 7.0 * resScale);
            float thr = max(dThr, 0.004) * 1.6;
            float rot = hash12(vec2(coord) + 3.7) * 6.2831853;
            vec3 sum = srcS;
            vec3 cnt = vec3(1.0);
            for (int k = 0; k < 14; k++) {
                float fr = (float(k) + 0.5) / 14.0;
                float ang = rot + float(k) * 2.39996323;
                float rr = (0.25 + 0.75 * fr) * radius;
                vec3 s = srcSrgb(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr)));
                vec3 m = step(abs(s - srcS), vec3(thr));
                sum += s * m;
                cnt += m;
            }
            vec3 avg = sum / cnt;
            vec3 n = vec3(hash12(vec2(coord) * 1.13 + 11.0), hash12(vec2(coord) * 0.77 + 51.0), hash12(vec2(coord) * 1.71 + 91.0)) - 0.5;
            srcS = clamp(avg + n * (1.0 / 255.0) * clamp(dRad, 0.0, 1.0), 0.0, 1.0);
        }
    }
    vec3 src0 = srgbToLinear(srcS);
    vec3 currentComposite = src0;

    // ---- STAGE 2: LINE THINNING (layer 0 slot, kept as-is) ----
    LayerData L0 = layers[0];
    if (L0.lineThinning > 0.01) {
        vec3 colT = srcLin(coord + ivec2(0,  edgeStep));
        vec3 colB = srcLin(coord + ivec2(0, -edgeStep));
        vec3 colL = srcLin(coord + ivec2(-edgeStep, 0));
        vec3 colR = srcLin(coord + ivec2( edgeStep, 0));
        float lumaC = luma(currentComposite);
        float lumaT = luma(colT); float lumaB = luma(colB);
        float lumaL = luma(colL); float lumaR = luma(colR);
        float edgeGrad = sqrt((lumaR - lumaL) * (lumaR - lumaL) + (lumaT - lumaB) * (lumaT - lumaB));
        if (edgeGrad > L0.lineThinningThreshold) {
            float minLuma = min(min(lumaT, lumaB), min(lumaL, lumaR));
            if (minLuma < lumaC) {
                vec3 darkest = colT;
                if (lumaB == minLuma) darkest = colB;
                if (lumaL == minLuma) darkest = colL;
                if (lumaR == minLuma) darkest = colR;
                currentComposite = mix(currentComposite, darkest, clamp(L0.lineThinning * 0.65, 0.0, 1.0));
            }
        }
    }

    // ---- Sobel gradient (source) for edge normal / line masks ----
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float lum = luma(srcLin(coord + ivec2(x * edgeStep, y * edgeStep)));
            gx += lum * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lum * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);
    vec2 edgeNormal = (lineEdge > 0.05) ? normalize(vec2(gx, gy)) : vec2(0.0);

    // ---- STAGE 3: MULTI-LAYER STACK ----
    int totalLayers = int(clamp(u_layerCount, 1.0, 10.0));

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;

        vec3 layerColor = currentComposite;

        vec3 fxPreDof = layerColor;
        // 1. Depth of field (tilt band or radial), disc blur with bokeh highlight emphasis
        if (L.depthOfField > 0.01) {
            float dist;
            if (L.dofMode > 0.5) {
                vec2 dd = uvN - vec2(0.5, L.dofFocus);
                dd.x *= float(width) / float(height);
                dist = length(dd);
            } else {
                dist = abs(uvN.y - L.dofFocus);
            }
            float rng = clamp(L.dofRange, 0.0, 1.0) * 0.5;
            float fall = max(0.02, L.dofFalloff * 0.6);
            float coc = smoothstep(rng, rng + fall, dist);
            float r = coc * L.depthOfField * 22.0 * resScale;
            if (r > 0.6) {
                vec3 acc = vec3(0.0);
                float wsum = 0.0;
                const int DOF_TAPS = 28;
                for (int k = 0; k < DOF_TAPS; k++) {
                    float fr = (float(k) + 0.5) / float(DOF_TAPS);
                    float rr = sqrt(fr) * r;
                    float th = float(k) * 2.39996323 + L.dofAngle;
                    vec3 s = srcLin(coord + ivec2(round(vec2(cos(th), sin(th)) * rr)));
                    float lw = 1.0 + L.dofBokeh * 6.0 * smoothstep(0.55, 1.2, luma(s));
                    acc += s * lw;
                    wsum += lw;
                }
                layerColor += (acc / wsum - src0) * smoothstep(0.0, 0.15, coc);
            }
        }

        layerColor = fxMix(fxPreDof, layerColor, fx[i].f[12], 0.0);
        // 1b. DOF focus preview: tints the zone that is IN FOCUS green so the focal plane / range can be set by eye
        if (L.dofPreview > 0.5 && L.depthOfField > 0.01) {
            float pd;
            if (L.dofMode > 0.5) {
                vec2 pdd = uvN - vec2(0.5, L.dofFocus);
                pdd.x *= float(width) / float(height);
                pd = length(pdd);
            } else {
                pd = abs(uvN.y - L.dofFocus);
            }
            float prng = clamp(L.dofRange, 0.0, 1.0) * 0.5;
            float pfall = max(0.02, L.dofFalloff * 0.6);
            float pcoc = smoothstep(prng, prng + pfall, pd);
            float focusLine = 1.0 - smoothstep(0.0, 0.004, pd);
            layerColor = mix(layerColor, vec3(0.05, 0.95, 0.35) * max(luma(layerColor), 0.15) * 2.0, (1.0 - pcoc) * 0.35);
            layerColor = mix(layerColor, vec3(1.0, 0.9, 0.1), focusLine * 0.8);
        }
        // 2. Edge chromatic aberration (delta)
        if (L.lineChromaStrength > 0.001 && lineEdge > 0.05) {
            float edgeFactor = smoothstep(0.08, 0.35, lineEdge);
            ivec2 sh = ivec2(round(edgeNormal * (L.lineChromaStrength * 3.0 * resScale)));
            vec3 sr = srcLin(coord + sh);
            vec3 sb = srcLin(coord - sh);
            layerColor.r += (sr.r - src0.r) * edgeFactor * 0.80;
            layerColor.b += (sb.b - src0.b) * edgeFactor * 0.80;
        }

        // 3. RGB directional warp shift (delta)
        if (L.copiedChromaShift > 0.001) {
            ivec2 cs = ivec2(int(round(L.copiedChromaShift * 6.0 * resScale)), 0);
            vec3 sr = srcLin(coord + cs);
            vec3 sb = srcLin(coord - cs);
            layerColor.r += sr.r - src0.r;
            layerColor.b += sb.b - src0.b;
        }

        // 3b. RADIAL chromatic aberration (lens style): red is pushed outward and blue pulled inward along the
        //     line from the frame centre, growing with distance (zero at the centre, strongest in the corners).
        if (L.radialChroma > 0.001) {
            vec2 sz = vec2(float(width), float(height));
            vec2 rc = (vec2(coord) + 0.5) - sz * 0.5;
            vec2 rdir = rc / max(0.5 * length(sz), 1.0);             // ~1 in the corners
            float rlen = length(rdir);
            vec2 shiftPx = rdir * rlen * (L.radialChroma * 14.0 * resScale);
            vec3 srR = srcLinBilinear(vec2(coord) + 0.5 + shiftPx);
            vec3 srB = srcLinBilinear(vec2(coord) + 0.5 - shiftPx);
            layerColor.r += srR.r - src0.r;
            layerColor.b += srB.b - src0.b;
        }

        // 4. Denoise: edge-aware bilateral, chroma cleaned harder than luma
        if (L.denoise > 0.01) {
            float dn = clamp(L.denoise, 0.0, 1.0);
            int dRad = clamp(int(round(1.0 + dn * 2.6 * resScale * 0.8)), 1, 4);
            float sigS = max(1.2, float(dRad) * 0.7);
            float sigR = mix(0.035, 0.18, dn);
            vec3 pc = sqrt(src0);
            vec3 acc = src0;
            float wsum = 1.0;
            for (int dy = -dRad; dy <= dRad; dy++) {
                for (int dx = -dRad; dx <= dRad; dx++) {
                    if (dx == 0 && dy == 0) continue;
                    vec3 s = srcLin(coord + ivec2(dx, dy));
                    vec3 ps = sqrt(s);
                    float sd = float(dx * dx + dy * dy);
                    vec3 dc = pc - ps;
                    float rd = dot(dc, dc);
                    float w = exp(-sd / (2.0 * sigS * sigS)) * exp(-rd / (2.0 * sigR * sigR));
                    acc += s * w;
                    wsum += w;
                }
            }
            vec3 avg = acc / wsum;
            float lC = luma(src0);
            float lA = luma(avg);
            vec3 target = vec3(mix(lC, lA, clamp(dn * 0.85, 0.0, 1.0))) + mix(src0 - vec3(lC), avg - vec3(lA), clamp(dn * 1.15, 0.0, 1.0));
            layerColor += (max(target, vec3(0.0)) - src0) * (1.0 - lineEdge * 0.25);
        }

        // 5. Anime skin smoothing: Oklab skin-tone mask + ink-line shielding.
        //    v2.5: the old version protected every colour step (cel-shadow edges) as if it were ink and used a tiny
        //    kernel, so on flat cel skin it changed nothing. Now: a 40-tap bilateral whose taps must THEMSELVES be skin
        //    (hair / eyes / clothes / ink can never bleed in, so the reach can be much wider), only real ink lines
        //    are shielded, and the slider curve is front-loaded so low values are visible.
        if (L.bilateralIntensity > 0.01) {
            vec3 lab0 = linearRgbToOklab(src0);
            float chroma0 = length(lab0.yz);
            float hue0 = atan(lab0.z, lab0.y);
            float skin = smoothstep(0.30, 0.55, hue0) * (1.0 - smoothstep(1.20, 1.50, hue0))
                       * smoothstep(0.010, 0.035, chroma0) * (1.0 - smoothstep(0.13, 0.19, chroma0))
                       * smoothstep(0.30, 0.50, lab0.x);
            // ink shielding: dark-line proximity (centre and 4 neighbours) + only STRONG luminance edges
            float inkMax = 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord)));
            int inkR = max(2, edgeStep * 2);
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord + ivec2(inkR, 0)))));
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord - ivec2(inkR, 0)))));
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord + ivec2(0, inkR)))));
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord - ivec2(0, inkR)))));
            // Colour steps (cel-shadow edges) are exactly what this should soften, so only real ink protects.
            float prot = 1.0 - inkMax;
            if (skin > 0.01 && prot > 0.01) {
                float rad = clamp((1.0 + L.bilateralRadius * 2.2) * resScale, 1.5, 14.0);
                float sigS = max(1.0, rad * 0.55);
                // Range: how big a tonal step still counts as "the same surface" (small = keep shading edges).
                float sigR = 0.05 + clamp(L.bilateralRange, 0.0, 1.0) * 0.55;
                vec3 pc = sqrt(src0);
                vec3 acc = src0;
                float wsum = 1.0;
                const int SK_TAPS = 40;
                for (int k = 0; k < SK_TAPS; k++) {
                    float fr = (float(k) + 0.5) / float(SK_TAPS);
                    float rr = rad * sqrt(fr);                       // uniform disc density
                    float ang = float(k) * 2.39996323;
                    vec2 off = vec2(cos(ang), sin(ang)) * rr;
                    vec3 s = srcLin(coord + ivec2(round(off)));
                    vec3 dc = pc - sqrt(s);
                    float inkTap = smoothstep(0.012, 0.060, luma(s));          // near-black ink never contributes
                    float skinTap = smoothstep(0.25, 0.75, skinMaskOf(s));     // only skin blends into skin
                    float w = exp(-(rr * rr) / (2.0 * sigS * sigS)) * exp(-dot(dc, dc) / (2.0 * sigR * sigR)) * inkTap * skinTap;
                    acc += s * w;
                    wsum += w;
                }
                vec3 smoothC = acc / wsum;
                float amt = 1.0 - pow(1.0 - clamp(L.bilateralIntensity, 0.0, 1.0), 2.2);   // 0.1 -> 0.21, 0.5 -> 0.78
                layerColor += (smoothC - src0) * amt * skin * prot;
                layerColor *= 1.0 + skin * prot * amt * 0.03;
            }
        }

        // 6. Frequency unsharp mask (delta on source detail)
        if (L.unsharpAmount > 0.01) {
            int uRad = int(clamp(L.unsharpRadius * resScale, 1.0, 6.0));
            vec3 lowPass = vec3(0.0);
            float uW = 0.0;
            for (int uy = -uRad; uy <= uRad; uy += 2) {
                for (int ux = -uRad; ux <= uRad; ux += 2) {
                    lowPass += srcLin(coord + ivec2(ux, uy));
                    uW += 1.0;
                }
            }
            lowPass /= max(uW, 1.0);
            vec3 highPass = src0 - lowPass;
            float diffLum = abs(luma(highPass));
            if (diffLum >= L.unsharpThreshold) {
                float boost = smoothstep(L.unsharpThreshold, L.unsharpThreshold + 0.10, diffLum);
                layerColor += highPass * (L.unsharpAmount * boost * 1.3);
            }
        }

        // 7. Acutance sharpness (delta)
        if (L.sharpness > 0.01) {
            vec3 blur = srcLin(coord + ivec2(0, -edgeStep)) + srcLin(coord + ivec2(0, edgeStep))
                      + srcLin(coord + ivec2(-edgeStep, 0)) + srcLin(coord + ivec2(edgeStep, 0));
            blur *= 0.25;
            layerColor += (src0 - blur) * (L.sharpness * 1.5);
        }

        // 8. S_lining: line-art detection -> tiny inner grey-black blur on the edges
        //    slider 1 (darkOutlines) = intensity + radius, slider 2 (sLiningOpacity) = opacity
        if (L.darkOutlines > 0.01 && L.sLiningOpacity > 0.01) {
            float radius = (1.6 + L.darkOutlines * 5.0) * resScale;
            float sigma = radius * 0.55;
            float cLuma = dot(srcSrgb(coord), vec3(0.2126, 0.7152, 0.0722));
            float centerLine = 1.0 - smoothstep(0.06, 0.30, cLuma);
            float acc = 0.0;
            float wacc = 0.0;
            const int SL_TAPS = 22;
            for (int k = 0; k < SL_TAPS; k++) {
                float fr = (float(k) + 0.5) / float(SL_TAPS);
                float rr = sqrt(fr) * radius;
                float ang = float(k) * 2.39996323;
                float sl = dot(srcSrgb(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr))), vec3(0.2126, 0.7152, 0.0722));
                float lineness = 1.0 - smoothstep(0.06, 0.30, sl);
                float w = exp(-(rr * rr) / (2.0 * sigma * sigma));
                acc += lineness * w;
                wacc += w;
            }
            float halo = acc / max(wacc, 1e-4);
            float mask = (1.0 - exp(-halo * 4.2)) * (1.0 - centerLine);   // soft, saturating falloff
            vec3 inner = mix(layerColor * 0.12, vec3(0.020), 0.45);        // soft dark, not on the line itself
            float amt = mask * (0.85 + 0.65 * L.darkOutlines) * L.sLiningOpacity * 1.25;
            layerColor = mix(layerColor, inner, clamp(amt, 0.0, 1.0));
        }
        // 7b. CLARITY / LOCAL CONTRAST: large-radius, midtone-weighted local contrast. Works on perceptual
        //     luma and scales colour multiplicatively, so hue is kept and highlights / shadows don't halo.
        if (abs(L.clarity) > 0.001) {
            float cR = (5.0 + L.clarityRadius * 20.0) * resScale;
            float cSig = cR * 0.55;
            float lowAcc = 0.0;
            float lowW = 0.0;
            const int CL_TAPS = 24;
            for (int k = 0; k < CL_TAPS; k++) {
                float fr = (float(k) + 0.5) / float(CL_TAPS);
                float rr = sqrt(fr) * cR;
                float ang = float(k) * 2.39996323;
                float sl = sqrt(max(luma(srcLin(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr)))), 0.0));
                float w = exp(-(rr * rr) / (2.0 * cSig * cSig));
                lowAcc += sl * w;
                lowW += w;
            }
            float lc = sqrt(max(luma(src0), 0.0));
            float dl = clamp(lc - (lowAcc + lc) / (lowW + 1.0), -0.22, 0.22);   // detail vs local average
            float mid = clamp(4.0 * lc * (1.0 - lc), 0.0, 1.0);
            mid = 0.25 + 0.75 * mid;
            layerColor *= exp2(dl * L.clarity * 3.0 * mid);
        }

        // 8b. COLOURED LINE ART: only thin ink lines are recoloured (never solid black areas). The colour is a
        //     darker, richer version of the fill the line borders, so the line belongs to the picture.
        //     Placement: 0 = every thin line, 0.5 = only lines next to lit areas, 1 = only skin contours.
        if (L.lineArtStrength > 0.01) {
            float cL = luma(srcSrgb(coord));
            float inkSelf = 1.0 - smoothstep(0.10, 0.34, cL);
            if (inkSelf > 0.02) {
                float laR = (1.5 + L.lineArtWidth * 4.5) * resScale;
                float inkMass = 0.0;
                vec3 fillAcc = vec3(0.0);
                float fillW = 0.0;
                const int LA_TAPS = 16;
                for (int k = 0; k < LA_TAPS; k++) {
                    float fr = (float(k) + 0.5) / float(LA_TAPS);
                    float rr = (0.35 + 0.65 * fr) * laR;
                    float ang = float(k) * 2.39996323;
                    vec3 sSrgb = srcSrgb(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr)));
                    float ink = 1.0 - smoothstep(0.10, 0.34, luma(sSrgb));
                    inkMass += ink;
                    float wf = 1.0 - ink;
                    fillAcc += srgbToLinear(sSrgb) * wf;
                    fillW += wf;
                }
                inkMass /= float(LA_TAPS);
                float thinLine = inkSelf * (1.0 - smoothstep(0.35, 0.70, inkMass));
                if (fillW > 0.5 && thinLine > 0.01) {
                    vec3 fillCol = fillAcc / fillW;
                    float lit = smoothstep(0.08, 0.40, luma(fillCol));
                    float skinF = skinMaskOf(fillCol);
                    float pl = clamp(L.lineArtPlacement, 0.0, 1.0);
                    float place = mix(1.0, lit, clamp(pl * 2.0, 0.0, 1.0));
                    place = mix(place, skinF, clamp(pl * 2.0 - 1.0, 0.0, 1.0));
                    vec3 lineCol = saturateColor(fillCol, 1.0 + L.lineArtSaturation * 1.2) * 0.42;
                    layerColor = mix(layerColor, lineCol, clamp(thinLine * place * L.lineArtStrength * 0.9, 0.0, 1.0));
                }
            }
        }

        vec3 fxPreEb = layerColor;
        // 8c. SKIN EDGE BLEED (v2.6): the inner rim of the skin picks up depth. The old version only nudged the
        //     saturation of a 16-tap neighbourhood at constant brightness, which on flat cel skin changed nothing.
        //     Now rays look for the nearest non-skin pixel (ink, hair, clothes, background); inside that reach the skin
        //     is pulled toward a deeper, warmer, slightly darker tone, mixed with the colour of whatever it borders,
        //     fading smoothly inward. Depth = strength, Width = how far the rim reaches.
        if (L.skinEdgeBleed > 0.01) {
            float skinC = skinMaskOf(src0);
            float inkC = 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord)));
            if (skinC > 0.05 && inkC < 0.7) {
                float reach = (3.0 + L.skinEdgeWidth * 18.0) * resScale;
                vec3 outAcc = vec3(0.0);
                float outW = 0.0;
                vec3 inAcc = src0 * skinC;
                float inW = skinC;
                float prox = 0.0;
                float proxSum = 0.0;
                float ebRot = hash12(vec2(coord) + 17.0) * 0.785398;      // per-pixel ray rotation: no fixed ray pattern = no blocks
                for (int rI = 0; rI < 8; rI++) {
                    float ang = (float(rI) + 0.5) * 0.78539816 + ebRot;            // 45 degree spacing
                    vec2 dir = vec2(cos(ang), sin(ang));
                    for (int sI = 1; sI <= 4; sI++) {
                        float fr = float(sI) * 0.25;
                        vec3 s = srcLinBilinear(vec2(coord) + 0.5 + dir * (reach * fr));   // bilinear, not nearest: smooth, no stair-steps
                        float sk = skinMaskOf(s);
                        float notSkin = 1.0 - smoothstep(0.25, 0.75, sk);
                        float wd = 1.0 - 0.85 * (fr - 0.25);                      // 1.0 near .. 0.36 far
                        prox = max(prox, notSkin * wd);
                        proxSum += notSkin * wd;
                        float ink = 1.0 - smoothstep(0.006, 0.06, luma(s));
                        float isOut = notSkin * (1.0 - ink) * wd;
                        outAcc += s * isOut;
                        outW += isOut;
                        inAcc += s * sk;
                        inW += sk;
                    }
                }
                prox = mix(prox, clamp(proxSum * 0.12, 0.0, 1.0), 0.5);   // blend the hard max with the mean: continuous, not stepped
                float band = smoothstep(0.0, 0.85, prox);
                vec3 insideCol = inAcc / max(inW, 1e-4);
                vec3 outsideCol = (outW > 0.2) ? outAcc / outW : insideCol;
                vec3 deep = saturateColor(insideCol, 1.80) * vec3(1.00, 0.80, 0.74) * 0.86;   // deeper, warmer, a little darker
                vec3 bleed = mix(deep, outsideCol, 0.30);
                bleed *= (0.90 * luma(layerColor)) / max(luma(bleed), 1e-4);
                layerColor = mix(layerColor, bleed, clamp(skinC * band * (1.0 - inkC) * L.skinEdgeBleed * 0.90, 0.0, 0.95));
            }
        }

        layerColor = fxMix(fxPreEb, layerColor, fx[i].f[13], 0.0);
        // 8d. EDGE DARKEN (v2.5)
        //     (1) line art: the ink core and its anti-aliased edge get a slight darkening (edgeDarken).
        //     (2) inner spread: the FILL beside every line gets a soft blur that reaches inward from the line
        //         (edgeDarkenBlur = strength and reach). It is a blur of the source around the pixel, so the dark of the
        //         line bleeds a little way into the fill and any shading detail next to the line is softened;
        //         the line itself stays crisp, and a gentle extra darkening fades inward with the same reach.
        //         Applied as a DELTA so earlier grades survive.
        if (L.edgeDarken > 0.01 || L.edgeDarkenBlur > 0.01) {
            float ed = clamp(L.edgeDarken, 0.0, 1.0);
            float eb = clamp(L.edgeDarkenBlur, 0.0, 1.0);
            float selfInk = 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord)));
            float innerEdge = smoothstep(0.10, 0.45, lineEdge);

            // (1) line core + AA edge
            layerColor *= 1.0 - max(innerEdge, selfInk * 0.8) * ed * 0.40;

            // (2) inner spread. 12 rays x 5 steps looking for ink; reach grows with the slider.
            if (selfInk < 0.85 && (eb > 0.01 || ed > 0.30)) {
                float reach = (2.5 + 11.0 * max(eb, 0.25 * ed)) * resScale;
                vec3 accAll = src0;
                float wAll = 1.0;
                vec3 accFill = src0;
                float wFill = 1.0;
                float prox = 0.0;                                   // 0 = no ink in reach, 1 = ink right next to us
                for (int rI = 0; rI < 12; rI++) {
                    float ang = (float(rI) + 0.5) * 0.52359878;      // 30 degree spacing, offset so axes are not special
                    vec2 dir = vec2(cos(ang), sin(ang));
                    for (int sI = 0; sI < 5; sI++) {
                        float fr = float(sI + 1) / 5.0;
                        vec3 sS = srcSrgb(coord + ivec2(round(dir * (reach * fr))));
                        vec3 sL = srgbToLinear(sS);
                        float ink = 1.0 - smoothstep(0.08, 0.28, luma(sS));
                        float wd = 1.0 - 0.55 * fr;                  // nearer taps count more
                        accAll += sL * wd;
                        wAll += wd;
                        accFill += sL * wd * (1.0 - ink);
                        wFill += wd * (1.0 - ink);
                        prox = max(prox, ink * (1.0 - 0.8 * (fr - 0.2)));   // max, not mean: a thin line still counts fully
                    }
                }
                vec3 blurAll = accAll / wAll;
                vec3 blurFill = accFill / wFill;
                vec3 soft = mix(blurFill, blurAll, 0.60);            // 40% pure fill softening, 60% line darkness bleeding in
                float band = smoothstep(0.0, 0.55, prox) * (1.0 - selfInk) * (1.0 - innerEdge * 0.35);
                layerColor += (soft - src0) * band * eb * 0.90;
                layerColor *= 1.0 - band * band * ed * 0.18;         // gentle inward darkening that fades with distance
            }
        }

        // 9. Colour temperature
        if (L.temperature > 1000.0 && abs(L.temperature - 6500.0) > 30.0) {
            layerColor *= colorTempToRGB(L.temperature) / colorTempToRGB(6500.0);
        }

        // 9b. EXPOSURE: a true photographic exposure, i.e. multiply scene-linear light by 2^EV.
        //     (Slider -0.8..0.8 = -1.6..+1.6 stops.) Scales everything together, so black stays black,
        //     highlights go up the most and mids follow - unlike gamma, which only bends the mids.
        //     The old version added a constant to Oklab L, which lifted blacks like a gamma/lift.
        if (abs(L.brightness) > 0.001) layerColor *= exp2(L.brightness * 2.0);

        // ---- OKLAB perceptual grading ----
        vec3 lab = linearRgbToOklab(layerColor);

        // 10. Contrast, shadows / highlights, gamma
        if (abs(L.contrast - 1.0) > 0.001) lab.x = (lab.x - 0.50) * L.contrast + 0.50;
        lab.x = max(lab.x, 0.0);

        if (L.blackCrush > 0.01) lab.x = smoothstep(L.blackCrush * 0.08, 1.0, lab.x);

        lab.x += lab.x * (L.shadows * (1.0 - smoothstep(0.0, 0.45, lab.x)) * 0.30);
        lab.x += lab.x * (L.highlights * smoothstep(0.55, 1.0, lab.x) * 0.30);
        if (abs(L.gamma - 1.0) > 0.001) lab.x = pow(max(lab.x, 0.0), 1.0 / max(L.gamma, 0.001));

        // 11. Mojo teal & orange
        if (L.mblMojoTealOrange > 0.01) {
            float shadowMask = clamp(1.0 - lab.x * 1.8, 0.0, 1.0);
            float warmMask = clamp((lab.x - 0.35) * 1.5, 0.0, 1.0);
            lab.z -= shadowMask * L.mblMojoTealOrange * 0.045;
            lab.y -= shadowMask * L.mblMojoTealOrange * 0.015;
            lab.y += warmMask * L.mblMojoTealOrange * 0.025;
            lab.z += warmMask * L.mblMojoTealOrange * 0.035;
        }

        // 12. Deep teal with skin shielding
        if (L.deepTeal > 0.01) {
            float deepShadowMask = clamp(1.0 - lab.x * 1.8, 0.0, 1.0);
            bool isSkin = (lab.y > 0.015 && lab.z > 0.015);
            float shield = isSkin ? 0.15 : 1.0;
            lab.z -= deepShadowMask * L.deepTeal * 0.055 * shield;
            lab.y -= deepShadowMask * L.deepTeal * 0.025 * shield;
        }

        // 13. Colorista 3-way
        if (abs(L.mblColoristaLift) > 0.001 || abs(L.mblColoristaGamma) > 0.001 || abs(L.mblColoristaGain) > 0.001) {
            lab.x += L.mblColoristaLift * (1.0 - lab.x) * 0.35;
            lab.x = pow(max(0.0, lab.x), 1.0 / max(1.0 + L.mblColoristaGamma * 0.40, 0.01));
            lab.x += L.mblColoristaGain * lab.x * 0.35;
        }

        // 14. Cosmo skin protection
        if (L.cosmoCleanHighlight > 0.01) {
            float faceMask = smoothstep(0.50, 0.85, lab.x) * (1.0 - lineEdge);
            lab.yz = mix(lab.yz, lab.yz * 0.85, faceMask * L.cosmoCleanHighlight * 0.40);
        }

        // 15. (removed in batch 4: curves are now the free-point Curves v2 block, applied at step 17)
        if (L.magicCurves > 0.01) {
            float lx = clamp(lab.x, 0.0, 1.0);
            float s = lx * lx * (3.0 - 2.0 * lx);
            lab.x = mix(lab.x, s, L.magicCurves * 0.50);
        }

        // 16. Saturation & hue rotation
        // Saturation slider = saturation below 1.0, VIBRANCE above 1.0 (continuous at 1.0).
        //  0..1  : plain Oklab chroma scale (0 = fully grey)
        //  1..2.5: dull colours get the boost, already-vivid colours barely move, skin tones are
        //          protected, so pushing it up no longer turns skin/eyes neon or clips them.
        if (L.saturation <= 1.0) {
            lab.yz *= max(L.saturation, 0.0);
        } else {
            float boost = L.saturation - 1.0;
            float cch = length(lab.yz);
            float lowChroma = 1.0 - smoothstep(0.05, 0.28, cch);          // 1 = dull, 0 = already vivid
            float wv = mix(0.12, 1.0, lowChroma);                          // vivid colours still move a little
            float vh = atan(lab.z, lab.y);
            float skinV = smoothstep(0.30, 0.55, vh) * (1.0 - smoothstep(1.20, 1.50, vh))
                        * smoothstep(0.015, 0.040, cch) * (1.0 - smoothstep(0.13, 0.19, cch))
                        * smoothstep(0.42, 0.62, lab.x);
            wv *= 1.0 - 0.65 * skinV;
            lab.yz *= 1.0 + boost * wv;
        }
        if (abs(L.hue) > 0.001) lab.yz = oklabRotateHue(lab.yz, L.hue * 3.14159265);

        // 16a. CHROMA CONTRAST: S-curve on Oklab chroma around mid-chroma. + pulls dull colours down and
        //      vivid ones up (more separation), - flattens everything toward the middle. Monotone for -1..1.
        if (abs(L.chromaContrast) > 0.001) {
            float cc0 = length(lab.yz);
            if (cc0 > 1e-5) {
                float cn = clamp(cc0 / 0.30, 0.0, 1.0);
                float cs = cn * cn * (3.0 - 2.0 * cn);
                float cn2 = mix(cn, cs, clamp(L.chromaContrast, -1.0, 1.0));
                lab.yz *= max(cc0 + (cn2 - cn) * 0.30, 0.0) / cc0;
            }
        }

        // 16b. HUE vs SATURATION / HUE / LUMINANCE: 8 periodic hue bands (partition-of-unity blend, so
        //      neighbouring bands never leave gaps or steps) + one custom hue-range qualifier. Works on the
        //      same Oklab hue axis the Hue slider rotates. Greys are ignored (they have no hue).
        {
            bool hsOn = false;
            for (int hb = 0; hb < 8; hb++) {
                if (abs(L.hsSat[hb]) > 0.002 || abs(L.hsHue[hb]) > 0.002 || abs(L.hsLum[hb]) > 0.002) hsOn = true;
            }
            bool cuOn = abs(L.hsCustomSat) > 0.002 || abs(L.hsCustomHue) > 0.002 || abs(L.hsCustomLum) > 0.002;
            float chroma16 = length(lab.yz);
            if ((hsOn || cuOn) && chroma16 > 1e-4) {
                const float HS_C[8] = float[8](29.0, 65.0, 110.0, 142.0, 195.0, 264.0, 305.0, 340.0);
                float hDeg = degrees(atan(lab.z, lab.y));
                if (hDeg < 0.0) hDeg += 360.0;
                float dSat = 0.0;
                float dHue = 0.0;
                float dLum = 0.0;
                if (hsOn) {
                    int i0 = 7;
                    for (int hb = 0; hb < 8; hb++) { if (hDeg >= HS_C[hb]) i0 = hb; }
                    int i1 = (i0 + 1) & 7;
                    float span = HS_C[i1] - HS_C[i0];
                    if (span <= 0.0) span += 360.0;
                    float dh = hDeg - HS_C[i0];
                    if (dh < 0.0) dh += 360.0;
                    float tb = clamp(dh / span, 0.0, 1.0);
                    float hsEdge = (1.0 - clamp(L.hsSoftness, 0.0, 1.0)) * 0.45;
                    tb = smoothstep(hsEdge, 1.0 - hsEdge, tb);
                    dSat = mix(L.hsSat[i0], L.hsSat[i1], tb);
                    dHue = mix(L.hsHue[i0], L.hsHue[i1], tb);
                    dLum = mix(L.hsLum[i0], L.hsLum[i1], tb);
                }
                if (cuOn) {
                    float hc = fract(L.hsCustomCenter) * 360.0;
                    float dist = abs(hDeg - hc);
                    dist = min(dist, 360.0 - dist);
                    float halfW = clamp(L.hsCustomWidth, 0.0, 1.0) * 90.0;
                    float feather = max(clamp(L.hsCustomSoft, 0.0, 1.0) * 90.0, 2.0);
                    float wq = 1.0 - smoothstep(halfW, halfW + feather, dist);
                    dSat += wq * L.hsCustomSat;
                    dHue += wq * L.hsCustomHue;
                    dLum += wq * L.hsCustomLum;
                }
                dSat = clamp(dSat, -1.0, 1.0);
                dHue = clamp(dHue, -1.0, 1.0);
                dLum = clamp(dLum, -1.0, 1.0);
                float hueGate = smoothstep(0.003, 0.035, chroma16);
                float lumGate = smoothstep(0.010, 0.070, chroma16);
                float hAng = dHue * 0.90 * hueGate;
                float hCa = cos(hAng);
                float hSa = sin(hAng);
                lab.yz = vec2(lab.y * hCa - lab.z * hSa, lab.y * hSa + lab.z * hCa);
                lab.yz *= (dSat >= 0.0) ? (1.0 + dSat * 1.5) : (1.0 + dSat);
                lab.x *= 1.0 + dLum * 0.30 * lumGate;
            }
        }

        layerColor = oklabToLinearRgb(lab);

        // 17. CURVES v2 (batch 4): RGB composite + R / G / B, free monotone points, display-space like AE, never clips or inverts.
        {
            vec3 fxPreCv = layerColor;
            layerColor = fxMix(fxPreCv, fxCurves(layerColor, i), fx[i].f[0], 0.0);
        }

        // 17b. COLORISTA: Lift / Gamma / Gain / Offset colour wheels (+ the luma sliders already applied in
        //      step 13), range saturation, contrast + pivot, temperature / tint, preserve-luma, mix.
        //      Works per channel in gamma space like the RGB curves (AE / Magic Bullet behaviour).
        {
            vec2 wLift = vec2(L.cLiftX, L.cLiftY);
            vec2 wGamma = vec2(L.cGammaX, L.cGammaY);
            vec2 wGain = vec2(L.cGainX, L.cGainY);
            vec2 wOff = vec2(L.cOffX, L.cOffY);
            bool wheelsOn = (dot(wLift, wLift) + dot(wGamma, wGamma) + dot(wGain, wGain) + dot(wOff, wOff)) > 1e-6
                         || abs(L.cOffLuma) > 0.001;
            bool toneOn = abs(L.cSat - 1.0) > 0.002 || abs(L.cSatShadows) > 0.002 || abs(L.cSatMids) > 0.002 || abs(L.cSatHighs) > 0.002;
            bool conOn = abs(L.cContrast) > 0.002;
            bool ttOn = abs(L.cTemp) > 0.002 || abs(L.cTint) > 0.002;
            if (wheelsOn || toneOn || conOn || ttOn) {
                vec3 over = max(layerColor - 1.0, vec3(0.0));
                vec3 e0 = pow(clamp(layerColor, 0.0, 1.0), vec3(1.0 / 2.2));
                vec3 e = e0;
                float y0 = luma(e0);
                if (wheelsOn) {
                    e += wheelTint(wOff) * 0.20 + vec3(L.cOffLuma * 0.25);          // Offset: moves everything
                    e += wheelTint(wLift) * 0.30 * (1.0 - e);                       // Lift: weighs shadows most
                    e *= vec3(1.0) + wheelTint(wGain) * 0.60;                       // Gain: weighs highlights most
                    e = pow(max(e, vec3(0.0)), clamp(vec3(1.0) - wheelTint(wGamma) * 0.55, vec3(0.30), vec3(3.0)));   // Gamma: mids
                }
                if (ttOn) {
                    e.r *= 1.0 + 0.12 * L.cTemp;
                    e.b *= 1.0 - 0.12 * L.cTemp;
                    e.g *= 1.0 - 0.10 * L.cTint;
                    e.r *= 1.0 + 0.05 * L.cTint;
                    e.b *= 1.0 + 0.05 * L.cTint;
                }
                if (conOn) {
                    float piv = clamp(L.cPivot, 0.05, 0.95);
                    e = (e - vec3(piv)) * max(1.0 + L.cContrast, 0.0) + vec3(piv);
                }
                if (L.cPreserveLuma > 0.001) {
                    float y1 = luma(max(e, vec3(0.0)));
                    e *= mix(1.0, clamp(y0 / max(y1, 1e-4), 0.25, 4.0), clamp(L.cPreserveLuma, 0.0, 1.0));
                }
                if (toneOn) {
                    float yy = luma(max(e, vec3(0.0)));
                    float sR = max(L.cShadowRange, 0.05);
                    float hR = min(L.cHighRange, 0.95);
                    float shM = 1.0 - smoothstep(0.0, sR, yy);
                    float hiM = smoothstep(hR, 1.0, yy);
                    float miM = clamp(1.0 - shM - hiM, 0.0, 1.0);
                    float sat = L.cSat + shM * L.cSatShadows + miM * L.cSatMids + hiM * L.cSatHighs;
                    e = vec3(yy) + (e - vec3(yy)) * max(sat, 0.0);
                }
                e = mix(e0, e, clamp(L.cMix, 0.0, 1.0));
                layerColor = pow(max(e, vec3(0.0)), vec3(2.2)) + over;
            }
        }

        // 18. Split toning (per layer)
        if (L.splitToneShadowSat > 0.01 || L.splitToneHighSat > 0.01) {
            vec3 sTint = srgbToLinear(hueToRGB(L.splitToneShadowHue));
            vec3 hTint = srgbToLinear(hueToRGB(L.splitToneHighHue));
            float cl = luma(layerColor);
            float pivot = clamp(0.5 + L.splitToneBalance * 0.35, 0.1, 0.9);
            layerColor = mix(layerColor, layerColor * (sTint * 1.6 + vec3(0.1)), smoothstep(pivot, 0.0, cl) * L.splitToneShadowSat * 0.65);
            layerColor = mix(layerColor, layerColor * (hTint * 1.5 + vec3(0.1)), smoothstep(pivot, 1.0, cl) * L.splitToneHighSat * 0.65);
        }

        // 19. 4-point star glint
        float curLuma = luma(layerColor);
        if (L.copiedStarGlint > 0.01 && curLuma > 0.72) {
            float glint = 0.0;
            int gSpan = int(clamp(L.copiedStarGlint * 16.0 * resScale, 4.0, 24.0));
            for (int d = -gSpan; d <= gSpan; d += 2) {
                float decay = 1.0 - (abs(float(d)) / float(gSpan));
                glint += dot(srcLin(coord + ivec2(d, d)), vec3(0.333)) * decay;
                glint += dot(srcLin(coord + ivec2(d, -d)), vec3(0.333)) * decay;
            }
            glint = (glint / float(gSpan * 2)) * L.copiedStarGlint * 0.60;
            layerColor += vec3(glint);
        }

        // 20. Volumetric god rays
        if (L.bslaGodRays > 0.01) {
            vec2 sunPos = vec2(float(width) * 0.50, float(height) * 0.06);
            vec2 rayDir = normalize(vec2(coord) - sunPos + vec2(0.0001));
            vec3 rayAccum = vec3(0.0);
            float rayWeight = 0.0;
            float stepSize = float(max(width, height)) / 36.0;
            float jitter = hash12(vec2(coord) + vec2(u_time));
            for (int s = 1; s <= 20; s++) {
                float dist = (float(s) + jitter) * stepSize * 0.38;
                vec3 scCol = srcLin(ivec2(vec2(coord) - rayDir * dist));
                float shaftMask = smoothstep(0.50, 0.92, luma(scCol));
                float decay = exp(-0.07 * float(s));
                rayAccum += scCol * shaftMask * decay;
                rayWeight += decay;
            }
            if (rayWeight > 0.001) {
                layerColor += (rayAccum / rayWeight) * (L.bslaGodRays * 2.2) * vec3(1.15, 1.05, 0.90);
            }
        }

        vec3 fxPreFog = layerColor;
        // 21. Volumetric fog (BSL-shader style)
        //     * pseudo view distance: higher in frame = further away, plus a separate ground-fog layer
        //     * domain-warped, drifting fbm gives cloud banks + wisps (not a flat overlay)
        //     * per-channel Beer-Lambert extinction: blue scatters/extinguishes a bit more, so distance
        //       goes cool and desaturated the way real fog does
        //     * in-scatter colour comes from the scene's own sky/ground, plus a forward-scatter (Mie)
        //       sun glow around the same sun position the god rays use
        //     sliders: Fog Density = optical thickness, Fog Depth = how far the fog reaches / how high
        //     the ground fog climbs
        if (L.bslaFogDensity > 0.01) {
            float sigma = clamp(L.bslaFogDensity, 0.0, 1.0);
            float reach = clamp(L.bslaFogDepth, 0.0, 1.0);
            float aspectF = float(width) / float(height);
            float tf = u_time * 0.030;
            float yy = clamp(uvN.y, 0.0, 1.0);                       // 0 = top of frame, 1 = bottom

            // --- noise: domain warp -> banks (low freq) + wisps (high freq) + sun-aligned shafts ---
            vec2 wp = uvN * vec2(2.2 * aspectF, 2.2);
            vec2 warp = vec2(fbm(wp + vec2(tf, 3.1)), fbm(wp + vec2(7.7, -tf * 0.8))) - 0.5;
            vec2 npos = wp + warp * 1.6;
            float bank = fbm(npos * 1.0 + vec2(tf * 1.0, -tf * 0.45));
            float wisp = fbm(npos * 3.4 + vec2(-tf * 1.7, tf * 0.9) + 31.7);
            float vol = smoothstep(0.22, 0.82, mix(bank, wisp, 0.35));

            // --- pseudo depth + height fog ---
            float distFar = 1.0 - yy * 0.62;                                        // 0.38 (near) .. 1.0 (far)
            float groundFog = smoothstep(1.0 - (0.28 + reach * 0.62), 1.0, yy);   // thicker towards the bottom
            float column = (0.40 + 0.75 * reach) * distFar + 0.85 * groundFog;
            float dens = sigma * column * mix(0.40, 1.65, vol);

            // --- sun: same position as the god rays, forward-scatter lobe + soft shafts through the fog ---
            vec2 sunUV = vec2(0.50, 0.06);
            float sd = length((uvN - sunUV) * vec2(aspectF, 1.0));
            float mieTight = exp(-sd * 7.0);
            float mieWide = exp(-sd * 2.2);
            float shafts = fbm(vec2(uvN.x * 15.0 * aspectF, uvN.y * 1.4 - tf * 0.6) + 5.3);
            dens *= 1.0 + 0.30 * (shafts - 0.5) * mieWide;

            // keep ink / fine character detail readable: fog is thinner where detail is dense (= nearer)
            dens *= 1.0 - 0.30 * smoothstep(0.10, 0.50, lineEdge);
            dens = max(dens, 0.0);

            // --- Beer-Lambert, slightly stronger extinction in blue ---
            vec3 trans = exp(-dens * 3.2 * vec3(0.92, 1.00, 1.12));

            // --- in-scatter colour: sky above, ground below, both from the actual scene ---
            vec3 skyC = (srcLin(ivec2(width / 4, height / 8)) + srcLin(ivec2(3 * width / 4, height / 8))) * 0.5;
            vec3 gndC = (srcLin(ivec2(width / 4, 7 * height / 8)) + srcLin(ivec2(3 * width / 4, 7 * height / 8))) * 0.5;
            vec3 amb = (skyC + gndC) * 0.5;
            vec3 cool = srgbToLinear(vec3(0.62, 0.72, 0.84));
            vec3 hazeBase = mix(skyC, gndC, smoothstep(0.30, 0.95, yy));
            vec3 fogCol = mix(cool, hazeBase * 1.40 + cool * 0.20, 0.45);
            float ambL = clamp(luma(amb) * 2.4 + clamp(luma(layerColor), 0.0, 1.0) * 0.5, 0.0, 1.2);
            fogCol *= (0.30 + 0.70 * ambL);
            fogCol *= 1.0 + (bank - 0.5) * 0.40;                                  // lit banks vs shadowed banks
            vec3 sunTint = vec3(1.00, 0.80, 0.55);
            fogCol += sunTint * (mieWide * 0.16 + mieTight * 0.34) * (0.35 + 0.65 * vol) * (0.30 + 0.70 * ambL);
            fogCol = max(fogCol, vec3(0.0));

            layerColor = layerColor * trans + fogCol * (vec3(1.0) - trans);
        }

        // 21b. FOG v2 (batch 4)
        if (fx[i].f[53] > 0.01) {
            layerColor = fxFog(layerColor, i, coord, uvN, width, height);
        }
        layerColor = fxMix(fxPreFog, layerColor, fx[i].f[5], fx[i].f[20]);
        // 23. Film grain (luma-weighted, grows in mids like real stock)
        if (L.filmGrain > 0.001) {
            float noise = (hash12(vec2(coord) + vec2(u_time * 17.13, u_time * 31.37)) - 0.5);
            float lw = 0.35 + 0.65 * (1.0 - abs(clamp(luma(layerColor), 0.0, 1.0) - 0.45) * 1.4);
            layerColor += vec3(noise * L.filmGrain * 0.06 * lw);
        }

        // 24. Flicker
        if (L.flickerIntensity > 0.005) {
            float freq = max(L.flickerSpeed, 1.0) * 6.2831853;
            float fWave = sin(u_time * freq) * 0.5 + 0.5;
            layerColor *= (1.0 + (fWave - 0.5) * L.flickerIntensity * 0.30);
        }

        // 25. Vignettes (slightly gentler than v1)
        if (L.vignette > 0.01) {
            vec2 vuv = uvN - 0.5;
            layerColor *= clamp(smoothstep(0.78, 0.18, length(vuv) * (0.62 + L.vignette * 0.58)), 0.0, 1.0);
        }
        if (L.vignetteBoxed > 0.01) {
            vec2 buv = abs(uvN - 0.5) * 2.0;
            layerColor *= clamp(smoothstep(0.98, 0.22, max(buv.x, buv.y) * (0.62 + L.vignetteBoxed * 0.58)), 0.0, 1.0);
        }

        // 26. Centre aura + horizontal ramp
        if (L.centerAura > 0.01) {
            layerColor += vec3(smoothstep(0.60, 0.0, length(uvN - 0.5)) * L.centerAura * 0.30);
        }
        if (L.horizontalRamp > 0.01) {
            layerColor *= (1.0 + smoothstep(0.35, 0.65, uvN.y) * L.horizontalRamp * 0.30);
        }

        // 26b. EDGE SOFTNESS (batch 4)
        if (fx[i].f[60] > 0.01) {
            vec3 fxPreEs = layerColor;
            layerColor = fxMix(fxPreEs, fxEdgeSoftness(layerColor, i, coord, lineEdge, resScale), fx[i].f[7], 0.0);
        }
        // 26c. OVERALL BLEND: two colour regions -> one coherent look (batch 4)
        if (fx[i].f[45] > 0.01) {
            vec3 fxPreOb = layerColor;
            layerColor = fxMix(fxPreOb, fxOverallBlend(layerColor, i, coord, height), fx[i].f[6], 0.0);
        }
        // 26d. DUOTONE (batch 4)
        if (fx[i].f[33] > 0.5) {
            vec3 fxPreDu = layerColor;
            layerColor = fxMix(fxPreDu, fxDuotone(layerColor, i), fx[i].f[2], fx[i].f[19]);
        }

        // 27. Gradient Map (before the blend, so the layer's blend mode shapes it; always upstream of the LUT)
        if (gmaps[i].enabled > 0.5) {
            vec3 fxPreGm = layerColor;
            layerColor = fxMix(fxPreGm, gradientMapApply(layerColor, gmaps[i], coord, uvN, width, height), fx[i].f[1], fx[i].f[15]);
        }

        // Composite this layer (gamma-space blending by default = AE)
        currentComposite = applyBlendMode(currentComposite, max(layerColor, vec3(0.0)), int(L.blendMode + 0.5), L.opacity, L.blendLinear > 0.5);
    }

    // 28. TEXT SUITE (batch 5). Same razor-edge bevel as before (the clip is never blurred), now with:
    //       * a metal / silk face built from real reflection maths (textMetalFace), bands, Fresnel, dark body, ambient
    //       * ONE continuous deep glow (textGlowDisk): inverse-square falloff, rolloff slider goes high, no low clamp,
    //         positionable, wheel-coloured, hot core - replaces the 4 fixed sample rings that read as ghost copies
    //       * personal softener / mask range / fill pattern / overall opacity
    //     All personal values come from tx[] (see class TextFx in models.dart); without the block the old defaults apply.
    if (u_textSuiteEnabled > 0.5) {
        vec2 boxMin = vec2(u_textBoxX, u_textBoxY);
        vec2 boxSize = max(vec2(u_textBoxW, u_textBoxH), vec2(1e-3));
        vec2 whPx = vec2(float(width), float(height));
        float tpx = max(resScale, 0.5);

        float pStyle    = tfx(1, 0.0);
        float pRound    = tfx(2, 0.9);
        float pBands    = tfx(3, 2.0);
        float pBandAng  = tfx(4, 0.35);
        float pBandSft  = tfx(5, 0.25);
        float pBandStr  = tfx(6, 0.8);
        float pAniso    = tfx(7, 0.5);
        float pBodyDk   = tfx(8, 0.35);
        float pRim      = tfx(9, 1.0);
        float pAmb      = tfx(10, 0.35);
        float pFres     = tfx(11, 0.6);
        vec3  pHiW      = srgbToLinear(vec3(tfx(12, 1.0), tfx(13, 1.0), tfx(14, 1.0)));
        vec3  pBodyW    = srgbToLinear(vec3(tfx(15, 0.6), tfx(16, 0.6), tfx(17, 0.65)));
        float pTintMix  = tfx(18, 0.0);
        float pGInt     = tfx(20, 0.4);
        float pGRad     = tfx(21, 0.5);
        float pGRoll    = tfx(22, 0.8);
        vec2  pGOff     = vec2(tfx(23, 0.0), tfx(24, 0.0));
        float pGInner   = tfx(25, 0.0);
        float pGCore    = tfx(26, 0.5);
        float pGColMix  = tfx(27, 0.0);
        vec3  pGCol     = srgbToLinear(vec3(tfx(28, 0.5), tfx(29, 0.9), tfx(30, 1.0)));
        float pGQual    = tfx(31, 0.6);
        float pSoft     = tfx(32, 0.0);
        float pRangeLo  = tfx(33, 0.14);
        float pRangeHi  = tfx(34, 0.08);
        float pPatType  = tfx(35, 0.0);
        float pPatScale = tfx(36, 8.0);
        float pPatStr   = tfx(37, 0.5);
        float pPatAng   = tfx(38, 0.0);
        float pOpacity  = tfx(39, 1.0);

        // glow reach: the tail radius grows with the rolloff slider (no low clamp, no perf cap below 0.6 x the frame)
        float boxHpx = max(boxSize.y * whPx.y, 8.0);
        float baseR = clamp(boxHpx * 0.5, 6.0, 180.0 * tpx) * clamp(pGRad, 0.02, 4.0);
        float Rc = max(1.5 * tpx, 0.22 * baseR);
        float Rt = min(baseR * (0.5 + 1.3 * max(pGRoll, 0.0)), 0.6 * max(whPx.x, whPx.y));
        float reachUv = (pGInt > 0.01) ? (Rt + length(pGOff) * boxHpx) / min(whPx.x, whPx.y) : 0.0;
        float tMargin = max(0.03, 0.22 * boxSize.y);
        float gMargin = max(tMargin, reachUv);
        vec2 qd = max(abs(uvN - (boxMin + boxSize * 0.5)) - boxSize * 0.5, vec2(0.0));
        float outD = length(qd);
        if (outD < gMargin) {
            float boxFade = 1.0 - smoothstep(0.0, tMargin, outD);        // shadow fades out smoothly
            float glowFade = 1.0 - smoothstep(0.0, gMargin, outD);       // glow fades over its own reach
            float inBox = 1.0 - smoothstep(0.0, 0.004, outD);            // the bevel itself stays in the box

            gTextThr = (u_g22 > 0.01) ? clamp(u_g22, 0.15, 0.95) : 0.65;
            gTextLo = clamp(pRangeLo, 0.02, 0.45);
            gTextHi = clamp(pRangeHi, 0.02, 0.45);
            gTextCutS = linearToSrgb(max(gTextThr - gTextLo, 0.0)) - 1e-4;   // tiny margin: never cuts a pixel that could be > 0
            float tDepth = clamp(u_textBevelDepth, 0.0, 3.0);
            float tChrome = clamp(u_textChromeIntensity, 0.0, 3.0);
            float tSpec = clamp(u_g20, 0.0, 2.0);
            float tShadow = clamp(u_g21, 0.0, 1.0);

            float fillC = textFillSoft(coord, pSoft, tpx);
            float outside = 1.0 - fillC;
            float mText = fillC * inBox;

            // ---- ring A (r = 1.5 px): thin-stroke direction + rim coverage ----
            vec2 gA = vec2(0.0); float mA = 0.0;
            for (int k = 0; k < 8; k++) {
                float a = (float(k) + 0.5) * 0.78539816;
                vec2 d = vec2(cos(a), sin(a));
                float f = textFillAt(coord + ivec2(round(d * 1.5 * tpx)));
                gA += d * f; mA += f;
            }
            gA *= 0.25; mA *= 0.125;

            // ---- ring B (r = 2..5 px by bevel depth): bevel-band coverage + direction + the text's own colour ----
            float bw = mix(2.0, 5.0, clamp(tDepth * 0.5, 0.0, 1.0));
            vec2 gB = vec2(0.0); float mB = 0.0;
            vec3 ringCol = vec3(0.0); float ringW = 0.0;
            for (int k = 0; k < 8; k++) {
                float a = (float(k) + 0.1) * 0.78539816;
                vec2 d = vec2(cos(a), sin(a));
                vec4 sB = textSampleAt(coord + ivec2(round(d * bw * tpx)));
                gB += d * sB.a; mB += sB.a;
                ringCol += sB.rgb * sB.a; ringW += sB.a;
            }
            gB *= 0.25; mB *= 0.125;

            // outward edge normal (screen space, y down) and light from the upper left
            vec2 gDir = gA + gB * 0.7;
            float gLen = length(gDir);
            vec2 outN = (gLen > 1e-4) ? -gDir / gLen : vec2(0.0);
            vec2 L2 = normalize(vec2(-0.55, -0.83));
            float lit = dot(outN, L2);
            float hi = smoothstep(0.05, 0.85, lit);
            float lo = smoothstep(0.05, 0.85, -lit);

            float rimBand = fillC * (1.0 - smoothstep(0.55, 0.95, mA));   // ~1-2 px right on the edge
            float bandIn  = fillC * (1.0 - smoothstep(0.50, 0.97, mB));   // a few px deep, fades inward

            // ---- the text's own hue (Oklab) ----
            vec3 tcol = (ringW > 0.5) ? ringCol / ringW : vec3(0.0);
            tcol = mix(tcol, srcLin(coord), fillC * 0.30);
            vec3 tLab = linearRgbToOklab(max(tcol, vec3(0.0)));
            float tC = length(tLab.yz);
            vec2 tDir = (tC > 1e-4) ? tLab.yz / tC : vec2(1.0, 0.0);
            float hasHue = smoothstep(0.010, 0.045, tC);
            float chromaGen = clamp(tC * 1.3 + 0.02, 0.04, 0.22);
            if (u_g23 > 0.5) {                                           // explicit finish overrides the hue
                float hOver = (u_g23 < 1.5) ? 1.75 : ((u_g23 < 2.5) ? 3.35 : ((u_g23 < 3.5) ? 0.45 : 5.30));
                tDir = vec2(cos(hOver), sin(hOver));
                hasHue = 1.0; chromaGen = 0.14;
            }
            vec3 hiCol = oklabToLinearRgb(vec3(0.97, tDir * chromaGen * 0.20));
            vec3 tintRaw = oklabToLinearRgb(vec3(0.80, tDir * chromaGen * 0.80));
            vec3 tintN = tintRaw / max(luma(tintRaw), 1e-3);

            // ---- 1) the letters: original pixels + bevel lines + metal / silk face ----
            vec3 orig = currentComposite;
            vec3 toned = orig;
            float bevelK = clamp(tDepth, 0.0, 2.0);
            float metalAmt = clamp(tChrome * 0.42, 0.0, 0.92) * smoothstep(0.02, 0.50, fillC);
            if (metalAmt > 0.01) {
                float smax = clamp(0.5 * boxSize.y * whPx.y, 24.0 * tpx, 140.0 * tpx);
                float dUp = textEdgeDist(coord, vec2(0.0, -1.0), smax);
                float dDn = textEdgeDist(coord, vec2(0.0, 1.0), smax);
                float vText = clamp(dUp / max(dUp + dDn, 1e-3), 0.0, 1.0);
                // what the metal "sees": scene colour just above and below the box
                vec3 skyAcc = vec3(0.0);
                vec3 gndAcc = vec3(0.0);
                ivec2 lim = ivec2(width - 1, height - 1);
                for (int q = 0; q < 4; q++) {
                    float fx = (float(q) + 0.5) * 0.25;
                    vec2 pu = vec2(boxMin.x + boxSize.x * fx, boxMin.y - 0.035);
                    vec2 pg = vec2(boxMin.x + boxSize.x * fx, boxMin.y + boxSize.y + 0.035);
                    skyAcc += srcLin(clamp(ivec2(pu * whPx), ivec2(0), lim));
                    gndAcc += srcLin(clamp(ivec2(pg * whPx), ivec2(0), lim));
                }
                skyAcc *= 0.25;
                gndAcc *= 0.25;
                vec3 skyRef = mix(vec3(0.60), skyAcc * 1.5 + 0.06, 0.65);
                vec3 gndRef = mix(vec3(0.35), gndAcc * 1.5 + 0.04, 0.65);

                vec3 autoTint = mix(vec3(1.0), tintN, hasHue * 0.85);      // the text's own colour tints the metal
                vec3 wheelTint = pHiW / max(luma(pHiW), 1e-3);
                float tm = clamp(pTintMix, 0.0, 1.0);
                vec3 tintHi = mix(autoTint, wheelTint, tm);
                vec3 bodyCol = mix(autoTint * 0.55, pBodyW, tm);
                vec2 qBox = (uvN - boxMin) / boxSize;
                vec3 metal = textMetalFace(vText, outN, max(bandIn, rimBand), qBox, skyRef, gndRef, tintHi, bodyCol,
                                           pStyle, pRound, pBands, pBandAng, pBandSft, pBandStr, pAniso, pBodyDk, pAmb, pFres);
                if (pPatType > 0.5) {
                    float pv = textPattern(vec2(coord) / tpx, pPatType, pPatScale, pPatAng);
                    metal *= max(1.0 + clamp(pPatStr, 0.0, 1.0) * (pv - 0.5) * 1.6, 0.0);
                }
                toned = mix(orig, max(metal, vec3(0.0)), metalAmt);
            }
            toned *= 1.0 - 0.38 * lo * bandIn * min(bevelK, 1.5);                    // shaded bevel face
            toned += hiCol * hi * bandIn * (0.32 + 0.20 * metalAmt) * bevelK;        // lit bevel face (narrow), brighter on metal
            toned += hiCol * hi * rimBand * 1.05 * tSpec * clamp(pRim, 0.0, 2.0);    // razor lit edge line
            toned += tintN * lo * rimBand * 0.28 * (0.4 + 0.6 * hasHue) * min(bevelK, 1.5); // thin shaded edge line

            // ---- 2) around the letters: crisp offset shadow + the continuous deep glow ----
            vec3 under = orig;
            ivec2 shOff = ivec2(round(vec2(2.0, 3.0) * tpx * (0.5 + 0.5 * min(tDepth, 1.5))));
            float shM = 0.5 * textFillAt(coord - shOff)
                      + 0.25 * textFillAt(coord - shOff + ivec2(1, 0))
                      + 0.25 * textFillAt(coord - shOff - ivec2(1, 0));
            under *= 1.0 - clamp(shM * outside * 0.45 * tShadow, 0.0, 0.5) * boxFade;

            if (pGInt > 0.01) {
                float rot = 6.2831853 * fract(52.9829189 * fract(dot(vec2(coord), vec2(0.06711056, 0.00583715))));
                vec2 gOff = pGOff * boxHpx;
                float coreAmt = textGlowDisk(coord, gOff, Rc, 20, 2.0, rot, false);
                int tTaps = 16 + int(32.0 * clamp(pGQual, 0.0, 1.0));
                float tailAmt = textGlowDisk(coord, gOff, Rt, tTaps, 1.0, rot + 1.7, true);
                float tailW = clamp(0.35 + 0.65 * pGRoll, 0.0, 2.0);
                float G = coreAmt + tailAmt * tailW;

                vec3 neon = mix(vec3(0.85), oklabToLinearRgb(vec3(0.84, tDir * max(chromaGen, 0.07))), hasHue);
                vec3 gCol = mix(neon, pGCol, clamp(pGColMix, 0.0, 1.0));
                gCol = mix(gCol, vec3(1.0), clamp(pGCore * coreAmt * 1.2, 0.0, 1.0));   // hot white core like AE deep glow
                vec3 halo = gCol * (G * pGInt * glowFade * outside);
                under += halo * (1.0 - 0.5 * clamp(luma(under), 0.0, 1.0));
                toned += gCol * (G * pGInt * clamp(pGInner, 0.0, 1.0) * 0.35);          // glow bleeding onto the letters
            }

            // ---- 3) letters keep their own detail; the surroundings only get glow + shadow; overall opacity ----
            vec3 res = mix(under, max(toned, vec3(0.0)), mText);
            currentComposite = mix(orig, res, clamp(pOpacity, 0.0, 1.0));
        }
    }

    // HDR half-float store. LUT + tonemap + dither happen in pass 6, after all glows.
    packComposite(pixelIndex, vec4(currentComposite, rawPixel.a));
}
