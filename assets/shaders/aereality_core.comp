#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// =============================================================================
// AEReality / Shaderly - Master Vulkan Compute Shader (v2 - AE-matched pipeline)
// -----------------------------------------------------------------------------
//  * HDR half-float (fp16) intermediate composite + bloom pyramid (no 8-bit
//    linear storage anywhere between input decode and final quantise)
//  * Per-layer parameters for EVERY effect (switching layers can't change CC)
//  * Neighbourhood filters apply a DELTA so earlier layers' grades survive
//  * Oklab grading with chroma-reduction gamut mapping (no random green/purple)
//  * C1-continuous monotone cubic curves (no ridges / banding)
//  * Gamma-space (AE style) or linear-space blending, selectable per layer
//  * Proper AgX + enhanced Khronos Neutral, LUT applied display-referred
//  * Continuous anamorphic streak, true edge glow, prismatic diffuse glow
//  * TPDF dither right before the final quantise
// Layer stride = 192 floats, 10 layers -> 32 + 10*192 = 1952 floats (UBO capacity 2048).
// -----------------------------------------------------------------------------
// v2.1 changes
//  * AgX: inset matrix was transposed (pink/dark cast) -> fixed, SDR white restored, mids kept
//  * Khronos Neutral: black-level subtraction removed (was the brightness drop), real shoulder
//  * Glows (Deep / Kawase / Diffuse SP / Shaderly / Sapphire edge / halo) take scene colour
//  * Anamorphic streak: jittered continuous kernel, scene-tinted, soft shoulder
//  * S_lining: stronger, soft dark falloff outside the line art
//  * Anime skin smoothing: Oklab skin mask + ink shielding (skin only, lines untouched)
//  * Text bevel: scene-aware chrome, contact shadow, horizon bands, glints, contour glow
// -----------------------------------------------------------------------------
// v2.3 changes
//  * FIX: Chroma Contrast slider was packed (slot 103) but never read by the shader. It is now a real
//    Oklab chroma S-curve: + separates dull from vivid colours, - flattens chroma.
//  * FIX: Green / Blue curves only received their midpoint. All 5 points of R, G, B now reach the GPU.
//  * FIX: Anamorphic flare was a weight-averaged line (a small highlight became ~5% of its own value),
//    then gated a second time. It now keeps the highlight's energy and picks its bloom-pyramid level from
//    the tap spacing, so a long / stretched flare stays one continuous smear (never repeated copies).
//  * NEW: Hue vs Saturation / Hue / Luminance (8 hue bands + custom hue-range qualifier)
//  * NEW: Colorista: Lift / Gamma / Gain / Offset colour wheels, range saturation, contrast + pivot,
//         temperature / tint, preserve-luma, mix
// -----------------------------------------------------------------------------
// v2.2 changes
//  * FIX: packComposite() was called with 3 args but declared with 2 (shader would not compile)
//  * Every glow is now a DIFFERENT effect (see the per-glow notes in pass 6):
//      Deep Glow     = HDR multi-radius glow with a hot, whitened core
//      Kawase        = soft blur glow
//      Shaderly Glow = overall AE-"Glow" style screen-blended glow over the whole frame
//      Diffuse SP    = light-source simulation: finds the dominant light, scatters it onto the
//                      subject along the light direction, prismatic radial dispersion (R>G>B)
//      Sapphire Edge = crisp contour glow hugging edges (coloured by the bright side of the edge)
//      Edge Halo     = wide soft aura that spills OUTWARD from silhouettes, never touches the line
//  * S_LightWrap rebuilt: wraps the blurred bright background into the foreground edge (no tap
//    ring, so the clip is never duplicated)
//  * Volumetric fog rebuilt (BSL-style): pseudo-depth + ground fog, domain-warped drifting noise,
//    per-channel Beer-Lambert extinction, forward-scatter sun glow, sky/ground in-scatter colour
//  * TPDF dither: exact +-1 LSB triangular at default strength
//  * Saturation slider: <1 = saturation, >1 = skin-protected vibrance
//  * Text bevel: rounder 4-scale height, glow + metal follow the text's own colour, inner rim light, smoky halo
//  * Linear tonemap mode now has a hue-preserving soft shoulder (identity below 0.92) instead of hard clipping
// -----------------------------------------------------------------------------
// v2.4 changes
//  * NEW tonemappers (modes 3-6): Aurora Depth, Sakura Silk, Prism Blend, Obsidian Cel. Modes 0-2 untouched.
// -----------------------------------------------------------------------------
// v2.5 changes
//  * AgX: the old white-lift ended in a hard per-channel clip at input 1.0 (no roll-off for glows / pushed
//    exposure, and skin drifted ~29 degrees toward yellow). It now lifts SDR white to 0.965, then rolls the peak
//    off with a hue-preserving shoulder (4.0 -> 0.99, never a clip) and gamut-fits instead of clipping.
//  * Khronos Neutral+: the shoulder had a slope kink at its start (slope 1.0 -> 1.13, i.e. it briefly EXPANDED
//    just above the knee). It is now C1 (slope 1 at the knee, same exp shoulder), starts at 0.72 and maps SDR white
//    to ~0.91 instead of ~0.88.
//  * Anime skin smoothing (Bilateral): rebuilt. The old version shielded every colour step (cel-shadow edges)
//    as if it were ink, and used a tiny kernel, so it smoothed nothing. Now: 40-tap skin-constrained bilateral
//    (taps must be skin, ink never contributes), only real ink lines are protected (cel-shadow steps are smoothed), wider reach, and the
//    intensity curve is front-loaded so low slider values are visible.
//  * v2.6: Sapphire edge glow no longer lights the line art itself (glow now comes FROM the edges, never ON them);
//    Skin Edge Bleed rebuilt (visible inward gradient); Anamorphic flares rebuilt (strict sources, spacing, thickness,
//    hard/soft = edge profile only, true frame-edge entry, scene colour). New slots 178-183.
//  * Edge Darken: rebuilt. Darkens the line art core slightly, plus an INNER soft spread on the fill beside every
//    line (blur + gentle darkening that fades inward). New slider edgeDarkenBlur (slot 177) = strength AND reach.
// -----------------------------------------------------------------------------
// =============================================================================

// STORAGE BUFFERS
layout(std430, binding = 0) readonly buffer InputBuffer {
    uint in_pixels[];
};

layout(std430, binding = 1) buffer OutputBuffer {
    uint out_pixels[];
};

// BINDING 3: Hardware 3D LUT sampler
layout(binding = 3) uniform sampler3D u_lutTexture;

// Bloom pyramid (fp16 RGBA = 2 uints / texel). RGB = highlights, A = edge mask.
layout(std430, binding = 4) buffer BloomL0 { uint bloom_l0[]; }; // 1/2 res
layout(std430, binding = 5) buffer BloomL1 { uint bloom_l1[]; }; // 1/4 res
layout(std430, binding = 6) buffer BloomL2 { uint bloom_l2[]; }; // 1/8 res
layout(std430, binding = 8) buffer BloomL3 { uint bloom_l3[]; }; // 1/16 res (Deep Glow long tail)
layout(std430, binding = 9) buffer BloomL4 { uint bloom_l4[]; }; // 1/32 res (Deep Glow long tail)

// HDR composite (fp16 RGBA = 2 uints / pixel)
layout(std430, binding = 7) buffer TempCompositeBuffer { uint temp_composite[]; };

layout(push_constant) uniform PushConsts {
    int u_passIndex;   // 0 Grade, 1 Prefilter->L0, 2 Down1, 3 Down2, 4 Up1, 5 Up0, 6 Composite, 7 Down3, 8 Down4, 9 Up3
    int u_passWidth;
    int u_passHeight;
    float u_passRadius;
    int u_bandY;       // row offset for banded dispatch (keeps each GPU submit short)
    int u_srcW;        // true width of the parent bloom level (downsample passes)
    int u_srcH;        // true height of the parent bloom level (downsample passes)
};

