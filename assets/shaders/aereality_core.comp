// =============================================================================
// COLOR UTILITIES
// =============================================================================
float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

vec3 sanitize(vec3 c) {
    if (any(isnan(c)) || any(isinf(c))) return vec3(0.0);
    return clamp(c, vec3(0.0), vec3(60000.0));
}

float srgbToLinear(float c) {
    return (c <= 0.04045) ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4);
}
vec3 srgbToLinear(vec3 c) {
    return vec3(srgbToLinear(c.r), srgbToLinear(c.g), srgbToLinear(c.b));
}
float linearToSrgb(float c) {
    c = clamp(c, 0.0, 1.0);
    return (c <= 0.0031308) ? (c * 12.92) : (1.055 * pow(c, 1.0 / 2.4) - 0.055);
}
vec3 linearToSrgb(vec3 c) {
    return vec3(linearToSrgb(c.r), linearToSrgb(c.g), linearToSrgb(c.b));
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float hashInt12(ivec2 p) {
    uvec2 q = uvec2(p);
    q = q * uvec2(1597334677u, 3812015801u);
    uint n = (q.x ^ q.y) * 1597334677u;
    return float(n) * (1.0 / 4294967296.0);
}

float vnoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash12(i);
    float b = hash12(i + vec2(1.0, 0.0));
    float c = hash12(i + vec2(0.0, 1.0));
    float d = hash12(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
        v += a * vnoise(p);
        p = p * 2.03 + vec2(17.1, 9.2);
        a *= 0.5;
    }
    return v / 0.9375;
}

vec3 hueToRGB(float h) {
    float r = abs(h * 6.0 - 3.0) - 1.0;
    float g = 2.0 - abs(h * 6.0 - 2.0);
    float b = 2.0 - abs(h * 6.0 - 4.0);
    return clamp(vec3(r, g, b), 0.0, 1.0);
}

vec3 colorTempToRGB(float kelvin) {
    if (kelvin < 1000.0) return vec3(1.0);
    float temp = kelvin / 100.0;
    float red, green, blue;
    if (temp <= 66.0) {
        red = 255.0;
        green = 99.4708025861 * log(max(temp, 1.0)) - 161.1195681661;
        if (temp <= 19.0) blue = 0.0;
        else blue = 138.5177312231 * log(max(temp - 10.0, 1.0)) - 305.0447927307;
    } else {
        red = 329.698727446 * pow(max(temp - 60.0, 1.0), -0.1332047592);
        green = 288.1221695283 * pow(max(temp - 60.0, 1.0), -0.0755148492);
        blue = 255.0;
    }
    return srgbToLinear(clamp(vec3(red, green, blue) / 255.0, 0.0, 1.0));
}

float karisWeight(vec3 color) {
    return 1.0 / (1.0 + luma(color) * 0.5);
}

// =============================================================================
// OKLAB with chroma-reduction gamut mapping
// =============================================================================
vec3 linearRgbToOklab(vec3 c) {
    c = max(vec3(0.0), c);
    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
    float l_ = pow(max(0.0, l), 1.0 / 3.0);
    float m_ = pow(max(0.0, m), 1.0 / 3.0);
    float s_ = pow(max(0.0, s), 1.0 / 3.0);
    return vec3(
        0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
    );
}

vec3 oklabToLinearRgbRaw(vec3 lab) {
    float l_ = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z;
    float m_ = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;
    float s_ = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;
    float l = l_ * l_ * l_;
    float m = m_ * m_ * m_;
    float s = s_ * s_ * s_;
    return vec3(
        +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
    );
}

// Keeps lightness + hue, pulls chroma in until no channel is negative.
// This is what stops grades turning into random green / purple / cyan.
vec3 oklabToLinearRgb(vec3 lab) {
    lab.x = max(lab.x, 0.0);
    vec3 rgb = oklabToLinearRgbRaw(lab);
    if (min(rgb.r, min(rgb.g, rgb.b)) >= -0.00005) return max(rgb, vec3(0.0));
    float lo = 0.0;
    float hi = 1.0;
    for (int i = 0; i < 9; i++) {
        float mid = 0.5 * (lo + hi);
        vec3 t = oklabToLinearRgbRaw(vec3(lab.x, lab.y * mid, lab.z * mid));
        if (min(t.r, min(t.g, t.b)) >= -0.00005) lo = mid; else hi = mid;
    }
    return max(oklabToLinearRgbRaw(vec3(lab.x, lab.y * lo, lab.z * lo)), vec3(0.0));
}

vec2 oklabRotateHue(vec2 ab, float angleRadians) {
    float cosA = cos(angleRadians * 0.45);
    float sinA = sin(angleRadians * 0.45);
    return vec2(ab.x * cosA - ab.y * sinA, ab.x * sinA + ab.y * cosA);
}

// Colour wheel vector (x right, y up, |v| <= 1) -> zero-mean RGB push. Angle = hue (0 = red),
// radius = amount, so the centre is neutral. Zero-mean means the wheel never changes brightness.
vec3 wheelTint(vec2 w) {
    float m = min(length(w), 1.0);
    if (m < 1e-4) return vec3(0.0);
    float hue = fract(atan(w.y, w.x) / 6.28318530718);
    vec3 c = hueToRGB(hue);
    c -= vec3((c.r + c.g + c.b) * (1.0 / 3.0));
    return c * (1.5 * m);
}

// =============================================================================
// C1-CONTINUOUS MONOTONE CUBIC (PCHIP) 5-POINT CURVE - no slope breaks, no ridges
// =============================================================================
float evalCurve5(float x, float p0, float p1, float p2, float p3, float p4) {
    x = clamp(x, 0.0, 1.0);
    // Guard: points are forced to be non-decreasing so a curve can never fold back / invert,
    // even if an old preset or a drag left a point below its neighbour.
    p0 = clamp(p0, 0.0, 1.0);
    p1 = clamp(max(p1, p0), 0.0, 1.0);
    p2 = clamp(max(p2, p1), 0.0, 1.0);
    p3 = clamp(max(p3, p2), 0.0, 1.0);
    p4 = clamp(max(p4, p3), 0.0, 1.0);
    float p[5] = float[5](p0, p1, p2, p3, p4);
    float d[4];
    for (int i = 0; i < 4; i++) d[i] = (p[i + 1] - p[i]) * 4.0;
    float m[5];
    m[0] = d[0];
    m[4] = d[3];
    for (int i = 1; i < 4; i++) {
        float prod = d[i - 1] * d[i];
        m[i] = (prod <= 0.0) ? 0.0 : (2.0 * prod / (d[i - 1] + d[i]));
    }
    float seg = x * 4.0;
    int idx = min(int(floor(seg)), 3);
    float t = seg - float(idx);
    float t2 = t * t;
    float t3 = t2 * t;
    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;
    float y = h00 * p[idx] + h10 * 0.25 * m[idx] + h01 * p[idx + 1] + h11 * 0.25 * m[idx + 1];
    return clamp(y, 0.0, 1.0);
}

bool curveIsIdentity(float p0, float p1, float p2, float p3, float p4) {
    return abs(p0) < 0.0005 && abs(p1 - 0.25) < 0.0005 && abs(p2 - 0.5) < 0.0005 &&
           abs(p3 - 0.75) < 0.0005 && abs(p4 - 1.0) < 0.0005;
}

// =============================================================================
// PIXEL STORAGE
// =============================================================================
vec4 unpackRGBA_Dynamic(int pixelIndex, float bitMode) {
    if (bitMode > 1.5) {
        uint word0 = in_pixels[pixelIndex * 2];
        uint word1 = in_pixels[pixelIndex * 2 + 1];
        return vec4(float(word0 & 0xFFFFu), float((word0 >> 16u) & 0xFFFFu),
                    float(word1 & 0xFFFFu), float((word1 >> 16u) & 0xFFFFu)) / 65535.0;
    }
    uint val = in_pixels[pixelIndex];
    return vec4(float(val & 0xFFu), float((val >> 8u) & 0xFFu),
                float((val >> 16u) & 0xFFu), float((val >> 24u) & 0xFFu)) / 255.0;
}

vec3 srcSrgb(ivec2 c) {
    c = clamp(c, ivec2(0), ivec2(gW - 1, gH - 1));
    return unpackRGBA_Dynamic(c.y * gW + c.x, gBit).rgb;
}
vec3 srcLin(ivec2 c) { return srgbToLinear(srcSrgb(c)); }

// "Is this pixel part of the (bright) text?" - used by the text suite only
float gTextThr = 0.65;
float textFillAt(ivec2 p) {
    vec3 c = srcLin(p);
    float v = 0.5 * luma(c) + 0.5 * max(c.r, max(c.g, c.b));
    return smoothstep(gTextThr - 0.14, gTextThr + 0.08, v);
}

// Same mask, but also returns the linear colour so callers do not fetch the pixel twice (rgb = colour, a = fill)
vec4 textSampleAt(ivec2 p) {
    vec3 c = srcLin(p);
    float v = 0.5 * luma(c) + 0.5 * max(c.r, max(c.g, c.b));
    return vec4(c, smoothstep(gTextThr - 0.14, gTextThr + 0.08, v));
}

// Distance (px) from this pixel to the edge of the letter along a direction. Geometric search then
// 4 bisection steps, so it is sub-pixel smooth (no stepped bands in the chrome).
float textEdgeDist(ivec2 coord, vec2 dir, float smax) {
    float prev = 0.0;
    for (int k = 1; k <= 14; k++) {
        float sp = smax * pow(float(k) / 14.0, 1.8);
        if (textFillAt(coord + ivec2(round(dir * sp))) < 0.5) {
            float lo = prev;
            float hi = sp;
            for (int b = 0; b < 4; b++) {
                float mid = 0.5 * (lo + hi);
                if (textFillAt(coord + ivec2(round(dir * mid))) < 0.5) hi = mid; else lo = mid;
            }
            return 0.5 * (lo + hi);
        }
        prev = sp;
    }
    return smax;
}

vec4 unpackComposite(int idx) {
    return vec4(unpackHalf2x16(temp_composite[idx * 2]), unpackHalf2x16(temp_composite[idx * 2 + 1]));
}
void packComposite(int idx, vec4 c) {
    c.rgb = sanitize(c.rgb);
    temp_composite[idx * 2] = packHalf2x16(c.rg);
    temp_composite[idx * 2 + 1] = packHalf2x16(c.ba);
}
vec3 compAt(ivec2 c, int w, int h) {
    c = clamp(c, ivec2(0), ivec2(w - 1, h - 1));
    return unpackComposite(c.y * w + c.x).rgb;
}

void packFinalDisplay(int pixelIndex, vec4 col, float bitMode) {
    if (bitMode > 1.5) {
        uint r = uint(clamp(col.r * 65535.0 + 0.5, 0.0, 65535.0));
        uint g = uint(clamp(col.g * 65535.0 + 0.5, 0.0, 65535.0));
        uint b = uint(clamp(col.b * 65535.0 + 0.5, 0.0, 65535.0));
        uint a = uint(clamp(col.a * 65535.0 + 0.5, 0.0, 65535.0));
        out_pixels[pixelIndex * 2] = (g << 16u) | r;
        out_pixels[pixelIndex * 2 + 1] = (a << 16u) | b;
    } else {
        uint r = uint(clamp(col.r * 255.0 + 0.5, 0.0, 255.0));
        uint g = uint(clamp(col.g * 255.0 + 0.5, 0.0, 255.0));
        uint b = uint(clamp(col.b * 255.0 + 0.5, 0.0, 255.0));
        uint a = uint(clamp(col.a * 255.0 + 0.5, 0.0, 255.0));
        out_pixels[pixelIndex] = (a << 24u) | (b << 16u) | (g << 8u) | r;
    }
}

// Bloom storage (fp16 RGBA)
vec4 bloomLoad(int level, int idx) {
    uvec2 u;
    if (level == 0)      u = uvec2(bloom_l0[idx * 2], bloom_l0[idx * 2 + 1]);
    else if (level == 1) u = uvec2(bloom_l1[idx * 2], bloom_l1[idx * 2 + 1]);
    else if (level == 2) u = uvec2(bloom_l2[idx * 2], bloom_l2[idx * 2 + 1]);
    else if (level == 3) u = uvec2(bloom_l3[idx * 2], bloom_l3[idx * 2 + 1]);
    else                 u = uvec2(bloom_l4[idx * 2], bloom_l4[idx * 2 + 1]);
    return vec4(unpackHalf2x16(u.x), unpackHalf2x16(u.y));
}
void bloomStore(int level, int idx, vec4 v) {
    v = clamp(v, vec4(0.0), vec4(60000.0));
    if (any(isnan(v))) v = vec4(0.0);
    uint a = packHalf2x16(v.rg);
    uint b = packHalf2x16(v.ba);
    if (level == 0)      { bloom_l0[idx * 2] = a; bloom_l0[idx * 2 + 1] = b; }
    else if (level == 1) { bloom_l1[idx * 2] = a; bloom_l1[idx * 2 + 1] = b; }
    else if (level == 2) { bloom_l2[idx * 2] = a; bloom_l2[idx * 2 + 1] = b; }
    else if (level == 3) { bloom_l3[idx * 2] = a; bloom_l3[idx * 2 + 1] = b; }
    else                 { bloom_l4[idx * 2] = a; bloom_l4[idx * 2 + 1] = b; }
}

vec4 sampleBloom(int level, vec2 uv, int w, int h) {
    vec2 pos = clamp(uv * vec2(w, h) - 0.5, vec2(0.0), vec2(w - 1, h - 1));
    ivec2 p0 = ivec2(floor(pos));
    ivec2 p1 = clamp(p0 + ivec2(1), ivec2(0), ivec2(w - 1, h - 1));
    vec2 f = fract(pos);
    vec4 c00 = bloomLoad(level, p0.y * w + p0.x);
    vec4 c10 = bloomLoad(level, p0.y * w + p1.x);
    vec4 c01 = bloomLoad(level, p1.y * w + p0.x);
    vec4 c11 = bloomLoad(level, p1.y * w + p1.x);
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

// Fractional pyramid level (1..4): blends two levels so a streak never pops between them.
vec3 sampleBloomLevelF(float lvlF, vec2 uv, int width, int height) {
    int lo = int(floor(lvlF));
    int hi = min(lo + 1, 4);
    float f = lvlF - float(lo);
    vec3 a = sampleBloom(lo, uv, max(width >> (lo + 1), 1), max(height >> (lo + 1), 1)).rgb;
    if (hi == lo || f < 0.001) return a;
    vec3 b = sampleBloom(hi, uv, max(width >> (hi + 1), 1), max(height >> (hi + 1), 1)).rgb;
    return mix(a, b, f);
}

// =============================================================================
// TONEMAPPERS
// =============================================================================
vec3 agxCore(vec3 c, float sat) {
    // GLSL mat3(vec3, vec3, vec3) is COLUMN-major. toRec2020 / outset / toSrgb below were already
    // listed as columns. The AgX *inset* was listed row-by-row (transposed), so neutral greys were
    // pushed off-axis - that was the pink, dark cast. It is now written as columns too.
    const mat3 toRec2020 = mat3(vec3(0.6274, 0.0691, 0.0164), vec3(0.3293, 0.9195, 0.0880), vec3(0.0433, 0.0113, 0.8956));
    const mat3 inset = mat3(
        vec3(0.856627153315983, 0.137318972929847, 0.11189821299995),
        vec3(0.0951212405381588, 0.761241990602591, 0.0767994186031903),
        vec3(0.0482516061458583, 0.101439036467562, 0.811302368396859));
    const mat3 outset = mat3(
        vec3(1.1271005818144368, -0.1413297634984383, -0.14132976349843826),
        vec3(-0.11060664309660323, 1.157823702216272, -0.11060664309660294),
        vec3(-0.016493938717834573, -0.016493938717834257, 1.2519364065950405));
    const mat3 toSrgb = mat3(vec3(1.6605, -0.1246, -0.0182), vec3(-0.5876, 1.1329, -0.1006), vec3(-0.0728, -0.0083, 1.1187));

    c = max(c, vec3(0.0));
    c = inset * (toRec2020 * c);
    c = log2(max(c, vec3(1e-10)));
    c = clamp((c - (-12.47393)) / (4.026069 + 12.47393), 0.0, 1.0);

    // Troy Sobotka's 6th-order contrast approximation (AgX base look)
    vec3 x2 = c * c;
    vec3 x4 = x2 * x2;
    c = 15.5 * x4 * x2 - 40.14 * x4 * c + 31.96 * x4 - 6.868 * x2 * c + 0.4298 * x2 + 0.1191 * c - 0.00232;
    c = clamp(c, 0.0, 1.0);

    // gentle chroma restore (AgX desaturates highlights by design)
    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
    c = mix(vec3(l), c, sat);

    c = outset * c;
    c = pow(max(c, vec3(0.0)), vec3(2.2));
    c = toSrgb * c;
    return max(c, vec3(0.0));
}

// Khronos PBR Neutral, retuned for video: no black-level subtraction (that was the "brightness
// drop"), a real shoulder that maps SDR white back to ~white, hue-preserving peak compression,
// highlight desaturation, and a very light display-space contrast curve.
vec3 tonemapNeutralPlus(vec3 color) {
    color = max(color, vec3(0.0));
    const float startCompression = 0.72;
    const float desaturation = 0.25;
    const float kShoulder = 2.0;
    // Shoulder is C1: slope exactly 1.0 at the knee (no kink, no expansion above it). The input that reaches 1.0
    // follows from the slope condition: whitePoint = start + d * k / (1 - exp(-k)).
    float d = 1.0 - startCompression;
    float whitePoint = startCompression + d * kShoulder / (1.0 - exp(-kShoulder));

    float peak = max(color.r, max(color.g, color.b));
    if (peak > startCompression) {
        float t = (peak - startCompression) / (whitePoint - startCompression);
        float newPeak = startCompression + d * (1.0 - exp(-kShoulder * t)) / (1.0 - exp(-kShoulder));
        newPeak = min(newPeak, 1.0);
        color *= newPeak / peak;
        float g = max(1.0 - 1.0 / (desaturation * max(peak - newPeak, 0.0) + 1.0), 0.0);
        color = mix(color, vec3(newPeak), g);
    }
    color = clamp(color, 0.0, 1.0);

    vec3 e = linearToSrgb(color);
    e = e + 0.12 * (e * e * (3.0 - 2.0 * e) - e);
    return srgbToLinear(e);
}

// "Linear" mode, de-slopped: values up to the knee pass through UNCHANGED (so the grade looks exactly
// like plain linear), then the PEAK channel is rolled off smoothly towards 1.0 and the other channels
// are scaled with it. Hue is preserved instead of every channel hard-clipping to flat white, and a
// touch of highlight desaturation stops over-driven colours going neon.
vec3 tonemapLinearSoft(vec3 c) {
    c = max(c, vec3(0.0));
    const float knee = 0.92;      // linear light (~sRGB 0.96): nothing below this is touched
    const float whiteIn = 1.60;   // input peak that reaches 1.0
    const float kS = 8.5;         // gives slope 1.0 at the knee (C1-continuous, no visible kink)
    float peak = max(c.r, max(c.g, c.b));
    if (peak <= knee) return c;
    float d = 1.0 - knee;
    float t = clamp((peak - knee) / (whiteIn - knee), 0.0, 1.0);
    float newPeak = knee + d * (1.0 - exp(-kS * t)) / (1.0 - exp(-kS));
    c *= newPeak / peak;
    float g = 1.0 - 1.0 / (0.20 * max(peak - newPeak, 0.0) + 1.0);
    return clamp(mix(c, vec3(newPeak), g), 0.0, 1.0);
}


// =============================================================================
// NEW ANIME TONEMAPPERS (modes 3..6)  - depth-preserving, hue-safe, skin-protected
// -----------------------------------------------------------------------------
// Shared design rules for all four:
//   * Everything the SDR frame already contains below the knee is left alone (no flattening, no grey-out).
//   * Compression only ever happens at the TOP (exponential shoulder, C1, asymptote 1.0, never a hard clip).
//   * Depth comes from a perceptual (Oklab lightness) curve, and chroma FOLLOWS lightness, so colours get
//     deeper instead of greyer / neon.
//   * Skin hues (Oklab mask) get an earlier, softer shoulder and a weaker highlight lift -> faces never blow out.
//   * Anything still > 1.0 is brought into gamut by moving toward its OWN luma (hue-preserving), never per-channel clip.
// =============================================================================
float tmMax3(vec3 c) { return max(c.r, max(c.g, c.b)); }

// C1-continuous exponential shoulder: identity below k, slope 1 at k, asymptotically approaches 1.0.
float tmShoulder(float x, float k) {
    if (x <= k) return x;
    float d = 1.0 - k;
    return k + d * (1.0 - exp(-(x - k) / d));
}

// Pull a colour that exceeds 1.0 toward its own luma until the brightest channel fits (keeps hue).
vec3 tmFitToGamut(vec3 c) {
    c = max(c, vec3(0.0));
    float pk = tmMax3(c);
    if (pk <= 1.0) return c;
    float l = min(luma(c), 0.9999);
    float t = (1.0 - l) / max(pk - l, 1e-5);
    return clamp(mix(vec3(l), c, t), 0.0, 1.0);
}

// ---- 1: AgX (display-referred) ---------------------------------------------
// agxCore() is the real AgX transform (inset -> log2 -> 6th-order sigmoid -> outset). Raw AgX tops out near 0.59 for
// SDR white, so the result is lifted so that input 1.0 lands at 0.965. Everything ABOVE white is then rolled off with
// the same hue-preserving shoulder the other tonemappers use, and gamut-fitted - the old version clipped every channel
// at 1.0, which flattened glows / pushed exposure and swung skin toward yellow.
vec3 tonemapAgx(vec3 c) {
    const float AGX_SAT = 1.20;
    const float WHITE_OUT = 0.965;
    vec3 raw = agxCore(c, AGX_SAT);
    float whiteEnc = linearToSrgb(luma(agxCore(vec3(1.0), AGX_SAT)));
    float gain = WHITE_OUT / whiteEnc;
    vec3 e = linearToSrgb(raw);
    float ye = luma(e);
    float lift = (ye >= whiteEnc) ? gain : 1.0 + (gain - 1.0) * smoothstep(0.42, whiteEnc, ye);
    e *= lift;
    float pk = tmMax3(e);
    if (pk > 0.93) e *= tmShoulder(pk, 0.93) / pk;
    return srgbToLinear(tmFitToGamut(e));
}

// Oklab skin mask (same hue / chroma / lightness window the anime skin smoother uses).
float tmSkinMask(vec3 lab) {
    float ch = length(lab.yz);
    float h = atan(lab.z, lab.y);
    return smoothstep(0.30, 0.55, h) * (1.0 - smoothstep(1.20, 1.50, h))
         * smoothstep(0.015, 0.040, ch) * (1.0 - smoothstep(0.13, 0.19, ch))
         * smoothstep(0.42, 0.62, lab.x);
}

// Perceptual depth curve on Oklab L (0 and 1 are fixed points, curve is smooth and monotone for amt <= ~0.5).
// Below the pivot it deepens, above it adds separation. The highlight lift is reduced on skin.
float tmDepthCurve(float L, float amt, float pivot, float skin) {
    float x = clamp(L, 0.0, 1.0);
    float p = x * (1.0 - x) * (x - pivot) * 2.4;
    if (p > 0.0) p *= (1.0 - 0.85 * skin);
    return L + amt * p;
}

// Rebuild a colour from Oklab with a new lightness. Chroma follows lightness (constant *saturation*, so darker
// stays rich and lighter does not grey out); chromaMul adds or removes richness on top. Gamut-mapped by chroma reduction.
vec3 tmRebuild(vec3 lab, float Lnew, float chromaMul) {
    float r = clamp(Lnew / max(lab.x, 1e-4), 0.0, 1.25);
    float cm = mix(1.0, r, 0.85) * chromaMul;
    return oklabToLinearRgb(vec3(Lnew, lab.yz * cm));
}

// The lightness-curve modes cannot carry colour above white (L > 1 has no chroma), so once a pixel is over-driven
// (glow cores, pushed exposure) they hand over smoothly to a hue-preserving shoulder + light desaturation. Over-driven
// orange stays a hot orange-gold instead of snapping to flat white.
vec3 tmHdrBlend(vec3 labPath, vec3 c) {
    float pk = tmMax3(c);
    float w = smoothstep(0.85, 1.25, pk);
    if (w <= 0.0) return labPath;
    float fp = tmShoulder(pk, 0.95);
    vec3 H = c * (fp / max(pk, 1e-5));
    float g = 1.0 - 1.0 / (0.35 * max(pk - fp, 0.0) + 1.0);
    H = tmFitToGamut(mix(H, vec3(luma(H)), g));
    return mix(labPath, H, w);
}

// ---- 3: AURORA DEPTH -------------------------------------------------------
// Pure lightness tonemapper: the S-curve lives in Oklab L, colour direction is never touched, so nothing shifts
// hue and nothing flattens. Deeper toe, midtone separation, smooth top shoulder, tiny richness lift in the mids.
vec3 tonemapAuroraDepth(vec3 c) {
    c = max(c, vec3(0.0));
    vec3 lab = linearRgbToOklab(c);
    float L = lab.x;
    float skin = tmSkinMask(lab);

    float Ld = tmDepthCurve(L, mix(0.20, 0.12, skin), 0.60, skin);
    float Lo = tmShoulder(Ld, mix(0.985, 0.90, skin));

    // richness only goes to colours that are not already vivid (no gamut-edge neon), never to skin
    float midBand = smoothstep(0.08, 0.35, L) * (1.0 - smoothstep(0.55, 0.95, L));
    float notVivid = 1.0 - smoothstep(0.10, 0.24, length(lab.yz));
    float rich = 1.0 + 0.10 * midBand * notVivid * (1.0 - 0.70 * skin);

    return tmHdrBlend(tmFitToGamut(tmRebuild(lab, Lo, rich)), c);
}

// ---- 4: SAKURA SILK --------------------------------------------------------
// Skin-first, hue-preserving RGB tonemapper. Scales the whole RGB triplet by the shoulder ratio (so hue and
// saturation of the frame are untouched), starts the shoulder much earlier on skin so faces roll off softly
// instead of clipping to flat pink/white, keeps warmth in the roll-off, then adds a soft depth curve.
vec3 tonemapSakuraSilk(vec3 c) {
    c = max(c, vec3(0.0));
    vec3 lab = linearRgbToOklab(c);
    float skin = tmSkinMask(lab);

    float n = mix(tmMax3(c), luma(c), 0.30);        // vivid colours are not over-compressed (no dulling)
    float k = mix(0.95, 0.76, skin);
    float fn = tmShoulder(n, k);
    vec3 o = c * (fn / max(n, 1e-5));

    // desaturate only the genuinely over-driven part, and much less on skin (skin must not go chalky)
    float over = max(n - fn, 0.0);
    float g = (1.0 - 1.0 / (0.35 * over + 1.0)) * (1.0 - 0.60 * skin);
    o = mix(o, vec3(luma(o)), g);
    o = tmFitToGamut(o);

    vec3 lab2 = linearRgbToOklab(o);
    float Ld = tmDepthCurve(lab2.x, mix(0.16, 0.08, skin), 0.62, skin);
    return tmFitToGamut(tmRebuild(lab2, Ld, 1.0 + 0.05 * skin));
}

// ---- 5: PRISM BLEND --------------------------------------------------------
// Colour-blending tonemapper. Two roll-offs are mixed: a hue-preserving one and a per-channel "dye" one.
// In the highlights the per-channel path lets saturated colours drift toward lighter tints of themselves
// (orange -> warm gold -> cream, cyan -> ice, magenta -> pearl) instead of clipping, which is what makes
// glows and light edges blend beautifully. An Oklab chroma-recovery stage then gives back any colour that the
// blend took away in the shadows/mids, so the picture neither under- nor over-saturates.
vec3 tonemapPrismBlend(vec3 c) {
    c = max(c, vec3(0.0));
    vec3 labIn = linearRgbToOklab(c);
    float skin = tmSkinMask(labIn);
    float pk = tmMax3(c);

    float fA = tmShoulder(pk, 0.93);
    vec3 A = c * (fA / max(pk, 1e-5));                                    // hue-preserving path
    vec3 B = vec3(tmShoulder(c.r, 0.90), tmShoulder(c.g, 0.90), tmShoulder(c.b, 0.90));   // dye path
    float w = 0.55 * smoothstep(0.55, 1.10, pk) * (1.0 - 0.50 * skin);
    vec3 o = mix(A, B, w);

    vec3 labO = linearRgbToOklab(o);
    float Cin = length(labIn.yz);
    float Co = length(labO.yz);
    float lr = clamp(labO.x / max(labIn.x, 1e-4), 0.0, 1.20);
    float target = Cin * lr;                                              // same saturation at the new lightness
    float keep = 0.70 * (1.0 - smoothstep(0.80, 1.30, pk));               // fades out in the highlights so they can blend
    float Cn = mix(Co, max(Co, target), keep);
    labO.yz *= Cn / max(Co, 1e-5);

    float Ld = tmDepthCurve(labO.x, 0.14, 0.60, skin);
    return tmFitToGamut(tmRebuild(labO, Ld, 1.0));
}

// ---- 6: OBSIDIAN CEL -------------------------------------------------------
// Cel-shaded depth: pushes the shadows deeper and richer (jewel-toned, never grey or crushed flat), leaves the
// midtones and highlights where the artist put them, and rolls off only at the very top.
vec3 tonemapObsidianCel(vec3 c) {
    c = max(c, vec3(0.0));
    vec3 lab = linearRgbToOklab(c);
    float L = lab.x;
    float skin = tmSkinMask(lab);

    float toe = 1.0 - smoothstep(0.0, 0.62, L);
    float Ld = L - mix(0.22, 0.10, skin) * toe * min(L, 1.0);
    float Lo = tmShoulder(Ld, mix(0.985, 0.90, skin));

    float shadowBand = smoothstep(0.02, 0.14, L) * (1.0 - smoothstep(0.15, 0.60, L));
    float notVivid = 1.0 - smoothstep(0.10, 0.24, length(lab.yz));
    float rich = 1.0 + 0.18 * shadowBand * (0.4 + 0.6 * notVivid) * (1.0 - 0.50 * skin);

    return tmHdrBlend(tmFitToGamut(tmRebuild(lab, Lo, rich)), c);
}

vec3 applyToneMapping(vec3 linearCol, float mode) {
    if (mode > 5.5) return tonemapObsidianCel(linearCol);
    if (mode > 4.5) return tonemapPrismBlend(linearCol);
    if (mode > 3.5) return tonemapSakuraSilk(linearCol);
    if (mode > 2.5) return tonemapAuroraDepth(linearCol);
    if (mode > 1.5) return tonemapNeutralPlus(linearCol);
    if (mode > 0.5) return tonemapAgx(linearCol);
    return tonemapLinearSoft(linearCol);
}

// =============================================================================
// LUT (display-referred: input/outputs are sRGB-encoded 0..1)
// =============================================================================
vec3 sample3DLutDisplay(vec3 srgb, float opacity) {
    if (opacity <= 0.001) return srgb;
    vec3 c = clamp(srgb, 0.0, 1.0);
    vec3 lutCoord = (c * 31.0 + 0.5) / 32.0;
    vec3 graded = texture(u_lutTexture, lutCoord).rgb;
    return mix(srgb, clamp(graded, 0.0, 1.0), clamp(opacity, 0.0, 1.0));
}

// =============================================================================
// BLEND MODES (gamma space by default = After Effects behaviour)
// =============================================================================
vec3 softLightW3C(vec3 a, vec3 b) {
    vec3 dA = mix(sqrt(a), ((16.0 * a - 12.0) * a + 4.0) * a, step(a, vec3(0.25)));
    vec3 low  = a - (1.0 - 2.0 * b) * a * (1.0 - a);
    vec3 high = a + (2.0 * b - 1.0) * (dA - a);
    return mix(low, high, step(vec3(0.5), b));
}

vec3 blendCore(vec3 a, vec3 b, int mode) {
    if (mode == 1) {                       // Screen
        vec3 ca = clamp(a, 0.0, 1.0);
        vec3 cb = clamp(b, 0.0, 1.0);
        return (ca + cb - ca * cb) + max(a - 1.0, 0.0) + max(b - 1.0, 0.0);
    } else if (mode == 3) {                // Overlay
        vec3 ca = clamp(a, 0.0, 1.0);
        vec3 cb = clamp(b, 0.0, 1.0);
        return mix(2.0 * ca * cb, 1.0 - 2.0 * (1.0 - ca) * (1.0 - cb), step(vec3(0.5), ca));
    } else if (mode == 4) {                // Soft Light
        return softLightW3C(clamp(a, 0.0, 1.0), clamp(b, 0.0, 1.0));
    } else if (mode == 5) {                // Multiply
        return a * b;
    } else if (mode == 6) {                // Add
        return a + b;
    }
    return b;                              // Normal
}

vec3 applyBlendMode(vec3 baseCol, vec3 blendCol, int mode, float opacity, bool linearSpace) {
    opacity = clamp(opacity, 0.0, 1.0);
    if (mode == 2 || mode == 7) {          // Linear Add / Linear Dodge: always linear light
        return mix(baseCol, baseCol + blendCol, opacity);
    }
    if (mode == 0 && opacity >= 0.9999) return blendCol;
    if (linearSpace) {
        return mix(baseCol, blendCore(baseCol, blendCol, mode), opacity);
    }
    vec3 ga = pow(max(baseCol, vec3(0.0)), vec3(1.0 / 2.2));
    vec3 gb = pow(max(blendCol, vec3(0.0)), vec3(1.0 / 2.2));
    vec3 gr = mix(ga, blendCore(ga, gb, mode), opacity);
    return pow(max(gr, vec3(0.0)), vec3(2.2));
}

vec3 tintFor(float id) {
    if (id == 1.0) return vec3(1.20, 1.05, 0.65);
    if (id == 2.0) return vec3(0.40, 1.10, 1.45);
    if (id == 3.0) return vec3(1.25, 0.85, 0.40);
    if (id == 4.0) return vec3(1.30, 0.25, 0.30);
    if (id == 5.0) return vec3(1.00, 0.55, 1.45);
    if (id == 6.0) return vec3(1.35, 0.65, 0.95);
    return vec3(1.0);
}

vec3 saturateColor(vec3 c, float s) {
    float l = luma(c);
    return max(mix(vec3(l), c, s), vec3(0.0));
}

// Lowest highlight threshold any enabled glow needs (shared bloom extraction)
float glowExtractThreshold() {
    float t = 1.0;
    bool any_ = false;
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int i = 0; i < total; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;
        if (L.deepGlowIntensity > 0.01 || L.kawaseGlowIntensity > 0.01) { t = min(t, L.deepGlowThreshold); any_ = true; }
        if (L.diffuseSpGlowIntensity > 0.01) { t = min(t, L.diffuseSpGlowThreshold); any_ = true; }
        if (L.shaderlyGlowIntensity > 0.01)  { t = min(t, L.shaderlyGlowThreshold);  any_ = true; }
        if (L.lightWrapIntensity > 0.01 && L.lightWrapWidth > 0.01) { t = min(t, L.lightWrapThreshold); any_ = true; }
        if (L.thinStreakIntensity > 0.01)    { t = min(t, 0.20); any_ = true; }
        if (L.halationRadius > 0.01 && L.halationStrength > 0.01) { t = min(t, clamp(L.halationThreshold, 0.25, 0.95)); any_ = true; }
        if (L.copiedProMist > 0.01 || L.bslaBloomHaze > 0.01 || L.bslFogScatter > 0.01) { t = min(t, 0.40); any_ = true; }
    }
    return any_ ? clamp(t, 0.05, 0.95) : 0.60;
}

float edgeSensitivity() {
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int i = 0; i < total; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;
        if (L.sapphireGlowWidth > 0.01 || L.copiedEdgeRays > 0.01 || L.edgeHaloRadius > 0.01)
            return clamp(L.sapphireGlowThreshold, 0.1, 0.99);
    }
    return 0.70;
}

vec3 gateGlow(vec3 g, float th, float exMin) {
    float rel = th - exMin;
    if (rel <= 0.03) return g;
    float l = luma(g);
    return g * smoothstep(rel * 0.15, rel * 0.15 + 0.12, l);
}

// =============================================================================
// PASS 1: HIGHLIGHT + EDGE EXTRACTION -> Bloom L0
// =============================================================================
void executeHighlightExtraction(ivec2 coord, int l0W, int l0H, int srcW, int srcH) {
    vec2 centerUV = (vec2(coord) + 0.5) / vec2(l0W, l0H);
    ivec2 srcC = clamp(ivec2(centerUV * vec2(srcW, srcH)), ivec2(0), ivec2(srcW - 1, srcH - 1));

    vec3 col = unpackComposite(srcC.y * srcW + srcC.x).rgb;
    float l = luma(col);

    float threshold = glowExtractThreshold();
    float knee = smoothstep(threshold, threshold + 0.20, l);
    vec3 isolated = col * knee;
    isolated *= karisWeight(isolated);

    // Edge mask (perceptual-luma Sobel, 2px step because L0 is half-res)
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec3 pc = compAt(srcC + ivec2(x, y) * 2, srcW, srcH);
            float lp = sqrt(max(luma(pc), 0.0));
            gx += lp * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lp * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float grad = sqrt(gx * gx + gy * gy);
    float sens = edgeSensitivity();
    float edge = smoothstep(sens * 0.12, sens * 0.12 + 0.16, grad);

    bloomStore(0, coord.y * l0W + coord.x, vec4(isolated, edge));
}

// PASS 2, 3, 7, 8: 13-tap anti-grid downsample (2: L0->L1, 3: L1->L2, 7: L2->L3, 8: L3->L4)
void executeBloomDownsample(int passIdx, ivec2 coord, int width, int height, float radius) {
    int srcLevel = (passIdx == 2) ? 0 : ((passIdx == 3) ? 1 : ((passIdx == 7) ? 2 : 3));
    // The parent level is built with integer shifts (w >> n), so it is NOT always 2x the child
    // (e.g. 819 -> 409). Using width*2 read the parent with the wrong row stride at odd sizes and
    // sheared the whole bloom pyramid into ghost copies. The host now passes the exact parent size.
    int srcW = (u_srcW > 0) ? u_srcW : width * 2;
    int srcH = (u_srcH > 0) ? u_srcH : height * 2;
    vec2 uv = (vec2(coord) + 0.5) / vec2(width, height);
    vec2 texel = (1.0 / vec2(srcW, srcH)) * max(radius, 0.6);
    float x = texel.x;
    float y = texel.y;

    vec4 a = sampleBloom(srcLevel, uv + vec2(-2.0 * x,  2.0 * y), srcW, srcH);
    vec4 b = sampleBloom(srcLevel, uv + vec2( 0.0,      2.0 * y), srcW, srcH);
    vec4 c = sampleBloom(srcLevel, uv + vec2( 2.0 * x,  2.0 * y), srcW, srcH);
    vec4 d = sampleBloom(srcLevel, uv + vec2(-2.0 * x,  0.0), srcW, srcH);
    vec4 e = sampleBloom(srcLevel, uv, srcW, srcH);
    vec4 f = sampleBloom(srcLevel, uv + vec2( 2.0 * x,  0.0), srcW, srcH);
    vec4 g = sampleBloom(srcLevel, uv + vec2(-2.0 * x, -2.0 * y), srcW, srcH);
    vec4 h = sampleBloom(srcLevel, uv + vec2( 0.0,     -2.0 * y), srcW, srcH);
    vec4 i = sampleBloom(srcLevel, uv + vec2( 2.0 * x, -2.0 * y), srcW, srcH);
    vec4 j = sampleBloom(srcLevel, uv + vec2(-x,  y), srcW, srcH);
    vec4 k = sampleBloom(srcLevel, uv + vec2( x,  y), srcW, srcH);
    vec4 l = sampleBloom(srcLevel, uv + vec2(-x, -y), srcW, srcH);
    vec4 m = sampleBloom(srcLevel, uv + vec2( x, -y), srcW, srcH);

    vec4 downsample = (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (e + j + k + l + m) * 0.125;
    bloomStore(srcLevel + 1, coord.y * width + coord.x, downsample);
}

// PASS 4, 5, 9: tent upsample (4: L2->L1, 5: L1->L0, 9: L4->L3)
void executeBloomUpsample(int passIdx, ivec2 coord, int w, int h, float radius) {
    int srcLevel = (passIdx == 4) ? 2 : ((passIdx == 5) ? 1 : 4);
    int srcW = w / 2;
    int srcH = h / 2;
    vec2 uv = (vec2(coord) + 0.5) / vec2(w, h);
    vec2 texel = (1.0 / vec2(srcW, srcH)) * max(radius, 0.6);

    vec4 sum = vec4(0.0);
    sum += sampleBloom(srcLevel, uv + vec2(-texel.x, 0.0), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2( texel.x, 0.0), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2(0.0, -texel.y), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2(0.0,  texel.y), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2(-texel.x, -texel.y), srcW, srcH);
    sum += sampleBloom(srcLevel, uv + vec2( texel.x, -texel.y), srcW, srcH);
    sum += sampleBloom(srcLevel, uv + vec2(-texel.x,  texel.y), srcW, srcH);
    sum += sampleBloom(srcLevel, uv + vec2( texel.x,  texel.y), srcW, srcH);
    sum /= 12.0;

    int dstLevel = srcLevel - 1;
    int dstIdx = coord.y * w + coord.x;
    vec4 existing = bloomLoad(dstLevel, dstIdx);
    bloomStore(dstLevel, dstIdx, mix(existing, sum, 0.55));
}

// =============================================================================
// SCENE-COLOUR HELPERS (glows / flares inherit the background instead of going white)
// =============================================================================
vec3 sampleAmbientColor(ivec2 coord, int width, int height, float radiusPx) {
    vec3 acc = vec3(0.0);
    float wsum = 0.0;
    const int AMB_TAPS = 16;
    // Fixed pattern (no per-pixel random rotation = no grain) and each tap is a 4-point box blur,
    // so neighbouring pixels see nearly the same colour and the result is smooth.
    int foot = int(max(round(radiusPx * 0.11), 1.0));
    for (int k = 0; k < AMB_TAPS; k++) {
        float fr = (float(k) + 0.5) / float(AMB_TAPS);
        float rr = sqrt(fr) * radiusPx;
        float ang = float(k) * 2.39996323;
        ivec2 c0 = coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr));
        vec3 s = 0.25 * (compAt(c0 + ivec2(foot, foot), width, height) + compAt(c0 + ivec2(-foot, foot), width, height)
                       + compAt(c0 + ivec2(foot, -foot), width, height) + compAt(c0 + ivec2(-foot, -foot), width, height));
        float w = smoothstep(0.015, 0.12, luma(s)) + 0.03;   // ignore ink / near-black
        acc += s * w;
        wsum += w;
    }
    return acc / max(wsum, 1e-4);
}

// Glows built from highlight extraction tend to be near-white. Where a glow has little chroma,
// re-tint it with the surrounding scene colour (luminance of the glow is preserved).
vec3 colorizeGlow(vec3 g, vec3 ambient, float amount) {
    float lg = luma(g);
    if (lg < 1e-5) return g;
    float mx = max(g.r, max(g.g, g.b));
    float mn = min(g.r, min(g.g, g.b));
    float chroma = (mx - mn) / max(mx, 1e-5);
    float whiteness = 1.0 - clamp(chroma * 2.5, 0.0, 1.0);
    float la = luma(ambient);
    vec3 hue = (la > 1e-4) ? clamp(ambient / la, vec3(0.05), vec3(4.0)) : vec3(1.0);
    hue = saturateColor(hue, 1.5);
    hue /= max(luma(hue), 1e-4);
    return mix(g, hue * lg, clamp(whiteness * amount, 0.0, 1.0));
}

// Flare beam profile along the streak. at = 0 at the source, 1 at the end of the reach.
// pw/pk come from the softness slider: low = peaked spike, high = flat plateau with a soft shoulder.
float flareProfile(float at, float pk, float pw) {
    return exp(-pk * pow(clamp(at, 0.0, 1.0), pw)) * (1.0 - smoothstep(0.80, 1.0, at));
}

float gaussBand(float x, float w) {
    float t = x / w;
    return exp(-t * t);
}

// Multi-band chrome reflection. v: 0 = top of the text, 1 = bottom. Horizon sits just under the
// middle: bright sky -> dark band -> thin bright horizon line -> dark ground -> lit lower band.
vec3 chromeBands(float v, vec3 skyRef, vec3 gndRef) {
    const float HZ = 0.52;
    vec3 top = mix(skyRef * 1.25, skyRef * 0.28, smoothstep(0.0, HZ - 0.04, v));
    top *= 1.0 - 0.60 * gaussBand(v - (HZ - 0.07), 0.05);
    vec3 warm = vec3(1.0, 0.72, 0.45);
    vec3 bot = mix(gndRef * 0.22, gndRef * 1.15 + warm * 0.10, smoothstep(HZ, 0.92, v));
    bot += (gndRef * 0.6 + warm * 0.08) * gaussBand(v - 0.83, 0.06);
    vec3 col = mix(top, bot, smoothstep(HZ - 0.012, HZ + 0.012, v));
    col += mix(vec3(1.0), skyRef, 0.35) * gaussBand(v - HZ, 0.012) * 1.4;
    return col;
}

// Light satin-metal tone for the text faces. v: 0 = top of the letter, 1 = bottom.
// Small brightness multiplier (~0.88 .. 1.12) with one crisp horizon line - it must never flatten the artwork.
float silkProfile(float v) {
    float p = mix(1.10, 0.93, smoothstep(0.0, 0.5, v));
    p += 0.10 * gaussBand(v - 0.52, 0.03);
    p -= 0.10 * smoothstep(0.60, 0.78, v);
    p += 0.08 * gaussBand(v - 0.92, 0.05);
    return p;
}

// =============================================================================
// FINAL COMPOSITE HELPERS
// =============================================================================
vec3 applyFxaa(ivec2 coord, int width, int height) {
    vec3 rgbM = compAt(coord, width, height);
    float lumaM = luma(rgbM);
    vec3 cU = compAt(coord + ivec2(0, -1), width, height);
    vec3 cD = compAt(coord + ivec2(0,  1), width, height);
    vec3 cL = compAt(coord + ivec2(-1, 0), width, height);
    vec3 cR = compAt(coord + ivec2( 1, 0), width, height);
    float lU = luma(cU); float lD = luma(cD); float lL = luma(cL); float lR = luma(cR);
    float lumaMin = min(lumaM, min(min(lU, lD), min(lL, lR)));
    float lumaMax = max(lumaM, max(max(lU, lD), max(lL, lR)));
    if ((lumaMax - lumaMin) < max(0.04, lumaMax * 0.12)) return rgbM;
    return mix(rgbM, (cU + cD + cL + cR) * 0.25, 0.30);
}

// =============================================================================
// DOMINANT LIGHT SOURCE (used by Diffuse SP)
// One 16x16 workgroup scans the 1/8-res highlight pyramid level on a 16x16 lattice (4 sub-taps per
// cell so small suns are not missed) and reduces it in shared memory to a luminance^3-weighted
// centroid. That is the "where would the sun / brightest source be" point. Cost: ~1 load/pixel.
// =============================================================================
shared vec4 s_lightA[256];   // rgb * w, w
shared vec2 s_lightB[256];   // uv  * w
vec2  gLightUV = vec2(0.5, 0.10);
vec3  gLightCol = vec3(1.0);
float gLightStrength = 0.0;

bool diffuseLayerActive() {
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int i = 0; i < total; i++) {
        if (layers[i].isEnabled > 0.5 && layers[i].diffuseSpGlowIntensity > 0.01) return true;
    }
    return false;
}

// MUST be called from uniform control flow (before any early return) because it uses barrier().
void detectDominantLight(int width, int height) {
    uint lid = gl_LocalInvocationIndex;
    ivec2 cell = ivec2(int(lid & 15u), int(lid >> 4u));
    int w8 = max(width / 8, 1);
    int h8 = max(height / 8, 1);
    vec4 acc = vec4(0.0);
    vec2 accUV = vec2(0.0);
    for (int k = 0; k < 4; k++) {
        vec2 sub = vec2(float(k & 1), float(k >> 1)) * 0.5 + 0.25;
        vec2 cuv = (vec2(cell) + sub) / 16.0;
        vec3 c = sampleBloom(2, cuv, w8, h8).rgb;
        float l = luma(c);
        float w = l * l * l;
        acc += vec4(c * w, w);
        accUV += cuv * w;
    }
    s_lightA[lid] = acc;
    s_lightB[lid] = accUV;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (lid < st) {
            s_lightA[lid] += s_lightA[lid + st];
            s_lightB[lid] += s_lightB[lid + st];
        }
        barrier();
    }
    float wt = s_lightA[0].w;
    if (wt > 1e-7) {
        gLightUV = s_lightB[0] / wt;
        vec3 lc = s_lightA[0].rgb / wt;
        float ll = max(luma(lc), 1e-4);
        gLightCol = clamp(lc / ll, vec3(0.3), vec3(3.0));          // hue only (luma = 1)
        gLightStrength = smoothstep(0.02, 0.35, ll);
    }
}

// =============================================================================
// PASS 6: GLOWS, LIGHT WRAP, ATMOSPHERE, TONEMAP, LUT, TPDF DITHER
// =============================================================================
void executeFinalComposite(ivec2 coord, int width, int height) {
    int pixelIndex = coord.y * width + coord.x;
    float bitMode = gBit;

    vec4 compPx = unpackComposite(pixelIndex);
    vec3 linearBase = applyFxaa(coord, width, height);
    float centerLuma = luma(linearBase);
    vec2 uv = (vec2(coord) + 0.5) / vec2(width, height);

    vec4 tightS = sampleBloom(0, uv, max(width / 2, 1), max(height / 2, 1));
    vec4 midS   = sampleBloom(1, uv, max(width / 4, 1), max(height / 4, 1));
    vec4 wideS  = sampleBloom(2, uv, max(width / 8, 1), max(height / 8, 1));
    vec3 tightGlow = tightS.rgb;
    vec3 midGlow   = midS.rgb;
    vec3 wideGlow  = wideS.rgb;

    // line-art edge gradient (used to protect ink lines)
    float resScale = gRes;
    int edgeStep = gEdgeStep;
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float lum = luma(compAt(coord + ivec2(x * edgeStep, y * edgeStep), width, height));
            gx += lum * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lum * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);

    float exMin = glowExtractThreshold();
    int totalLayers = int(clamp(u_layerCount, 1.0, 10.0));

    // Scene colour context shared by every glow / flare (only paid for when one is active)
    bool anyGlow = false;
    for (int i = 0; i < totalLayers; i++) {
        LayerData Lg = layers[i];
        if (Lg.isEnabled < 0.5) continue;
        if (Lg.deepGlowIntensity > 0.01 || Lg.kawaseGlowIntensity > 0.01 || Lg.diffuseSpGlowIntensity > 0.01 ||
            Lg.shaderlyGlowIntensity > 0.01 || Lg.copiedEdgeRays > 0.01 || Lg.sapphireGlowWidth > 0.01 ||
            Lg.edgeHaloRadius > 0.01 || Lg.thinStreakIntensity > 0.01) { anyGlow = true; }
    }
    float maxDim = float(max(width, height));
    vec3 ambientCol = vec3(0.5);
    vec3 ambientNear = vec3(0.5);
    if (anyGlow) {
        ambientCol  = sampleAmbientColor(coord, width, height, 0.045 * maxDim);
        ambientNear = sampleAmbientColor(coord, width, height, 0.012 * maxDim);
    }

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;
        float op = clamp(L.opacity, 0.0, 1.0);
        vec3 glowTint = tintFor(L.edgeGlowTint);

        // ---- S_LightWrap: blurred BACKGROUND light wrapping into the darker foreground edge ----
        // v2.2: no more tap ring. The old version gathered a fixed ring of raw taps (a literal copy of
        // the clip at a fixed offset = the "duplicated ring"). Now the wrap source is the already
        // blurred highlight pyramid, so it is a smooth gradient that is strong at the silhouette and
        // dies off inward, exactly like a real light wrap.
        if (L.lightWrapIntensity > 0.01 && L.lightWrapWidth > 0.01) {
            float wv = clamp(L.lightWrapWidth, 0.0, 1.0);
            vec3 field = (wv < 0.5) ? mix(tightGlow, midGlow, wv * 2.0) : mix(midGlow, wideGlow, (wv - 0.5) * 2.0);
            field = gateGlow(field, L.lightWrapThreshold, exMin);
            float lumaP = luma(linearBase);
            float lf = luma(field);
            // the pixel only receives light if it is darker than the light spilling onto it
            float receive = clamp((lf - lumaP * 0.85) / max(lf, 1e-4), 0.0, 1.0);
            receive = receive * receive * (3.0 - 2.0 * receive);
            // hug the silhouette: strongest where the blurred edge mask is high
            float nearEdge = clamp(max(tightS.a, midS.a * 0.8) * 1.6, 0.0, 1.0);
            float edgeGate = mix(0.15, 1.0, nearEdge);
            vec3 wrap = saturateColor(field, 1.10) * receive * edgeGate * L.lightWrapIntensity * 1.35;
            float lw = luma(wrap);
            if (lw > 1e-5) wrap *= (1.0 - exp(-lw * 1.3)) / lw;   // soft-limit: never slams to pure white
            // INNER EDGE DEPTH: bright subject pixels right at the silhouette (they receive no wrap) go
            // deeper and richer: darker, with their own colour pushed (skin -> warm rose, not grey).
            float innerEdge = nearEdge * (1.0 - receive) * smoothstep(0.15, 0.60, lumaP);
            vec3 deepEdge = saturateColor(linearBase, 1.45) * 0.72;
            linearBase = mix(linearBase, deepEdge, clamp(innerEdge * L.lightWrapIntensity * 0.55, 0.0, 0.7) * op);
            if (L.lightWrapBlendMode > 0.5) linearBase += wrap * op;
            else {
                vec3 cb = clamp(linearBase, 0.0, 1.0);
                linearBase = mix(linearBase, cb + wrap - cb * wrap + max(linearBase - 1.0, 0.0), op);
            }
        }

        // ---- 1. Deep Glow: multi-radius, colour-faithful, energy-aware ----
        if (L.deepGlowIntensity > 0.01) {
            float r = clamp(L.deepGlowRadius, 0.0, 1.0);
            // Inverse-square style decay: each pyramid level (relative blur size sT/sM/sW) is weighted by
            // 1/(1+(s/R)^2). Small R = bright tight core with a short tail; large R pulls energy into the
            // wide levels = long, slowly fading tail. The tight core is always present.
            float Rg = mix(0.8, 7.0, r);
            float wT = 1.0 / (1.0 + (1.0 / Rg) * (1.0 / Rg));
            float wM = 1.0 / (1.0 + (2.5 / Rg) * (2.5 / Rg));
            float wW = 1.0 / (1.0 + (6.0 / Rg) * (6.0 / Rg));
            float wn = wT + wM + wW;
            vec3 g = (tightGlow * wT + midGlow * wM + wideGlow * wW) / wn;

            // LONG TAIL: two extra pyramid levels (1/16 and 1/32 res, built by passes 7-9) carry the glow
            // far from the source. They follow the same inverse-square decay as the other levels (relative
            // blur size ~14 and ~30) and are ADDED, so a bigger Radius lengthens the tail without
            // dimming the core. Pure bilinear reads of a genuinely blurred image: no sampling pattern,
            // so no echoes or ghost copies are possible.
            {
                float wL3 = 1.0 / (1.0 + (14.0 / Rg) * (14.0 / Rg));
                float wL4 = 1.0 / (1.0 + (30.0 / Rg) * (30.0 / Rg));
                vec3 lv3 = sampleBloom(3, uv, max(width / 16, 1), max(height / 16, 1)).rgb;
                vec3 lv4 = sampleBloom(4, uv, max(width / 32, 1), max(height / 32, 1)).rgb;
                g += lv3 * wL3 * 1.6 + lv4 * wL4 * 2.6;
            }

            g = gateGlow(g, L.deepGlowThreshold, exMin);
            g = colorizeGlow(g, ambientCol, 0.85);
            g = saturateColor(g, 1.15) * mix(vec3(1.0), glowTint, 0.80);
            // Deep Glow signature: a hot core. Where the tight glow is strong the light burns towards
            // white (energy-aware), while the outer falloff keeps the scene colour.
            float hotAmt = smoothstep(0.30, 1.10, luma(tightGlow) * (1.25 - 0.6 * r));
            g = mix(g, vec3(luma(g)) * vec3(1.00, 0.96, 0.90) * 1.20, hotAmt * 0.35);
            g *= (1.0 - lineEdge * 0.15);
            // bright pixels (skin highlights) receive less added light so their colour variation survives
            float dgRecv = mix(0.40, 1.0, 1.0 - smoothstep(0.50, 1.10, luma(linearBase)));
            linearBase += g * (L.deepGlowIntensity * 1.9) * dgRecv * op;
        }

        // ---- 2. Kawase glow ----
        if (L.kawaseGlowIntensity > 0.01) {
            float r = clamp(L.kawaseGlowRadius, 0.0, 1.0);
            vec3 g = (r < 0.5) ? mix(tightGlow, midGlow, r * 2.0) : mix(midGlow, wideGlow, (r - 0.5) * 2.0);
            g = gateGlow(g, L.deepGlowThreshold, exMin);
            g = colorizeGlow(g, ambientCol, 0.80);
            linearBase += g * glowTint * (L.kawaseGlowIntensity * 1.6) * op;
        }

        // ---- 3. Diffuse SP: light-source simulation + prismatic dispersion bloom ----
        // Finds the dominant light (sun / brightest source), then every pixel gathers the highlight
        // field ALONG THE RAY towards that light, so the light visibly travels onto the subject
        // instead of just blooming in place. The R/G/B gathers use radially scaled offsets about the
        // light (R furthest, B least) = prismatic screen-space dispersion with radial chromatic
        // aberration that grows with distance from the source. Strength falls off with distance to
        // the light, and pixels that are already bright receive less.
        if (L.diffuseSpGlowIntensity > 0.01) {
            float r = clamp(L.diffuseSpGlowRadius, 0.0, 1.0);
            float aspect = float(width) / float(height);
            vec2 toL = (gLightUV - uv) * vec2(aspect, 1.0);
            float dL = length(toL);
            vec2 dirUv = (toL / max(dL, 1e-4)) * vec2(1.0 / aspect, 1.0);   // unit direction, in uv space
            float dispAmt = (0.006 + r * 0.040) * (0.35 + dL);               // dispersion grows with distance
            float reachLen = dL * (0.45 + 0.55 * r);                          // how far along the ray we gather
            int mw = max(width / 4, 1); int mh = max(height / 4, 1);
            int ww = max(width / 8, 1); int wh = max(height / 8, 1);
            float jit = hashInt12(coord * 7 + ivec2(3, 29));
            const int DN = 6;
            vec3 prism = vec3(0.0);
            float wsum = 0.0;
            for (int k = 0; k < DN; k++) {
                float t = (float(k) + jit) / float(DN);                       // 0..1 along the ray
                float wk = exp(-t * 1.8);
                vec2 base = uv + dirUv * reachLen * t;
                int lv = (t < 0.5) ? 1 : 2;
                int lw_ = (lv == 1) ? mw : ww;
                int lh_ = (lv == 1) ? mh : wh;
                float sR = sampleBloom(lv, base + dirUv * dispAmt * 1.00, lw_, lh_).r;
                float sG = sampleBloom(lv, base + dirUv * dispAmt * 0.60, lw_, lh_).g;
                float sB = sampleBloom(lv, base + dirUv * dispAmt * 0.22, lw_, lh_).b;
                prism += vec3(sR, sG, sB) * wk;
                wsum += wk;
            }
            prism /= max(wsum, 1e-3);
            vec3 core = mix(tightGlow, midGlow, 0.5) * vec3(1.06, 1.00, 0.92);
            vec3 g = prism * 1.15 + core * 0.30;
            g = gateGlow(g, L.diffuseSpGlowThreshold, exMin);
            g = colorizeGlow(g, ambientCol, 0.55);
            g *= mix(vec3(1.0), gLightCol, 0.35);                              // inherit the light's own colour
            float prox = 1.0 / (1.0 + dL * dL * mix(14.0, 3.0, r));            // closer to the light = stronger
            float receiveD = 1.0 - smoothstep(0.55, 1.15, luma(linearBase));    // already-bright pixels receive less
            float gain = mix(0.30, 1.0, prox) * mix(0.55, 1.0, gLightStrength);
            linearBase += g * (L.diffuseSpGlowIntensity * 1.5) * gain * receiveD * (1.0 - lineEdge * 0.25) * op;
        }

        // ---- 4a. Sapphire edge glow: glow that comes FROM the detected edges ----
        // v2.6: the old version lit the contour itself (= the line art turned into a bright line). Now the edge mask
        // is blurred (tight -> mid -> wide with the width slider) and the line art itself is masked OUT, so the
        // light spills from the edges into the surroundings while the drawn lines stay exactly as they were.
        // Colour comes from the bright side of the edge.
        {
            float sapInt = 0.0;
            if (L.copiedEdgeRays > 0.01) sapInt = L.copiedEdgeRays;
            else if (L.sapphireGlowWidth > 0.01) sapInt = 0.8;
            if (sapInt > 0.01) {
                float widthN = clamp(L.sapphireGlowWidth * 0.5, 0.0, 1.0);          // 0..1 (slider is 0..2)
                float sens = clamp(L.sapphireGlowThreshold, 0.1, 0.99);
                float lo = sens * 0.30;
                float crisp = smoothstep(lo, lo + 0.18, lineEdge);                   // = the line art / contour itself
                int ss = max(3, edgeStep * 3);
                vec3 n0 = compAt(coord + ivec2( ss, 0), width, height);
                vec3 n1 = compAt(coord + ivec2(-ss, 0), width, height);
                vec3 n2 = compAt(coord + ivec2(0,  ss), width, height);
                vec3 n3 = compAt(coord + ivec2(0, -ss), width, height);
                vec3 lit = n0;
                if (luma(n1) > luma(lit)) lit = n1;
                if (luma(n2) > luma(lit)) lit = n2;
                if (luma(n3) > luma(lit)) lit = n3;
                float ll = max(luma(lit), 1e-4);
                vec3 hueL = saturateColor(clamp(lit / ll, vec3(0.05), vec3(4.0)), 1.45);
                hueL /= max(luma(hueL), 1e-4);
                float lvl = clamp(ll * 1.5 + 0.25, 0.30, 1.60);
                vec3 edgeCol = hueL * lvl + ambientNear * 0.15;
                edgeCol = mix(edgeCol, edgeCol * glowTint + glowTint * 0.10 * luma(edgeCol), step(0.5, L.edgeGlowTint) * 0.65);
                // blurred edge mask: tight (slider low) -> mid -> wide (slider high)
                float eBlur = mix(mix(tightS.a, midS.a, clamp(widthN * 2.0, 0.0, 1.0)), wideS.a, clamp(widthN * 2.0 - 1.0, 0.0, 1.0));
                eBlur = smoothstep(0.02, 0.45, eBlur);
                float offLine = 1.0 - crisp * 0.92;                                  // never brighten the line art itself
                float field = eBlur * offLine * (1.15 + widthN * 0.9);
                linearBase += edgeCol * field * sapInt * 0.85 * op;
            }
        }

        // ---- 4b. Edge Halo: a wide, soft AURA that spills OUTWARD from silhouettes ----
        // Opposite of Sapphire: no contour at all (it is masked off the line itself), very wide, built
        // from the coarse edge mask, tinted by the surrounding ambient light, and it prefers the darker
        // side of an edge so it reads as light bleeding out into the background.
        if (L.edgeHaloRadius > 0.01) {
            float hs = clamp(L.edgeHaloRadius / 1.5, 0.0, 1.0);
            // The raw edge mask is speckly (it is a Sobel of a noisy / 8-bit source), and the old
            // 1 - exp(-k*mask) curve amplified every tiny speckle into grain. Now: gather the mask
            // with a fixed 16-tap gaussian spiral from the 1/8-res level (bilinear = smooth), then
            // gate out the low-level noise floor before shaping the aura.
            int hw = max(width / 8, 1);
            int hh = max(height / 8, 1);
            float spread = mix(1.6, 5.0, hs);
            float eAcc = 0.0;
            float eWt = 0.0;
            for (int hk = 0; hk < 16; hk++) {
                float hfr = (float(hk) + 0.5) / 16.0;
                float hr = sqrt(hfr) * spread;
                float ha = float(hk) * 2.39996323;
                vec2 hoff = vec2(cos(ha), sin(ha)) * hr / vec2(float(hw), float(hh));
                float hwgt = exp(-hfr * 1.4);
                eAcc += sampleBloom(2, uv + hoff, hw, hh).a * hwgt;
                eWt += hwgt;
            }
            float eWide = eAcc / eWt;
            float eH = smoothstep(0.025, 0.50, eWide);
            eH = eH * eH * (3.0 - 2.0 * eH);
            float la = luma(ambientCol);
            float lp = luma(wideGlow) * 0.5 + luma(linearBase) * 0.5;
            float outward = smoothstep(-0.2, 0.60, (la - lp) / (la + 0.05));
            float sideGate = mix(0.45, 1.0, outward);
            vec3 haloCol = saturateColor(ambientCol * 1.15 + wideGlow * 1.4 + midGlow * 0.4, 1.25);
            haloCol *= mix(vec3(1.0), glowTint, 0.70);
            linearBase += haloCol * eH * sideGate * L.edgeHaloRadius * 0.60 * (1.0 - lineEdge * 0.30) * op;
        }

        // ---- 5. Anamorphic flare v4 ----
        // The old flare treated almost the whole image as a source (the shared bloom extraction threshold for flares is
        // 0.20), so most rows lit up and the beams merged into full-width white bars, and "from edge" just multiplied
        // that by a left/right fade. Now:
        // * Sources are only strong LOCAL PEAKS above a Threshold slider.
        // * Spacing: a source only flares if it is the strongest one within +-Spacing of its row (vertical non-maximum
        //   suppression), so flares are separate bands, not a wall.
        // * Thickness sets the band height. Softness ONLY changes the edge of the band: low = flat-topped with a crisp
        //   edge, high = blurred and spread out.
        // * Origin: 0 = beam grows out of each highlight, 1 = beam enters from the left / right frame edge on the
        //   source's row and runs inward (Length = how far in). In-between mixes both.
        // * Colour: source colour, blended toward the scene colour, with an optional hot white core.
        if (L.thinStreakIntensity > 0.01 && L.thinStreakOpacity > 0.01) {
            const int NT = 56;
            float origin = clamp(L.thinStreakEdgeMode, 0.0, 1.0);
            float soft = clamp(L.thinStreakSoftness, 0.0, 1.0);
            float reach = clamp(L.thinStreakWidth, 0.05, 2.0) * 0.5;         // frame widths per side / inward from the edge
            float thrV = mix(0.01, 0.20, clamp(L.flareThreshold, 0.0, 1.0));
            float spaceN = clamp(L.flareSpacing, 0.0, 0.5);
            float thick = clamp(L.flareThickness, 0.0, 1.0);
            float fall = clamp(L.flareFalloff, 0.0, 1.0);
            float pk = mix(2.2, 6.5, fall);
            const float pw = 1.25;
            bool needEdge = origin > 0.02;
            bool needLocal = origin < 0.98;

            float sxA = needEdge ? 0.0 : max(uv.x - reach, 0.0);
            float sxB = needEdge ? 1.0 : min(uv.x + reach, 1.0);
            float spacingPx = max((sxB - sxA) * float(width) / float(NT), 1.0);
            float bodyPx = max(float(height) * mix(0.004, 0.032, thick), 2.0);
            float lvlSp = clamp(log2(max(spacingPx, 2.0) / 2.0) + 0.6, 0.0, 4.0);   // blur >= 1.5x tap spacing: no beads
            float lvlBody = clamp(log2(bodyPx / 2.0), 0.0, 4.0);
            float lvl = max(lvlSp, lvlBody);
            float texPx = 2.0 * exp2(lvl);
            float normK = min(spacingPx / texPx, 1.0);
            // Source strength is normalised for the blur level (a small bright point keeps the same strength at any
            // thickness), thrV is the minimum strength a source needs to flare.
            float boost = pow(texPx * 0.125, 1.85);
            float bodyUv = bodyPx / float(height);
            float edgeW = mix(0.04, 0.38, soft);                             // hard: crisp edge, soft: wide blurred edge
            int l2W = max(width >> 3, 1);
            int l2H = max(height >> 3, 1);
            int l4W = max(width >> 5, 1);
            int l4H = max(height >> 5, 1);

            vec3 lSum = vec3(0.0);
            vec3 lMax = vec3(0.0);
            vec3 eSum = vec3(0.0);
            vec3 eMax = vec3(0.0);
            for (int k = 0; k < NT; k++) {
                float sx = mix(sxA, sxB, (float(k) + 0.5) / float(NT));
                float at = abs(sx - uv.x) / reach;
                float wLocal = needLocal ? flareProfile(at, pk, pw) : 0.0;
                if (!needEdge && wLocal < 0.003) continue;

                vec2 tapUv = vec2(sx, uv.y);
                vec3 sm = sampleBloomLevelF(lvl, tapUv, width, height);
                float sl = luma(sm);
                float sN = sl * boost;
                if (sN < thrV * 0.35) continue;

                // compact sources only: a big bright area (hair, sky, a lit wall) is NOT a flare source
                float f2 = luma(sampleBloom(2, tapUv, l2W, l2H).rgb);
                float f4 = luma(sampleBloom(4, tapUv, l4W, l4H).rgb);
                float compact = smoothstep(0.45, 0.80, 1.0 - f4 / max(f2, 1e-5));
                if (compact < 0.01) continue;

                // local peak of this source's vertical profile -> band edge is placed relative to it
                float pr = sN;
                for (int j = 1; j <= 2; j++) {
                    float o = bodyUv * 0.75 * float(j);
                    pr = max(pr, luma(sampleBloomLevelF(lvl, vec2(sx, uv.y + o), width, height)) * boost);
                    pr = max(pr, luma(sampleBloomLevelF(lvl, vec2(sx, uv.y - o), width, height)) * boost);
                }
                if (pr < thrV) continue;
                float v = sN / pr;
                float s = smoothstep(0.45 - edgeW, 0.45 + edgeW, v) * smoothstep(thrV, thrV * 1.8, pr) * compact;
                if (s < 0.004) continue;

                if (spaceN > 0.02) {
                    // strongest source within +-Spacing of this row? (soft non-maximum suppression)
                    float nb = 0.0;
                    for (int j = 1; j <= 3; j++) {
                        float o = spaceN * float(j) * 0.3333;
                        nb = max(nb, luma(sampleBloomLevelF(lvl, vec2(sx, uv.y + o), width, height)) * boost);
                        nb = max(nb, luma(sampleBloomLevelF(lvl, vec2(sx, uv.y - o), width, height)) * boost);
                    }
                    s *= smoothstep(0.55, 0.85, pr / max(pr, nb));
                    if (s < 0.004) continue;
                }

                vec3 hueC = sm / max(sl, 1e-4);                                // colour direction of the source
                float level = mix(1.0, clamp(pr / (thrV * 2.5), 0.6, 1.8), 0.25 + 0.5 * soft);
                vec3 c = hueC * (level * s);
                vec3 spectral = mix(vec3(0.85, 0.97, 1.15), vec3(1.15, 0.92, 0.75), clamp(at, 0.0, 1.0));
                if (needLocal) {
                    vec3 cl = c * mix(vec3(1.0), spectral, 0.20) * wLocal;
                    lSum += cl;
                    lMax = max(lMax, cl);
                }
                if (needEdge) {
                    eSum += c;
                    eMax = max(eMax, c);
                }
            }

            vec3 beamL = mix(lSum * normK, lMax, 0.50);
            float dE = min(uv.x, 1.0 - uv.x) / reach;
            vec3 beamE = mix(eSum * normK * 0.5, eMax, 0.75) * flareProfile(dE, pk, pw);
            vec3 beam = beamL;
            if (needEdge) beam = needLocal ? mix(beamL, beamE, origin) : beamE;

            vec3 st = beam;
            float lst = luma(st);
            if (lst > 1e-5) {
                float scn = clamp(L.flareSceneTint, 0.0, 1.0);
                st = colorizeGlow(st, ambientCol, 0.35 + 0.65 * scn);
                vec3 ah = clamp(ambientNear / max(luma(ambientNear), 1e-4), vec3(0.30), vec3(3.0));
                ah = saturateColor(ah, 1.35);
                ah /= max(luma(ah), 1e-4);
                st = mix(st, ah * lst, scn * 0.45);
                st = saturateColor(st, 1.10);
                float core = clamp(L.flareCoreWhite, 0.0, 1.0) * smoothstep(0.50, 1.40, lst);
                st = mix(st, vec3(lst), core * 0.75);
            }
            st *= mix(vec3(1.0), glowTint, 0.65);
            st = vec3(1.0) - exp(-st);                                         // filmic shoulder

            linearBase += st * L.thinStreakIntensity * 1.1 * L.thinStreakOpacity * op;
        }

        // ---- 6a. Pro-Mist: soft diffusion veil. Colour of the scene is kept (no tint), highlights bleed softly into
        //          the surroundings and contrast eases a little. Not an additive glow.
        if (L.copiedProMist > 0.01) {
            vec3 mist = mix(midGlow, wideGlow, 0.60);
            mist = gateGlow(mist, 0.40, exMin);
            vec3 veil = vec3(1.0) - exp(-mist * (L.copiedProMist * 1.1));
            vec3 cb = clamp(linearBase, 0.0, 1.0);
            vec3 screened = cb + veil * 0.55 - cb * veil * 0.55 + max(linearBase - 1.0, vec3(0.0));
            linearBase = mix(linearBase, screened, op * (1.0 - lineEdge * 0.65));
            float l0 = luma(linearBase);
            linearBase = mix(linearBase, vec3(l0) + (linearBase - vec3(l0)) * 0.97, clamp(L.copiedProMist * 0.5, 0.0, 0.5));
        }

        // ---- 6b. TRUE HALATION. Light from bright highlights passes through the film, reflects off the film base
        //          and re-exposes the emulsion from behind. The red layer is exposed most, green a little, blue
        //          almost not at all, so the spill is a red-orange fringe that is WIDE and sits OUTSIDE the
        //          highlight edge. Channels spread by different amounts (red widest). It is never a white
        //          luminance glow and the highlight cores themselves are left alone.
        if (L.halationRadius > 0.01 && L.halationStrength > 0.01) {
            float hr = clamp(L.halationRadius / 1.5, 0.0, 1.0);
            float lvlR = 1.0 + hr * 2.6;                       // red: widest pyramid level
            float lvlG = max(lvlR - 0.9, 0.0);                 // green: narrower
            vec3 hR = sampleBloomLevelF(lvlR, uv, width, height);
            vec3 hG = sampleBloomLevelF(lvlG, uv, width, height);
            float th = clamp(L.halationThreshold, 0.25, 0.95);
            float spillR = luma(gateGlow(hR, th, exMin));      // only highlights above the threshold feed it
            float spillG = luma(gateGlow(hG, th, exMin));
            float warm = clamp(L.halationWarmth / 1.5, 0.0, 1.0);   // 0 = deep red, 1 = orange
            vec3 halRGB = vec3(spillR * 1.00, spillG * mix(0.10, 0.34, warm), spillG * mix(0.0, 0.03, warm));
            // fringe sits outside the highlight: bright pixels receive little, dark neighbours receive the most
            float halRecv = 1.0 - smoothstep(0.50, 1.00, luma(linearBase));
            float hl = L.halationStrength * 1.4;
            linearBase += halRGB * hl * mix(0.10, 1.0, halRecv) * (1.0 - lineEdge * 0.6) * op;
        }

        // ---- 7. Atmosphere haze / scatter (glow-driven) ----
        if (L.bslaBloomHaze > 0.01) {
            vec3 hz = mix(wideGlow, vec3(luma(wideGlow)) * vec3(0.78, 0.90, 1.10), 0.35);
            linearBase += hz * L.bslaBloomHaze * 1.2 * op;
        }
        if (L.bslFogScatter > 0.01) {
            vec3 sc = mix(midGlow, wideGlow, 0.6) * vec3(1.05, 1.0, 0.92);
            linearBase += sc * L.bslFogScatter * 1.1 * op;
        }
    }

    // ---- Shaderly Glow: OVERALL glow (AE "Glow" effect) ----
    // Whole-frame, threshold-driven, always has a strong wide component and is SCREEN-blended (like AE's
    // Glow), so it lifts and softens the entire image rather than adding hot spots like Deep Glow.
    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5 || L.shaderlyGlowIntensity <= 0.01) continue;
        float r = clamp(L.shaderlyGlowRadius, 0.0, 1.0);
        float wT2 = 0.35 * (1.0 - r);
        float wM2 = 0.50;
        float wW2 = 0.40 + 0.60 * r;
        vec3 g = (tightGlow * wT2 + midGlow * wM2 + wideGlow * wW2) / (wT2 + wM2 + wW2);
        g = gateGlow(g, L.shaderlyGlowThreshold, exMin);
        g = colorizeGlow(g, ambientCol, 0.90);
        g = saturateColor(g, 1.30);
        if (L.shaderlyGlowTint > 0.01) {
            vec3 tint = srgbToLinear(hueToRGB(fract(L.shaderlyGlowTint)));
            g = mix(g, tint * luma(g) * 2.2, 0.55);
        }
        // exposure-style shoulder, then Screen against the image (never clips highlights)
        vec3 gl = vec3(1.0) - exp(-g * (L.shaderlyGlowIntensity * 2.4));
        vec3 cb = clamp(linearBase, 0.0, 1.0);
        vec3 screened = cb + gl - cb * gl + max(linearBase - 1.0, vec3(0.0));
        linearBase = mix(linearBase, screened, clamp(L.opacity, 0.0, 1.0) * (1.0 - lineEdge * 0.30));
    }

    // ---- Master tonemap -> sRGB ----
    vec3 finalLinear = applyToneMapping(linearBase, u_tonemapMode);
    vec3 finalDisplay = linearToSrgb(finalLinear);

    // ---- LUT: display-referred. The LUT gets a NEUTRAL display transform (identity below the knee, soft
    //      shoulder above), NOT the AgX / Neutral look. Feeding a creative LUT an already flattened AgX image is what
    //      made every LUT look washed out. LUT Opacity blends between the tonemapped look and the LUT look. ----
    if (u_hasLut > 0.5) {
        vec3 lutIn = linearToSrgb(tonemapLinearSoft(linearBase));
        vec3 lutOut = sample3DLutDisplay(lutIn, 1.0);
        finalDisplay = mix(finalDisplay, lutOut, clamp(u_lutOpacity, 0.0, 1.0));
    }

    // ---- TPDF dither right before the quantise (+-1 LSB triangular, scaled) ----
    float lsb = (bitMode > 1.5) ? (1.0 / 65535.0) : (1.0 / 255.0);
    float amt = mix(0.50, 1.00, clamp(u_ditherStrength, 0.0, 1.0));   // 1.0 = exact +-1 LSB triangular
    ivec2 shift = ivec2(int(fract(u_time * 0.1371) * 997.0), int(fract(u_time * 0.0713) * 991.0));
    float n1 = hashInt12(coord + shift);
    float n2 = hashInt12(coord + shift + ivec2(41, 17));
    float tpdf = (n1 + n2) - 1.0;
    vec3 chroma = vec3(tpdf, (hashInt12(coord + shift + ivec2(7, 91)) + hashInt12(coord + shift + ivec2(113, 3)) - 1.0),
                       (hashInt12(coord + shift + ivec2(59, 29)) + hashInt12(coord + shift + ivec2(5, 211)) - 1.0));
    finalDisplay = clamp(finalDisplay + mix(vec3(tpdf), chroma, 0.35) * lsb * amt, 0.0, 1.0);

    packFinalDisplay(pixelIndex, vec4(finalDisplay, 1.0), bitMode);
}

// =============================================================================
// v2.4 helpers (pass 0)
// =============================================================================
vec3 srcLinBilinear(vec2 p) {
    vec2 q = p - 0.5;
    ivec2 i0 = ivec2(floor(q));
    vec2 f = q - vec2(i0);
    vec3 a = srcLin(i0);
    vec3 b = srcLin(i0 + ivec2(1, 0));
    vec3 c = srcLin(i0 + ivec2(0, 1));
    vec3 d = srcLin(i0 + ivec2(1, 1));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

// Oklab hue/chroma/lightness skin-tone mask (same range the anime skin smoother uses)
float skinMaskOf(vec3 lin) {
    vec3 lab = linearRgbToOklab(lin);
    float ch = length(lab.yz);
    float h = atan(lab.z, lab.y);
    return smoothstep(0.30, 0.55, h) * (1.0 - smoothstep(1.20, 1.50, h))
         * smoothstep(0.015, 0.040, ch) * (1.0 - smoothstep(0.13, 0.19, ch))
         * smoothstep(0.42, 0.62, lab.x);
}

// =============================================================================
// MAIN
// =============================================================================

// =============================================================================
// GRADIENT MAP FUNCTIONS
// =============================================================================
vec3 gmapUnpack(float f) {
    uint v = uint(f + 0.5);
    return vec3(float((v >> 16u) & 255u), float((v >> 8u) & 255u), float(v & 255u)) / 255.0;
}

vec3 gmapRamp(GMapData G, float t) {
    int n = int(clamp(G.stopCount + 0.5, 2.0, 6.0));
    t = clamp(t, 0.0, 1.0);
    vec3 c = gmapUnpack(G.stopCol[0]);
    if (t <= G.stopPos[0]) return c;
    for (int k = 1; k < 6; k++) {
        if (k >= n) break;
        float p0 = G.stopPos[k - 1];
        float p1 = G.stopPos[k];
        vec3 c1 = gmapUnpack(G.stopCol[k]);
        if (t <= p1) {
            vec3 c0 = gmapUnpack(G.stopCol[k - 1]);
            return mix(c0, c1, clamp((t - p0) / max(p1 - p0, 1e-4), 0.0, 1.0));
        }
        c = c1;
    }
    return c;
}

float gmapLumaAt(ivec2 c) {
    return linearToSrgb(luma(srcLin(c)));
}

// Types: 0 Luma, 1 Linear, 2 Corner (top-right -> bottom-left), 3 Radial, 4 Angular, 5 Edge, 6 Split Tone,
//        7 Posterized, 8 Checker, 9 Stripes, 10 Halftone, 11 Noise, 12 Luma + Linear
float gradientMapField(GMapData G, ivec2 coord, vec2 uvN, int width, int height, float lumaG) {
    int type = int(G.type + 0.5);
    float aspect = float(width) / float(max(height, 1));
    vec2 p = uvN - 0.5;
    float cellPx = max(2.0, mix(4.0, 64.0, clamp(G.patternSize, 0.0, 1.0)) * max(gRes, 1.0));
    float t = lumaG;

    if (type == 1 || type == 2 || type == 12) {
        float a = (type == 2) ? 2.3561945 : G.angle;
        vec2 dir = vec2(cos(a), sin(a));
        float lin = dot(p, dir) / max(abs(dir.x) + abs(dir.y), 1e-4) * G.scale + 0.5;
        t = (type == 12) ? (lumaG * 0.5 + clamp(lin, 0.0, 1.0) * 0.5) : lin;
    } else if (type == 3) {
        vec2 dd = uvN - vec2(G.centerX, G.centerY);
        dd.x *= aspect;
        t = length(dd) * G.scale * 1.4;
    } else if (type == 4) {
        vec2 dd = uvN - vec2(G.centerX, G.centerY);
        dd.x *= aspect;
        t = fract(atan(dd.y, dd.x) / 6.2831853 + 0.5 + G.angle / 6.2831853);
    } else if (type == 5) {
        int st = max(1, int(round(mix(1.0, 4.0, clamp(G.edgeWidth, 0.0, 1.0)) * gRes)));
        float gx = gmapLumaAt(coord + ivec2(st, 0)) - gmapLumaAt(coord - ivec2(st, 0));
        float gy = gmapLumaAt(coord + ivec2(0, st)) - gmapLumaAt(coord - ivec2(0, st));
        t = clamp(length(vec2(gx, gy)) * 3.0 * G.scale, 0.0, 1.0);
    } else if (type == 6) {
        float soft = mix(0.03, 0.5, clamp(G.edgeWidth, 0.0, 1.0));
        t = smoothstep(0.5 - soft, 0.5 + soft, lumaG);
    } else if (type == 7) {
        float nb = max(G.bands, 2.0);
        t = floor(clamp(lumaG, 0.0, 0.999) * nb) / (nb - 1.0);
    } else if (type == 8) {
        vec2 cell = floor(vec2(coord) / cellPx);
        float chk = mod(cell.x + cell.y, 2.0);
        t = clamp(lumaG * 0.7 + chk * 0.3, 0.0, 1.0);
    } else if (type == 9) {
        vec2 dir = vec2(cos(G.angle), sin(G.angle));
        float proj = dot(vec2(coord), dir) / cellPx;
        float tri = abs(fract(proj) * 2.0 - 1.0);
        t = clamp(lumaG * 0.7 + tri * 0.3, 0.0, 1.0);
    } else if (type == 10) {
        vec2 f = fract(vec2(coord) / cellPx) - 0.5;
        float d = length(f) * 2.0;
        float dotv = smoothstep(0.12, -0.12, d - sqrt(clamp(lumaG, 0.0, 1.0)) * 1.15);
        t = mix(lumaG, dotv, 0.6);
    } else if (type == 11) {
        vec2 q = vec2(coord) / cellPx;
        vec2 i = floor(q);
        vec2 f = fract(q);
        f = f * f * (3.0 - 2.0 * f);
        float n = mix(mix(hash12(i), hash12(i + vec2(1.0, 0.0)), f.x),
                      mix(hash12(i + vec2(0.0, 1.0)), hash12(i + vec2(1.0, 1.0)), f.x), f.y);
        t = clamp(lumaG * 0.6 + n * 0.4, 0.0, 1.0);
    }

    if (G.invert > 0.5) t = 1.0 - t;
    t = pow(clamp(t, 0.0, 1.0), max(G.curve, 0.05));
    t = clamp((t - G.rangeLo) / max(G.rangeHi - G.rangeLo, 1e-3), 0.0, 1.0);
    return t;
}

vec3 gradientMapApply(vec3 col, GMapData G, ivec2 coord, vec2 uvN, int width, int height) {
    float lumaG = linearToSrgb(luma(col));
    float t = gradientMapField(G, coord, uvN, width, height, lumaG);
    vec3 mapped = srgbToLinear(gmapRamp(G, t));
    float lm = max(luma(mapped), 1e-4);
    vec3 keep = mapped * clamp(luma(col) / lm, 0.0, 4.0);
    mapped = mix(mapped, keep, clamp(G.lumaKeep, 0.0, 1.0));
    return mix(col, mapped, clamp(G.strength, 0.0, 0.65));
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy) + ivec2(0, u_bandY);
    int width = u_passWidth;
    int height = u_passHeight;

    // Dominant-light scan uses shared memory + barrier(), so it must run before the bounds return.
    // Both conditions are dispatch-uniform, so every invocation in the group takes the same path.
    if (u_passIndex == 6 && diffuseLayerActive()) {
        detectDominantLight(width, height);
    }

    if (coord.x >= width || coord.y >= height) return;

    gW = int(round(u_imgWidth)) > 0 ? width : width;
    gH = height;
    gBit = u_bitDepthMode;
    gRes = float(max(width, height)) / 720.0;
    gEdgeStep = max(1, int(round(gRes)));

    if (u_passIndex == 1) {
        executeHighlightExtraction(coord, width, height, int(u_imgWidth), int(u_imgHeight));
        return;
    } else if (u_passIndex == 2 || u_passIndex == 3 || u_passIndex == 7 || u_passIndex == 8) {
        executeBloomDownsample(u_passIndex, coord, width, height, u_passRadius);
        return;
    } else if (u_passIndex == 4 || u_passIndex == 5 || u_passIndex == 9) {
        executeBloomUpsample(u_passIndex, coord, width, height, u_passRadius);
        return;
    } else if (u_passIndex == 6) {
        executeFinalComposite(coord, width, height);
        return;
    }

    // =========================================================================
    // PASS 0: PRIMARY GRADE -> HDR half-float composite
    // =========================================================================
    int pixelIndex = coord.y * width + coord.x;
    vec4 rawPixel = unpackRGBA_Dynamic(pixelIndex, gBit);
    float resScale = gRes;
    int edgeStep = gEdgeStep;
    vec2 uvN = (vec2(coord) + 0.5) / vec2(width, height);

    // ---- STAGE 1: DEBAND (works in gamma space, restores 8-bit source gradients) ----
    vec3 srcS = rawPixel.rgb;
    {
        float dRad = 0.0;
        float dThr = 0.02;
        int totalL = int(clamp(u_layerCount, 1.0, 10.0));
        for (int i = 0; i < totalL; i++) {
            if (layers[i].isEnabled > 0.5 && layers[i].debandRadius > dRad) {
                dRad = layers[i].debandRadius;
                dThr = layers[i].debandThreshold;
            }
        }
        if (dRad > 0.01) {
            float radius = max(1.5, dRad * 7.0 * resScale);
            float thr = max(dThr, 0.004) * 1.6;
            float rot = hash12(vec2(coord) + 3.7) * 6.2831853;
            vec3 sum = srcS;
            vec3 cnt = vec3(1.0);
            for (int k = 0; k < 14; k++) {
                float fr = (float(k) + 0.5) / 14.0;
                float ang = rot + float(k) * 2.39996323;
                float rr = (0.25 + 0.75 * fr) * radius;
                vec3 s = srcSrgb(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr)));
                vec3 m = step(abs(s - srcS), vec3(thr));
                sum += s * m;
                cnt += m;
            }
            vec3 avg = sum / cnt;
            vec3 n = vec3(hash12(vec2(coord) * 1.13 + 11.0), hash12(vec2(coord) * 0.77 + 51.0), hash12(vec2(coord) * 1.71 + 91.0)) - 0.5;
            srcS = clamp(avg + n * (1.0 / 255.0) * clamp(dRad, 0.0, 1.0), 0.0, 1.0);
        }
    }
    vec3 src0 = srgbToLinear(srcS);
    vec3 currentComposite = src0;

    // ---- STAGE 2: LINE THINNING (layer 0 slot, kept as-is) ----
    LayerData L0 = layers[0];
    if (L0.lineThinning > 0.01) {
        vec3 colT = srcLin(coord + ivec2(0,  edgeStep));
        vec3 colB = srcLin(coord + ivec2(0, -edgeStep));
        vec3 colL = srcLin(coord + ivec2(-edgeStep, 0));
        vec3 colR = srcLin(coord + ivec2( edgeStep, 0));
        float lumaC = luma(currentComposite);
        float lumaT = luma(colT); float lumaB = luma(colB);
        float lumaL = luma(colL); float lumaR = luma(colR);
        float edgeGrad = sqrt((lumaR - lumaL) * (lumaR - lumaL) + (lumaT - lumaB) * (lumaT - lumaB));
        if (edgeGrad > L0.lineThinningThreshold) {
            float minLuma = min(min(lumaT, lumaB), min(lumaL, lumaR));
            if (minLuma < lumaC) {
                vec3 darkest = colT;
                if (lumaB == minLuma) darkest = colB;
                if (lumaL == minLuma) darkest = colL;
                if (lumaR == minLuma) darkest = colR;
                currentComposite = mix(currentComposite, darkest, clamp(L0.lineThinning * 0.65, 0.0, 1.0));
            }
        }
    }

    // ---- Sobel gradient (source) for edge normal / line masks ----
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float lum = luma(srcLin(coord + ivec2(x * edgeStep, y * edgeStep)));
            gx += lum * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lum * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);
    vec2 edgeNormal = (lineEdge > 0.05) ? normalize(vec2(gx, gy)) : vec2(0.0);

    // ---- STAGE 3: MULTI-LAYER STACK ----
    int totalLayers = int(clamp(u_layerCount, 1.0, 10.0));

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;

        vec3 layerColor = currentComposite;

        // 1. Depth of field (tilt band or radial), disc blur with bokeh highlight emphasis
        if (L.depthOfField > 0.01) {
            float dist;
            if (L.dofMode > 0.5) {
                vec2 dd = uvN - vec2(0.5, L.dofFocus);
                dd.x *= float(width) / float(height);
                dist = length(dd);
            } else {
                dist = abs(uvN.y - L.dofFocus);
            }
            float rng = clamp(L.dofRange, 0.0, 1.0) * 0.5;
            float fall = max(0.02, L.dofFalloff * 0.6);
            float coc = smoothstep(rng, rng + fall, dist);
            float r = coc * L.depthOfField * 22.0 * resScale;
            if (r > 0.6) {
                vec3 acc = vec3(0.0);
                float wsum = 0.0;
                const int DOF_TAPS = 28;
                for (int k = 0; k < DOF_TAPS; k++) {
                    float fr = (float(k) + 0.5) / float(DOF_TAPS);
                    float rr = sqrt(fr) * r;
                    float th = float(k) * 2.39996323 + L.dofAngle;
                    vec3 s = srcLin(coord + ivec2(round(vec2(cos(th), sin(th)) * rr)));
                    float lw = 1.0 + L.dofBokeh * 6.0 * smoothstep(0.55, 1.2, luma(s));
                    acc += s * lw;
                    wsum += lw;
                }
                layerColor += (acc / wsum - src0) * smoothstep(0.0, 0.15, coc);
            }
        }

        // 2. Edge chromatic aberration (delta)
        if (L.lineChromaStrength > 0.001 && lineEdge > 0.05) {
            float edgeFactor = smoothstep(0.08, 0.35, lineEdge);
            ivec2 sh = ivec2(round(edgeNormal * (L.lineChromaStrength * 3.0 * resScale)));
            vec3 sr = srcLin(coord + sh);
            vec3 sb = srcLin(coord - sh);
            layerColor.r += (sr.r - src0.r) * edgeFactor * 0.80;
            layerColor.b += (sb.b - src0.b) * edgeFactor * 0.80;
        }

        // 3. RGB directional warp shift (delta)
        if (L.copiedChromaShift > 0.001) {
            ivec2 cs = ivec2(int(round(L.copiedChromaShift * 6.0 * resScale)), 0);
            vec3 sr = srcLin(coord + cs);
            vec3 sb = srcLin(coord - cs);
            layerColor.r += sr.r - src0.r;
            layerColor.b += sb.b - src0.b;
        }

        // 3b. RADIAL chromatic aberration (lens style): red is pushed outward and blue pulled inward along the
        //     line from the frame centre, growing with distance (zero at the centre, strongest in the corners).
        if (L.radialChroma > 0.001) {
            vec2 sz = vec2(float(width), float(height));
            vec2 rc = (vec2(coord) + 0.5) - sz * 0.5;
            vec2 rdir = rc / max(0.5 * length(sz), 1.0);             // ~1 in the corners
            float rlen = length(rdir);
            vec2 shiftPx = rdir * rlen * (L.radialChroma * 14.0 * resScale);
            vec3 srR = srcLinBilinear(vec2(coord) + 0.5 + shiftPx);
            vec3 srB = srcLinBilinear(vec2(coord) + 0.5 - shiftPx);
            layerColor.r += srR.r - src0.r;
            layerColor.b += srB.b - src0.b;
        }

        // 4. Denoise: edge-aware bilateral, chroma cleaned harder than luma
        if (L.denoise > 0.01) {
            float dn = clamp(L.denoise, 0.0, 1.0);
            int dRad = clamp(int(round(1.0 + dn * 2.6 * resScale * 0.8)), 1, 4);
            float sigS = max(1.2, float(dRad) * 0.7);
            float sigR = mix(0.035, 0.18, dn);
            vec3 pc = sqrt(src0);
            vec3 acc = src0;
            float wsum = 1.0;
            for (int dy = -dRad; dy <= dRad; dy++) {
                for (int dx = -dRad; dx <= dRad; dx++) {
                    if (dx == 0 && dy == 0) continue;
                    vec3 s = srcLin(coord + ivec2(dx, dy));
                    vec3 ps = sqrt(s);
                    float sd = float(dx * dx + dy * dy);
                    vec3 dc = pc - ps;
                    float rd = dot(dc, dc);
                    float w = exp(-sd / (2.0 * sigS * sigS)) * exp(-rd / (2.0 * sigR * sigR));
                    acc += s * w;
                    wsum += w;
                }
            }
            vec3 avg = acc / wsum;
            float lC = luma(src0);
            float lA = luma(avg);
            vec3 target = vec3(mix(lC, lA, clamp(dn * 0.85, 0.0, 1.0))) + mix(src0 - vec3(lC), avg - vec3(lA), clamp(dn * 1.15, 0.0, 1.0));
            layerColor += (max(target, vec3(0.0)) - src0) * (1.0 - lineEdge * 0.25);
        }

        // 5. Anime skin smoothing: Oklab skin-tone mask + ink-line shielding.
        //    v2.5: the old version protected every colour step (cel-shadow edges) as if it were ink and used a tiny
        //    kernel, so on flat cel skin it changed nothing. Now: a 40-tap bilateral whose taps must THEMSELVES be skin
        //    (hair / eyes / clothes / ink can never bleed in, so the reach can be much wider), only real ink lines
        //    are shielded, and the slider curve is front-loaded so low values are visible.
        if (L.bilateralIntensity > 0.01) {
            vec3 lab0 = linearRgbToOklab(src0);
            float chroma0 = length(lab0.yz);
            float hue0 = atan(lab0.z, lab0.y);
            float skin = smoothstep(0.30, 0.55, hue0) * (1.0 - smoothstep(1.20, 1.50, hue0))
                       * smoothstep(0.010, 0.035, chroma0) * (1.0 - smoothstep(0.13, 0.19, chroma0))
                       * smoothstep(0.30, 0.50, lab0.x);
            // ink shielding: dark-line proximity (centre and 4 neighbours) + only STRONG luminance edges
            float inkMax = 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord)));
            int inkR = max(2, edgeStep * 2);
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord + ivec2(inkR, 0)))));
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord - ivec2(inkR, 0)))));
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord + ivec2(0, inkR)))));
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord - ivec2(0, inkR)))));
            // Colour steps (cel-shadow edges) are exactly what this should soften, so only real ink protects.
            float prot = 1.0 - inkMax;
            if (skin > 0.01 && prot > 0.01) {
                float rad = clamp((1.0 + L.bilateralRadius * 2.2) * resScale, 1.5, 14.0);
                float sigS = max(1.0, rad * 0.55);
                // Range: how big a tonal step still counts as "the same surface" (small = keep shading edges).
                float sigR = 0.05 + clamp(L.bilateralRange, 0.0, 1.0) * 0.55;
                vec3 pc = sqrt(src0);
                vec3 acc = src0;
                float wsum = 1.0;
                const int SK_TAPS = 40;
                for (int k = 0; k < SK_TAPS; k++) {
                    float fr = (float(k) + 0.5) / float(SK_TAPS);
                    float rr = rad * sqrt(fr);                       // uniform disc density
                    float ang = float(k) * 2.39996323;
                    vec2 off = vec2(cos(ang), sin(ang)) * rr;
                    vec3 s = srcLin(coord + ivec2(round(off)));
                    vec3 dc = pc - sqrt(s);
                    float inkTap = smoothstep(0.012, 0.060, luma(s));          // near-black ink never contributes
                    float skinTap = smoothstep(0.25, 0.75, skinMaskOf(s));     // only skin blends into skin
                    float w = exp(-(rr * rr) / (2.0 * sigS * sigS)) * exp(-dot(dc, dc) / (2.0 * sigR * sigR)) * inkTap * skinTap;
                    acc += s * w;
                    wsum += w;
                }
                vec3 smoothC = acc / wsum;
                float amt = 1.0 - pow(1.0 - clamp(L.bilateralIntensity, 0.0, 1.0), 2.2);   // 0.1 -> 0.21, 0.5 -> 0.78
                layerColor += (smoothC - src0) * amt * skin * prot;
                layerColor *= 1.0 + skin * prot * amt * 0.03;
            }
        }

        // 6. Frequency unsharp mask (delta on source detail)
        if (L.unsharpAmount > 0.01) {
            int uRad = int(clamp(L.unsharpRadius * resScale, 1.0, 6.0));
            vec3 lowPass = vec3(0.0);
            float uW = 0.0;
            for (int uy = -uRad; uy <= uRad; uy += 2) {
                for (int ux = -uRad; ux <= uRad; ux += 2) {
                    lowPass += srcLin(coord + ivec2(ux, uy));
                    uW += 1.0;
                }
            }
            lowPass /= max(uW, 1.0);
            vec3 highPass = src0 - lowPass;
            float diffLum = abs(luma(highPass));
            if (diffLum >= L.unsharpThreshold) {
                float boost = smoothstep(L.unsharpThreshold, L.unsharpThreshold + 0.10, diffLum);
                layerColor += highPass * (L.unsharpAmount * boost * 1.3);
            }
        }

        // 7. Acutance sharpness (delta)
        if (L.sharpness > 0.01) {
            vec3 blur = srcLin(coord + ivec2(0, -edgeStep)) + srcLin(coord + ivec2(0, edgeStep))
                      + srcLin(coord + ivec2(-edgeStep, 0)) + srcLin(coord + ivec2(edgeStep, 0));
            blur *= 0.25;
            layerColor += (src0 - blur) * (L.sharpness * 1.5);
        }

        // 8. S_lining: line-art detection -> tiny inner grey-black blur on the edges
        //    slider 1 (darkOutlines) = intensity + radius, slider 2 (sLiningOpacity) = opacity
        if (L.darkOutlines > 0.01 && L.sLiningOpacity > 0.01) {
            float radius = (1.6 + L.darkOutlines * 5.0) * resScale;
            float sigma = radius * 0.55;
            float cLuma = dot(srcSrgb(coord), vec3(0.2126, 0.7152, 0.0722));
            float centerLine = 1.0 - smoothstep(0.06, 0.30, cLuma);
            float acc = 0.0;
            float wacc = 0.0;
            const int SL_TAPS = 22;
            for (int k = 0; k < SL_TAPS; k++) {
                float fr = (float(k) + 0.5) / float(SL_TAPS);
                float rr = sqrt(fr) * radius;
                float ang = float(k) * 2.39996323;
                float sl = dot(srcSrgb(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr))), vec3(0.2126, 0.7152, 0.0722));
                float lineness = 1.0 - smoothstep(0.06, 0.30, sl);
                float w = exp(-(rr * rr) / (2.0 * sigma * sigma));
                acc += lineness * w;
                wacc += w;
            }
            float halo = acc / max(wacc, 1e-4);
            float mask = (1.0 - exp(-halo * 4.2)) * (1.0 - centerLine);   // soft, saturating falloff
            vec3 inner = mix(layerColor * 0.12, vec3(0.020), 0.45);        // soft dark, not on the line itself
            float amt = mask * (0.85 + 0.65 * L.darkOutlines) * L.sLiningOpacity * 1.25;
            layerColor = mix(layerColor, inner, clamp(amt, 0.0, 1.0));
        }
        // 7b. CLARITY / LOCAL CONTRAST: large-radius, midtone-weighted local contrast. Works on perceptual
        //     luma and scales colour multiplicatively, so hue is kept and highlights / shadows don't halo.
        if (abs(L.clarity) > 0.001) {
            float cR = (5.0 + L.clarityRadius * 20.0) * resScale;
            float cSig = cR * 0.55;
            float lowAcc = 0.0;
            float lowW = 0.0;
            const int CL_TAPS = 24;
            for (int k = 0; k < CL_TAPS; k++) {
                float fr = (float(k) + 0.5) / float(CL_TAPS);
                float rr = sqrt(fr) * cR;
                float ang = float(k) * 2.39996323;
                float sl = sqrt(max(luma(srcLin(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr)))), 0.0));
                float w = exp(-(rr * rr) / (2.0 * cSig * cSig));
                lowAcc += sl * w;
                lowW += w;
            }
            float lc = sqrt(max(luma(src0), 0.0));
            float dl = clamp(lc - (lowAcc + lc) / (lowW + 1.0), -0.22, 0.22);   // detail vs local average
            float mid = clamp(4.0 * lc * (1.0 - lc), 0.0, 1.0);
            mid = 0.25 + 0.75 * mid;
            layerColor *= exp2(dl * L.clarity * 3.0 * mid);
        }

        // 8b. COLOURED LINE ART: only thin ink lines are recoloured (never solid black areas). The colour is a
        //     darker, richer version of the fill the line borders, so the line belongs to the picture.
        //     Placement: 0 = every thin line, 0.5 = only lines next to lit areas, 1 = only skin contours.
        if (L.lineArtStrength > 0.01) {
            float cL = luma(srcSrgb(coord));
            float inkSelf = 1.0 - smoothstep(0.10, 0.34, cL);
            if (inkSelf > 0.02) {
                float laR = (1.5 + L.lineArtWidth * 4.5) * resScale;
                float inkMass = 0.0;
                vec3 fillAcc = vec3(0.0);
                float fillW = 0.0;
                const int LA_TAPS = 16;
                for (int k = 0; k < LA_TAPS; k++) {
                    float fr = (float(k) + 0.5) / float(LA_TAPS);
                    float rr = (0.35 + 0.65 * fr) * laR;
                    float ang = float(k) * 2.39996323;
                    vec3 sSrgb = srcSrgb(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr)));
                    float ink = 1.0 - smoothstep(0.10, 0.34, luma(sSrgb));
                    inkMass += ink;
                    float wf = 1.0 - ink;
                    fillAcc += srgbToLinear(sSrgb) * wf;
                    fillW += wf;
                }
                inkMass /= float(LA_TAPS);
                float thinLine = inkSelf * (1.0 - smoothstep(0.35, 0.70, inkMass));
                if (fillW > 0.5 && thinLine > 0.01) {
                    vec3 fillCol = fillAcc / fillW;
                    float lit = smoothstep(0.08, 0.40, luma(fillCol));
                    float skinF = skinMaskOf(fillCol);
                    float pl = clamp(L.lineArtPlacement, 0.0, 1.0);
                    float place = mix(1.0, lit, clamp(pl * 2.0, 0.0, 1.0));
                    place = mix(place, skinF, clamp(pl * 2.0 - 1.0, 0.0, 1.0));
                    vec3 lineCol = saturateColor(fillCol, 1.0 + L.lineArtSaturation * 1.2) * 0.42;
                    layerColor = mix(layerColor, lineCol, clamp(thinLine * place * L.lineArtStrength * 0.9, 0.0, 1.0));
                }
            }
        }

        // 8c. SKIN EDGE BLEED (v2.6): the inner rim of the skin picks up depth. The old version only nudged the
        //     saturation of a 16-tap neighbourhood at constant brightness, which on flat cel skin changed nothing.
        //     Now rays look for the nearest non-skin pixel (ink, hair, clothes, background); inside that reach the skin
        //     is pulled toward a deeper, warmer, slightly darker tone, mixed with the colour of whatever it borders,
        //     fading smoothly inward. Depth = strength, Width = how far the rim reaches.
        if (L.skinEdgeBleed > 0.01) {
            float skinC = skinMaskOf(src0);
            float inkC = 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord)));
            if (skinC > 0.05 && inkC < 0.7) {
                float reach = (3.0 + L.skinEdgeWidth * 18.0) * resScale;
                vec3 outAcc = vec3(0.0);
                float outW = 0.0;
                vec3 inAcc = src0 * skinC;
                float inW = skinC;
                float prox = 0.0;
                for (int rI = 0; rI < 6; rI++) {
                    float ang = (float(rI) + 0.5) * 1.04719755;                 // 60 degree spacing
                    vec2 dir = vec2(cos(ang), sin(ang));
                    for (int sI = 1; sI <= 4; sI++) {
                        float fr = float(sI) * 0.25;
                        vec3 s = srcLin(coord + ivec2(round(dir * (reach * fr))));
                        float sk = skinMaskOf(s);
                        float notSkin = 1.0 - smoothstep(0.25, 0.75, sk);
                        float wd = 1.0 - 0.85 * (fr - 0.25);                      // 1.0 near .. 0.36 far
                        prox = max(prox, notSkin * wd);
                        float ink = 1.0 - smoothstep(0.006, 0.06, luma(s));
                        float isOut = notSkin * (1.0 - ink) * wd;
                        outAcc += s * isOut;
                        outW += isOut;
                        inAcc += s * sk;
                        inW += sk;
                    }
                }
                float band = smoothstep(0.0, 0.85, prox);
                vec3 insideCol = inAcc / max(inW, 1e-4);
                vec3 outsideCol = (outW > 0.2) ? outAcc / outW : insideCol;
                vec3 deep = saturateColor(insideCol, 1.80) * vec3(1.00, 0.80, 0.74) * 0.86;   // deeper, warmer, a little darker
                vec3 bleed = mix(deep, outsideCol, 0.30);
                bleed *= (0.90 * luma(layerColor)) / max(luma(bleed), 1e-4);
                layerColor = mix(layerColor, bleed, clamp(skinC * band * (1.0 - inkC) * L.skinEdgeBleed * 0.90, 0.0, 0.95));
            }
        }

        // 8d. EDGE DARKEN (v2.5)
        //     (1) line art: the ink core and its anti-aliased edge get a slight darkening (edgeDarken).
        //     (2) inner spread: the FILL beside every line gets a soft blur that reaches inward from the line
        //         (edgeDarkenBlur = strength and reach). It is a blur of the source around the pixel, so the dark of the
        //         line bleeds a little way into the fill and any shading detail next to the line is softened;
        //         the line itself stays crisp, and a gentle extra darkening fades inward with the same reach.
        //         Applied as a DELTA so earlier grades survive.
        if (L.edgeDarken > 0.01 || L.edgeDarkenBlur > 0.01) {
            float ed = clamp(L.edgeDarken, 0.0, 1.0);
            float eb = clamp(L.edgeDarkenBlur, 0.0, 1.0);
            float selfInk = 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord)));
            float innerEdge = smoothstep(0.10, 0.45, lineEdge);

            // (1) line core + AA edge
            layerColor *= 1.0 - max(innerEdge, selfInk * 0.8) * ed * 0.40;

            // (2) inner spread. 12 rays x 5 steps looking for ink; reach grows with the slider.
            if (selfInk < 0.85 && (eb > 0.01 || ed > 0.30)) {
                float reach = (2.5 + 11.0 * max(eb, 0.25 * ed)) * resScale;
                vec3 accAll = src0;
                float wAll = 1.0;
                vec3 accFill = src0;
                float wFill = 1.0;
                float prox = 0.0;                                   // 0 = no ink in reach, 1 = ink right next to us
                for (int rI = 0; rI < 12; rI++) {
                    float ang = (float(rI) + 0.5) * 0.52359878;      // 30 degree spacing, offset so axes are not special
                    vec2 dir = vec2(cos(ang), sin(ang));
                    for (int sI = 0; sI < 5; sI++) {
                        float fr = float(sI + 1) / 5.0;
                        vec3 sS = srcSrgb(coord + ivec2(round(dir * (reach * fr))));
                        vec3 sL = srgbToLinear(sS);
                        float ink = 1.0 - smoothstep(0.08, 0.28, luma(sS));
                        float wd = 1.0 - 0.55 * fr;                  // nearer taps count more
                        accAll += sL * wd;
                        wAll += wd;
                        accFill += sL * wd * (1.0 - ink);
                        wFill += wd * (1.0 - ink);
                        prox = max(prox, ink * (1.0 - 0.8 * (fr - 0.2)));   // max, not mean: a thin line still counts fully
                    }
                }
                vec3 blurAll = accAll / wAll;
                vec3 blurFill = accFill / wFill;
                vec3 soft = mix(blurFill, blurAll, 0.60);            // 40% pure fill softening, 60% line darkness bleeding in
                float band = smoothstep(0.0, 0.55, prox) * (1.0 - selfInk) * (1.0 - innerEdge * 0.35);
                layerColor += (soft - src0) * band * eb * 0.90;
                layerColor *= 1.0 - band * band * ed * 0.18;         // gentle inward darkening that fades with distance
            }
        }

        // 9. Colour temperature
        if (L.temperature > 1000.0 && abs(L.temperature - 6500.0) > 30.0) {
            layerColor *= colorTempToRGB(L.temperature) / colorTempToRGB(6500.0);
        }

        // 9b. EXPOSURE: a true photographic exposure, i.e. multiply scene-linear light by 2^EV.
        //     (Slider -0.8..0.8 = -1.6..+1.6 stops.) Scales everything together, so black stays black,
        //     highlights go up the most and mids follow - unlike gamma, which only bends the mids.
        //     The old version added a constant to Oklab L, which lifted blacks like a gamma/lift.
        if (abs(L.brightness) > 0.001) layerColor *= exp2(L.brightness * 2.0);

        // ---- OKLAB perceptual grading ----
        vec3 lab = linearRgbToOklab(layerColor);

        // 10. Contrast, shadows / highlights, gamma
        if (abs(L.contrast - 1.0) > 0.001) lab.x = (lab.x - 0.50) * L.contrast + 0.50;
        lab.x = max(lab.x, 0.0);

        if (L.blackCrush > 0.01) lab.x = smoothstep(L.blackCrush * 0.08, 1.0, lab.x);

        lab.x += lab.x * (L.shadows * (1.0 - smoothstep(0.0, 0.45, lab.x)) * 0.30);
        lab.x += lab.x * (L.highlights * smoothstep(0.55, 1.0, lab.x) * 0.30);
        if (abs(L.gamma - 1.0) > 0.001) lab.x = pow(max(lab.x, 0.0), 1.0 / max(L.gamma, 0.001));

        // 11. Mojo teal & orange
        if (L.mblMojoTealOrange > 0.01) {
            float shadowMask = clamp(1.0 - lab.x * 1.8, 0.0, 1.0);
            float warmMask = clamp((lab.x - 0.35) * 1.5, 0.0, 1.0);
            lab.z -= shadowMask * L.mblMojoTealOrange * 0.045;
            lab.y -= shadowMask * L.mblMojoTealOrange * 0.015;
            lab.y += warmMask * L.mblMojoTealOrange * 0.025;
            lab.z += warmMask * L.mblMojoTealOrange * 0.035;
        }

        // 12. Deep teal with skin shielding
        if (L.deepTeal > 0.01) {
            float deepShadowMask = clamp(1.0 - lab.x * 1.8, 0.0, 1.0);
            bool isSkin = (lab.y > 0.015 && lab.z > 0.015);
            float shield = isSkin ? 0.15 : 1.0;
            lab.z -= deepShadowMask * L.deepTeal * 0.055 * shield;
            lab.y -= deepShadowMask * L.deepTeal * 0.025 * shield;
        }

        // 13. Colorista 3-way
        if (abs(L.mblColoristaLift) > 0.001 || abs(L.mblColoristaGamma) > 0.001 || abs(L.mblColoristaGain) > 0.001) {
            lab.x += L.mblColoristaLift * (1.0 - lab.x) * 0.35;
            lab.x = pow(max(0.0, lab.x), 1.0 / max(1.0 + L.mblColoristaGamma * 0.40, 0.01));
            lab.x += L.mblColoristaGain * lab.x * 0.35;
        }

        // 14. Cosmo skin protection
        if (L.cosmoCleanHighlight > 0.01) {
            float faceMask = smoothstep(0.50, 0.85, lab.x) * (1.0 - lineEdge);
            lab.yz = mix(lab.yz, lab.yz * 0.85, faceMask * L.cosmoCleanHighlight * 0.40);
        }

        // 15. Master curve on lightness (C1 monotone cubic, float precision -> no banding)
        if (!curveIsIdentity(L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4)) {
            // The curve only sees 0..1; anything brighter (after exposure) is carried over unchanged.
            // Chroma follows the lightness change (partially) so lifted shadows don't turn neon and
            // crushed ones don't keep full colour - this is what made curves "go out of colour".
            float L0 = lab.x;
            float Ln = evalCurve5(clamp(L0, 0.0, 1.0), L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4) + max(L0 - 1.0, 0.0);
            float ratio = clamp(Ln / max(L0, 0.04), 0.30, 2.50);
            lab.yz *= pow(ratio, 0.60);
            lab.x = Ln;
        }
        if (L.magicCurves > 0.01) {
            float lx = clamp(lab.x, 0.0, 1.0);
            float s = lx * lx * (3.0 - 2.0 * lx);
            lab.x = mix(lab.x, s, L.magicCurves * 0.50);
        }

        // 16. Saturation & hue rotation
        // Saturation slider = saturation below 1.0, VIBRANCE above 1.0 (continuous at 1.0).
        //  0..1  : plain Oklab chroma scale (0 = fully grey)
        //  1..2.5: dull colours get the boost, already-vivid colours barely move, skin tones are
        //          protected, so pushing it up no longer turns skin/eyes neon or clips them.
        if (L.saturation <= 1.0) {
            lab.yz *= max(L.saturation, 0.0);
        } else {
            float boost = L.saturation - 1.0;
            float cch = length(lab.yz);
            float lowChroma = 1.0 - smoothstep(0.05, 0.28, cch);          // 1 = dull, 0 = already vivid
            float wv = mix(0.12, 1.0, lowChroma);                          // vivid colours still move a little
            float vh = atan(lab.z, lab.y);
            float skinV = smoothstep(0.30, 0.55, vh) * (1.0 - smoothstep(1.20, 1.50, vh))
                        * smoothstep(0.015, 0.040, cch) * (1.0 - smoothstep(0.13, 0.19, cch))
                        * smoothstep(0.42, 0.62, lab.x);
            wv *= 1.0 - 0.65 * skinV;
            lab.yz *= 1.0 + boost * wv;
        }
        if (abs(L.hue) > 0.001) lab.yz = oklabRotateHue(lab.yz, L.hue * 3.14159265);

        // 16a. CHROMA CONTRAST: S-curve on Oklab chroma around mid-chroma. + pulls dull colours down and
        //      vivid ones up (more separation), - flattens everything toward the middle. Monotone for -1..1.
        if (abs(L.chromaContrast) > 0.001) {
            float cc0 = length(lab.yz);
            if (cc0 > 1e-5) {
                float cn = clamp(cc0 / 0.30, 0.0, 1.0);
                float cs = cn * cn * (3.0 - 2.0 * cn);
                float cn2 = mix(cn, cs, clamp(L.chromaContrast, -1.0, 1.0));
                lab.yz *= max(cc0 + (cn2 - cn) * 0.30, 0.0) / cc0;
            }
        }

        // 16b. HUE vs SATURATION / HUE / LUMINANCE: 8 periodic hue bands (partition-of-unity blend, so
        //      neighbouring bands never leave gaps or steps) + one custom hue-range qualifier. Works on the
        //      same Oklab hue axis the Hue slider rotates. Greys are ignored (they have no hue).
        {
            bool hsOn = false;
            for (int hb = 0; hb < 8; hb++) {
                if (abs(L.hsSat[hb]) > 0.002 || abs(L.hsHue[hb]) > 0.002 || abs(L.hsLum[hb]) > 0.002) hsOn = true;
            }
            bool cuOn = abs(L.hsCustomSat) > 0.002 || abs(L.hsCustomHue) > 0.002 || abs(L.hsCustomLum) > 0.002;
            float chroma16 = length(lab.yz);
            if ((hsOn || cuOn) && chroma16 > 1e-4) {
                const float HS_C[8] = float[8](29.0, 65.0, 110.0, 142.0, 195.0, 264.0, 305.0, 340.0);
                float hDeg = degrees(atan(lab.z, lab.y));
                if (hDeg < 0.0) hDeg += 360.0;
                float dSat = 0.0;
                float dHue = 0.0;
                float dLum = 0.0;
                if (hsOn) {
                    int i0 = 7;
                    for (int hb = 0; hb < 8; hb++) { if (hDeg >= HS_C[hb]) i0 = hb; }
                    int i1 = (i0 + 1) & 7;
                    float span = HS_C[i1] - HS_C[i0];
                    if (span <= 0.0) span += 360.0;
                    float dh = hDeg - HS_C[i0];
                    if (dh < 0.0) dh += 360.0;
                    float tb = clamp(dh / span, 0.0, 1.0);
                    float hsEdge = (1.0 - clamp(L.hsSoftness, 0.0, 1.0)) * 0.45;
                    tb = smoothstep(hsEdge, 1.0 - hsEdge, tb);
                    dSat = mix(L.hsSat[i0], L.hsSat[i1], tb);
                    dHue = mix(L.hsHue[i0], L.hsHue[i1], tb);
                    dLum = mix(L.hsLum[i0], L.hsLum[i1], tb);
                }
                if (cuOn) {
                    float hc = fract(L.hsCustomCenter) * 360.0;
                    float dist = abs(hDeg - hc);
                    dist = min(dist, 360.0 - dist);
                    float halfW = clamp(L.hsCustomWidth, 0.0, 1.0) * 90.0;
                    float feather = max(clamp(L.hsCustomSoft, 0.0, 1.0) * 90.0, 2.0);
                    float wq = 1.0 - smoothstep(halfW, halfW + feather, dist);
                    dSat += wq * L.hsCustomSat;
                    dHue += wq * L.hsCustomHue;
                    dLum += wq * L.hsCustomLum;
                }
                dSat = clamp(dSat, -1.0, 1.0);
                dHue = clamp(dHue, -1.0, 1.0);
                dLum = clamp(dLum, -1.0, 1.0);
                float hueGate = smoothstep(0.003, 0.035, chroma16);
                float lumGate = smoothstep(0.010, 0.070, chroma16);
                float hAng = dHue * 0.90 * hueGate;
                float hCa = cos(hAng);
                float hSa = sin(hAng);
                lab.yz = vec2(lab.y * hCa - lab.z * hSa, lab.y * hSa + lab.z * hCa);
                lab.yz *= (dSat >= 0.0) ? (1.0 + dSat * 1.5) : (1.0 + dSat);
                lab.x *= 1.0 + dLum * 0.30 * lumGate;
            }
        }

        layerColor = oklabToLinearRgb(lab);

        // 17. Per-channel RGB curves, applied in gamma space (as AE does), no cross-channel tint
        {
            bool redOn = !curveIsIdentity(L.curveR0, L.curveR1, L.curveR2, L.curveR3, L.curveR4);
            bool grnOn = !curveIsIdentity(L.curveG0, L.curveG1, L.curveG2, L.curveG3, L.curveG4);
            bool bluOn = !curveIsIdentity(L.curveB0, L.curveB1, L.curveB2, L.curveB3, L.curveB4);
            if (redOn || grnOn || bluOn) {
                vec3 over = max(layerColor - 1.0, vec3(0.0));
                vec3 e = pow(clamp(layerColor, 0.0, 1.0), vec3(1.0 / 2.2));
                if (redOn) e.r = evalCurve5(e.r, L.curveR0, L.curveR1, L.curveR2, L.curveR3, L.curveR4);
                if (grnOn) e.g = evalCurve5(e.g, L.curveG0, L.curveG1, L.curveG2, L.curveG3, L.curveG4);
                if (bluOn) e.b = evalCurve5(e.b, L.curveB0, L.curveB1, L.curveB2, L.curveB3, L.curveB4);
                layerColor = pow(e, vec3(2.2)) + over;
            }
        }

        // 17b. COLORISTA: Lift / Gamma / Gain / Offset colour wheels (+ the luma sliders already applied in
        //      step 13), range saturation, contrast + pivot, temperature / tint, preserve-luma, mix.
        //      Works per channel in gamma space like the RGB curves (AE / Magic Bullet behaviour).
        {
            vec2 wLift = vec2(L.cLiftX, L.cLiftY);
            vec2 wGamma = vec2(L.cGammaX, L.cGammaY);
            vec2 wGain = vec2(L.cGainX, L.cGainY);
            vec2 wOff = vec2(L.cOffX, L.cOffY);
            bool wheelsOn = (dot(wLift, wLift) + dot(wGamma, wGamma) + dot(wGain, wGain) + dot(wOff, wOff)) > 1e-6
                         || abs(L.cOffLuma) > 0.001;
            bool toneOn = abs(L.cSat - 1.0) > 0.002 || abs(L.cSatShadows) > 0.002 || abs(L.cSatMids) > 0.002 || abs(L.cSatHighs) > 0.002;
            bool conOn = abs(L.cContrast) > 0.002;
            bool ttOn = abs(L.cTemp) > 0.002 || abs(L.cTint) > 0.002;
            if (wheelsOn || toneOn || conOn || ttOn) {
                vec3 over = max(layerColor - 1.0, vec3(0.0));
                vec3 e0 = pow(clamp(layerColor, 0.0, 1.0), vec3(1.0 / 2.2));
                vec3 e = e0;
                float y0 = luma(e0);
                if (wheelsOn) {
                    e += wheelTint(wOff) * 0.20 + vec3(L.cOffLuma * 0.25);          // Offset: moves everything
                    e += wheelTint(wLift) * 0.30 * (1.0 - e);                       // Lift: weighs shadows most
                    e *= vec3(1.0) + wheelTint(wGain) * 0.60;                       // Gain: weighs highlights most
                    e = pow(max(e, vec3(0.0)), clamp(vec3(1.0) - wheelTint(wGamma) * 0.55, vec3(0.30), vec3(3.0)));   // Gamma: mids
                }
                if (ttOn) {
                    e.r *= 1.0 + 0.12 * L.cTemp;
                    e.b *= 1.0 - 0.12 * L.cTemp;
                    e.g *= 1.0 - 0.10 * L.cTint;
                    e.r *= 1.0 + 0.05 * L.cTint;
                    e.b *= 1.0 + 0.05 * L.cTint;
                }
                if (conOn) {
                    float piv = clamp(L.cPivot, 0.05, 0.95);
                    e = (e - vec3(piv)) * max(1.0 + L.cContrast, 0.0) + vec3(piv);
                }
                if (L.cPreserveLuma > 0.001) {
                    float y1 = luma(max(e, vec3(0.0)));
                    e *= mix(1.0, clamp(y0 / max(y1, 1e-4), 0.25, 4.0), clamp(L.cPreserveLuma, 0.0, 1.0));
                }
                if (toneOn) {
                    float yy = luma(max(e, vec3(0.0)));
                    float sR = max(L.cShadowRange, 0.05);
                    float hR = min(L.cHighRange, 0.95);
                    float shM = 1.0 - smoothstep(0.0, sR, yy);
                    float hiM = smoothstep(hR, 1.0, yy);
                    float miM = clamp(1.0 - shM - hiM, 0.0, 1.0);
                    float sat = L.cSat + shM * L.cSatShadows + miM * L.cSatMids + hiM * L.cSatHighs;
                    e = vec3(yy) + (e - vec3(yy)) * max(sat, 0.0);
                }
                e = mix(e0, e, clamp(L.cMix, 0.0, 1.0));
                layerColor = pow(max(e, vec3(0.0)), vec3(2.2)) + over;
            }
        }

        // 18. Split toning (per layer)
        if (L.splitToneShadowSat > 0.01 || L.splitToneHighSat > 0.01) {
            vec3 sTint = srgbToLinear(hueToRGB(L.splitToneShadowHue));
            vec3 hTint = srgbToLinear(hueToRGB(L.splitToneHighHue));
            float cl = luma(layerColor);
            float pivot = clamp(0.5 + L.splitToneBalance * 0.35, 0.1, 0.9);
            layerColor = mix(layerColor, layerColor * (sTint * 1.6 + vec3(0.1)), smoothstep(pivot, 0.0, cl) * L.splitToneShadowSat * 0.65);
            layerColor = mix(layerColor, layerColor * (hTint * 1.5 + vec3(0.1)), smoothstep(pivot, 1.0, cl) * L.splitToneHighSat * 0.65);
        }

        // 19. 4-point star glint
        float curLuma = luma(layerColor);
        if (L.copiedStarGlint > 0.01 && curLuma > 0.72) {
            float glint = 0.0;
            int gSpan = int(clamp(L.copiedStarGlint * 16.0 * resScale, 4.0, 24.0));
            for (int d = -gSpan; d <= gSpan; d += 2) {
                float decay = 1.0 - (abs(float(d)) / float(gSpan));
                glint += dot(srcLin(coord + ivec2(d, d)), vec3(0.333)) * decay;
                glint += dot(srcLin(coord + ivec2(d, -d)), vec3(0.333)) * decay;
            }
            glint = (glint / float(gSpan * 2)) * L.copiedStarGlint * 0.60;
            layerColor += vec3(glint);
        }

        // 20. Volumetric god rays
        if (L.bslaGodRays > 0.01) {
            vec2 sunPos = vec2(float(width) * 0.50, float(height) * 0.06);
            vec2 rayDir = normalize(vec2(coord) - sunPos + vec2(0.0001));
            vec3 rayAccum = vec3(0.0);
            float rayWeight = 0.0;
            float stepSize = float(max(width, height)) / 36.0;
            float jitter = hash12(vec2(coord) + vec2(u_time));
            for (int s = 1; s <= 20; s++) {
                float dist = (float(s) + jitter) * stepSize * 0.38;
                vec3 scCol = srcLin(ivec2(vec2(coord) - rayDir * dist));
                float shaftMask = smoothstep(0.50, 0.92, luma(scCol));
                float decay = exp(-0.07 * float(s));
                rayAccum += scCol * shaftMask * decay;
                rayWeight += decay;
            }
            if (rayWeight > 0.001) {
                layerColor += (rayAccum / rayWeight) * (L.bslaGodRays * 2.2) * vec3(1.15, 1.05, 0.90);
            }
        }

        // 21. Volumetric fog (BSL-shader style)
        //     * pseudo view distance: higher in frame = further away, plus a separate ground-fog layer
        //     * domain-warped, drifting fbm gives cloud banks + wisps (not a flat overlay)
        //     * per-channel Beer-Lambert extinction: blue scatters/extinguishes a bit more, so distance
        //       goes cool and desaturated the way real fog does
        //     * in-scatter colour comes from the scene's own sky/ground, plus a forward-scatter (Mie)
        //       sun glow around the same sun position the god rays use
        //     sliders: Fog Density = optical thickness, Fog Depth = how far the fog reaches / how high
        //     the ground fog climbs
        if (L.bslaFogDensity > 0.01) {
            float sigma = clamp(L.bslaFogDensity, 0.0, 1.0);
            float reach = clamp(L.bslaFogDepth, 0.0, 1.0);
            float aspectF = float(width) / float(height);
            float tf = u_time * 0.030;
            float yy = clamp(uvN.y, 0.0, 1.0);                       // 0 = top of frame, 1 = bottom

            // --- noise: domain warp -> banks (low freq) + wisps (high freq) + sun-aligned shafts ---
            vec2 wp = uvN * vec2(2.2 * aspectF, 2.2);
            vec2 warp = vec2(fbm(wp + vec2(tf, 3.1)), fbm(wp + vec2(7.7, -tf * 0.8))) - 0.5;
            vec2 npos = wp + warp * 1.6;
            float bank = fbm(npos * 1.0 + vec2(tf * 1.0, -tf * 0.45));
            float wisp = fbm(npos * 3.4 + vec2(-tf * 1.7, tf * 0.9) + 31.7);
            float vol = smoothstep(0.22, 0.82, mix(bank, wisp, 0.35));

            // --- pseudo depth + height fog ---
            float distFar = 1.0 - yy * 0.62;                                        // 0.38 (near) .. 1.0 (far)
            float groundFog = smoothstep(1.0 - (0.28 + reach * 0.62), 1.0, yy);   // thicker towards the bottom
            float column = (0.40 + 0.75 * reach) * distFar + 0.85 * groundFog;
            float dens = sigma * column * mix(0.40, 1.65, vol);

            // --- sun: same position as the god rays, forward-scatter lobe + soft shafts through the fog ---
            vec2 sunUV = vec2(0.50, 0.06);
            float sd = length((uvN - sunUV) * vec2(aspectF, 1.0));
            float mieTight = exp(-sd * 7.0);
            float mieWide = exp(-sd * 2.2);
            float shafts = fbm(vec2(uvN.x * 15.0 * aspectF, uvN.y * 1.4 - tf * 0.6) + 5.3);
            dens *= 1.0 + 0.30 * (shafts - 0.5) * mieWide;

            // keep ink / fine character detail readable: fog is thinner where detail is dense (= nearer)
            dens *= 1.0 - 0.30 * smoothstep(0.10, 0.50, lineEdge);
            dens = max(dens, 0.0);

            // --- Beer-Lambert, slightly stronger extinction in blue ---
            vec3 trans = exp(-dens * 3.2 * vec3(0.92, 1.00, 1.12));

            // --- in-scatter colour: sky above, ground below, both from the actual scene ---
            vec3 skyC = (srcLin(ivec2(width / 4, height / 8)) + srcLin(ivec2(3 * width / 4, height / 8))) * 0.5;
            vec3 gndC = (srcLin(ivec2(width / 4, 7 * height / 8)) + srcLin(ivec2(3 * width / 4, 7 * height / 8))) * 0.5;
            vec3 amb = (skyC + gndC) * 0.5;
            vec3 cool = srgbToLinear(vec3(0.62, 0.72, 0.84));
            vec3 hazeBase = mix(skyC, gndC, smoothstep(0.30, 0.95, yy));
            vec3 fogCol = mix(cool, hazeBase * 1.40 + cool * 0.20, 0.45);
            float ambL = clamp(luma(amb) * 2.4 + clamp(luma(layerColor), 0.0, 1.0) * 0.5, 0.0, 1.2);
            fogCol *= (0.30 + 0.70 * ambL);
            fogCol *= 1.0 + (bank - 0.5) * 0.40;                                  // lit banks vs shadowed banks
            vec3 sunTint = vec3(1.00, 0.80, 0.55);
            fogCol += sunTint * (mieWide * 0.16 + mieTight * 0.34) * (0.35 + 0.65 * vol) * (0.30 + 0.70 * ambL);
            fogCol = max(fogCol, vec3(0.0));

            layerColor = layerColor * trans + fogCol * (vec3(1.0) - trans);
        }

        // 23. Film grain (luma-weighted, grows in mids like real stock)
        if (L.filmGrain > 0.001) {
            float noise = (hash12(vec2(coord) + vec2(u_time * 17.13, u_time * 31.37)) - 0.5);
            float lw = 0.35 + 0.65 * (1.0 - abs(clamp(luma(layerColor), 0.0, 1.0) - 0.45) * 1.4);
            layerColor += vec3(noise * L.filmGrain * 0.06 * lw);
        }

        // 24. Flicker
        if (L.flickerIntensity > 0.005) {
            float freq = max(L.flickerSpeed, 1.0) * 6.2831853;
            float fWave = sin(u_time * freq) * 0.5 + 0.5;
            layerColor *= (1.0 + (fWave - 0.5) * L.flickerIntensity * 0.30);
        }

        // 25. Vignettes (slightly gentler than v1)
        if (L.vignette > 0.01) {
            vec2 vuv = uvN - 0.5;
            layerColor *= clamp(smoothstep(0.78, 0.18, length(vuv) * (0.62 + L.vignette * 0.58)), 0.0, 1.0);
        }
        if (L.vignetteBoxed > 0.01) {
            vec2 buv = abs(uvN - 0.5) * 2.0;
            layerColor *= clamp(smoothstep(0.98, 0.22, max(buv.x, buv.y) * (0.62 + L.vignetteBoxed * 0.58)), 0.0, 1.0);
        }

        // 26. Centre aura + horizontal ramp
        if (L.centerAura > 0.01) {
            layerColor += vec3(smoothstep(0.60, 0.0, length(uvN - 0.5)) * L.centerAura * 0.30);
        }
        if (L.horizontalRamp > 0.01) {
            layerColor *= (1.0 + smoothstep(0.35, 0.65, uvN.y) * L.horizontalRamp * 0.30);
        }

        // 27. Gradient Map (before the blend, so the layer's blend mode shapes it; always upstream of the LUT)
        if (gmaps[i].enabled > 0.5) {
            layerColor = gradientMapApply(layerColor, gmaps[i], coord, uvN, width, height);
        }

        // Composite this layer (gamma-space blending by default = AE)
        currentComposite = applyBlendMode(currentComposite, max(layerColor, vec3(0.0)), int(L.blendMode + 0.5), L.opacity, L.blendLinear > 0.5);
    }

    // 28. Razor-edge text bevel (v5, metal face restored in v6) - the clip itself is NEVER blurred, softened or re-coloured.
    //     v4 still shaded the letter faces and dropped wide shadow / glow hazes over the box, which read as
    //     softening. v5 touches only three things, all driven by the text mask and all hard-edged:
    //       * a 1-2 px lit rim and a thin shaded rim on the letter edges (the razor bevel line)
    //       * a narrow bevel band just inside the edge (small highlight / small shade, fades in a few px)
    //       * an outside edge halo: a bright core hugging the edge that falls off quickly (additive only)
    //     Every sample is taken at fixed integer offsets from the mask; the source pixels are never averaged.
    if (u_textSuiteEnabled > 0.5) {
        vec2 boxMin = vec2(u_textBoxX, u_textBoxY);
        vec2 boxSize = max(vec2(u_textBoxW, u_textBoxH), vec2(1e-3));
        float tMargin = max(0.03, 0.22 * boxSize.y);
        vec2 qd = max(abs(uvN - (boxMin + boxSize * 0.5)) - boxSize * 0.5, vec2(0.0));
        float outD = length(qd);
        if (outD < tMargin) {
            float boxFade = 1.0 - smoothstep(0.0, tMargin, outD);       // halo / shadow fade out smoothly
            float inBox = 1.0 - smoothstep(0.0, 0.004, outD);            // the bevel itself stays in the box

            gTextThr = (u_g22 > 0.01) ? clamp(u_g22, 0.15, 0.95) : 0.65;
            float tDepth = clamp(u_textBevelDepth, 0.0, 3.0);
            float tChrome = clamp(u_textChromeIntensity, 0.0, 3.0);
            float tSpec = clamp(u_g20, 0.0, 2.0);
            float tShadow = clamp(u_g21, 0.0, 1.0);
            float tGlow = clamp(u_g24, 0.0, 2.0);
            float tGlowR = 0.6 + 0.8 * clamp(u_g25, 0.0, 1.5);
            float tpx = max(resScale, 0.5);
            vec2 whPx = vec2(float(width), float(height));

            float fillC = textFillAt(coord);
            float outside = 1.0 - fillC;
            float mText = fillC * inBox;

            // ---- ring A (r = 1.5 px): thin-stroke direction + rim coverage ----
            vec2 gA = vec2(0.0); float mA = 0.0;
            for (int k = 0; k < 8; k++) {
                float a = (float(k) + 0.5) * 0.78539816;
                vec2 d = vec2(cos(a), sin(a));
                float f = textFillAt(coord + ivec2(round(d * 1.5 * tpx)));
                gA += d * f; mA += f;
            }
            gA *= 0.25; mA *= 0.125;

            // ---- ring B (r = 2..5 px by bevel depth): bevel-band coverage + direction + the text's own colour ----
            float bw = mix(2.0, 5.0, clamp(tDepth * 0.5, 0.0, 1.0));
            vec2 gB = vec2(0.0); float mB = 0.0;
            vec3 ringCol = vec3(0.0); float ringW = 0.0;
            for (int k = 0; k < 8; k++) {
                float a = (float(k) + 0.1) * 0.78539816;
                vec2 d = vec2(cos(a), sin(a));
                vec4 s = textSampleAt(coord + ivec2(round(d * bw * tpx)));
                gB += d * s.a; mB += s.a;
                ringCol += s.rgb * s.a; ringW += s.a;
            }
            gB *= 0.25; mB *= 0.125;

            // outward edge normal (screen space, y down) and light from the upper left
            vec2 gDir = gA + gB * 0.7;
            float gLen = length(gDir);
            vec2 outN = (gLen > 1e-4) ? -gDir / gLen : vec2(0.0);
            vec2 L2 = normalize(vec2(-0.55, -0.83));
            float lit = dot(outN, L2);
            float hi = smoothstep(0.05, 0.85, lit);
            float lo = smoothstep(0.05, 0.85, -lit);

            float rimBand = fillC * (1.0 - smoothstep(0.55, 0.95, mA));   // ~1-2 px right on the edge
            float bandIn  = fillC * (1.0 - smoothstep(0.50, 0.97, mB));   // a few px deep, fades inward

            // ---- the text's own hue (Oklab), used gently ----
            vec3 tcol = (ringW > 0.5) ? ringCol / ringW : vec3(0.0);
            tcol = mix(tcol, srcLin(coord), fillC * 0.30);
            vec3 tLab = linearRgbToOklab(max(tcol, vec3(0.0)));
            float tC = length(tLab.yz);
            vec2 tDir = (tC > 1e-4) ? tLab.yz / tC : vec2(1.0, 0.0);
            float hasHue = smoothstep(0.010, 0.045, tC);
            float chromaGen = clamp(tC * 1.3 + 0.02, 0.04, 0.22);
            if (u_g23 > 0.5) {                                           // explicit finish overrides the hue
                float hOver = (u_g23 < 1.5) ? 1.75 : ((u_g23 < 2.5) ? 3.35 : ((u_g23 < 3.5) ? 0.45 : 5.30));
                tDir = vec2(cos(hOver), sin(hOver));
                hasHue = 1.0; chromaGen = 0.14;
            }
            vec3 hiCol = oklabToLinearRgb(vec3(0.97, tDir * chromaGen * 0.20));
            vec3 tintRaw = oklabToLinearRgb(vec3(0.80, tDir * chromaGen * 0.80));
            vec3 tintN = tintRaw / max(luma(tintRaw), 1e-3);

            // ---- 1) the letters: original pixels + bevel lines (nothing is blurred or replaced) ----
            vec3 orig = currentComposite;
            vec3 toned = orig;
            float bevelK = clamp(tDepth, 0.0, 2.0);
            // v6 METAL FACE: v5 only multiplied the face by a +-12% silk tone, which is why it stopped looking metallic.
            // The face is now a real reflective surface: a multi-band horizon reflection (bright sky -> dark band ->
            // thin horizon line -> dark ground -> lit lower band) whose sky / ground colours are SAMPLED from the scene
            // above and below the text box (so it reflects what is around it), tinted by the text's own hue (white text =
            // neutral chrome that picks up the scene, gold text = gold metal, ...), plus a diagonal gloss sweep.
            // Chrome slider = how metal the face is (1.2 default = slightly metallic, 2+ = full chrome).
            float metalAmt = clamp(tChrome * 0.42, 0.0, 0.92) * smoothstep(0.02, 0.50, fillC);
            if (metalAmt > 0.01) {
                float smax = clamp(0.5 * boxSize.y * whPx.y, 24.0 * tpx, 140.0 * tpx);
                float dUp = textEdgeDist(coord, vec2(0.0, -1.0), smax);
                float dDn = textEdgeDist(coord, vec2(0.0, 1.0), smax);
                float vText = clamp(dUp / max(dUp + dDn, 1e-3), 0.0, 1.0);
                // what the metal "sees": scene colour just above and below the box
                vec3 skyAcc = vec3(0.0);
                vec3 gndAcc = vec3(0.0);
                ivec2 lim = ivec2(width - 1, height - 1);
                for (int q = 0; q < 4; q++) {
                    float fx = (float(q) + 0.5) * 0.25;
                    vec2 pu = vec2(boxMin.x + boxSize.x * fx, boxMin.y - 0.035);
                    vec2 pg = vec2(boxMin.x + boxSize.x * fx, boxMin.y + boxSize.y + 0.035);
                    skyAcc += srcLin(clamp(ivec2(pu * whPx), ivec2(0), lim));
                    gndAcc += srcLin(clamp(ivec2(pg * whPx), ivec2(0), lim));
                }
                skyAcc *= 0.25;
                gndAcc *= 0.25;
                vec3 skyRef = mix(vec3(0.60), skyAcc * 1.5 + 0.06, 0.65);
                vec3 gndRef = mix(vec3(0.35), gndAcc * 1.5 + 0.04, 0.65);
                vec3 metal = chromeBands(vText, skyRef, gndRef);
                metal *= mix(vec3(1.0), tintN, hasHue * 0.85);                   // the text's own colour tints the metal
                // diagonal gloss sweep (follows the box, slides down the letter), driven by the Specular slider
                float ux = clamp((uvN.x - boxMin.x) / boxSize.x, 0.0, 1.0);
                float sheen = gaussBand(ux - (0.28 + 0.38 * vText), 0.07) + 0.35 * gaussBand(ux - (0.72 + 0.20 * vText), 0.04);
                metal += mix(vec3(1.0), hiCol, hasHue) * sheen * 0.50 * clamp(tSpec, 0.0, 1.5);
                toned = mix(orig, metal, metalAmt);
            }
            toned *= 1.0 - 0.38 * lo * bandIn * min(bevelK, 1.5);                    // shaded bevel face
            toned += hiCol * hi * bandIn * (0.32 + 0.20 * metalAmt) * bevelK;        // lit bevel face (narrow), brighter on metal
            toned += hiCol * hi * rimBand * 1.05 * tSpec;                            // razor lit edge line
            toned += tintN * lo * rimBand * 0.28 * (0.4 + 0.6 * hasHue) * min(bevelK, 1.5); // thin shaded edge line

            // ---- 2) around the letters: crisp offset shadow + tight edge halo (additive, no haze) ----
            vec3 under = orig;
            ivec2 shOff = ivec2(round(vec2(2.0, 3.0) * tpx * (0.5 + 0.5 * min(tDepth, 1.5))));
            float shM = 0.5 * textFillAt(coord - shOff)
                      + 0.25 * textFillAt(coord - shOff + ivec2(1, 0))
                      + 0.25 * textFillAt(coord - shOff - ivec2(1, 0));
            under *= 1.0 - clamp(shM * outside * 0.45 * tShadow, 0.0, 0.5) * boxFade;

            float c0 = 0.0; float c1 = 0.0; float c2 = 0.0; float c3 = 0.0;
            for (int k = 0; k < 8; k++) {
                float a = (float(k) + 0.5) * 0.78539816;
                vec2 d0 = vec2(cos(a), sin(a));
                vec2 d1 = vec2(cos(a + 0.26), sin(a + 0.26));
                c0 += textFillAt(coord + ivec2(round(d0 * 1.6 * tpx * tGlowR)));
                c1 += textFillAt(coord + ivec2(round(d1 * 3.6 * tpx * tGlowR)));
                c2 += textFillAt(coord + ivec2(round(d0 * 7.0 * tpx * tGlowR)));
                c3 += textFillAt(coord + ivec2(round(d1 * 12.0 * tpx * tGlowR)));
            }
            c0 *= 0.125; c1 *= 0.125; c2 *= 0.125; c3 *= 0.125;
            float haloAmt = (c0 * 1.0 + c1 * 0.65 + c2 * 0.35 + c3 * 0.16) * outside * tGlow * boxFade;
            float haloCore = smoothstep(0.20, 0.60, c0) * outside * tGlow * boxFade;   // bright line hugging the edge
            vec3 neon = mix(vec3(0.85), oklabToLinearRgb(vec3(0.84, tDir * max(chromaGen, 0.07))), hasHue);
            vec3 halo = neon * ((1.0 - exp(-haloAmt * 1.3)) * 0.80 + haloCore * 0.40);
            under += halo * (1.0 - 0.5 * clamp(luma(under), 0.0, 1.0));

            // ---- 3) letters keep their own detail; the surroundings only get halo + shadow ----
            currentComposite = mix(under, max(toned, vec3(0.0)), mText);
        }
    }

    // HDR half-float store. LUT + tonemap + dither happen in pass 6, after all glows.
    packComposite(pixelIndex, vec4(currentComposite, rawPixel.a));
}
