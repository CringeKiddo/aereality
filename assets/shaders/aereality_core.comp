// =============================================================================
// COLOR SPACE UTILITIES: sRGB <-> LINEAR RGB
// =============================================================================
float srgbToLinear(float c) {
    return (c <= 0.04045) ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4);
}

vec3 srgbToLinear(vec3 c) {
    return vec3(srgbToLinear(c.r), srgbToLinear(c.g), srgbToLinear(c.b));
}

float linearToSrgb(float c) {
    c = clamp(c, 0.0, 1.0);
    return (c <= 0.0031308) ? (c * 12.92) : (1.055 * pow(c, 1.0 / 2.4) - 0.055);
}

vec3 linearToSrgb(vec3 c) {
    return vec3(linearToSrgb(c.r), linearToSrgb(c.g), linearToSrgb(c.b));
}

// =============================================================================
// PERCEPTUAL COLOR SPACE: OKLAB (<-> LINEAR RGB)
// =============================================================================
vec3 linearRgbToOklab(vec3 c) {
    c = max(vec3(0.0), c);
    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;

    float l_ = pow(l, 1.0 / 3.0);
    float m_ = pow(m, 1.0 / 3.0);
    float s_ = pow(s, 1.0 / 3.0);

    return vec3(
        0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
    );
}

vec3 oklabToLinearRgb(vec3 lab) {
    float l_ = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z;
    float m_ = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;
    float s_ = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;

    float l = l_ * l_ * l_;
    float m = m_ * m_ * m_;
    float s = s_ * s_ * s_;

    return vec3(
        +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
    );
}

// Gentle, controlled hue shift in Oklab chroma plane
vec2 oklabRotateHue(vec2 ab, float angleRadians) {
    float cosA = cos(angleRadians * 0.45);
    float sinA = sin(angleRadians * 0.45);
    return vec2(ab.x * cosA - ab.y * sinA, ab.x * sinA + ab.y * cosA);
}

// =============================================================================
// MONOTONIC SPLINE CURVE EVALUATION (STRICT SAFE BOUNDS - ZERO INVERSIONS)
// =============================================================================
float evalCatmullRom(float x, float p0, float p1, float p2, float p3, float p4) {
    x = clamp(x, 0.0, 1.0);
    float seg = x * 4.0;
    int idx = int(floor(seg));
    if (idx >= 4) return clamp(p4, 0.0, 1.0);
    float t = seg - float(idx);

    float cp0 = (idx == 0) ? p0 : (idx == 1) ? p0 : (idx == 2) ? p1 : p2;
    float cp1 = (idx == 0) ? p0 : (idx == 1) ? p1 : (idx == 2) ? p2 : p3;
    float cp2 = (idx == 0) ? p1 : (idx == 1) ? p2 : (idx == 2) ? p3 : p4;
    float cp3 = (idx == 0) ? p2 : (idx == 1) ? p3 : (idx == 2) ? p4 : p4;

    float m1 = clamp(0.5 * (cp2 - cp0), -1.0, 1.0);
    float m2 = clamp(0.5 * (cp3 - cp1), -1.0, 1.0);
    float t2 = t * t;
    float t3 = t2 * t;

    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;

    return clamp(h00 * cp1 + h10 * m1 + h01 * cp2 + h11 * m2, 0.0, 1.0);
}

// Overload for RGB vector
vec3 evalCatmullRom(vec3 c, float p0, float p1, float p2, float p3, float p4) {
    return vec3(
        evalCatmullRom(c.r, p0, p1, p2, p3, p4),
        evalCatmullRom(c.g, p0, p1, p2, p3, p4),
        evalCatmullRom(c.b, p0, p1, p2, p3, p4)
    );
}

// =============================================================================
// BIT-DEPTH PIXEL READ & WRITE (8-Bit, 10-Bit, 16-Bit Precision)
// =============================================================================
vec4 unpackRGBA_Dynamic(int pixelIndex, float bitMode) {
    if (bitMode > 1.5) {
        uint word0 = in_pixels[pixelIndex * 2];
        uint word1 = in_pixels[pixelIndex * 2 + 1];
        float r = float(word0 & 0xFFFFu) / 65535.0;
        float g = float((word0 >> 16u) & 0xFFFFu) / 65535.0;
        float b = float(word1 & 0xFFFFu) / 65535.0;
        float a = float((word1 >> 16u) & 0xFFFFu) / 65535.0;
        return vec4(r, g, b, a);
    } else if (bitMode > 0.5) {
        uint val = in_pixels[pixelIndex];
        float r = float(val & 0x3FFu) / 1023.0;
        float g = float((val >> 10u) & 0x3FFu) / 1023.0;
        float b = float((val >> 20u) & 0x3FFu) / 1023.0;
        float a = float((val >> 30u) & 0x3u) / 3.0;
        return vec4(r, g, b, a);
    } else {
        uint val = in_pixels[pixelIndex];
        float r = float(val & 0xFFu) / 255.0;
        float g = float((val >> 8u) & 0xFFu) / 255.0;
        float b = float((val >> 16u) & 0xFFu) / 255.0;
        float a = float((val >> 24u) & 0xFFu) / 255.0;
        return vec4(r, g, b, a);
    }
}

vec4 unpackOut_Dynamic(int pixelIndex, float bitMode) {
    if (bitMode > 1.5) {
        uint word0 = out_pixels[pixelIndex * 2];
        uint word1 = out_pixels[pixelIndex * 2 + 1];
        float r = float(word0 & 0xFFFFu) / 65535.0;
        float g = float((word0 >> 16u) & 0xFFFFu) / 65535.0;
        float b = float(word1 & 0xFFFFu) / 65535.0;
        float a = float((word1 >> 16u) & 0xFFFFu) / 65535.0;
        return vec4(r, g, b, a);
    } else if (bitMode > 0.5) {
        uint val = out_pixels[pixelIndex];
        float r = float(val & 0x3FFu) / 1023.0;
        float g = float((val >> 10u) & 0x3FFu) / 1023.0;
        float b = float((val >> 20u) & 0x3FFu) / 1023.0;
        float a = float((val >> 30u) & 0x3u) / 3.0;
        return vec4(r, g, b, a);
    } else {
        uint val = out_pixels[pixelIndex];
        float r = float(val & 0xFFu) / 255.0;
        float g = float((val >> 8u) & 0xFFu) / 255.0;
        float b = float((val >> 16u) & 0xFFu) / 255.0;
        float a = float((val >> 24u) & 0xFFu) / 255.0;
        return vec4(r, g, b, a);
    }
}

void packRGBA_Dynamic(int pixelIndex, vec4 col, float bitMode) {
    if (bitMode > 1.5) {
        uint r = uint(clamp(col.r * 65535.0 + 0.5, 0.0, 65535.0));
        uint g = uint(clamp(col.g * 65535.0 + 0.5, 0.0, 65535.0));
        uint b = uint(clamp(col.b * 65535.0 + 0.5, 0.0, 65535.0));
        uint a = uint(clamp(col.a * 65535.0 + 0.5, 0.0, 65535.0));
        out_pixels[pixelIndex * 2] = (g << 16u) | r;
        out_pixels[pixelIndex * 2 + 1] = (a << 16u) | b;
    } else if (bitMode > 0.5) {
        uint r = uint(clamp(col.r * 1023.0 + 0.5, 0.0, 1023.0));
        uint g = uint(clamp(col.g * 1023.0 + 0.5, 0.0, 1023.0));
        uint b = uint(clamp(col.b * 1023.0 + 0.5, 0.0, 1023.0));
        uint a = uint(clamp(col.a * 3.0 + 0.5, 0.0, 3.0));
        out_pixels[pixelIndex] = (a << 30u) | (b << 20u) | (g << 10u) | r;
    } else {
        uint r = uint(clamp(col.r * 255.0 + 0.5, 0.0, 255.0));
        uint g = uint(clamp(col.g * 255.0 + 0.5, 0.0, 255.0));
        uint b = uint(clamp(col.b * 255.0 + 0.5, 0.0, 255.0));
        uint a = uint(clamp(col.a * 255.0 + 0.5, 0.0, 255.0));
        out_pixels[pixelIndex] = (a << 24u) | (b << 16u) | (g << 8u) | r;
    }
}

vec3 unpackBloomHalf(uint val) {
    float r = float(val & 0xFFu) / 255.0;
    float g = float((val >> 8u) & 0xFFu) / 255.0;
    float b = float((val >> 16u) & 0xFFu) / 255.0;
    return vec3(r * r, g * g, b * b); // Linearize
}

uint packBloomHalf(vec3 col) {
    col = sqrt(max(vec3(0.0), col));
    uint r = uint(clamp(col.r * 255.0 + 0.5, 0.0, 255.0));
    uint g = uint(clamp(col.g * 255.0 + 0.5, 0.0, 255.0));
    uint b = uint(clamp(col.b * 255.0 + 0.5, 0.0, 255.0));
    return (255u << 24u) | (b << 16u) | (g << 8u) | r;
}

// Smooth triangular dither noise (zero brick grid lines)
float smoothTriangularDither(vec2 screenPos) {
    float n = fract(sin(dot(screenPos, vec2(12.9898, 78.233))) * 43758.5453);
    float n2 = fract(sin(dot(screenPos + vec2(1.0), vec2(12.9898, 78.233))) * 43758.5453);
    return (n + n2) * 0.5 - 0.5;
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec3 hueToRGB(float h) {
    float r = abs(h * 6.0 - 3.0) - 1.0;
    float g = 2.0 - abs(h * 6.0 - 2.0);
    float b = 2.0 - abs(h * 6.0 - 4.0);
    return clamp(vec3(r, g, b), 0.0, 1.0);
}

vec3 colorTempToRGB(float kelvin) {
    if (kelvin < 1000.0) return vec3(1.0);
    float temp = kelvin / 100.0;
    float red, green, blue;

    if (temp <= 66.0) {
        red = 255.0;
        green = temp;
        green = 99.4708025861 * log(max(green, 1.0)) - 161.1195681661;
        if (temp <= 19.0) {
            blue = 0.0;
        } else {
            blue = temp - 10.0;
            blue = 138.5177312231 * log(max(blue, 1.0)) - 305.0447927307;
        }
    } else {
        red = temp - 60.0;
        red = 329.698727446 * pow(max(red, 1.0), -0.1332047592);
        green = temp - 60.0;
        green = 288.1221695283 * pow(max(green, 1.0), -0.0755148492);
        blue = 255.0;
    }

    vec3 srgbCol = clamp(vec3(red, green, blue) / 255.0, 0.0, 1.0);
    return srgbToLinear(srgbCol);
}

// =============================================================================
// TONEMAPPERS (REAL KHRONOS & REAL AgX ANIME PUNCH - ZERO BLOWN-OUT FACES)
// =============================================================================
vec3 tonemapKhronosPbrNeutral(vec3 color) {
    color = max(color, vec3(0.0));
    const float startCompression = 0.8 - 0.04;
    const float desaturation = 0.15;

    float x = min(color.r, min(color.g, color.b));
    float offset = x < 0.08 ? x - 6.25 * x * x : 0.04;
    color -= offset;

    float peak = max(color.r, max(color.g, color.b));
    if (peak < startCompression) return color;

    const float d = 1.0 - startCompression;
    float newPeak = 1.0 - d * d / (peak + d - startCompression);
    color *= newPeak / peak;

    float g = 1.0 - 1.0 / (desaturation * (peak - newPeak) + 1.0);
    return mix(color, newPeak * vec3(1.0), g);
}

// True AgX implementation tailored for Anime Aesthetics
vec3 tonemapAgxAnime(vec3 color) {
    color = max(vec3(0.0), color);

    // 1. Inset matrix
    const mat3 agxMat = mat3(
        0.842479062253094, 0.0423282422610123, 0.0423756549057051,
        0.0784335999999992, 0.878468636494572, 0.0784336,
        0.0792237451477643, 0.0791661274605434, 0.879223745147764
    );
    vec3 val = agxMat * color;

    // 2. Log2 encoding with safe floor
    const float minEV = -10.0;
    const float maxEV = 6.5;
    val = clamp(log2(val + 1e-5), minEV, maxEV);
    val = (val - minEV) / (maxEV - minEV);

    // 3. Punchy Anime S-Curve: Deepens dark midtones without blowing skin highlights
    vec3 sCurve = val * val * (3.0 - 2.0 * val);
    val = mix(val, sCurve, 0.65);

    // Sigmoid compression
    val = val * (2.2 * val + 0.04) / (val * (2.0 * val + 0.55) + 0.14);

    // 4. Outset matrix
    const mat3 agxMatInv = mat3(
        1.19687900512017, -0.0528968517594969, -0.0529716355844491,
        -0.0980208811401368, 1.15190312990417, -0.0980434501171241,
        -0.0990297470775088, -0.0989611768448433, 1.15107367264188
    );
    val = max(vec3(0.0), agxMatInv * val);

    // 5. Anime Vibrance Restorer in Linear Space
    float luma = dot(val, vec3(0.2126, 0.7152, 0.0722));
    val = mix(vec3(luma), val, 1.15);
    return clamp(val, 0.0, 1.0);
}

vec3 applyToneMapping(vec3 linearCol, float mode) {
    if (mode == 1.0) {
        return tonemapAgxAnime(linearCol);
    } else if (mode == 2.0) {
        return tonemapKhronosPbrNeutral(linearCol);
    }
    return linearCol; // Mode 0 = Linear Passthrough
}

// 3D LUT TRILINEAR SAMPLER
vec3 sample3DLut(vec3 color, float opacity) {
    if (opacity <= 0.001) return color;
    vec3 coord = clamp(color, 0.0, 1.0) * 31.0;
    ivec3 c0 = clamp(ivec3(floor(coord)), ivec3(0), ivec3(31));
    ivec3 c1 = clamp(c0 + ivec3(1), ivec3(0), ivec3(31));
    vec3 f = fract(coord);

    #define LUT_IDX(r, g, b) (((b) * 1024 + (g) * 32 + (r)) * 3)
    vec3 s000 = vec3(lut_table[LUT_IDX(c0.x, c0.y, c0.z)], lut_table[LUT_IDX(c0.x, c0.y, c0.z)+1], lut_table[LUT_IDX(c0.x, c0.y, c0.z)+2]);
    vec3 s100 = vec3(lut_table[LUT_IDX(c1.x, c0.y, c0.z)], lut_table[LUT_IDX(c1.x, c0.y, c0.z)+1], lut_table[LUT_IDX(c1.x, c0.y, c0.z)+2]);
    vec3 s010 = vec3(lut_table[LUT_IDX(c0.x, c1.y, c0.z)], lut_table[LUT_IDX(c0.x, c1.y, c0.z)+1], lut_table[LUT_IDX(c0.x, c1.y, c0.z)+2]);
    vec3 s110 = vec3(lut_table[LUT_IDX(c1.x, c1.y, c0.z)], lut_table[LUT_IDX(c1.x, c1.y, c0.z)+1], lut_table[LUT_IDX(c1.x, c1.y, c0.z)+2]);
    vec3 s001 = vec3(lut_table[LUT_IDX(c0.x, c0.y, c1.z)], lut_table[LUT_IDX(c0.x, c0.y, c1.z)+1], lut_table[LUT_IDX(c0.x, c0.y, c1.z)+2]);
    vec3 s101 = vec3(lut_table[LUT_IDX(c1.x, c0.y, c1.z)], lut_table[LUT_IDX(c1.x, c0.y, c1.z)+1], lut_table[LUT_IDX(c1.x, c0.y, c1.z)+2]);
    vec3 s011 = vec3(lut_table[LUT_IDX(c0.x, c1.y, c1.z)], lut_table[LUT_IDX(c0.x, c1.y, c1.z)+1], lut_table[LUT_IDX(c0.x, c1.y, c1.z)+2]);
    vec3 s111 = vec3(lut_table[LUT_IDX(c1.x, c1.y, c1.z)], lut_table[LUT_IDX(c1.x, c1.y, c1.z)+1], lut_table[LUT_IDX(c1.x, c1.y, c1.z)+2]);

    vec3 s00 = mix(s000, s100, f.x);
    vec3 s01 = mix(s001, s101, f.x);
    vec3 s10 = mix(s010, s110, f.x);
    vec3 s11 = mix(s011, s111, f.x);
    vec3 s0 = mix(s00, s10, f.y);
    vec3 s1 = mix(s01, s11, f.y);
    return mix(color, mix(s0, s1, f.z), opacity);
}

// LINEAR RGB LAYER BLENDING
vec3 applyBlendModeLinear(vec3 baseCol, vec3 blendCol, int mode, float opacity) {
    vec3 result = blendCol;
    if (mode == 1) { // Screen
        result = baseCol + blendCol - (baseCol * blendCol);
    } else if (mode == 2) { // Linear Add
        result = baseCol + blendCol;
    } else if (mode == 3) { // Overlay
        result = mix(2.0 * baseCol * blendCol, 1.0 - 2.0 * (1.0 - baseCol) * (1.0 - blendCol), step(vec3(0.5), baseCol));
    } else if (mode == 4) { // Soft Light
        result = (1.0 - 2.0 * blendCol) * baseCol * baseCol + 2.0 * blendCol * baseCol;
    } else if (mode == 5) { // Multiply
        result = baseCol * blendCol;
    }
    return mix(baseCol, result, clamp(opacity, 0.0, 1.0));
}

// FXAA SPATIAL ANTI-ALIASING PASS (Line-Art Edge Smoothing)
vec3 applyFxaa(ivec2 coord, int width, int height, float bitMode) {
    vec3 rgbM = unpackOut_Dynamic(coord.y * width + coord.x, bitMode).rgb;
    float lumaM = dot(rgbM, vec3(0.2126, 0.7152, 0.0722));

    ivec2 up    = clamp(coord + ivec2(0, -1), ivec2(0), ivec2(width - 1, height - 1));
    ivec2 down  = clamp(coord + ivec2(0,  1), ivec2(0), ivec2(width - 1, height - 1));
    ivec2 left  = clamp(coord + ivec2(-1, 0), ivec2(0), ivec2(width - 1, height - 1));
    ivec2 right = clamp(coord + ivec2( 1, 0), ivec2(0), ivec2(width - 1, height - 1));

    float lumaU = dot(unpackOut_Dynamic(up.y * width + up.x, bitMode).rgb, vec3(0.2126, 0.7152, 0.0722));
    float lumaD = dot(unpackOut_Dynamic(down.y * width + down.x, bitMode).rgb, vec3(0.2126, 0.7152, 0.0722));
    float lumaL = dot(unpackOut_Dynamic(left.y * width + left.x, bitMode).rgb, vec3(0.2126, 0.7152, 0.0722));
    float lumaR = dot(unpackOut_Dynamic(right.y * width + right.x, bitMode).rgb, vec3(0.2126, 0.7152, 0.0722));

    float lumaMin = min(lumaM, min(min(lumaU, lumaD), min(lumaL, lumaR)));
    float lumaMax = max(lumaM, max(max(lumaU, lumaD), max(lumaL, lumaR)));
    float range = lumaMax - lumaMin;

    if (range < max(0.04, lumaMax * 0.12)) {
        return rgbM;
    }

    vec3 rgbFour = (unpackOut_Dynamic(up.y * width + up.x, bitMode).rgb +
                    unpackOut_Dynamic(down.y * width + down.x, bitMode).rgb +
                    unpackOut_Dynamic(left.y * width + left.x, bitMode).rgb +
                    unpackOut_Dynamic(right.y * width + right.x, bitMode).rgb) * 0.25;

    return mix(rgbM, rgbFour, 0.45);
}

// CONTINUOUS GAUSSIAN PYRAMID SAMPLING
vec3 sampleBloomBuffer(int passLevel, vec2 uv, int w, int h) {
    vec2 pos = clamp(uv * vec2(w, h) - 0.5, vec2(0.0), vec2(w - 1, h - 1));
    ivec2 p0 = ivec2(floor(pos));
    ivec2 p1 = clamp(p0 + ivec2(1), ivec2(0), ivec2(w - 1, h - 1));
    vec2 f = fract(pos);

    vec3 c00, c10, c01, c11;
    if (passLevel == 0) {
        c00 = unpackBloomHalf(bloom_l0[p0.y * w + p0.x]);
        c10 = unpackBloomHalf(bloom_l0[p0.y * w + p1.x]);
        c01 = unpackBloomHalf(bloom_l0[p1.y * w + p0.x]);
        c11 = unpackBloomHalf(bloom_l0[p1.y * w + p1.x]);
    } else if (passLevel == 1) {
        c00 = unpackBloomHalf(bloom_l1[p0.y * w + p0.x]);
        c10 = unpackBloomHalf(bloom_l1[p0.y * w + p1.x]);
        c01 = unpackBloomHalf(bloom_l1[p0.y * w + p0.x]);
        c11 = unpackBloomHalf(bloom_l1[p1.y * w + p1.x]);
    } else {
        c00 = unpackBloomHalf(bloom_l2[p0.y * w + p0.x]);
        c10 = unpackBloomHalf(bloom_l2[p0.y * w + p1.x]);
        c01 = unpackBloomHalf(bloom_l2[p1.y * w + p0.x]);
        c11 = unpackBloomHalf(bloom_l2[p1.y * w + p1.x]);
    }
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

// =============================================================================
// PASS 1: LINEAR HIGHLIGHT ISOLATION
// =============================================================================
void executeHighlightExtraction(ivec2 coord, int l0W, int l0H, int srcW, int srcH) {
    vec2 centerUV = (vec2(coord) + 0.5) / vec2(l0W, l0H);
    ivec2 srcC = ivec2(centerUV * vec2(srcW, srcH));
    float bitMode = u_bitDepthMode;
    vec3 col = unpackOut_Dynamic(srcC.y * srcW + srcC.x, bitMode).rgb;

    float luma = dot(col, vec3(0.2126, 0.7152, 0.0722));
    LayerData L = layers[0];
    float threshold = clamp(L.deepGlowThreshold, 0.10, 0.95);
    float knee = smoothstep(threshold, threshold + 0.20, luma);

    bloom_l0[coord.y * l0W + coord.x] = packBloomHalf(col * knee);
}

// PASS 2 & 3: CONTINUOUS DOWNSAMPLE
void executeBloomDownsample(int passIdx, ivec2 coord, int w, int h, float radius) {
    int srcLevel = (passIdx == 2) ? 0 : 1;
    int srcW = w * 2;
    int srcH = h * 2;
    vec2 uv = (vec2(coord) + 0.5) / vec2(w, h);
    vec2 texel = (1.0 / vec2(srcW, srcH)) * max(radius, 0.6);

    vec3 sum = sampleBloomBuffer(srcLevel, uv, srcW, srcH) * 4.0;
    sum += sampleBloomBuffer(srcLevel, uv + vec2(-texel.x, -texel.y), srcW, srcH);
    sum += sampleBloomBuffer(srcLevel, uv + vec2( texel.x, -texel.y), srcW, srcH);
    sum += sampleBloomBuffer(srcLevel, uv + vec2(-texel.x,  texel.y), srcW, srcH);
    sum += sampleBloomBuffer(srcLevel, uv + vec2( texel.x,  texel.y), srcW, srcH);
    sum /= 8.0;

    int dstIdx = coord.y * w + coord.x;
    if (passIdx == 2) {
        bloom_l1[dstIdx] = packBloomHalf(sum);
    } else {
        bloom_l2[dstIdx] = packBloomHalf(sum);
    }
}

// PASS 4 & 5: CONTINUOUS UPSAMPLE
void executeBloomUpsample(int passIdx, ivec2 coord, int w, int h, float radius) {
    int srcLevel = (passIdx == 4) ? 2 : 1;
    int srcW = w / 2;
    int srcH = h / 2;
    vec2 uv = (vec2(coord) + 0.5) / vec2(w, h);
    vec2 texel = (1.0 / vec2(srcW, srcH)) * max(radius, 0.6);

    vec3 sum = vec3(0.0);
    sum += sampleBloomBuffer(srcLevel, uv + vec2(-texel.x, 0.0), srcW, srcH) * 2.0;
    sum += sampleBloomBuffer(srcLevel, uv + vec2( texel.x, 0.0), srcW, srcH) * 2.0;
    sum += sampleBloomBuffer(srcLevel, uv + vec2(0.0, -texel.y), srcW, srcH) * 2.0;
    sum += sampleBloomBuffer(srcLevel, uv + vec2(0.0,  texel.y), srcW, srcH) * 2.0;
    sum += sampleBloomBuffer(srcLevel, uv + vec2(-texel.x, -texel.y), srcW, srcH);
    sum += sampleBloomBuffer(srcLevel, uv + vec2( texel.x, -texel.y), srcW, srcH);
    sum += sampleBloomBuffer(srcLevel, uv + vec2(-texel.x,  texel.y), srcW, srcH);
    sum += sampleBloomBuffer(srcLevel, uv + vec2( texel.x,  texel.y), srcW, srcH);
    sum /= 12.0;

    int dstIdx = coord.y * w + coord.x;
    if (passIdx == 4) {
        vec3 existing = unpackBloomHalf(bloom_l1[dstIdx]);
        bloom_l1[dstIdx] = packBloomHalf(mix(existing, sum, 0.55));
    } else {
        vec3 existing = unpackBloomHalf(bloom_l0[dstIdx]);
        bloom_l0[dstIdx] = packBloomHalf(mix(existing, sum, 0.55));
    }
}

// =============================================================================
// PASS 6: COMPOSITING & TONEMAPPING (Linear Blending + FXAA)
// =============================================================================
void executeFinalComposite(ivec2 coord, int width, int height) {
    int pixelIndex = coord.y * width + coord.x;
    float bitMode = u_bitDepthMode;
    vec3 linearBase = applyFxaa(coord, width, height, bitMode);

    vec2 uv = (vec2(coord) + 0.5) / vec2(width, height);
    LayerData L = layers[0];

    vec3 tightGlow = sampleBloomBuffer(0, uv, width / 2, height / 2);
    vec3 wideGlow  = sampleBloomBuffer(2, uv, width / 8, height / 8);

    // Calculate line-art edge gradient to protect ink outlines
    float resScale = float(max(width, height)) / 720.0;
    int edgeStep = max(1, int(round(resScale)));
    float gx = 0.0, gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 c = clamp(coord + ivec2(x * edgeStep, y * edgeStep), ivec2(0), ivec2(width - 1, height - 1));
            float lum = dot(unpackOut_Dynamic(c.y * width + c.x, bitMode).rgb, vec3(0.2126, 0.7152, 0.0722));
            gx += lum * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lum * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);

    // Dynamic Glow Tint Profiles
    vec3 glowTint = vec3(1.0);
    if (L.edgeGlowTint == 1.0) glowTint = vec3(1.20, 1.05, 0.65);
    else if (L.edgeGlowTint == 2.0) glowTint = vec3(0.40, 1.10, 1.45);
    else if (L.edgeGlowTint == 3.0) glowTint = vec3(1.25, 0.85, 0.40);
    else if (L.edgeGlowTint == 4.0) glowTint = vec3(1.30, 0.25, 0.30);
    else if (L.edgeGlowTint == 5.0) glowTint = vec3(1.00, 0.55, 1.45);
    else if (L.edgeGlowTint == 6.0) glowTint = vec3(1.35, 0.65, 0.95);

    // 1. DEEP GLOW: High-threshold atmospheric light falloff
    if (L.deepGlowIntensity > 0.01) {
        float falloff = 1.0 / (1.0 + (1.0 - L.deepGlowRadius) * 2.2);
        vec3 deepBloom = wideGlow * glowTint * (L.deepGlowIntensity * 1.35 * falloff);
        deepBloom *= (1.0 - lineEdge * 0.75); // Protect black ink outlines
        linearBase += deepBloom;
    }

    // 2. SHADERLY GLOW: Soft creamy bloom that wraps based on underlying video color
    if (u_shaderlyGlowIntensity > 0.01) {
        // Color-aware wrap: tight bloom modulated by the underlying footage color
        vec3 creamyColor = mix(linearBase, tightGlow, 0.40);
        vec3 softBloom = creamyColor * (u_shaderlyGlowIntensity * 1.10);
        softBloom *= (1.0 - lineEdge * 0.40);
        linearBase += softBloom;
    }

    // 3. SAPPHIRE S_GLOW: Soft outer edge halo (spreads outward like Nanami/Adevob screenshots)
    if (L.sapphireGlowWidth > 0.01) {
        // Radial dilation around edges (not a flat Sobel line)
        float outerHalo = smoothstep(0.08, 0.45, lineEdge) * (1.0 - smoothstep(0.70, 0.98, lineEdge));
        vec3 haloTint = (L.edgeGlowTint == 2.0) ? vec3(0.45, 1.15, 1.50) : glowTint;
        vec3 edgeHalo = tightGlow * outerHalo * haloTint * (L.sapphireGlowWidth * 1.5);
        linearBase += edgeHalo;
    }

    // 4. Master Tonemapping (Linear -> Display Transfer)
    vec3 finalLinear = applyToneMapping(linearBase, u_tonemapMode);

    // 5. Convert to sRGB for display output
    vec3 finalDisplay = linearToSrgb(finalLinear);

    // 6. Smooth Sub-Pixel Dithering (Clean triangular distribution - Zero Brick-Wall Grid Artifacts)
    if (u_ditherStrength > 0.01) {
        float dither = smoothTriangularDither(vec2(coord));
        float quantStep = (bitMode > 1.5) ? (1.0 / 65535.0) : ((bitMode > 0.5) ? (1.0 / 1023.0) : (1.0 / 255.0));
        finalDisplay = clamp(finalDisplay + vec3(dither * quantStep * (u_ditherStrength * 1.5)), 0.0, 1.0);
    }

    packRGBA_Dynamic(pixelIndex, vec4(finalDisplay, 1.0), bitMode);
}

// =============================================================================
// MAIN DISPATCH ROUTER
// =============================================================================
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    int width = u_passWidth;
    int height = u_passHeight;

    if (coord.x >= width || coord.y >= height) return;

    if (u_passIndex == 1) {
        executeHighlightExtraction(coord, width, height, int(u_imgWidth), int(u_imgHeight));
        return;
    } else if (u_passIndex == 2 || u_passIndex == 3) {
        executeBloomDownsample(u_passIndex, coord, width, height, u_passRadius);
        return;
    } else if (u_passIndex == 4 || u_passIndex == 5) {
        executeBloomUpsample(u_passIndex, coord, width, height, u_passRadius);
        return;
    } else if (u_passIndex == 6) {
        executeFinalComposite(coord, width, height);
        return;
    }

    // =========================================================================
    // PASS 0: FULL PRIMARY GRADE PIPELINE (ALL 26 ORIGINAL EFFECTS PRESERVED)
    // =========================================================================
    int pixelIndex = coord.y * width + coord.x;
    float bitMode = u_bitDepthMode;
    vec4 rawPixel = unpackRGBA_Dynamic(pixelIndex, bitMode);

    // Linearize base footage
    vec3 currentComposite = srgbToLinear(rawPixel.rgb);

    float resScale = float(max(width, height)) / 720.0;
    int edgeStep = max(1, int(round(resScale)));

    // Sobel gradient for line detection and edge normal
    float gx = 0.0, gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 c = clamp(coord + ivec2(x * edgeStep, y * edgeStep), ivec2(0), ivec2(width - 1, height - 1));
            vec3 pLin = srgbToLinear(unpackRGBA_Dynamic(c.y * width + c.x, bitMode).rgb);
            float lum = dot(pLin, vec3(0.2126, 0.7152, 0.0722));
            float kx = float(x) * ((y == 0) ? 2.0 : 1.0);
            float ky = float(y) * ((x == 0) ? 2.0 : 1.0);
            gx += lum * kx;
            gy += lum * ky;
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);
    vec2 edgeNormal = (lineEdge > 0.05) ? normalize(vec2(gx, gy)) : vec2(0.0);

    int totalLayers = int(clamp(u_layerCount, 0.0, 4.0));

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;

        vec3 layerColor = currentComposite;

        // 1. Tilt-Shift Depth of Field (in Linear Space)
        if (L.depthOfField > 0.01) {
            float normY = float(coord.y) / float(height);
            float dofDist = abs(normY - L.dofFocus);
            float dofBlurAmt = smoothstep(0.10, 0.45, dofDist) * L.depthOfField * 6.0 * resScale;
            if (dofBlurAmt > 0.5) {
                vec2 dofDir = vec2(cos(L.dofAngle), sin(L.dofAngle));
                vec3 dofSum = layerColor;
                float dofTotal = 1.0;
                for (int step = 1; step <= 6; step++) {
                    ivec2 dOffset = ivec2(dofDir * (float(step) * (dofBlurAmt / 6.0)));
                    ivec2 dP1 = clamp(coord + dOffset, ivec2(0), ivec2(width - 1, height - 1));
                    ivec2 dP2 = clamp(coord - dOffset, ivec2(0), ivec2(width - 1, height - 1));
                    dofSum += srgbToLinear(unpackRGBA_Dynamic(dP1.y * width + dP1.x, bitMode).rgb);
                    dofSum += srgbToLinear(unpackRGBA_Dynamic(dP2.y * width + dP2.x, bitMode).rgb);
                    dofTotal += 2.0;
                }
                layerColor = dofSum / dofTotal;
            }
        }

        // 2. Edge Chromatic Aberration
        if (L.lineChromaStrength > 0.001 && lineEdge > 0.05) {
            float edgeFactor = smoothstep(0.08, 0.35, lineEdge);
            ivec2 shift = ivec2(edgeNormal * (L.lineChromaStrength * 3.0 * resScale));
            ivec2 rCoord = clamp(coord + shift, ivec2(0), ivec2(width - 1, height - 1));
            ivec2 bCoord = clamp(coord - shift, ivec2(0), ivec2(width - 1, height - 1));
            layerColor.r = mix(layerColor.r, srgbToLinear(unpackRGBA_Dynamic(rCoord.y * width + rCoord.x, bitMode).rgb).r, edgeFactor * 0.80);
            layerColor.b = mix(layerColor.b, srgbToLinear(unpackRGBA_Dynamic(bCoord.y * width + bCoord.x, bitMode).rgb).b, edgeFactor * 0.80);
        }

        // 3. RGB Directional Warp Shift
        if (u_copiedChromaShift > 0.001) {
            ivec2 cShift = ivec2(int(u_copiedChromaShift * 6.0 * resScale), 0);
            ivec2 rCoord = clamp(coord + cShift, ivec2(0), ivec2(width - 1, height - 1));
            ivec2 bCoord = clamp(coord - cShift, ivec2(0), ivec2(width - 1, height - 1));
            layerColor.r = srgbToLinear(unpackRGBA_Dynamic(rCoord.y * width + rCoord.x, bitMode).rgb).r;
            layerColor.b = srgbToLinear(unpackRGBA_Dynamic(bCoord.y * width + bCoord.x, bitMode).rgb).b;
        }

        // 4. Real Wide Bilateral Denoise
        if (L.denoise > 0.01) {
            vec3 centerCol = layerColor;
            vec3 denoiseSum = centerCol;
            float denoiseWeight = 1.0;
            int dRad = clamp(int(round(L.denoise * 3.0 * resScale)), 1, 5);
            float sigmaSpatial = max(1.5, L.denoise * 4.0);
            float sigmaColor = 0.16;

            for (int dy = -dRad; dy <= dRad; dy++) {
                for (int dx = -dRad; dx <= dRad; dx++) {
                    if (dx == 0 && dy == 0) continue;
                    ivec2 sc = clamp(coord + ivec2(dx, dy), ivec2(0), ivec2(width - 1, height - 1));
                    vec3 scCol = srgbToLinear(unpackRGBA_Dynamic(sc.y * width + sc.x, bitMode).rgb);
                    float spatialDist = float(dx * dx + dy * dy);
                    float colorDist = distance(centerCol, scCol);

                    float w = exp(-spatialDist / (2.0 * sigmaSpatial * sigmaSpatial)) * exp(-(colorDist * colorDist) / (2.0 * sigmaColor * sigmaColor));
                    denoiseSum += scCol * w;
                    denoiseWeight += w;
                }
            }
            layerColor = mix(layerColor, denoiseSum / max(denoiseWeight, 0.001), clamp(L.denoise * 0.90, 0.0, 1.0));
        }

        // 5. Frequency Unsharp Mask
        if (L.unsharpAmount > 0.01) {
            int uRad = int(clamp(L.unsharpRadius * resScale, 1.0, 6.0));
            vec3 lowPass = vec3(0.0);
            float uWeightTotal = 0.0;
            for (int uy = -uRad; uy <= uRad; uy += 2) {
                for (int ux = -uRad; ux <= uRad; ux += 2) {
                    ivec2 uc = clamp(coord + ivec2(ux, uy), ivec2(0), ivec2(width - 1, height - 1));
                    lowPass += srgbToLinear(unpackRGBA_Dynamic(uc.y * width + uc.x, bitMode).rgb);
                    uWeightTotal += 1.0;
                }
            }
            lowPass /= max(uWeightTotal, 1.0);
            vec3 highPass = layerColor - lowPass;
            float diffLum = abs(dot(highPass, vec3(0.2126, 0.7152, 0.0722)));
            if (diffLum >= L.unsharpThreshold) {
                float boost = smoothstep(L.unsharpThreshold, L.unsharpThreshold + 0.10, diffLum);
                layerColor += highPass * (L.unsharpAmount * boost * 1.3);
            }
        }

        // 6. High-Pass Anime Line Acutance Sharpness
        if (L.sharpness > 0.01) {
            vec3 blur = vec3(0.0);
            blur += srgbToLinear(unpackRGBA_Dynamic(clamp(coord.y - edgeStep, 0, height - 1) * width + coord.x, bitMode).rgb);
            blur += srgbToLinear(unpackRGBA_Dynamic(clamp(coord.y + edgeStep, 0, height - 1) * width + coord.x, bitMode).rgb);
            blur += srgbToLinear(unpackRGBA_Dynamic(coord.y * width + clamp(coord.x - edgeStep, 0, width - 1), bitMode).rgb);
            blur += srgbToLinear(unpackRGBA_Dynamic(coord.y * width + clamp(coord.x + edgeStep, 0, width - 1), bitMode).rgb);
            blur *= 0.25;
            vec3 detail = layerColor - blur;
            layerColor += detail * (L.sharpness * 1.5);
        }

        // 7. Cel Line Darkeners
        if (L.darkOutlines > 0.01) {
            float outlineFactor = smoothstep(0.12, 0.40, lineEdge);
            layerColor = mix(layerColor, vec3(0.0), outlineFactor * L.darkOutlines * 0.75);
        }
        if (L.edgeDarken > 0.01) {
            float innerEdge = smoothstep(0.10, 0.45, lineEdge);
            layerColor *= (1.0 - innerEdge * L.edgeDarken * 0.40);
        }

        // 8. Color Temperature
        if (L.temperature > 1000.0 && abs(L.temperature - 6500.0) > 30.0) {
            vec3 tempColor = colorTempToRGB(L.temperature);
            layerColor *= tempColor / colorTempToRGB(6500.0);
        }

        // --- CONVERT TO OKLAB FOR PERCEPTUAL TONAL & COLOR GRADING ---
        vec3 lab = linearRgbToOklab(layerColor);

        // 9. Exposure, Contrast & Shadows (Oklab Lightness - zero hue drift)
        if (abs(L.brightness) > 0.001) lab.x += L.brightness * 0.35;
        if (abs(L.contrast - 1.0) > 0.001) lab.x = (lab.x - 0.50) * L.contrast + 0.50;

        if (L.blackCrush > 0.01) {
            lab.x = smoothstep(L.blackCrush * 0.08, 1.0, lab.x);
        }

        lab.x += lab.x * (L.shadows * (1.0 - smoothstep(0.0, 0.45, lab.x)) * 0.30);
        lab.x += lab.x * (L.highlights * smoothstep(0.55, 1.0, lab.x) * 0.30);
        lab.x = pow(max(lab.x, 0.0), 1.0 / max(L.gamma, 0.001));

        // 10. Magic Mojo II (Oklab Teal & Orange)
        if (L.mblMojoTealOrange > 0.01) {
            float shadowMask = clamp(1.0 - lab.x * 1.8, 0.0, 1.0);
            float warmMask = clamp((lab.x - 0.35) * 1.5, 0.0, 1.0);
            lab.z -= shadowMask * L.mblMojoTealOrange * 0.045;
            lab.y -= shadowMask * L.mblMojoTealOrange * 0.015;
            lab.y += warmMask * L.mblMojoTealOrange * 0.025;
            lab.z += warmMask * L.mblMojoTealOrange * 0.035;
        }

        // 11. Deep Teal
        if (u_deepTeal > 0.01) {
            float deepShadowMask = clamp(1.0 - lab.x * 2.0, 0.0, 1.0);
            lab.z -= deepShadowMask * u_deepTeal * 0.055;
            lab.y -= deepShadowMask * u_deepTeal * 0.025;
        }

        // 12. Colorista 3-Way
        if (abs(L.mblColoristaLift) > 0.001 || abs(L.mblColoristaGamma) > 0.001 || abs(L.mblColoristaGain) > 0.001) {
            lab.x += L.mblColoristaLift * (1.0 - lab.x) * 0.35;
            lab.x = pow(max(0.0, lab.x), 1.0 / max(1.0 + L.mblColoristaGamma * 0.40, 0.01));
            lab.x += L.mblColoristaGain * lab.x * 0.35;
        }

        // 13. Cosmo Skin Protection
        if (L.cosmoCleanHighlight > 0.01) {
            float faceMask = smoothstep(0.50, 0.85, lab.x) * (1.0 - lineEdge);
            lab.yz = mix(lab.yz, lab.yz * 0.85, faceMask * L.cosmoCleanHighlight * 0.40);
        }

        // 14. Monotonic Spline Curves on Lightness (Zero Inversion Risk)
        lab.x = evalCatmullRom(float(lab.x), float(L.curveM0), float(L.curveM1), float(L.curveM2), float(L.curveM3), float(L.curveM4));

        // Magic Curves (Secondary S-Curve on L)
        if (u_magicCurves > 0.01) {
            float s = lab.x * lab.x * (3.0 - 2.0 * lab.x);
            lab.x = mix(lab.x, s, u_magicCurves * 0.50);
        }

        // 15. Saturation & Hue Rotation (Oklab Chroma Plane)
        lab.yz *= L.saturation;
        if (abs(L.hue) > 0.001) {
            lab.yz = oklabRotateHue(lab.yz, L.hue * 3.14159265);
        }

        // Convert back to Linear RGB
        layerColor = oklabToLinearRgb(lab);

        // Optional RGB curve offsets in Linear RGB with strict clamping
        if (abs(L.curveR2 - 0.5) > 0.01 || abs(L.curveG2 - 0.5) > 0.01 || abs(L.curveB2 - 0.5) > 0.01) {
            layerColor.r = evalCatmullRom(layerColor.r, L.curveR0, L.curveR1, L.curveR2, L.curveR3, L.curveR4);
            layerColor.g = clamp(layerColor.g + (L.curveG2 - 0.5) * 0.3, 0.0, 1.0);
            layerColor.b = clamp(layerColor.b + (L.curveB2 - 0.5) * 0.3, 0.0, 1.0);
        }

        // 16. Split Toning
        if (u_splitToneShadowSat > 0.01 || u_splitToneHighSat > 0.01) {
            vec3 sTint = srgbToLinear(hueToRGB(u_splitToneShadowHue));
            vec3 hTint = srgbToLinear(hueToRGB(u_splitToneHighHue));
            float curLuma = dot(layerColor, vec3(0.2126, 0.7152, 0.0722));
            float pivot = clamp(0.5 + u_splitToneBalance * 0.35, 0.1, 0.9);
            layerColor = mix(layerColor, layerColor * (sTint * 1.6 + vec3(0.1)), smoothstep(pivot, 0.0, curLuma) * u_splitToneShadowSat * 0.65);
            layerColor = mix(layerColor, layerColor * (hTint * 1.5 + vec3(0.1)), smoothstep(pivot, 1.0, curLuma) * u_splitToneHighSat * 0.65);
        }

        // 17. 4-Point Star Sparkle Glint
        float curLuma = dot(layerColor, vec3(0.2126, 0.7152, 0.0722));
        if (u_copiedStarGlint > 0.01 && curLuma > 0.72) {
            float glint = 0.0;
            int gSpan = int(clamp(u_copiedStarGlint * 16.0 * resScale, 4.0, 24.0));
            for (int d = -gSpan; d <= gSpan; d += 2) {
                float decay = 1.0 - (abs(float(d)) / float(gSpan));
                ivec2 cCross1 = clamp(coord + ivec2(d, d), ivec2(0), ivec2(width - 1, height - 1));
                ivec2 cCross2 = clamp(coord + ivec2(d, -d), ivec2(0), ivec2(width - 1, height - 1));
                glint += dot(srgbToLinear(unpackRGBA_Dynamic(cCross1.y * width + cCross1.x, bitMode).rgb), vec3(0.333)) * decay;
                glint += dot(srgbToLinear(unpackRGBA_Dynamic(cCross2.y * width + cCross2.x, bitMode).rgb), vec3(0.333)) * decay;
            }
            glint = (glint / float(gSpan * 2)) * u_copiedStarGlint * 0.60;
            layerColor += vec3(glint);
        }

        // 18. TRUE OPTICAL ANAMORPHIC FLARES (Gaussian Spectral Beam with Zero Duplicates)
        if (L.thinStreakIntensity > 0.01 && L.thinStreakOpacity > 0.01) {
            float flareLuma = dot(layerColor, vec3(0.2126, 0.7152, 0.0722));
            float specEnergy = smoothstep(0.82, 0.98, flareLuma);

            if (specEnergy > 0.001) {
                float halfWidth = clamp(L.thinStreakWidth * float(width) * 0.35, 30.0, float(width) * 0.5);
                vec3 flareBeam = vec3(0.0);
                float totalWeight = 0.0;

                vec3 cyanCore = vec3(0.55, 0.90, 1.35);
                vec3 amberEdge = vec3(1.20, 0.75, 0.40);

                for (int step = -18; step <= 18; step++) {
                    float t = float(step) / 18.0;
                    float weight = exp(-3.5 * t * t);
                    float offsetPx = t * halfWidth;

                    ivec2 sampleC = clamp(coord + ivec2(int(offsetPx), 0), ivec2(0), ivec2(width - 1, height - 1));
                    vec3 scCol = srgbToLinear(unpackRGBA_Dynamic(sampleC.y * width + sampleC.x, bitMode).rgb);
                    float scLuma = dot(scCol, vec3(0.2126, 0.7152, 0.0722));

                    if (scLuma > 0.80) {
                        vec3 spectralTint = mix(cyanCore, amberEdge, abs(t));
                        flareBeam += scCol * smoothstep(0.80, 0.98, scLuma) * weight * spectralTint;
                        totalWeight += weight;
                    }
                }

                if (totalWeight > 0.001) {
                    flareBeam = (flareBeam / totalWeight) * (L.thinStreakIntensity * 2.8) * L.thinStreakOpacity;
                    layerColor += flareBeam;
                }
            }
        }

        // 19. Volumetric God Rays
        if (L.bslaGodRays > 0.01) {
            vec2 sunPos = vec2(float(width) * 0.50, float(height) * 0.06);
            vec2 rayDir = normalize(vec2(coord) - sunPos + vec2(0.0001));
            vec3 rayAccum = vec3(0.0);
            float rayWeight = 0.0;
            float stepSize = float(max(width, height)) / 36.0;

            float jitter = hash12(vec2(coord) + vec2(u_time));
            for (int s = 1; s <= 20; s++) {
                float dist = (float(s) + jitter) * stepSize * 0.38;
                ivec2 sc = clamp(ivec2(vec2(coord) - rayDir * dist), ivec2(0), ivec2(width - 1, height - 1));
                vec3 scCol = srgbToLinear(unpackRGBA_Dynamic(sc.y * width + sc.x, bitMode).rgb);
                float scLuma = dot(scCol, vec3(0.2126, 0.7152, 0.0722));

                float shaftMask = smoothstep(0.50, 0.92, scLuma);
                float decay = exp(-0.07 * float(s));
                rayAccum += scCol * shaftMask * decay;
                rayWeight += decay;
            }

            if (rayWeight > 0.001) {
                vec3 shafts = (rayAccum / rayWeight) * (L.bslaGodRays * 2.2);
                layerColor += shafts * vec3(1.15, 1.05, 0.90);
            }
        }

        // 20. Volumetric Fog
        if (L.bslaFogDensity > 0.01) {
            vec2 fuv = vec2(coord) / vec2(width, height);
            float fogAlt = smoothstep(1.0 - L.bslaFogDepth, 0.0, fuv.y);
            vec3 mistColor = srgbToLinear(vec3(0.68, 0.75, 0.82)) * (1.0 + L.bslaBloomHaze * 0.5);
            float fogAmount = L.bslaFogDensity * (0.25 + 0.75 * fogAlt);
            layerColor = mix(layerColor, mistColor, clamp(fogAmount, 0.0, 0.65));
        }

        // 21. Pro-Mist & Halation
        if (L.halationRadius > 0.01 || u_copiedProMist > 0.01) {
            float mistStrength = max(L.halationRadius, u_copiedProMist);
            float redBleed = smoothstep(0.55, 0.95, curLuma) * mistStrength * 0.25;
            layerColor.r += redBleed * (1.0 + L.halationWarmth * 0.40);
            layerColor.g += redBleed * (0.20 + L.halationWarmth * 0.10);
        }

        // 22. Film Grain
        if (L.filmGrain > 0.001) {
            float noise = (hash12(vec2(coord) + vec2(u_time * 17.13, u_time * 31.37)) - 0.5);
            layerColor += vec3(noise * L.filmGrain * 0.06);
        }

        // 23. Micro-Pulse / Flicker
        if (L.flickerIntensity > 0.005) {
            float freq = max(L.flickerSpeed, 1.0) * 6.2831853;
            float fWave = sin(u_time * freq) * 0.5 + 0.5;
            layerColor *= (1.0 + (fWave - 0.5) * L.flickerIntensity * 0.30);
        }

        // 24. Radial & Boxed Vignettes
        if (L.vignette > 0.01) {
            vec2 vuv = (vec2(coord) / vec2(width, height)) - 0.5;
            layerColor *= clamp(smoothstep(0.75, 0.15, length(vuv) * (0.7 + L.vignette * 0.8)), 0.0, 1.0);
        }
        if (L.vignetteBoxed > 0.01) {
            vec2 buv = abs((vec2(coord) / vec2(width, height)) - 0.5) * 2.0;
            layerColor *= clamp(smoothstep(0.95, 0.20, max(buv.x, buv.y) * (0.7 + L.vignetteBoxed * 0.8)), 0.0, 1.0);
        }

        // 25. Centre Aura & Horizontal Ramp
        vec2 auv = vec2(coord) / vec2(width, height);
        if (L.centerAura > 0.01) {
            layerColor += vec3(smoothstep(0.60, 0.0, length(auv - 0.5)) * L.centerAura * 0.30);
        }
        if (u_horizontalRamp > 0.01) {
            layerColor *= (1.0 + smoothstep(0.35, 0.65, auv.y) * u_horizontalRamp * 0.30);
        }

        // Physical Layer Composite in Linear Space
        currentComposite = applyBlendModeLinear(currentComposite, layerColor, int(L.blendMode), L.opacity);
    }

    // 26. ISOLATED TEXT SUITE METALLIC BEVEL
    if (u_textSuiteEnabled > 0.5) {
        vec2 normCoord = vec2(coord) / vec2(width, height);
        bool inBox = (normCoord.x >= u_textBoxX && normCoord.x <= (u_textBoxX + u_textBoxW) &&
                      normCoord.y >= u_textBoxY && normCoord.y <= (u_textBoxY + u_textBoxH));

        if (inBox) {
            float textLuma = dot(currentComposite, vec3(0.2126, 0.7152, 0.0722));
            float textMask = smoothstep(0.50, 0.80, textLuma) * smoothstep(0.08, 0.40, lineEdge);

            if (textMask > 0.01) {
                vec3 N = normalize(vec3(edgeNormal.x * (u_textBevelDepth * resScale), edgeNormal.y * (u_textBevelDepth * resScale), 1.0));
                vec3 L_dir = normalize(vec3(0.35, -0.65, 0.65));
                float reflY = clamp(N.y * 0.5 + 0.5, 0.0, 1.0);
                float chromeReflection = pow(sin(reflY * 6.28318) * 0.5 + 0.5, 2.0) * u_textChromeIntensity;

                vec3 V = vec3(0.0, 0.0, 1.0);
                vec3 H = normalize(L_dir + V);
                float spec = pow(max(0.0, dot(N, H)), 24.0) * 1.8;

                vec3 chromeColor = mix(srgbToLinear(vec3(0.12, 0.14, 0.18)), srgbToLinear(vec3(0.95, 0.98, 1.05)), chromeReflection) + vec3(spec);
                currentComposite = mix(currentComposite, chromeColor, textMask * 0.90);
            }
        }
    }

    // 27. 3D LUT APPLICATION
    if (u_hasLut > 0.5) {
        currentComposite = sample3DLut(currentComposite, u_lutOpacity);
    }

    // Store linear composite into OutputBuffer for bloom & final composite pass
    packRGBA_Dynamic(pixelIndex, vec4(currentComposite, rawPixel.a), bitMode);
}
