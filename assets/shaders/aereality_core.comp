#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputBuffer {
    uint in_pixels[];
};

layout(std430, binding = 1) writeonly buffer OutputBuffer {
    uint out_pixels[];
};

// 3D LUT Table: 32 x 32 x 32 = 32,768 RGB triplets (98,304 floats)
layout(std430, binding = 3) readonly buffer LutBuffer {
    float lut_table[];
};

// Struct layout matching main.dart packUniforms exactly (64 floats = 256 bytes per layer)
struct LayerData {
    // Offset 0..3 (16 bytes)
    float isEnabled;              // 0: Disabled, 1: Enabled
    float opacity;                // 0.0 to 1.0
    float blendMode;              // 0:Normal, 1:Screen, 2:Linear Add, 3:Overlay, 4:Soft Light, 5:Multiply
    float brightness;             // -0.8 to +0.8 (Photographic Exposure Stops)

    // Offset 4..7 (16 bytes)
    float saturation;             // 0.0 to 2.5
    float contrast;               // 0.2 to 2.5 (0.18 Mid-Gray Pivot)
    float sharpness;              // 0.0 to 2.0
    float gamma;                  // 0.2 to 2.5

    // Offset 8..11 (16 bytes)
    float hue;                    // -3.14159 to +3.14159 (Hue / Color shift)
    float temperature;            // Kelvin (2000 to 12000)
    float deepGlowIntensity;      // 0.0 to 2.0 (Continuous Multi-Octave Bloom)
    float deepGlowRadius;         // 0.0 to 1.0 (Bloom Spread)

    // Offset 12..15 (16 bytes)
    float deepGlowThreshold;      // 0.10 to 0.95 (Soft knee luminance gate)
    float edgeGlowTint;           // 0:Natural, 1:Gold, 2:Cyan, 3:Amber, 4:Crimson, 5:Violet, 6:Pink
    float thinStreakIntensity;    // 0.0 to 2.0 (Amanai Flare Intensity)
    float thinStreakWidth;        // 0.05 to 2.0 (Amanai Flare Width)

    // Offset 16..19 (16 bytes)
    float lineChromaStrength;     // 0.0 to 1.0 (True Edge-Normal Chromatic Aberration)
    float volRaysLength;          // 0.0 to 1.0 (Volumetric Light Rays)
    float volRaysDecay;           // 0.70 to 0.98
    float shadows;                // -1.0 to 1.0

    // Offset 20..23 (16 bytes)
    float highlights;             // -1.0 to 1.0
    float blackCrush;             // 0.0 to 0.5
    float vignette;               // 0.0 to 1.0 (Radial)
    float vignetteBoxed;          // 0.0 to 1.0 (Boxed)

    // Offset 24..27 (16 bytes)
    float edgeDarken;             // 0.0 to 1.0 (Line Art Interior Shadow)
    float darkOutlines;           // 0.0 to 1.0 (Sobel Outline Darkener)
    float denoise;                // 0.0 to 1.0 (Bilateral Edge-Preserving Filter)
    float filmGrain;              // 0.0 to 0.3

    // Offset 28..31 (16 bytes)
    float flickerIntensity;       // 0.0 to 1.0
    float flickerSpeed;           // 1.0 to 20.0 (Hz)
    float halationRadius;         // 0.0 to 1.5
    float halationWarmth;         // 0.0 to 1.5

    // Offset 32..35 (16 bytes)
    float depthOfField;           // 0.0 to 1.0 (Directional Tilt-Shift DoF)
    float dofFocus;               // 0.0 to 1.0 (Focal Center Y)
    float dofAngle;               // 0.0 to 3.1415 (Directional Blur Angle)
    float unsharpRadius;          // 0.0 to 5.0

    // Offset 36..39 (16 bytes)
    float unsharpAmount;          // 0.0 to 2.0
    float unsharpThreshold;       // 0.0 to 0.5
    float curveM0;
    float curveM1;

    // Offset 40..43 (16 bytes)
    float curveM2;
    float curveM3;
    float curveM4;
    float curveR0;

    // Offset 44..47 (16 bytes)
    float curveR1;
    float curveR2;
    float curveR3;
    float curveR4;

    // Offset 48..51 (16 bytes)
    float curveG2;                // Green Midtone Pivot
    float curveB2;                // Blue Midtone Pivot
    float sapphireGlowWidth;      // 0.0 to 2.0 (Sapphire Specular Intensity & Spread)
    float sapphireGlowThreshold;  // 0.20 to 0.95 (Sapphire Threshold Knee)

    // Offset 52..55 (16 bytes)
    float thinStreakOpacity;      // 0.0 to 1.0 (Amanai Flare Opacity)
    float mblMojoTealOrange;      // Magic: Mojo II Teal/Orange
    float bslaGodRays;            // Sildurs Vibrant Extreme God Rays
    float bslaFogDensity;         // Atmospheric Fog Density

    // Offset 56..59 (16 bytes)
    float bslaFogDepth;           // Fog Altitude & Distance Falloff
    float bslaBloomHaze;          // Volumetric Mist Scatter
    float bslFogScatter;          // Liminal Atmosphere Scattering
    float cosmoCleanHighlight;    // Magic: Cosmo Clean Highlights

    // Offset 60..63 (16 bytes)
    float mblColoristaLift;       // Magic: Colorista Lift (Shadows)
    float mblColoristaGamma;      // Magic: Colorista Gamma (Midtones)
    float mblColoristaGain;       // Magic: Colorista Gain (Highlights)
    float centerAura;             // Glow & Flares: Centre Aura
};

layout(std430, binding = 2) readonly buffer UniformBlock {
    float u_time;
    float u_layerCount;
    float u_tonemapMode;          // 0: Off, 1: Shaderly Tonemapper 1 (Filmic ACES), 2: Shaderly Tonemapper 2 (AgX)
    float u_imgWidth;
    float u_imgHeight;
    float u_hasLut;               // 1.0 if 3D LUT is bound
    float u_lutOpacity;           // 0.0 to 1.0
    float u_copiedChromaShift;    // RGB Directional Warp Shift
    float u_copiedEdgeRays;       // Sapphire Edge Detect Glow
    float u_copiedProMist;        // Diffusion Pro-Mist Halation
    float u_copiedStarGlint;      // 4-Point Star Sparkle Glint
    float u_horizontalRamp;       // Glow & Flares: Horizontal Ramp
    float u_ditherStrength;       // Anti-Banding TPDF / IGN Dither Strength
    
    // Text Suite Parameters (Dedicated Isolated Region)
    float u_textSuiteEnabled;     // 1.0 if enabled
    float u_textBoxX;             // Normalized X [0.0..1.0]
    float u_textBoxY;             // Normalized Y [0.0..1.0]
    float u_textBoxW;             // Normalized Width [0.0..1.0]
    float u_textBoxH;             // Normalized Height [0.0..1.0]
    float u_textBevelDepth;       // Bevel depth
    float u_textChromeIntensity;  // Metallic reflection strength

    // New Shaderly Glow & Split Toning Global Uniforms (Packed in extensions)
    float u_shaderlyGlowIntensity;
    float u_shaderlyGlowRadius;
    float u_shaderlyGlowThreshold;
    float u_splitToneShadowHue;
    float u_splitToneShadowSat;
    float u_splitToneHighHue;
    float u_splitToneHighSat;
    float u_splitToneBalance;

    LayerData layers[4];
};

vec4 unpackRGBA(uint val) {
    float r = float(val & 0xFFu) / 255.0;
    float g = float((val >> 8u) & 0xFFu) / 255.0;
    float b = float((val >> 16u) & 0xFFu) / 255.0;
    float a = float((val >> 24u) & 0xFFu) / 255.0;
    return vec4(r, g, b, a);
}

// Fixed: Rounding + 0.5 completely prevents 8-bit truncation quantization banding
uint packRGBA(vec4 col) {
    uint r = uint(clamp(col.r * 255.0 + 0.5, 0.0, 255.0));
    uint g = uint(clamp(col.g * 255.0 + 0.5, 0.0, 255.0));
    uint b = uint(clamp(col.b * 255.0 + 0.5, 0.0, 255.0));
    uint a = uint(clamp(col.a * 255.0 + 0.5, 0.0, 255.0));
    return (a << 24u) | (b << 16u) | (g << 8u) | r;
}

vec3 sRGBToLinear(vec3 c) {
    return mix(c / 12.92, pow((c + vec3(0.055)) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

vec3 linearToSRGB(vec3 c) {
    c = max(c, vec3(0.0));
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

// Adevob-style Highlight Compression Curve (Soft Knee - preserves rich highlight textures)
vec3 compressShoulder(vec3 c) {
    return c / (vec3(1.0) + c * 0.25);
}

// Interleaved Gradient Noise for artifact-free mobile dithering
float interleavedGradientNoise(vec2 screenPos) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(magic.z * fract(dot(screenPos, magic.xy)));
}

// HSV to RGB for Split Toning
vec3 hueToRGB(float h) {
    float r = abs(h * 6.0 - 3.0) - 1.0;
    float g = 2.0 - abs(h * 6.0 - 2.0);
    float b = 2.0 - abs(h * 6.0 - 4.0);
    return clamp(vec3(r, g, b), 0.0, 1.0);
}

vec3 tonemapACES(vec3 x) {
    vec3 lin = sRGBToLinear(clamp(x, 0.0, 10.0));
    float a = 2.51;
    float b = 0.03;
    float c = 2.43;
    float d = 0.59;
    float e = 0.14;
    vec3 mapped = (lin * (a * lin + b)) / (lin * (c * lin + d) + e);
    return linearToSRGB(clamp(mapped, 0.0, 1.0));
}

vec3 tonemapAgX(vec3 x) {
    vec3 lin = sRGBToLinear(clamp(x, 0.0, 10.0));
    // AgX Pearlescent curve - protects saturated highlights from clipping to flat white
    vec3 mapped = (lin * (lin + vec3(0.0245786)) - vec3(0.000090537)) /
                  (lin * (0.983729 * lin + vec3(0.4329510)) + vec3(0.238081));
    return linearToSRGB(clamp(mapped, 0.0, 1.0));
}

vec3 sample3DLut(vec3 color, float opacity) {
    if (opacity <= 0.001) return color;

    vec3 coord = clamp(color, 0.0, 1.0) * 31.0;
    ivec3 c0 = clamp(ivec3(floor(coord)), ivec3(0), ivec3(31));
    ivec3 c1 = clamp(c0 + ivec3(1), ivec3(0), ivec3(31));
    vec3 f = fract(coord);

    #define LUT_IDX(r, g, b) (((b) * 1024 + (g) * 32 + (r)) * 3)

    int idx000 = LUT_IDX(c0.x, c0.y, c0.z);
    int idx100 = LUT_IDX(c1.x, c0.y, c0.z);
    int idx010 = LUT_IDX(c0.x, c1.y, c0.z);
    int idx110 = LUT_IDX(c1.x, c1.y, c0.z);
    int idx001 = LUT_IDX(c0.x, c0.y, c1.z);
    int idx101 = LUT_IDX(c1.x, c0.y, c1.z);
    int idx011 = LUT_IDX(c0.x, c1.y, c1.z);
    int idx111 = LUT_IDX(c1.x, c1.y, c1.z);

    vec3 s000 = vec3(lut_table[idx000], lut_table[idx000 + 1], lut_table[idx000 + 2]);
    vec3 s100 = vec3(lut_table[idx100], lut_table[idx100 + 1], lut_table[idx100 + 2]);
    vec3 s010 = vec3(lut_table[idx010], lut_table[idx010 + 1], lut_table[idx010 + 2]);
    vec3 s110 = vec3(lut_table[idx110], lut_table[idx110 + 1], lut_table[idx110 + 2]);
    vec3 s001 = vec3(lut_table[idx001], lut_table[idx001 + 1], lut_table[idx001 + 2]);
    vec3 s101 = vec3(lut_table[idx101], lut_table[idx101 + 1], lut_table[idx101 + 2]);
    vec3 s011 = vec3(lut_table[idx011], lut_table[idx011 + 1], lut_table[idx011 + 2]);
    vec3 s111 = vec3(lut_table[idx111], lut_table[idx111 + 1], lut_table[idx111 + 2]);

    vec3 s00 = mix(s000, s100, f.x);
    vec3 s01 = mix(s001, s101, f.x);
    vec3 s10 = mix(s010, s110, f.x);
    vec3 s11 = mix(s011, s111, f.x);
    vec3 s0 = mix(s00, s10, f.y);
    vec3 s1 = mix(s01, s11, f.y);

    return mix(color, mix(s0, s1, f.z), opacity);
}

// Clamped tangent Catmull-Rom (eliminates color inversion / solarization bugs)
float evalCatmullRom(float x, float p0, float p1, float p2, float p3, float p4) {
    x = clamp(x, 0.0, 1.0);
    float seg = x * 4.0;
    int idx = int(floor(seg));
    if (idx >= 4) return p4;
    float t = seg - float(idx);

    float cp0 = (idx == 0) ? p0 : (idx == 1) ? p0 : (idx == 2) ? p1 : p2;
    float cp1 = (idx == 0) ? p0 : (idx == 1) ? p1 : (idx == 2) ? p2 : p3;
    float cp2 = (idx == 0) ? p1 : (idx == 1) ? p2 : (idx == 2) ? p3 : p4;
    float cp3 = (idx == 0) ? p2 : (idx == 1) ? p3 : (idx == 2) ? p4 : p4;

    float m1 = clamp(0.5 * (cp2 - cp0), -1.2, 1.2);
    float m2 = clamp(0.5 * (cp3 - cp1), -1.2, 1.2);
    float t2 = t * t;
    float t3 = t2 * t;

    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;

    return clamp(h00 * cp1 + h10 * m1 + h01 * cp2 + h11 * m2, 0.0, 1.0);
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec3 colorTempToRGB(float kelvin) {
    if (kelvin < 1000.0) return vec3(1.0);
    float temp = kelvin / 100.0;
    float red, green, blue;

    if (temp <= 66.0) {
        red = 255.0;
        green = temp;
        green = 99.4708025861 * log(max(green, 1.0)) - 161.1195681661;
        if (temp <= 19.0) {
            blue = 0.0;
        } else {
            blue = temp - 10.0;
            blue = 138.5177312231 * log(max(blue, 1.0)) - 305.0447927307;
        }
    } else {
        red = temp - 60.0;
        red = 329.698727446 * pow(max(red, 1.0), -0.1332047592);
        green = temp - 60.0;
        green = 288.1221695283 * pow(max(green, 1.0), -0.0755148492);
        blue = 255.0;
    }

    return clamp(vec3(red, green, blue) / 255.0, 0.0, 1.0);
}

vec3 applyBlendMode(vec3 baseCol, vec3 blendCol, int mode, float opacity) {
    vec3 result = blendCol;
    if (mode == 1) { // Screen
        result = 1.0 - (1.0 - baseCol) * (1.0 - clamp(blendCol, 0.0, 1.0));
    } else if (mode == 2) { // Linear Add (clamped)
        result = baseCol + blendCol * 0.8;
    } else if (mode == 3) { // Overlay
        result = mix(2.0 * baseCol * blendCol, 1.0 - 2.0 * (1.0 - baseCol) * (1.0 - blendCol), step(vec3(0.5), baseCol));
    } else if (mode == 4) { // Soft Light (metallic clean blend)
        result = (1.0 - 2.0 * blendCol) * baseCol * baseCol + 2.0 * blendCol * baseCol;
    } else if (mode == 5) { // Multiply
        result = baseCol * blendCol;
    }
    return mix(baseCol, clamp(result, 0.0, 1.0), clamp(opacity, 0.0, 1.0));
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    int width = int(u_imgWidth > 0.0 ? u_imgWidth : gl_NumWorkGroups.x * gl_WorkGroupSize.x);
    int height = int(u_imgHeight > 0.0 ? u_imgHeight : gl_NumWorkGroups.y * gl_WorkGroupSize.y);

    if (coord.x >= width || coord.y >= height) return;

    int pixelIndex = coord.y * width + coord.x;
    vec4 basePixel = unpackRGBA(in_pixels[pixelIndex]);
    vec3 currentComposite = basePixel.rgb;

    // Sobel line detection & Edge Normal vectors
    float gx = 0.0, gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 c = clamp(coord + ivec2(x, y), ivec2(0), ivec2(width - 1, height - 1));
            vec4 p = unpackRGBA(in_pixels[c.y * width + c.x]);
            float lum = dot(p.rgb, vec3(0.2126, 0.7152, 0.0722));
            float kx = float(x) * ((y == 0) ? 2.0 : 1.0);
            float ky = float(y) * ((x == 0) ? 2.0 : 1.0);
            gx += lum * kx;
            gy += lum * ky;
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);
    vec2 edgeNormal = (lineEdge > 0.05) ? normalize(vec2(gx, gy)) : vec2(0.0);

    int totalLayers = int(clamp(u_layerCount, 0.0, 4.0));

    if (totalLayers <= 0) {
        if (u_hasLut > 0.5) currentComposite = sample3DLut(currentComposite, u_lutOpacity);
        if (u_tonemapMode == 1.0) currentComposite = tonemapACES(currentComposite);
        else if (u_tonemapMode == 2.0) currentComposite = tonemapAgX(currentComposite);
        
        if (u_ditherStrength > 0.01) {
            float ign = interleavedGradientNoise(vec2(coord));
            float dither = (ign - 0.5) / 255.0 * u_ditherStrength;
            currentComposite += vec3(dither);
        }
        out_pixels[pixelIndex] = packRGBA(vec4(currentComposite, basePixel.a));
        return;
    }

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;

        // TRUE LAYER ACCUMULATION: Layer operates on accumulated composite
        vec3 layerColor = currentComposite;

        // 1. DIRECTIONAL TILT-SHIFT DEPTH OF FIELD
        if (L.depthOfField > 0.01) {
            float normY = float(coord.y) / float(height);
            float dofDist = abs(normY - L.dofFocus);
            float dofBlurAmt = smoothstep(0.10, 0.45, dofDist) * L.depthOfField * 6.0;
            if (dofBlurAmt > 0.5) {
                vec2 dofDir = vec2(cos(L.dofAngle), sin(L.dofAngle));
                vec3 dofSum = layerColor;
                float dofTotal = 1.0;
                for (int step = 1; step <= 4; step++) {
                    ivec2 dOffset = ivec2(dofDir * (float(step) * (dofBlurAmt / 4.0)));
                    ivec2 dP1 = clamp(coord + dOffset, ivec2(0), ivec2(width - 1, height - 1));
                    ivec2 dP2 = clamp(coord - dOffset, ivec2(0), ivec2(width - 1, height - 1));
                    dofSum += unpackRGBA(in_pixels[dP1.y * width + dP1.x]).rgb;
                    dofSum += unpackRGBA(in_pixels[dP2.y * width + dP2.x]).rgb;
                    dofTotal += 2.0;
                }
                layerColor = dofSum / dofTotal;
            }
        }

        // 2. TRUE EDGE-NORMAL CHROMATIC ABERRATION
        if (L.lineChromaStrength > 0.001 && lineEdge > 0.05) {
            float edgeFactor = smoothstep(0.08, 0.35, lineEdge);
            ivec2 shift = ivec2(edgeNormal * (L.lineChromaStrength * 3.0));
            ivec2 rCoord = clamp(coord + shift, ivec2(0), ivec2(width - 1, height - 1));
            ivec2 bCoord = clamp(coord - shift, ivec2(0), ivec2(width - 1, height - 1));
            layerColor.r = mix(layerColor.r, unpackRGBA(in_pixels[rCoord.y * width + rCoord.x]).r, edgeFactor * 0.80);
            layerColor.b = mix(layerColor.b, unpackRGBA(in_pixels[bCoord.y * width + bCoord.x]).b, edgeFactor * 0.80);
        }

        // 3. RGB Directional Warp Shift
        if (u_copiedChromaShift > 0.001) {
            ivec2 cShift = ivec2(int(u_copiedChromaShift * 6.0), 0);
            ivec2 rCoord = clamp(coord + cShift, ivec2(0), ivec2(width - 1, height - 1));
            ivec2 bCoord = clamp(coord - cShift, ivec2(0), ivec2(width - 1, height - 1));
            layerColor.r = unpackRGBA(in_pixels[rCoord.y * width + rCoord.x]).r;
            layerColor.b = unpackRGBA(in_pixels[bCoord.y * width + bCoord.x]).b;
        }

        // 4. REAL BILATERAL EDGE-PRESERVING DENOISE
        if (L.denoise > 0.01) {
            vec3 centerCol = layerColor;
            vec3 denoiseSum = centerCol;
            float denoiseWeight = 1.0;
            float sigmaSpatial = max(1.5, L.denoise * 3.5);
            float sigmaColor = 0.12;

            for (int dy = -2; dy <= 2; dy++) {
                for (int dx = -2; dx <= 2; dx++) {
                    if (dx == 0 && dy == 0) continue;
                    ivec2 sc = clamp(coord + ivec2(dx, dy), ivec2(0), ivec2(width - 1, height - 1));
                    vec3 scCol = unpackRGBA(in_pixels[sc.y * width + sc.x]).rgb;
                    float spatialDist = float(dx * dx + dy * dy);
                    float colorDist = distance(centerCol, scCol);

                    float w = exp(-spatialDist / (2.0 * sigmaSpatial * sigmaSpatial)) * exp(-(colorDist * colorDist) / (2.0 * sigmaColor * sigmaColor));
                    denoiseSum += scCol * w;
                    denoiseWeight += w;
                }
            }
            layerColor = mix(layerColor, denoiseSum / max(denoiseWeight, 0.001), clamp(L.denoise * 0.85, 0.0, 1.0));
        }

        // 5. Frequency Unsharp Mask
        if (L.unsharpAmount > 0.01) {
            int uRad = int(clamp(L.unsharpRadius, 1.0, 4.0));
            vec3 lowPass = vec3(0.0);
            float uWeightTotal = 0.0;
            for (int uy = -uRad; uy <= uRad; uy++) {
                for (int ux = -uRad; ux <= uRad; ux++) {
                    ivec2 uc = clamp(coord + ivec2(ux, uy), ivec2(0), ivec2(width - 1, height - 1));
                    lowPass += unpackRGBA(in_pixels[uc.y * width + uc.x]).rgb;
                    uWeightTotal += 1.0;
                }
            }
            lowPass /= max(uWeightTotal, 1.0);
            vec3 highPass = layerColor - lowPass;
            float diffLum = abs(dot(highPass, vec3(0.2126, 0.7152, 0.0722)));
            if (diffLum >= L.unsharpThreshold) {
                float boost = smoothstep(L.unsharpThreshold, L.unsharpThreshold + 0.10, diffLum);
                layerColor += highPass * (L.unsharpAmount * boost);
            }
        }

        // 6. High-Pass Anime Acutance Sharpness (Adevob steel lines)
        if (L.sharpness > 0.01) {
            vec3 blur = vec3(0.0);
            blur += unpackRGBA(in_pixels[clamp(coord.y - 1, 0, height - 1) * width + coord.x]).rgb;
            blur += unpackRGBA(in_pixels[clamp(coord.y + 1, 0, height - 1) * width + coord.x]).rgb;
            blur += unpackRGBA(in_pixels[coord.y * width + clamp(coord.x - 1, 0, width - 1)]).rgb;
            blur += unpackRGBA(in_pixels[coord.y * width + clamp(coord.x + 1, 0, width - 1)]).rgb;
            blur *= 0.25;
            vec3 detail = layerColor - blur;
            layerColor += detail * (L.sharpness * 1.6);
        }

        // 7. Sobel Darkeners
        if (L.darkOutlines > 0.01) {
            float outlineFactor = smoothstep(0.12, 0.40, lineEdge);
            layerColor = mix(layerColor, vec3(0.0), outlineFactor * L.darkOutlines * 0.75);
        }
        if (L.edgeDarken > 0.01) {
            float innerEdge = smoothstep(0.10, 0.45, lineEdge);
            layerColor *= (1.0 - innerEdge * L.edgeDarken * 0.40);
        }

        // 8. Color Temperature
        if (L.temperature > 1000.0 && abs(L.temperature - 6500.0) > 30.0) {
            vec3 tempColor = colorTempToRGB(L.temperature);
            layerColor *= tempColor / colorTempToRGB(6500.0);
        }

        // 9. Photographic Exposure Stops & Contrast Pivot
        if (abs(L.brightness) > 0.001) {
            layerColor *= pow(2.0, L.brightness * 1.5);
        }
        layerColor = (layerColor - 0.18) * L.contrast + 0.18;

        if (L.blackCrush > 0.01) {
            layerColor = smoothstep(vec3(L.blackCrush * 0.08), vec3(1.0), layerColor);
        }

        float luma = dot(layerColor, vec3(0.2126, 0.7152, 0.0722));
        float sWeight = 1.0 - smoothstep(0.0, 0.45, luma);
        layerColor += layerColor * (L.shadows * sWeight * 0.30);

        float hWeight = smoothstep(0.55, 1.0, luma);
        layerColor += layerColor * (L.highlights * hWeight * 0.30);
        layerColor = pow(max(layerColor, vec3(0.0)), vec3(1.0 / max(L.gamma, 0.001)));

        // 10. Magic Mojo II (Teal / Orange Split)
        if (L.mblMojoTealOrange > 0.01) {
            float shadowMask = clamp(1.0 - luma * 1.5, 0.0, 1.0);
            float warmMask = clamp((luma - 0.40) * 1.6, 0.0, 1.0);
            vec3 tealTint = vec3(0.48, 0.86, 1.12);
            vec3 orangeTint = vec3(1.18, 0.96, 0.74);
            layerColor = mix(layerColor, layerColor * tealTint, shadowMask * L.mblMojoTealOrange * 0.35);
            layerColor = mix(layerColor, layerColor * orangeTint, warmMask * L.mblMojoTealOrange * 0.28);
        }

        // 11. Magic Colorista 3-Way
        if (abs(L.mblColoristaLift) > 0.001 || abs(L.mblColoristaGamma) > 0.001 || abs(L.mblColoristaGain) > 0.001) {
            layerColor += vec3(L.mblColoristaLift) * (1.0 - luma) * 0.6;
            layerColor = pow(max(layerColor, vec3(0.0)), vec3(1.0 / max(1.0 + L.mblColoristaGamma * 0.5, 0.01)));
            layerColor += vec3(L.mblColoristaGain) * luma * 0.6;
        }

        // 12. Cosmo Clean Highlights (Face and Skin Protection)
        if (L.cosmoCleanHighlight > 0.01) {
            float faceMask = smoothstep(0.50, 0.85, luma) * (1.0 - lineEdge);
            float skinLuma = dot(layerColor, vec3(0.2126, 0.7152, 0.0722));
            vec3 neutralHighlight = mix(layerColor, vec3(skinLuma), 0.30);
            layerColor = mix(layerColor, neutralHighlight, faceMask * L.cosmoCleanHighlight * 0.45);
        }

        // 13. Spline Curves (Safe Clamped Catmull-Rom)
        layerColor.r = evalCatmullRom(layerColor.r, L.curveR0, L.curveR1, L.curveR2, L.curveR3, L.curveR4);
        layerColor.g = mix(layerColor.g, L.curveG2, 0.15 * (L.curveG2 - 0.5));
        layerColor.b = mix(layerColor.b, L.curveB2, 0.15 * (L.curveB2 - 0.5));
        layerColor.r = evalCatmullRom(layerColor.r, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);
        layerColor.g = evalCatmullRom(layerColor.g, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);
        layerColor.b = evalCatmullRom(layerColor.b, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);

        // 14. Saturation & Full RGB Hue Shift
        luma = dot(layerColor, vec3(0.2126, 0.7152, 0.0722));
        layerColor = mix(vec3(luma), layerColor, L.saturation);

        if (abs(L.hue) > 0.001) {
            float angle = L.hue * 3.14159265;
            float cosA = cos(angle);
            float sinA = sin(angle);
            mat3 hueMat = mat3(
                vec3(0.213 + cosA*0.787 - sinA*0.213, 0.715 - cosA*0.715 - sinA*0.715, 0.072 - cosA*0.072 + sinA*0.928),
                vec3(0.213 - cosA*0.213 + sinA*0.143, 0.715 + cosA*0.285 + sinA*0.140, 0.072 - cosA*0.072 - sinA*0.283),
                vec3(0.213 - cosA*0.213 - sinA*0.787, 0.715 - cosA*0.715 + sinA*0.715, 0.072 + cosA*0.928 + sinA*0.072)
            );
            layerColor = clamp(hueMat * layerColor, 0.0, 1.0);
        }

        // 15. SPLIT TONING
        if (u_splitToneShadowSat > 0.01 || u_splitToneHighSat > 0.01) {
            vec3 sTint = hueToRGB(u_splitToneShadowHue);
            vec3 hTint = hueToRGB(u_splitToneHighHue);
            float pivot = clamp(0.5 + u_splitToneBalance * 0.35, 0.1, 0.9);
            float sFac = smoothstep(pivot, 0.0, luma) * u_splitToneShadowSat * 0.40;
            float hFac = smoothstep(pivot, 1.0, luma) * u_splitToneHighSat * 0.40;
            layerColor = mix(layerColor, layerColor * sTint * 1.4, sFac);
            layerColor = mix(layerColor, layerColor * hTint * 1.3, hFac);
        }

        // 16. SAPPHIRE S_EDGERAYS
        if (u_copiedEdgeRays > 0.01) {
            vec3 edgeBloom = vec3(0.0);
            float edgeWeight = 0.0;
            float rayRadius = max(1.5, u_copiedEdgeRays * 4.5);

            for (int r = 1; r <= 3; r++) {
                float d = float(r) * (rayRadius / 3.0);
                float w = exp(-float(r) * 0.85);

                ivec2 pE = clamp(coord + ivec2(int(d), 0), ivec2(0), ivec2(width - 1, height - 1));
                ivec2 pW = clamp(coord - ivec2(int(d), 0), ivec2(0), ivec2(width - 1, height - 1));
                ivec2 pN = clamp(coord + ivec2(0, int(d)), ivec2(0), ivec2(width - 1, height - 1));
                ivec2 pS = clamp(coord - ivec2(0, int(d)), ivec2(0), ivec2(width - 1, height - 1));

                edgeBloom += unpackRGBA(in_pixels[pE.y * width + pE.x]).rgb * w;
                edgeBloom += unpackRGBA(in_pixels[pW.y * width + pW.x]).rgb * w;
                edgeBloom += unpackRGBA(in_pixels[pN.y * width + pN.x]).rgb * w;
                edgeBloom += unpackRGBA(in_pixels[pS.y * width + pS.x]).rgb * w;
                edgeWeight += w * 4.0;
            }

            float rimFactor = smoothstep(0.08, 0.40, lineEdge) * smoothstep(0.40, 0.90, luma);
            vec3 specularRim = (edgeBloom / max(edgeWeight, 0.001)) * (u_copiedEdgeRays * 1.10) * rimFactor;
            layerColor = 1.0 - (1.0 - layerColor) * (1.0 - clamp(specularRim, 0.0, 0.80));
        }

        // 17. 4-POINT STAR SPARKLE GLINT
        if (u_copiedStarGlint > 0.01) {
            if (luma > 0.70) {
                float glint = 0.0;
                int gSpan = int(clamp(u_copiedStarGlint * 16.0, 4.0, 22.0));
                for (int d = -gSpan; d <= gSpan; d += 2) {
                    float decay = 1.0 - (abs(float(d)) / float(gSpan));
                    ivec2 cCross1 = clamp(coord + ivec2(d, d), ivec2(0), ivec2(width - 1, height - 1));
                    ivec2 cCross2 = clamp(coord + ivec2(d, -d), ivec2(0), ivec2(width - 1, height - 1));
                    glint += dot(unpackRGBA(in_pixels[cCross1.y * width + cCross1.x]).rgb, vec3(0.333)) * decay;
                    glint += dot(unpackRGBA(in_pixels[cCross2.y * width + cCross2.x]).rgb, vec3(0.333)) * decay;
                }
                glint = (glint / float(gSpan * 2)) * u_copiedStarGlint * 0.60;
                layerColor += vec3(glint);
            }
        }

        // 18. CONTINUOUS MULTI-OCTAVE DEEP GLOW
        if (L.deepGlowIntensity > 0.01) {
            vec3 glowTint = vec3(1.0);
            if (L.edgeGlowTint == 1.0) glowTint = vec3(1.20, 1.05, 0.65);
            else if (L.edgeGlowTint == 2.0) glowTint = vec3(0.40, 1.10, 1.45);
            else if (L.edgeGlowTint == 3.0) glowTint = vec3(1.25, 0.85, 0.40);
            else if (L.edgeGlowTint == 4.0) glowTint = vec3(1.30, 0.25, 0.30);
            else if (L.edgeGlowTint == 5.0) glowTint = vec3(1.00, 0.55, 1.45);
            else if (L.edgeGlowTint == 6.0) glowTint = vec3(1.35, 0.65, 0.95);

            float maxRadius = max(3.0, L.deepGlowRadius * 40.0);
            float thresh = clamp(L.deepGlowThreshold, 0.20, 0.90);
            vec3 gaussianAccum = vec3(0.0);
            float totalWeight = 0.0;

            const float goldenAngle = 2.39996323;
            for (int s = 1; s <= 24; s++) {
                float rNorm = sqrt(float(s) / 24.0);
                float radius = rNorm * maxRadius;
                float theta = float(s) * goldenAngle;
                
                ivec2 offset = ivec2(cos(theta) * radius, sin(theta) * radius);
                ivec2 sc = clamp(coord + offset, ivec2(0), ivec2(width - 1, height - 1));
                vec3 scCol = unpackRGBA(in_pixels[sc.y * width + sc.x]).rgb;
                float scLuma = dot(scCol, vec3(0.2126, 0.7152, 0.0722));

                float knee = smoothstep(thresh, thresh + 0.20, scLuma);
                float w = exp(-2.5 * rNorm * rNorm);
                gaussianAccum += scCol * knee * w;
                totalWeight += w;
            }

            if (totalWeight > 0.001) {
                vec3 bloomSignal = (gaussianAccum / totalWeight) * (L.deepGlowIntensity * 1.25) * glowTint;
                bloomSignal *= (1.0 - lineEdge * 0.60);
                bloomSignal = compressShoulder(bloomSignal);
                layerColor = 1.0 - (1.0 - layerColor) * (1.0 - clamp(bloomSignal, 0.0, 0.80));
            }
        }

        // 19. NEW: SHADERLY GLOW (CAPCUT / AE SOFT SATURATED BLOOM - NO DUPLICATES)
        if (u_shaderlyGlowIntensity > 0.01) {
            float maxR = max(4.0, u_shaderlyGlowRadius * 36.0);
            float thr = clamp(u_shaderlyGlowThreshold, 0.15, 0.85);
            vec3 bloomSum = vec3(0.0);
            float wSum = 0.0;

            const vec2 poissonDisc[16] = vec2[](
                vec2(-0.326, -0.406), vec2(-0.840, -0.074),
                vec2(-0.696,  0.457), vec2(-0.203,  0.621),
                vec2( 0.962, -0.195), vec2( 0.473, -0.480),
                vec2( 0.519,  0.767), vec2( 0.185, -0.893),
                vec2( 0.507,  0.064), vec2( 0.896,  0.412),
                vec2(-0.322, -0.933), vec2(-0.792, -0.598),
                vec2(-0.024, -0.210), vec2( 0.220,  0.340),
                vec2(-0.380,  0.180), vec2( 0.080,  0.000)
            );

            for (int s = 0; s < 16; s++) {
                vec2 off = poissonDisc[s] * maxR;
                ivec2 sc = clamp(coord + ivec2(off), ivec2(0), ivec2(width - 1, height - 1));
                vec3 scCol = unpackRGBA(in_pixels[sc.y * width + sc.x]).rgb;
                float scLum = dot(scCol, vec3(0.2126, 0.7152, 0.0722));
                float scMax = max(scCol.r, max(scCol.g, scCol.b));
                float energy = max(scLum, scMax * 0.85);

                float knee = smoothstep(thr, thr + 0.22, energy);
                float distNorm = length(poissonDisc[s]);
                float w = exp(-2.2 * distNorm * distNorm);
                bloomSum += scCol * knee * w;
                wSum += w;
            }

            if (wSum > 0.001) {
                vec3 softBloom = (bloomSum / wSum) * (u_shaderlyGlowIntensity * 1.25);
                softBloom *= (1.0 - lineEdge * 0.50);
                softBloom = compressShoulder(softBloom);
                layerColor = 1.0 - (1.0 - layerColor) * (1.0 - clamp(softBloom, 0.0, 0.75));
            }
        }

        // 20. SAPPHIRE S_GLOW
        if (L.sapphireGlowWidth > 0.01) {
            float sRad = max(2.0, L.sapphireGlowWidth * 14.0);
            float sKnee = clamp(L.sapphireGlowThreshold, 0.30, 0.88);
            vec3 sGlowAccum = vec3(0.0);
            float sWeightTotal = 0.0;

            for (int step = 1; step <= 4; step++) {
                float d = float(step) * (sRad / 4.0);
                float w = exp(-d / (sRad * 0.5));
                ivec2 pN = clamp(coord + ivec2(0, int(d)), ivec2(0), ivec2(width - 1, height - 1));
                ivec2 pS = clamp(coord - ivec2(0, int(d)), ivec2(0), ivec2(width - 1, height - 1));
                ivec2 pE = clamp(coord + ivec2(int(d), 0), ivec2(0), ivec2(width - 1, height - 1));
                ivec2 pW = clamp(coord - ivec2(int(d), 0), ivec2(0), ivec2(width - 1, height - 1));

                vec3 colN = unpackRGBA(in_pixels[pN.y * width + pN.x]).rgb;
                vec3 colS = unpackRGBA(in_pixels[pS.y * width + pS.x]).rgb;
                vec3 colE = unpackRGBA(in_pixels[pE.y * width + pE.x]).rgb;
                vec3 colW = unpackRGBA(in_pixels[pW.y * width + pW.x]).rgb;

                sGlowAccum += colN * smoothstep(sKnee, sKnee + 0.18, dot(colN, vec3(0.2126, 0.7152, 0.0722))) * w;
                sGlowAccum += colS * smoothstep(sKnee, sKnee + 0.18, dot(colS, vec3(0.2126, 0.7152, 0.0722))) * w;
                sGlowAccum += colE * smoothstep(sKnee, sKnee + 0.18, dot(colE, vec3(0.2126, 0.7152, 0.0722))) * w;
                sGlowAccum += colW * smoothstep(sKnee, sKnee + 0.18, dot(colW, vec3(0.2126, 0.7152, 0.0722))) * w;
                sWeightTotal += (w * 4.0);
            }

            if (sWeightTotal > 0.001) {
                vec3 sCore = (sGlowAccum / sWeightTotal) * (L.sapphireGlowWidth * 1.05);
                layerColor = 1.0 - (1.0 - layerColor) * (1.0 - clamp(sCore, 0.0, 0.80));
            }
        }

        // 21. UPGRADED: 1D HORIZONTAL GAUSSIAN ANAMORPHIC FLARES (NO SHARP BOXES)
        if (L.thinStreakIntensity > 0.01 && L.thinStreakOpacity > 0.01) {
            float halfSpan = clamp(L.thinStreakWidth * float(width) * 0.25, 20.0, 200.0);
            vec3 flareAccum = vec3(0.0);
            float totalW = 0.0;

            for (int s = -20; s <= 20; s++) {
                float normX = float(s) / 20.0;
                float pixelDist = normX * halfSpan;
                ivec2 sc = clamp(coord + ivec2(int(pixelDist), 0), ivec2(0), ivec2(width - 1, height - 1));
                vec3 srcCol = unpackRGBA(in_pixels[sc.y * width + sc.x]).rgb;
                float srcLuma = dot(srcCol, vec3(0.2126, 0.7152, 0.0722));

                float highlightEnergy = smoothstep(0.68, 0.98, srcLuma);
                if (highlightEnergy > 0.001) {
                    float falloff = exp(-3.2 * normX * normX);
                    flareAccum += srcCol * highlightEnergy * falloff;
                    totalW += falloff;
                }
            }

            if (totalW > 0.001) {
                vec3 flareBeam = (flareAccum / totalW) * (L.thinStreakIntensity * 1.8) * L.thinStreakOpacity;
                layerColor = 1.0 - (1.0 - layerColor) * (1.0 - clamp(flareBeam, 0.0, 0.75));
            }
        }

        // 22. VOLUMETRICS & GOD RAYS
        if (L.bslaGodRays > 0.01) {
            vec2 sunPos = vec2(float(width) * 0.5, float(height) * 0.08);
            vec2 rayDir = normalize(vec2(coord) - sunPos + vec2(0.001));
            vec3 rayAccum = vec3(0.0);
            float rayWeight = 0.0;
            float stepSize = float(max(width, height)) / 24.0;

            for (int s = 1; s <= 16; s++) {
                vec2 samplePos = vec2(coord) - rayDir * (float(s) * stepSize * 0.45);
                ivec2 sc = clamp(ivec2(samplePos), ivec2(0), ivec2(width - 1, height - 1));
                vec3 scCol = unpackRGBA(in_pixels[sc.y * width + sc.x]).rgb;
                float scLuma = dot(scCol, vec3(0.2126, 0.7152, 0.0722));

                float shaftMask = smoothstep(0.48, 0.90, scLuma);
                float decay = pow(0.86, float(s));
                rayAccum += scCol * shaftMask * decay;
                rayWeight += decay;
            }

            vec3 radiantShafts = (rayAccum / max(rayWeight, 0.001)) * (L.bslaGodRays * 2.2);
            vec3 warmSun = vec3(1.15, 1.05, 0.82);
            layerColor = 1.0 - (1.0 - layerColor) * (1.0 - clamp(radiantShafts * warmSun, 0.0, 0.80));
        }

        // 23. Volumetric Fog
        if (L.bslaFogDensity > 0.01) {
            vec2 uv = vec2(coord) / vec2(width, height);
            float fogAlt = smoothstep(1.0 - L.bslaFogDepth, 0.0, uv.y);
            vec3 mistColor = vec3(0.68, 0.75, 0.82) * (1.0 + L.bslaBloomHaze * 0.5);
            float fogAmount = L.bslaFogDensity * (0.25 + 0.75 * fogAlt);
            layerColor = mix(layerColor, mistColor, clamp(fogAmount, 0.0, 0.65));
        }

        // 24. Pro-Mist & Halation
        if (L.halationRadius > 0.01 || u_copiedProMist > 0.01) {
            float mistStrength = max(L.halationRadius, u_copiedProMist);
            float redBleed = smoothstep(0.55, 0.95, luma) * mistStrength * 0.25;
            layerColor.r += redBleed * (1.0 + L.halationWarmth * 0.40);
            layerColor.g += redBleed * (0.20 + L.halationWarmth * 0.10);
        }

        // 25. Film Grain
        if (L.filmGrain > 0.001) {
            float noise = (hash12(vec2(coord) + vec2(u_time * 17.13, u_time * 31.37)) - 0.5);
            layerColor += vec3(noise * L.filmGrain * 0.06);
        }

        // 26. Micro-Pulse / Flicker
        if (L.flickerIntensity > 0.005) {
            float freq = max(L.flickerSpeed, 1.0) * 6.2831853;
            float fWave = sin(u_time * freq) * 0.5 + 0.5;
            layerColor *= (1.0 + (fWave - 0.5) * L.flickerIntensity * 0.30);
        }

        // 27. Radial & Boxed Vignettes
        if (L.vignette > 0.01) {
            vec2 uv = (vec2(coord) / vec2(width, height)) - 0.5;
            float dist = length(uv);
            float vig = smoothstep(0.75, 0.15, dist * (0.7 + L.vignette * 0.8));
            layerColor *= clamp(vig, 0.0, 1.0);
        }
        if (L.vignetteBoxed > 0.01) {
            vec2 uv = abs((vec2(coord) / vec2(width, height)) - 0.5) * 2.0;
            float boxDist = max(uv.x, uv.y);
            float boxVig = smoothstep(0.95, 0.20, boxDist * (0.7 + L.vignetteBoxed * 0.8));
            layerColor *= clamp(boxVig, 0.0, 1.0);
        }

        // 28. Centre Aura & Horizontal Ramp
        vec2 uv = vec2(coord) / vec2(width, height);
        if (L.centerAura > 0.01) {
            float dist = length(uv - 0.5);
            float aura = smoothstep(0.60, 0.0, dist) * L.centerAura * 0.30;
            layerColor += vec3(aura);
        }
        if (u_horizontalRamp > 0.01) {
            float ramp = smoothstep(0.35, 0.65, uv.y) * u_horizontalRamp * 0.30;
            layerColor *= (1.0 + ramp);
        }

        currentComposite = applyBlendMode(currentComposite, layerColor, int(L.blendMode), L.opacity);
    }

    // 29. ISOLATED TEXT SUITE: CHROME CHISEL & METALLIC HORIZON
    if (u_textSuiteEnabled > 0.5) {
        vec2 normCoord = vec2(coord) / vec2(width, height);
        bool inBox = (normCoord.x >= u_textBoxX && normCoord.x <= (u_textBoxX + u_textBoxW) &&
                      normCoord.y >= u_textBoxY && normCoord.y <= (u_textBoxY + u_textBoxH));

        if (inBox) {
            float textLuma = dot(currentComposite, vec3(0.2126, 0.7152, 0.0722));
            float textMask = smoothstep(0.55, 0.80, textLuma) * smoothstep(0.10, 0.45, lineEdge);

            if (textMask > 0.01) {
                vec3 N = normalize(vec3(edgeNormal.x * u_textBevelDepth, edgeNormal.y * u_textBevelDepth, 1.0));
                vec3 L_dir = normalize(vec3(0.35, -0.65, 0.65));
                float NdotL = max(0.0, dot(N, L_dir));

                float reflY = clamp(N.y * 0.5 + 0.5, 0.0, 1.0);
                float chromeReflection = sin(reflY * 6.28318) * 0.5 + 0.5;
                chromeReflection = pow(chromeReflection, 2.2) * u_textChromeIntensity;

                vec3 V = vec3(0.0, 0.0, 1.0);
                vec3 H = normalize(L_dir + V);
                float spec = pow(max(0.0, dot(N, H)), 24.0) * 1.5;

                vec3 chromeColor = mix(vec3(0.12, 0.14, 0.16), vec3(0.92, 0.95, 1.05), chromeReflection);
                chromeColor += vec3(spec);

                currentComposite = mix(currentComposite, chromeColor, textMask * 0.88);
            }
        }
    }

    // 30. 3D LUT APPLICATION
    if (u_hasLut > 0.5) {
        currentComposite = sample3DLut(currentComposite, u_lutOpacity);
    }

    // 31. MASTER TONEMAPPING (Shaderly 1 ACES Filmic / Shaderly 2 AgX)
    if (u_tonemapMode == 1.0) {
        currentComposite = tonemapACES(currentComposite);
    } else if (u_tonemapMode == 2.0) {
        currentComposite = tonemapAgX(currentComposite);
    }

    // 32. INTERLEAVED GRADIENT NOISE (IGN) DITHER
    if (u_ditherStrength > 0.01) {
        float ign = interleavedGradientNoise(vec2(coord));
        float tpdfDither = (ign - 0.5) / 255.0 * u_ditherStrength;
        currentComposite += vec3(tpdfDither);
    }

    out_pixels[pixelIndex] = packRGBA(vec4(currentComposite, basePixel.a));
}
