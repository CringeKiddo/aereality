// =============================================================================
// GRADIENT MAP (per layer, 48 floats, stored AFTER the 10 LayerData blocks: float index 1952 + l * 48)
// Runs inside the layer loop, so the layer's blend mode / opacity apply to it, and it always happens before the LUT.
// =============================================================================
struct GMapData {
    float enabled;      // 0
    float type;         // 1  see gradientMapField()
    float strength;     // 2  0..0.65 (hard capped in the shader)
    float angle;        // 3  radians
    float scale;        // 4
    float centerX;      // 5
    float centerY;      // 6
    float invert;       // 7
    float stopCount;    // 8  2..6
    float bands;        // 9  posterize steps
    float patternSize;  // 10 0..1 -> 4..64 px cells
    float edgeWidth;    // 11 edge width / split softness
    float lumaKeep;     // 12 0..1 keeps the original luminance (prevents flat / over-contrasty looks)
    float curve;        // 13 exponent on t
    float rangeLo;      // 14
    float rangeHi;      // 15
    float stopCol[6];   // 16..21 packed 0xRRGGBB (sRGB)
    float stopPos[6];   // 22..27
    float pad[20];      // 28..47
};

