// =============================================================================
// COLOR UTILITIES
// =============================================================================
float luma(vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }

vec3 sanitize(vec3 c) {
    if (any(isnan(c)) || any(isinf(c))) return vec3(0.0);
    return clamp(c, vec3(0.0), vec3(60000.0));
}

float srgbToLinear(float c) {
    return (c <= 0.04045) ? (c / 12.92) : pow((c + 0.055) / 1.055, 2.4);
}
vec3 srgbToLinear(vec3 c) {
    return vec3(srgbToLinear(c.r), srgbToLinear(c.g), srgbToLinear(c.b));
}
float linearToSrgb(float c) {
    c = clamp(c, 0.0, 1.0);
    return (c <= 0.0031308) ? (c * 12.92) : (1.055 * pow(c, 1.0 / 2.4) - 0.055);
}
vec3 linearToSrgb(vec3 c) {
    return vec3(linearToSrgb(c.r), linearToSrgb(c.g), linearToSrgb(c.b));
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

float hashInt12(ivec2 p) {
    uvec2 q = uvec2(p);
    q = q * uvec2(1597334677u, 3812015801u);
    uint n = (q.x ^ q.y) * 1597334677u;
    return float(n) * (1.0 / 4294967296.0);
}

float vnoise(vec2 p) {
    vec2 i = floor(p);
    vec2 f = fract(p);
    f = f * f * (3.0 - 2.0 * f);
    float a = hash12(i);
    float b = hash12(i + vec2(1.0, 0.0));
    float c = hash12(i + vec2(0.0, 1.0));
    float d = hash12(i + vec2(1.0, 1.0));
    return mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
}

float fbm(vec2 p) {
    float v = 0.0;
    float a = 0.5;
    for (int i = 0; i < 4; i++) {
        v += a * vnoise(p);
        p = p * 2.03 + vec2(17.1, 9.2);
        a *= 0.5;
    }
    return v / 0.9375;
}

vec3 hueToRGB(float h) {
    float r = abs(h * 6.0 - 3.0) - 1.0;
    float g = 2.0 - abs(h * 6.0 - 2.0);
    float b = 2.0 - abs(h * 6.0 - 4.0);
    return clamp(vec3(r, g, b), 0.0, 1.0);
}

vec3 colorTempToRGB(float kelvin) {
    if (kelvin < 1000.0) return vec3(1.0);
    float temp = kelvin / 100.0;
    float red, green, blue;
    if (temp <= 66.0) {
        red = 255.0;
        green = 99.4708025861 * log(max(temp, 1.0)) - 161.1195681661;
        if (temp <= 19.0) blue = 0.0;
        else blue = 138.5177312231 * log(max(temp - 10.0, 1.0)) - 305.0447927307;
    } else {
        red = 329.698727446 * pow(max(temp - 60.0, 1.0), -0.1332047592);
        green = 288.1221695283 * pow(max(temp - 60.0, 1.0), -0.0755148492);
        blue = 255.0;
    }
    return srgbToLinear(clamp(vec3(red, green, blue) / 255.0, 0.0, 1.0));
}

float karisWeight(vec3 color) {
    return 1.0 / (1.0 + luma(color) * 0.5);
}

// =============================================================================
// OKLAB with chroma-reduction gamut mapping
// =============================================================================
vec3 linearRgbToOklab(vec3 c) {
    c = max(vec3(0.0), c);
    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
    float l_ = pow(max(0.0, l), 1.0 / 3.0);
    float m_ = pow(max(0.0, m), 1.0 / 3.0);
    float s_ = pow(max(0.0, s), 1.0 / 3.0);
    return vec3(
        0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_
    );
}

vec3 oklabToLinearRgbRaw(vec3 lab) {
    float l_ = lab.x + 0.3963377774 * lab.y + 0.2158037573 * lab.z;
    float m_ = lab.x - 0.1055613458 * lab.y - 0.0638541728 * lab.z;
    float s_ = lab.x - 0.0894841775 * lab.y - 1.2914855480 * lab.z;
    float l = l_ * l_ * l_;
    float m = m_ * m_ * m_;
    float s = s_ * s_ * s_;
    return vec3(
        +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s
    );
}

// Keeps lightness + hue, pulls chroma in until no channel is negative.
// This is what stops grades turning into random green / purple / cyan.
vec3 oklabToLinearRgb(vec3 lab) {
    lab.x = max(lab.x, 0.0);
    vec3 rgb = oklabToLinearRgbRaw(lab);
    if (min(rgb.r, min(rgb.g, rgb.b)) >= -0.00005) return max(rgb, vec3(0.0));
    float lo = 0.0;
    float hi = 1.0;
    for (int i = 0; i < 9; i++) {
        float mid = 0.5 * (lo + hi);
        vec3 t = oklabToLinearRgbRaw(vec3(lab.x, lab.y * mid, lab.z * mid));
        if (min(t.r, min(t.g, t.b)) >= -0.00005) lo = mid; else hi = mid;
    }
    return max(oklabToLinearRgbRaw(vec3(lab.x, lab.y * lo, lab.z * lo)), vec3(0.0));
}

vec2 oklabRotateHue(vec2 ab, float angleRadians) {
    float cosA = cos(angleRadians * 0.45);
    float sinA = sin(angleRadians * 0.45);
    return vec2(ab.x * cosA - ab.y * sinA, ab.x * sinA + ab.y * cosA);
}

// =============================================================================
// C1-CONTINUOUS MONOTONE CUBIC (PCHIP) 5-POINT CURVE - no slope breaks, no ridges
// =============================================================================
float evalCurve5(float x, float p0, float p1, float p2, float p3, float p4) {
    x = clamp(x, 0.0, 1.0);
    float p[5] = float[5](p0, p1, p2, p3, p4);
    float d[4];
    for (int i = 0; i < 4; i++) d[i] = (p[i + 1] - p[i]) * 4.0;
    float m[5];
    m[0] = d[0];
    m[4] = d[3];
    for (int i = 1; i < 4; i++) {
        float prod = d[i - 1] * d[i];
        m[i] = (prod <= 0.0) ? 0.0 : (2.0 * prod / (d[i - 1] + d[i]));
    }
    float seg = x * 4.0;
    int idx = min(int(floor(seg)), 3);
    float t = seg - float(idx);
    float t2 = t * t;
    float t3 = t2 * t;
    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;
    float y = h00 * p[idx] + h10 * 0.25 * m[idx] + h01 * p[idx + 1] + h11 * 0.25 * m[idx + 1];
    return clamp(y, 0.0, 1.0);
}

bool curveIsIdentity(float p0, float p1, float p2, float p3, float p4) {
    return abs(p0) < 0.0005 && abs(p1 - 0.25) < 0.0005 && abs(p2 - 0.5) < 0.0005 &&
           abs(p3 - 0.75) < 0.0005 && abs(p4 - 1.0) < 0.0005;
}

// =============================================================================
// PIXEL STORAGE
// =============================================================================
vec4 unpackRGBA_Dynamic(int pixelIndex, float bitMode) {
    if (bitMode > 1.5) {
        uint word0 = in_pixels[pixelIndex * 2];
        uint word1 = in_pixels[pixelIndex * 2 + 1];
        return vec4(float(word0 & 0xFFFFu), float((word0 >> 16u) & 0xFFFFu),
                    float(word1 & 0xFFFFu), float((word1 >> 16u) & 0xFFFFu)) / 65535.0;
    }
    uint val = in_pixels[pixelIndex];
    return vec4(float(val & 0xFFu), float((val >> 8u) & 0xFFu),
                float((val >> 16u) & 0xFFu), float((val >> 24u) & 0xFFu)) / 255.0;
}

vec3 srcSrgb(ivec2 c) {
    c = clamp(c, ivec2(0), ivec2(gW - 1, gH - 1));
    return unpackRGBA_Dynamic(c.y * gW + c.x, gBit).rgb;
}
vec3 srcLin(ivec2 c) { return srgbToLinear(srcSrgb(c)); }

// "Is this pixel part of the (bright) text?" - used by the text suite only
float textFillAt(ivec2 p) {
    vec3 c = srcLin(p);
    float v = 0.5 * luma(c) + 0.5 * max(c.r, max(c.g, c.b));
    return smoothstep(0.45, 0.75, v);
}

vec4 unpackComposite(int idx) {
    return vec4(unpackHalf2x16(temp_composite[idx * 2]), unpackHalf2x16(temp_composite[idx * 2 + 1]));
}
void packComposite(int idx, vec4 c) {
    c.rgb = sanitize(c.rgb);
    temp_composite[idx * 2] = packHalf2x16(c.rg);
    temp_composite[idx * 2 + 1] = packHalf2x16(c.ba);
}
vec3 compAt(ivec2 c, int w, int h) {
    c = clamp(c, ivec2(0), ivec2(w - 1, h - 1));
    return unpackComposite(c.y * w + c.x).rgb;
}

void packFinalDisplay(int pixelIndex, vec4 col, float bitMode) {
    if (bitMode > 1.5) {
        uint r = uint(clamp(col.r * 65535.0 + 0.5, 0.0, 65535.0));
        uint g = uint(clamp(col.g * 65535.0 + 0.5, 0.0, 65535.0));
        uint b = uint(clamp(col.b * 65535.0 + 0.5, 0.0, 65535.0));
        uint a = uint(clamp(col.a * 65535.0 + 0.5, 0.0, 65535.0));
        out_pixels[pixelIndex * 2] = (g << 16u) | r;
        out_pixels[pixelIndex * 2 + 1] = (a << 16u) | b;
    } else {
        uint r = uint(clamp(col.r * 255.0 + 0.5, 0.0, 255.0));
        uint g = uint(clamp(col.g * 255.0 + 0.5, 0.0, 255.0));
        uint b = uint(clamp(col.b * 255.0 + 0.5, 0.0, 255.0));
        uint a = uint(clamp(col.a * 255.0 + 0.5, 0.0, 255.0));
        out_pixels[pixelIndex] = (a << 24u) | (b << 16u) | (g << 8u) | r;
    }
}

// Bloom storage (fp16 RGBA)
vec4 bloomLoad(int level, int idx) {
    uvec2 u;
    if (level == 0)      u = uvec2(bloom_l0[idx * 2], bloom_l0[idx * 2 + 1]);
    else if (level == 1) u = uvec2(bloom_l1[idx * 2], bloom_l1[idx * 2 + 1]);
    else                 u = uvec2(bloom_l2[idx * 2], bloom_l2[idx * 2 + 1]);
    return vec4(unpackHalf2x16(u.x), unpackHalf2x16(u.y));
}
void bloomStore(int level, int idx, vec4 v) {
    v = clamp(v, vec4(0.0), vec4(60000.0));
    if (any(isnan(v))) v = vec4(0.0);
    uint a = packHalf2x16(v.rg);
    uint b = packHalf2x16(v.ba);
    if (level == 0)      { bloom_l0[idx * 2] = a; bloom_l0[idx * 2 + 1] = b; }
    else if (level == 1) { bloom_l1[idx * 2] = a; bloom_l1[idx * 2 + 1] = b; }
    else                 { bloom_l2[idx * 2] = a; bloom_l2[idx * 2 + 1] = b; }
}

vec4 sampleBloom(int level, vec2 uv, int w, int h) {
    vec2 pos = clamp(uv * vec2(w, h) - 0.5, vec2(0.0), vec2(w - 1, h - 1));
    ivec2 p0 = ivec2(floor(pos));
    ivec2 p1 = clamp(p0 + ivec2(1), ivec2(0), ivec2(w - 1, h - 1));
    vec2 f = fract(pos);
    vec4 c00 = bloomLoad(level, p0.y * w + p0.x);
    vec4 c10 = bloomLoad(level, p0.y * w + p1.x);
    vec4 c01 = bloomLoad(level, p1.y * w + p0.x);
    vec4 c11 = bloomLoad(level, p1.y * w + p1.x);
    return mix(mix(c00, c10, f.x), mix(c01, c11, f.x), f.y);
}

// =============================================================================
// TONEMAPPERS
// =============================================================================
vec3 agxCore(vec3 c, float sat) {
    // GLSL mat3(vec3, vec3, vec3) is COLUMN-major. toRec2020 / outset / toSrgb below were already
    // listed as columns. The AgX *inset* was listed row-by-row (transposed), so neutral greys were
    // pushed off-axis - that was the pink, dark cast. It is now written as columns too.
    const mat3 toRec2020 = mat3(vec3(0.6274, 0.0691, 0.0164), vec3(0.3293, 0.9195, 0.0880), vec3(0.0433, 0.0113, 0.8956));
    const mat3 inset = mat3(
        vec3(0.856627153315983, 0.137318972929847, 0.11189821299995),
        vec3(0.0951212405381588, 0.761241990602591, 0.0767994186031903),
        vec3(0.0482516061458583, 0.101439036467562, 0.811302368396859));
    const mat3 outset = mat3(
        vec3(1.1271005818144368, -0.1413297634984383, -0.14132976349843826),
        vec3(-0.11060664309660323, 1.157823702216272, -0.11060664309660294),
        vec3(-0.016493938717834573, -0.016493938717834257, 1.2519364065950405));
    const mat3 toSrgb = mat3(vec3(1.6605, -0.1246, -0.0182), vec3(-0.5876, 1.1329, -0.1006), vec3(-0.0728, -0.0083, 1.1187));

    c = max(c, vec3(0.0));
    c = inset * (toRec2020 * c);
    c = log2(max(c, vec3(1e-10)));
    c = clamp((c - (-12.47393)) / (4.026069 + 12.47393), 0.0, 1.0);

    // Troy Sobotka's 6th-order contrast approximation (AgX base look)
    vec3 x2 = c * c;
    vec3 x4 = x2 * x2;
    c = 15.5 * x4 * x2 - 40.14 * x4 * c + 31.96 * x4 - 6.868 * x2 * c + 0.4298 * x2 + 0.1191 * c - 0.00232;
    c = clamp(c, 0.0, 1.0);

    // gentle chroma restore (AgX desaturates highlights by design)
    float l = dot(c, vec3(0.2126, 0.7152, 0.0722));
    c = mix(vec3(l), c, sat);

    c = outset * c;
    c = pow(max(c, vec3(0.0)), vec3(2.2));
    c = toSrgb * c;
    return max(c, vec3(0.0));
}

// AgX for display-referred video: neutral stays neutral, mids stay close to the source,
// and SDR white is lifted back to 1.0 (raw AgX tops out at ~0.79 = the muddy grey look).
vec3 tonemapAgx(vec3 c) {
    const float AGX_SAT = 1.20;
    vec3 raw = agxCore(c, AGX_SAT);
    float whiteEnc = linearToSrgb(luma(agxCore(vec3(1.0), AGX_SAT)));
    vec3 e = linearToSrgb(raw);
    float ye = luma(e);
    float lift = 1.0 + (1.0 / whiteEnc - 1.0) * smoothstep(0.42, whiteEnc, ye);
    if (ye >= whiteEnc) lift = 1.0 / whiteEnc;
    e = min(e * lift, vec3(1.0));
    return srgbToLinear(e);
}

// Khronos PBR Neutral, retuned for video: no black-level subtraction (that was the "brightness
// drop"), a real shoulder that maps SDR white back to ~white, hue-preserving peak compression,
// highlight desaturation, and a very light display-space contrast curve.
vec3 tonemapNeutralPlus(vec3 color) {
    color = max(color, vec3(0.0));
    const float startCompression = 0.55;
    const float desaturation = 0.25;
    const float whitePoint = 1.35;
    const float kShoulder = 1.6;

    float peak = max(color.r, max(color.g, color.b));
    if (peak > startCompression) {
        float d = 1.0 - startCompression;
        float t = (peak - startCompression) / (whitePoint - startCompression);
        float newPeak = startCompression + d * (1.0 - exp(-kShoulder * t)) / (1.0 - exp(-kShoulder));
        newPeak = min(newPeak, 1.0);
        color *= newPeak / peak;
        float g = max(1.0 - 1.0 / (desaturation * max(peak - newPeak, 0.0) + 1.0), 0.0);
        color = mix(color, vec3(newPeak), g);
    }
    color = clamp(color, 0.0, 1.0);

    vec3 e = linearToSrgb(color);
    e = e + 0.12 * (e * e * (3.0 - 2.0 * e) - e);
    return srgbToLinear(e);
}

// "Linear" mode, de-slopped: values up to the knee pass through UNCHANGED (so the grade looks exactly
// like plain linear), then the PEAK channel is rolled off smoothly towards 1.0 and the other channels
// are scaled with it. Hue is preserved instead of every channel hard-clipping to flat white, and a
// touch of highlight desaturation stops over-driven colours going neon.
vec3 tonemapLinearSoft(vec3 c) {
    c = max(c, vec3(0.0));
    const float knee = 0.92;      // linear light (~sRGB 0.96): nothing below this is touched
    const float whiteIn = 1.60;   // input peak that reaches 1.0
    const float kS = 8.5;         // gives slope 1.0 at the knee (C1-continuous, no visible kink)
    float peak = max(c.r, max(c.g, c.b));
    if (peak <= knee) return c;
    float d = 1.0 - knee;
    float t = clamp((peak - knee) / (whiteIn - knee), 0.0, 1.0);
    float newPeak = knee + d * (1.0 - exp(-kS * t)) / (1.0 - exp(-kS));
    c *= newPeak / peak;
    float g = 1.0 - 1.0 / (0.20 * max(peak - newPeak, 0.0) + 1.0);
    return clamp(mix(c, vec3(newPeak), g), 0.0, 1.0);
}

vec3 applyToneMapping(vec3 linearCol, float mode) {
    if (mode > 1.5) return tonemapNeutralPlus(linearCol);
    if (mode > 0.5) return tonemapAgx(linearCol);
    return tonemapLinearSoft(linearCol);
}

// =============================================================================
// LUT (display-referred: input/outputs are sRGB-encoded 0..1)
// =============================================================================
vec3 sample3DLutDisplay(vec3 srgb, float opacity) {
    if (opacity <= 0.001) return srgb;
    vec3 c = clamp(srgb, 0.0, 1.0);
    vec3 lutCoord = (c * 31.0 + 0.5) / 32.0;
    vec3 graded = texture(u_lutTexture, lutCoord).rgb;
    return mix(srgb, clamp(graded, 0.0, 1.0), clamp(opacity, 0.0, 1.0));
}

// =============================================================================
// BLEND MODES (gamma space by default = After Effects behaviour)
// =============================================================================
vec3 softLightW3C(vec3 a, vec3 b) {
    vec3 dA = mix(sqrt(a), ((16.0 * a - 12.0) * a + 4.0) * a, step(a, vec3(0.25)));
    vec3 low  = a - (1.0 - 2.0 * b) * a * (1.0 - a);
    vec3 high = a + (2.0 * b - 1.0) * (dA - a);
    return mix(low, high, step(vec3(0.5), b));
}

vec3 blendCore(vec3 a, vec3 b, int mode) {
    if (mode == 1) {                       // Screen
        vec3 ca = clamp(a, 0.0, 1.0);
        vec3 cb = clamp(b, 0.0, 1.0);
        return (ca + cb - ca * cb) + max(a - 1.0, 0.0) + max(b - 1.0, 0.0);
    } else if (mode == 3) {                // Overlay
        vec3 ca = clamp(a, 0.0, 1.0);
        vec3 cb = clamp(b, 0.0, 1.0);
        return mix(2.0 * ca * cb, 1.0 - 2.0 * (1.0 - ca) * (1.0 - cb), step(vec3(0.5), ca));
    } else if (mode == 4) {                // Soft Light
        return softLightW3C(clamp(a, 0.0, 1.0), clamp(b, 0.0, 1.0));
    } else if (mode == 5) {                // Multiply
        return a * b;
    } else if (mode == 6) {                // Add
        return a + b;
    }
    return b;                              // Normal
}

vec3 applyBlendMode(vec3 baseCol, vec3 blendCol, int mode, float opacity, bool linearSpace) {
    opacity = clamp(opacity, 0.0, 1.0);
    if (mode == 2 || mode == 7) {          // Linear Add / Linear Dodge: always linear light
        return mix(baseCol, baseCol + blendCol, opacity);
    }
    if (mode == 0 && opacity >= 0.9999) return blendCol;
    if (linearSpace) {
        return mix(baseCol, blendCore(baseCol, blendCol, mode), opacity);
    }
    vec3 ga = pow(max(baseCol, vec3(0.0)), vec3(1.0 / 2.2));
    vec3 gb = pow(max(blendCol, vec3(0.0)), vec3(1.0 / 2.2));
    vec3 gr = mix(ga, blendCore(ga, gb, mode), opacity);
    return pow(max(gr, vec3(0.0)), vec3(2.2));
}

vec3 tintFor(float id) {
    if (id == 1.0) return vec3(1.20, 1.05, 0.65);
    if (id == 2.0) return vec3(0.40, 1.10, 1.45);
    if (id == 3.0) return vec3(1.25, 0.85, 0.40);
    if (id == 4.0) return vec3(1.30, 0.25, 0.30);
    if (id == 5.0) return vec3(1.00, 0.55, 1.45);
    if (id == 6.0) return vec3(1.35, 0.65, 0.95);
    return vec3(1.0);
}

vec3 saturateColor(vec3 c, float s) {
    float l = luma(c);
    return max(mix(vec3(l), c, s), vec3(0.0));
}

// Lowest highlight threshold any enabled glow needs (shared bloom extraction)
float glowExtractThreshold() {
    float t = 1.0;
    bool any_ = false;
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int i = 0; i < total; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;
        if (L.deepGlowIntensity > 0.01 || L.kawaseGlowIntensity > 0.01) { t = min(t, L.deepGlowThreshold); any_ = true; }
        if (L.diffuseSpGlowIntensity > 0.01) { t = min(t, L.diffuseSpGlowThreshold); any_ = true; }
        if (L.shaderlyGlowIntensity > 0.01)  { t = min(t, L.shaderlyGlowThreshold);  any_ = true; }
        if (L.lightWrapIntensity > 0.01 && L.lightWrapWidth > 0.01) { t = min(t, L.lightWrapThreshold); any_ = true; }
        if (L.thinStreakIntensity > 0.01)    { t = min(t, 0.45); any_ = true; }
        if (L.halationRadius > 0.01 || L.copiedProMist > 0.01 || L.bslaBloomHaze > 0.01 || L.bslFogScatter > 0.01) { t = min(t, 0.40); any_ = true; }
    }
    return any_ ? clamp(t, 0.05, 0.95) : 0.60;
}

float edgeSensitivity() {
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int i = 0; i < total; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;
        if (L.sapphireGlowWidth > 0.01 || L.copiedEdgeRays > 0.01 || L.edgeHaloRadius > 0.01)
            return clamp(L.sapphireGlowThreshold, 0.1, 0.99);
    }
    return 0.70;
}

vec3 gateGlow(vec3 g, float th, float exMin) {
    float rel = th - exMin;
    if (rel <= 0.03) return g;
    float l = luma(g);
    return g * smoothstep(rel * 0.15, rel * 0.15 + 0.12, l);
}

// =============================================================================
// PASS 1: HIGHLIGHT + EDGE EXTRACTION -> Bloom L0
// =============================================================================
void executeHighlightExtraction(ivec2 coord, int l0W, int l0H, int srcW, int srcH) {
    vec2 centerUV = (vec2(coord) + 0.5) / vec2(l0W, l0H);
    ivec2 srcC = clamp(ivec2(centerUV * vec2(srcW, srcH)), ivec2(0), ivec2(srcW - 1, srcH - 1));

    vec3 col = unpackComposite(srcC.y * srcW + srcC.x).rgb;
    float l = luma(col);

    float threshold = glowExtractThreshold();
    float knee = smoothstep(threshold, threshold + 0.20, l);
    vec3 isolated = col * knee;
    isolated *= karisWeight(isolated);

    // Edge mask (perceptual-luma Sobel, 2px step because L0 is half-res)
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            vec3 pc = compAt(srcC + ivec2(x, y) * 2, srcW, srcH);
            float lp = sqrt(max(luma(pc), 0.0));
            gx += lp * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lp * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float grad = sqrt(gx * gx + gy * gy);
    float sens = edgeSensitivity();
    float edge = smoothstep(sens * 0.12, sens * 0.12 + 0.16, grad);

    bloomStore(0, coord.y * l0W + coord.x, vec4(isolated, edge));
}

// PASS 2 & 3: 13-tap anti-grid downsample
void executeBloomDownsample(int passIdx, ivec2 coord, int width, int height, float radius) {
    int srcLevel = (passIdx == 2) ? 0 : 1;
    int srcW = width * 2;
    int srcH = height * 2;
    vec2 uv = (vec2(coord) + 0.5) / vec2(width, height);
    vec2 texel = (1.0 / vec2(srcW, srcH)) * max(radius, 0.6);
    float x = texel.x;
    float y = texel.y;

    vec4 a = sampleBloom(srcLevel, uv + vec2(-2.0 * x,  2.0 * y), srcW, srcH);
    vec4 b = sampleBloom(srcLevel, uv + vec2( 0.0,      2.0 * y), srcW, srcH);
    vec4 c = sampleBloom(srcLevel, uv + vec2( 2.0 * x,  2.0 * y), srcW, srcH);
    vec4 d = sampleBloom(srcLevel, uv + vec2(-2.0 * x,  0.0), srcW, srcH);
    vec4 e = sampleBloom(srcLevel, uv, srcW, srcH);
    vec4 f = sampleBloom(srcLevel, uv + vec2( 2.0 * x,  0.0), srcW, srcH);
    vec4 g = sampleBloom(srcLevel, uv + vec2(-2.0 * x, -2.0 * y), srcW, srcH);
    vec4 h = sampleBloom(srcLevel, uv + vec2( 0.0,     -2.0 * y), srcW, srcH);
    vec4 i = sampleBloom(srcLevel, uv + vec2( 2.0 * x, -2.0 * y), srcW, srcH);
    vec4 j = sampleBloom(srcLevel, uv + vec2(-x,  y), srcW, srcH);
    vec4 k = sampleBloom(srcLevel, uv + vec2( x,  y), srcW, srcH);
    vec4 l = sampleBloom(srcLevel, uv + vec2(-x, -y), srcW, srcH);
    vec4 m = sampleBloom(srcLevel, uv + vec2( x, -y), srcW, srcH);

    vec4 downsample = (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (e + j + k + l + m) * 0.125;
    bloomStore((passIdx == 2) ? 1 : 2, coord.y * width + coord.x, downsample);
}

// PASS 4 & 5: tent upsample
void executeBloomUpsample(int passIdx, ivec2 coord, int w, int h, float radius) {
    int srcLevel = (passIdx == 4) ? 2 : 1;
    int srcW = w / 2;
    int srcH = h / 2;
    vec2 uv = (vec2(coord) + 0.5) / vec2(w, h);
    vec2 texel = (1.0 / vec2(srcW, srcH)) * max(radius, 0.6);

    vec4 sum = vec4(0.0);
    sum += sampleBloom(srcLevel, uv + vec2(-texel.x, 0.0), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2( texel.x, 0.0), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2(0.0, -texel.y), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2(0.0,  texel.y), srcW, srcH) * 2.0;
    sum += sampleBloom(srcLevel, uv + vec2(-texel.x, -texel.y), srcW, srcH);
    sum += sampleBloom(srcLevel, uv + vec2( texel.x, -texel.y), srcW, srcH);
    sum += sampleBloom(srcLevel, uv + vec2(-texel.x,  texel.y), srcW, srcH);
    sum += sampleBloom(srcLevel, uv + vec2( texel.x,  texel.y), srcW, srcH);
    sum /= 12.0;

    int dstLevel = (passIdx == 4) ? 1 : 0;
    int dstIdx = coord.y * w + coord.x;
    vec4 existing = bloomLoad(dstLevel, dstIdx);
    bloomStore(dstLevel, dstIdx, mix(existing, sum, 0.55));
}

// =============================================================================
// SCENE-COLOUR HELPERS (glows / flares inherit the background instead of going white)
// =============================================================================
vec3 sampleAmbientColor(ivec2 coord, int width, int height, float radiusPx) {
    vec3 acc = vec3(0.0);
    float wsum = 0.0;
    const int AMB_TAPS = 16;
    float rot = hash12(vec2(coord) * 0.61 + 3.3) * 6.2831853;
    for (int k = 0; k < AMB_TAPS; k++) {
        float fr = (float(k) + 0.5) / float(AMB_TAPS);
        float rr = sqrt(fr) * radiusPx;
        float ang = rot + float(k) * 2.39996323;
        vec3 s = compAt(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr)), width, height);
        float w = smoothstep(0.015, 0.12, luma(s)) + 0.03;   // ignore ink / near-black
        acc += s * w;
        wsum += w;
    }
    return acc / max(wsum, 1e-4);
}

// Glows built from highlight extraction tend to be near-white. Where a glow has little chroma,
// re-tint it with the surrounding scene colour (luminance of the glow is preserved).
vec3 colorizeGlow(vec3 g, vec3 ambient, float amount) {
    float lg = luma(g);
    if (lg < 1e-5) return g;
    float mx = max(g.r, max(g.g, g.b));
    float mn = min(g.r, min(g.g, g.b));
    float chroma = (mx - mn) / max(mx, 1e-5);
    float whiteness = 1.0 - clamp(chroma * 2.5, 0.0, 1.0);
    float la = luma(ambient);
    vec3 hue = (la > 1e-4) ? clamp(ambient / la, vec3(0.05), vec3(4.0)) : vec3(1.0);
    hue = saturateColor(hue, 1.5);
    hue /= max(luma(hue), 1e-4);
    return mix(g, hue * lg, clamp(whiteness * amount, 0.0, 1.0));
}

float gaussBand(float x, float w) {
    float t = x / w;
    return exp(-t * t);
}

// Multi-band chrome reflection. v: 0 = top of the text, 1 = bottom. Horizon sits just under the
// middle: bright sky -> dark band -> thin bright horizon line -> dark ground -> lit lower band.
vec3 chromeBands(float v, vec3 skyRef, vec3 gndRef) {
    const float HZ = 0.52;
    vec3 top = mix(skyRef * 1.25, skyRef * 0.28, smoothstep(0.0, HZ - 0.04, v));
    top *= 1.0 - 0.60 * gaussBand(v - (HZ - 0.07), 0.05);
    vec3 warm = vec3(1.0, 0.72, 0.45);
    vec3 bot = mix(gndRef * 0.22, gndRef * 1.15 + warm * 0.10, smoothstep(HZ, 0.92, v));
    bot += (gndRef * 0.6 + warm * 0.08) * gaussBand(v - 0.83, 0.06);
    vec3 col = mix(top, bot, smoothstep(HZ - 0.012, HZ + 0.012, v));
    col += mix(vec3(1.0), skyRef, 0.35) * gaussBand(v - HZ, 0.012) * 1.4;
    return col;
}

// =============================================================================
// FINAL COMPOSITE HELPERS
// =============================================================================
vec3 applyFxaa(ivec2 coord, int width, int height) {
    vec3 rgbM = compAt(coord, width, height);
    float lumaM = luma(rgbM);
    vec3 cU = compAt(coord + ivec2(0, -1), width, height);
    vec3 cD = compAt(coord + ivec2(0,  1), width, height);
    vec3 cL = compAt(coord + ivec2(-1, 0), width, height);
    vec3 cR = compAt(coord + ivec2( 1, 0), width, height);
    float lU = luma(cU); float lD = luma(cD); float lL = luma(cL); float lR = luma(cR);
    float lumaMin = min(lumaM, min(min(lU, lD), min(lL, lR)));
    float lumaMax = max(lumaM, max(max(lU, lD), max(lL, lR)));
    if ((lumaMax - lumaMin) < max(0.04, lumaMax * 0.12)) return rgbM;
    return mix(rgbM, (cU + cD + cL + cR) * 0.25, 0.30);
}

// =============================================================================
// DOMINANT LIGHT SOURCE (used by Diffuse SP)
// One 16x16 workgroup scans the 1/8-res highlight pyramid level on a 16x16 lattice (4 sub-taps per
// cell so small suns are not missed) and reduces it in shared memory to a luminance^3-weighted
// centroid. That is the "where would the sun / brightest source be" point. Cost: ~1 load/pixel.
// =============================================================================
shared vec4 s_lightA[256];   // rgb * w, w
shared vec2 s_lightB[256];   // uv  * w
vec2  gLightUV = vec2(0.5, 0.10);
vec3  gLightCol = vec3(1.0);
float gLightStrength = 0.0;

bool diffuseLayerActive() {
    int total = int(clamp(u_layerCount, 1.0, 10.0));
    for (int i = 0; i < total; i++) {
        if (layers[i].isEnabled > 0.5 && layers[i].diffuseSpGlowIntensity > 0.01) return true;
    }
    return false;
}

// MUST be called from uniform control flow (before any early return) because it uses barrier().
void detectDominantLight(int width, int height) {
    uint lid = gl_LocalInvocationIndex;
    ivec2 cell = ivec2(int(lid & 15u), int(lid >> 4u));
    int w8 = max(width / 8, 1);
    int h8 = max(height / 8, 1);
    vec4 acc = vec4(0.0);
    vec2 accUV = vec2(0.0);
    for (int k = 0; k < 4; k++) {
        vec2 sub = vec2(float(k & 1), float(k >> 1)) * 0.5 + 0.25;
        vec2 cuv = (vec2(cell) + sub) / 16.0;
        vec3 c = sampleBloom(2, cuv, w8, h8).rgb;
        float l = luma(c);
        float w = l * l * l;
        acc += vec4(c * w, w);
        accUV += cuv * w;
    }
    s_lightA[lid] = acc;
    s_lightB[lid] = accUV;
    barrier();
    for (uint st = 128u; st > 0u; st >>= 1u) {
        if (lid < st) {
            s_lightA[lid] += s_lightA[lid + st];
            s_lightB[lid] += s_lightB[lid + st];
        }
        barrier();
    }
    float wt = s_lightA[0].w;
    if (wt > 1e-7) {
        gLightUV = s_lightB[0] / wt;
        vec3 lc = s_lightA[0].rgb / wt;
        float ll = max(luma(lc), 1e-4);
        gLightCol = clamp(lc / ll, vec3(0.3), vec3(3.0));          // hue only (luma = 1)
        gLightStrength = smoothstep(0.02, 0.35, ll);
    }
}

// =============================================================================
// PASS 6: GLOWS, LIGHT WRAP, ATMOSPHERE, TONEMAP, LUT, TPDF DITHER
// =============================================================================
void executeFinalComposite(ivec2 coord, int width, int height) {
    int pixelIndex = coord.y * width + coord.x;
    float bitMode = gBit;

    vec4 compPx = unpackComposite(pixelIndex);
    vec3 linearBase = applyFxaa(coord, width, height);
    float centerLuma = luma(linearBase);
    vec2 uv = (vec2(coord) + 0.5) / vec2(width, height);

    vec4 tightS = sampleBloom(0, uv, max(width / 2, 1), max(height / 2, 1));
    vec4 midS   = sampleBloom(1, uv, max(width / 4, 1), max(height / 4, 1));
    vec4 wideS  = sampleBloom(2, uv, max(width / 8, 1), max(height / 8, 1));
    vec3 tightGlow = tightS.rgb;
    vec3 midGlow   = midS.rgb;
    vec3 wideGlow  = wideS.rgb;

    // line-art edge gradient (used to protect ink lines)
    float resScale = gRes;
    int edgeStep = gEdgeStep;
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float lum = luma(compAt(coord + ivec2(x * edgeStep, y * edgeStep), width, height));
            gx += lum * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lum * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);

    float exMin = glowExtractThreshold();
    int totalLayers = int(clamp(u_layerCount, 1.0, 10.0));

    // Scene colour context shared by every glow / flare (only paid for when one is active)
    bool anyGlow = false;
    for (int i = 0; i < totalLayers; i++) {
        LayerData Lg = layers[i];
        if (Lg.isEnabled < 0.5) continue;
        if (Lg.deepGlowIntensity > 0.01 || Lg.kawaseGlowIntensity > 0.01 || Lg.diffuseSpGlowIntensity > 0.01 ||
            Lg.shaderlyGlowIntensity > 0.01 || Lg.copiedEdgeRays > 0.01 || Lg.sapphireGlowWidth > 0.01 ||
            Lg.edgeHaloRadius > 0.01 || Lg.thinStreakIntensity > 0.01) { anyGlow = true; }
    }
    float maxDim = float(max(width, height));
    vec3 ambientCol = vec3(0.5);
    vec3 ambientNear = vec3(0.5);
    if (anyGlow) {
        ambientCol  = sampleAmbientColor(coord, width, height, 0.045 * maxDim);
        ambientNear = sampleAmbientColor(coord, width, height, 0.012 * maxDim);
    }

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;
        float op = clamp(L.opacity, 0.0, 1.0);
        vec3 glowTint = tintFor(L.edgeGlowTint);

        // ---- S_LightWrap: blurred BACKGROUND light wrapping into the darker foreground edge ----
        // v2.2: no more tap ring. The old version gathered a fixed ring of raw taps (a literal copy of
        // the clip at a fixed offset = the "duplicated ring"). Now the wrap source is the already
        // blurred highlight pyramid, so it is a smooth gradient that is strong at the silhouette and
        // dies off inward, exactly like a real light wrap.
        if (L.lightWrapIntensity > 0.01 && L.lightWrapWidth > 0.01) {
            float wv = clamp(L.lightWrapWidth, 0.0, 1.0);
            vec3 field = (wv < 0.5) ? mix(tightGlow, midGlow, wv * 2.0) : mix(midGlow, wideGlow, (wv - 0.5) * 2.0);
            field = gateGlow(field, L.lightWrapThreshold, exMin);
            float lumaP = luma(linearBase);
            float lf = luma(field);
            // the pixel only receives light if it is darker than the light spilling onto it
            float receive = clamp((lf - lumaP * 0.85) / max(lf, 1e-4), 0.0, 1.0);
            receive = receive * receive * (3.0 - 2.0 * receive);
            // hug the silhouette: strongest where the blurred edge mask is high
            float nearEdge = clamp(max(tightS.a, midS.a * 0.8) * 1.6, 0.0, 1.0);
            float edgeGate = mix(0.30, 1.0, nearEdge);
            vec3 wrap = saturateColor(field, 1.10) * receive * edgeGate * L.lightWrapIntensity * 1.35;
            float lw = luma(wrap);
            if (lw > 1e-5) wrap *= (1.0 - exp(-lw * 1.3)) / lw;   // soft-limit: never slams to pure white
            if (L.lightWrapBlendMode > 0.5) linearBase += wrap * op;
            else {
                vec3 cb = clamp(linearBase, 0.0, 1.0);
                linearBase = mix(linearBase, cb + wrap - cb * wrap + max(linearBase - 1.0, 0.0), op);
            }
        }

        // ---- 1. Deep Glow: multi-radius, colour-faithful, energy-aware ----
        if (L.deepGlowIntensity > 0.01) {
            float r = clamp(L.deepGlowRadius, 0.0, 1.0);
            // Inverse-square style decay: each pyramid level (relative blur size sT/sM/sW) is weighted by
            // 1/(1+(s/R)^2). Small R = bright tight core with a short tail; large R pulls energy into the
            // wide levels = long, slowly fading tail. The tight core is always present.
            float Rg = mix(0.8, 7.0, r);
            float wT = 1.0 / (1.0 + (1.0 / Rg) * (1.0 / Rg));
            float wM = 1.0 / (1.0 + (2.5 / Rg) * (2.5 / Rg));
            float wW = 1.0 / (1.0 + (6.0 / Rg) * (6.0 / Rg));
            float wn = wT + wM + wW;
            vec3 g = (tightGlow * wT + midGlow * wM + wideGlow * wW) / wn;
            g = gateGlow(g, L.deepGlowThreshold, exMin);
            g = colorizeGlow(g, ambientCol, 0.85);
            g = saturateColor(g, 1.15) * mix(vec3(1.0), glowTint, 0.80);
            // Deep Glow signature: a hot core. Where the tight glow is strong the light burns towards
            // white (energy-aware), while the outer falloff keeps the scene colour.
            float hotAmt = smoothstep(0.30, 1.10, luma(tightGlow) * (1.25 - 0.6 * r));
            g = mix(g, vec3(luma(g)) * vec3(1.00, 0.96, 0.90) * 1.20, hotAmt * 0.35);
            g *= (1.0 - lineEdge * 0.15);
            linearBase += g * (L.deepGlowIntensity * 1.9) * op;
        }

        // ---- 2. Kawase glow ----
        if (L.kawaseGlowIntensity > 0.01) {
            float r = clamp(L.kawaseGlowRadius, 0.0, 1.0);
            vec3 g = (r < 0.5) ? mix(tightGlow, midGlow, r * 2.0) : mix(midGlow, wideGlow, (r - 0.5) * 2.0);
            g = gateGlow(g, L.deepGlowThreshold, exMin);
            g = colorizeGlow(g, ambientCol, 0.80);
            linearBase += g * glowTint * (L.kawaseGlowIntensity * 1.6) * op;
        }

        // ---- 3. Diffuse SP: light-source simulation + prismatic dispersion bloom ----
        // Finds the dominant light (sun / brightest source), then every pixel gathers the highlight
        // field ALONG THE RAY towards that light, so the light visibly travels onto the subject
        // instead of just blooming in place. The R/G/B gathers use radially scaled offsets about the
        // light (R furthest, B least) = prismatic screen-space dispersion with radial chromatic
        // aberration that grows with distance from the source. Strength falls off with distance to
        // the light, and pixels that are already bright receive less.
        if (L.diffuseSpGlowIntensity > 0.01) {
            float r = clamp(L.diffuseSpGlowRadius, 0.0, 1.0);
            float aspect = float(width) / float(height);
            vec2 toL = (gLightUV - uv) * vec2(aspect, 1.0);
            float dL = length(toL);
            vec2 dirUv = (toL / max(dL, 1e-4)) * vec2(1.0 / aspect, 1.0);   // unit direction, in uv space
            float dispAmt = (0.006 + r * 0.040) * (0.35 + dL);               // dispersion grows with distance
            float reachLen = dL * (0.45 + 0.55 * r);                          // how far along the ray we gather
            int mw = max(width / 4, 1); int mh = max(height / 4, 1);
            int ww = max(width / 8, 1); int wh = max(height / 8, 1);
            float jit = hashInt12(coord * 7 + ivec2(3, 29));
            const int DN = 6;
            vec3 prism = vec3(0.0);
            float wsum = 0.0;
            for (int k = 0; k < DN; k++) {
                float t = (float(k) + jit) / float(DN);                       // 0..1 along the ray
                float wk = exp(-t * 1.8);
                vec2 base = uv + dirUv * reachLen * t;
                int lv = (t < 0.5) ? 1 : 2;
                int lw_ = (lv == 1) ? mw : ww;
                int lh_ = (lv == 1) ? mh : wh;
                float sR = sampleBloom(lv, base + dirUv * dispAmt * 1.00, lw_, lh_).r;
                float sG = sampleBloom(lv, base + dirUv * dispAmt * 0.60, lw_, lh_).g;
                float sB = sampleBloom(lv, base + dirUv * dispAmt * 0.22, lw_, lh_).b;
                prism += vec3(sR, sG, sB) * wk;
                wsum += wk;
            }
            prism /= max(wsum, 1e-3);
            vec3 core = mix(tightGlow, midGlow, 0.5) * vec3(1.06, 1.00, 0.92);
            vec3 g = prism * 1.15 + core * 0.30;
            g = gateGlow(g, L.diffuseSpGlowThreshold, exMin);
            g = colorizeGlow(g, ambientCol, 0.55);
            g *= mix(vec3(1.0), gLightCol, 0.35);                              // inherit the light's own colour
            float prox = 1.0 / (1.0 + dL * dL * mix(14.0, 3.0, r));            // closer to the light = stronger
            float receiveD = 1.0 - smoothstep(0.55, 1.15, luma(linearBase));    // already-bright pixels receive less
            float gain = mix(0.30, 1.0, prox) * mix(0.55, 1.0, gLightStrength);
            linearBase += g * (L.diffuseSpGlowIntensity * 1.5) * gain * receiveD * (1.0 - lineEdge * 0.25) * op;
        }

        // ---- 4a. Sapphire edge glow: a crisp, bright CONTOUR that hugs the edges ----
        // Full-res Sobel gives the contour itself; a tight blurred copy of the edge mask gives the short
        // falloff next to it. Colour comes from the BRIGHT side of the edge, so it reads as the edge
        // lighting up (Sapphire-style), not as a flat white line.
        {
            float sapInt = 0.0;
            if (L.copiedEdgeRays > 0.01) sapInt = L.copiedEdgeRays;
            else if (L.sapphireGlowWidth > 0.01) sapInt = 0.8;
            if (sapInt > 0.01) {
                float widthN = clamp(L.sapphireGlowWidth * 0.5, 0.0, 1.0);          // 0..1 (slider is 0..2)
                float sens = clamp(L.sapphireGlowThreshold, 0.1, 0.99);
                float lo = sens * 0.30;
                float crisp = smoothstep(lo, lo + 0.18, lineEdge);
                // brightest neighbour across the edge = the lit side
                int ss = max(2, edgeStep * 2);
                vec3 n0 = compAt(coord + ivec2( ss, 0), width, height);
                vec3 n1 = compAt(coord + ivec2(-ss, 0), width, height);
                vec3 n2 = compAt(coord + ivec2(0,  ss), width, height);
                vec3 n3 = compAt(coord + ivec2(0, -ss), width, height);
                vec3 lit = n0;
                if (luma(n1) > luma(lit)) lit = n1;
                if (luma(n2) > luma(lit)) lit = n2;
                if (luma(n3) > luma(lit)) lit = n3;
                float ll = max(luma(lit), 1e-4);
                vec3 hueL = saturateColor(clamp(lit / ll, vec3(0.05), vec3(4.0)), 1.45);
                hueL /= max(luma(hueL), 1e-4);
                float lvl = clamp(ll * 1.5 + 0.25, 0.30, 1.60);
                vec3 edgeCol = hueL * lvl + ambientNear * 0.15;
                edgeCol = mix(edgeCol, edgeCol * glowTint + glowTint * 0.10 * luma(edgeCol), step(0.5, L.edgeGlowTint) * 0.65);
                // short falloff just outside the contour (tight -> mid with the width slider)
                float eBlur = mix(tightS.a, midS.a, widthN) * (1.2 + widthN * 1.2);
                float field = clamp(crisp * 1.00 + eBlur * (1.0 - crisp * 0.5) * 0.85, 0.0, 1.6);
                linearBase += edgeCol * field * sapInt * 0.85 * op;
            }
        }

        // ---- 4b. Edge Halo: a wide, soft AURA that spills OUTWARD from silhouettes ----
        // Opposite of Sapphire: no contour at all (it is masked off the line itself), very wide, built
        // from the coarse edge mask, tinted by the surrounding ambient light, and it prefers the darker
        // side of an edge so it reads as light bleeding out into the background.
        if (L.edgeHaloRadius > 0.01) {
            float hs = clamp(L.edgeHaloRadius / 1.5, 0.0, 1.0);
            float eWide = mix(midS.a, wideS.a, 0.35 + 0.65 * hs);
            float eH = 1.0 - exp(-eWide * (2.4 + 2.0 * hs));
            float la = luma(ambientCol);
            float lp = luma(linearBase);
            float outward = smoothstep(0.0, 0.50, (la - lp) / (la + 0.05));
            float sideGate = mix(0.35, 1.0, outward);
            vec3 haloCol = saturateColor(ambientCol * 1.15 + wideGlow * 1.4 + midGlow * 0.4, 1.25);
            haloCol *= mix(vec3(1.0), glowTint, 0.70);
            linearBase += haloCol * eH * sideGate * L.edgeHaloRadius * 0.60 * (1.0 - lineEdge * 0.65) * op;
        }

        // ---- 5. Anamorphic streak: continuous, jittered, scene-coloured (no stepped copies) ----
        if (L.thinStreakIntensity > 0.01 && L.thinStreakOpacity > 0.01) {
            float halfLen = clamp(L.thinStreakWidth, 0.05, 2.0) * 0.30;
            const int SN = 40;
            int w8 = max(width / 8, 1);
            int h8 = max(height / 8, 1);
            int w4 = max(width / 4, 1);
            int h4 = max(height / 4, 1);
            // per-pixel jitter: taps never land on the same lattice twice, so no ghosted repeats
            float jit = hashInt12(coord * 3 + ivec2(17, 91)) - 0.5;
            vec3 sSum = vec3(0.0);
            float wSumS = 0.0;
            for (int s = -SN; s <= SN; s++) {
                float t = (float(s) + jit) / float(SN);
                float at = abs(t);
                float wgt = exp(-at * 3.0) * (1.0 - smoothstep(0.70, 1.0, at));
                vec2 suv = vec2(clamp(uv.x + t * halfLen, 0.0, 1.0), uv.y);
                vec3 sm = mix(sampleBloom(1, suv, w4, h4).rgb, sampleBloom(2, suv, w8, h8).rgb, 0.55);
                float gate = smoothstep(0.18, 0.70, luma(sm));
                vec3 spectral = mix(vec3(0.80, 1.00, 1.30), vec3(1.25, 0.85, 0.55), at);
                sSum += sm * gate * wgt * mix(vec3(1.0), spectral, 0.22);
                wSumS += wgt;
            }
            vec3 streak = sSum / max(wSumS, 1e-3) * 1.6;
            streak = colorizeGlow(streak, ambientCol, 0.70);
            streak = saturateColor(streak, 1.25) * mix(vec3(1.0), glowTint, 0.60);
            // soft shoulder (never hard-clips), and it reads less on already-bright backgrounds
            streak = vec3(1.0) - exp(-streak);
            streak *= 1.0 - 0.45 * clamp(luma(linearBase), 0.0, 1.0);
            linearBase += streak * L.thinStreakIntensity * L.thinStreakOpacity * op;
        }

        // ---- 6. Pro-Mist diffusion + red/orange halation ----
        if (L.copiedProMist > 0.01) {
            vec3 mist = mix(midGlow, wideGlow, 0.55);
            mist = gateGlow(mist, 0.40, exMin);
            vec3 m2 = mist * (L.copiedProMist * 1.25) * (1.0 - lineEdge * 0.65);
            linearBase += m2 * op;
            // diffusion also gently flattens contrast
            float l0 = luma(linearBase);
            linearBase = mix(linearBase, vec3(l0) + (linearBase - vec3(l0)) * 0.97, clamp(L.copiedProMist * 0.5, 0.0, 0.5));
        }
        if (L.halationRadius > 0.01) {
            float r = clamp(L.halationRadius / 1.5, 0.0, 1.0);
            vec3 hal = mix(tightGlow, mix(midGlow, wideGlow, 0.5), r);
            float warm = clamp(L.halationWarmth / 1.5, 0.0, 1.0);
            vec3 halTint = mix(vec3(1.00, 0.30, 0.12), vec3(1.00, 0.52, 0.20), warm);
            float hl = luma(hal);
            vec3 halCol = halTint * hl * 1.35;
            linearBase += halCol * (1.0 - lineEdge * 0.6) * L.halationRadius * 1.1 * op;
        }

        // ---- 7. Atmosphere haze / scatter (glow-driven) ----
        if (L.bslaBloomHaze > 0.01) {
            vec3 hz = mix(wideGlow, vec3(luma(wideGlow)) * vec3(0.78, 0.90, 1.10), 0.35);
            linearBase += hz * L.bslaBloomHaze * 1.2 * op;
        }
        if (L.bslFogScatter > 0.01) {
            vec3 sc = mix(midGlow, wideGlow, 0.6) * vec3(1.05, 1.0, 0.92);
            linearBase += sc * L.bslFogScatter * 1.1 * op;
        }
    }

    // ---- Shaderly Glow: OVERALL glow (AE "Glow" effect) ----
    // Whole-frame, threshold-driven, always has a strong wide component and is SCREEN-blended (like AE's
    // Glow), so it lifts and softens the entire image rather than adding hot spots like Deep Glow.
    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5 || L.shaderlyGlowIntensity <= 0.01) continue;
        float r = clamp(L.shaderlyGlowRadius, 0.0, 1.0);
        float wT2 = 0.35 * (1.0 - r);
        float wM2 = 0.50;
        float wW2 = 0.40 + 0.60 * r;
        vec3 g = (tightGlow * wT2 + midGlow * wM2 + wideGlow * wW2) / (wT2 + wM2 + wW2);
        g = gateGlow(g, L.shaderlyGlowThreshold, exMin);
        g = colorizeGlow(g, ambientCol, 0.90);
        g = saturateColor(g, 1.30);
        if (L.shaderlyGlowTint > 0.01) {
            vec3 tint = srgbToLinear(hueToRGB(fract(L.shaderlyGlowTint)));
            g = mix(g, tint * luma(g) * 2.2, 0.55);
        }
        // exposure-style shoulder, then Screen against the image (never clips highlights)
        vec3 gl = vec3(1.0) - exp(-g * (L.shaderlyGlowIntensity * 2.4));
        vec3 cb = clamp(linearBase, 0.0, 1.0);
        vec3 screened = cb + gl - cb * gl + max(linearBase - 1.0, vec3(0.0));
        linearBase = mix(linearBase, screened, clamp(L.opacity, 0.0, 1.0) * (1.0 - lineEdge * 0.30));
    }

    // ---- Master tonemap -> sRGB ----
    vec3 finalLinear = applyToneMapping(linearBase, u_tonemapMode);
    vec3 finalDisplay = linearToSrgb(finalLinear);

    // ---- LUT: display-referred, after tonemap ----
    if (u_hasLut > 0.5) {
        finalDisplay = sample3DLutDisplay(finalDisplay, u_lutOpacity);
    }

    // ---- TPDF dither right before the quantise (+-1 LSB triangular, scaled) ----
    float lsb = (bitMode > 1.5) ? (1.0 / 65535.0) : (1.0 / 255.0);
    float amt = mix(0.50, 1.00, clamp(u_ditherStrength, 0.0, 1.0));   // 1.0 = exact +-1 LSB triangular
    ivec2 shift = ivec2(int(fract(u_time * 0.1371) * 997.0), int(fract(u_time * 0.0713) * 991.0));
    float n1 = hashInt12(coord + shift);
    float n2 = hashInt12(coord + shift + ivec2(41, 17));
    float tpdf = (n1 + n2) - 1.0;
    vec3 chroma = vec3(tpdf, (hashInt12(coord + shift + ivec2(7, 91)) + hashInt12(coord + shift + ivec2(113, 3)) - 1.0),
                       (hashInt12(coord + shift + ivec2(59, 29)) + hashInt12(coord + shift + ivec2(5, 211)) - 1.0));
    finalDisplay = clamp(finalDisplay + mix(vec3(tpdf), chroma, 0.35) * lsb * amt, 0.0, 1.0);

    packFinalDisplay(pixelIndex, vec4(finalDisplay, 1.0), bitMode);
}

// =============================================================================
// MAIN
// =============================================================================
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    int width = u_passWidth;
    int height = u_passHeight;

    // Dominant-light scan uses shared memory + barrier(), so it must run before the bounds return.
    // Both conditions are dispatch-uniform, so every invocation in the group takes the same path.
    if (u_passIndex == 6 && diffuseLayerActive()) {
        detectDominantLight(width, height);
    }

    if (coord.x >= width || coord.y >= height) return;

    gW = int(round(u_imgWidth)) > 0 ? width : width;
    gH = height;
    gBit = u_bitDepthMode;
    gRes = float(max(width, height)) / 720.0;
    gEdgeStep = max(1, int(round(gRes)));

    if (u_passIndex == 1) {
        executeHighlightExtraction(coord, width, height, int(u_imgWidth), int(u_imgHeight));
        return;
    } else if (u_passIndex == 2 || u_passIndex == 3) {
        executeBloomDownsample(u_passIndex, coord, width, height, u_passRadius);
        return;
    } else if (u_passIndex == 4 || u_passIndex == 5) {
        executeBloomUpsample(u_passIndex, coord, width, height, u_passRadius);
        return;
    } else if (u_passIndex == 6) {
        executeFinalComposite(coord, width, height);
        return;
    }

    // =========================================================================
    // PASS 0: PRIMARY GRADE -> HDR half-float composite
    // =========================================================================
    int pixelIndex = coord.y * width + coord.x;
    vec4 rawPixel = unpackRGBA_Dynamic(pixelIndex, gBit);
    float resScale = gRes;
    int edgeStep = gEdgeStep;
    vec2 uvN = (vec2(coord) + 0.5) / vec2(width, height);

    // ---- STAGE 1: DEBAND (works in gamma space, restores 8-bit source gradients) ----
    vec3 srcS = rawPixel.rgb;
    {
        float dRad = 0.0;
        float dThr = 0.02;
        int totalL = int(clamp(u_layerCount, 1.0, 10.0));
        for (int i = 0; i < totalL; i++) {
            if (layers[i].isEnabled > 0.5 && layers[i].debandRadius > dRad) {
                dRad = layers[i].debandRadius;
                dThr = layers[i].debandThreshold;
            }
        }
        if (dRad > 0.01) {
            float radius = max(1.5, dRad * 7.0 * resScale);
            float thr = max(dThr, 0.004) * 1.6;
            float rot = hash12(vec2(coord) + 3.7) * 6.2831853;
            vec3 sum = srcS;
            vec3 cnt = vec3(1.0);
            for (int k = 0; k < 14; k++) {
                float fr = (float(k) + 0.5) / 14.0;
                float ang = rot + float(k) * 2.39996323;
                float rr = (0.25 + 0.75 * fr) * radius;
                vec3 s = srcSrgb(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr)));
                vec3 m = step(abs(s - srcS), vec3(thr));
                sum += s * m;
                cnt += m;
            }
            vec3 avg = sum / cnt;
            vec3 n = vec3(hash12(vec2(coord) * 1.13 + 11.0), hash12(vec2(coord) * 0.77 + 51.0), hash12(vec2(coord) * 1.71 + 91.0)) - 0.5;
            srcS = clamp(avg + n * (1.0 / 255.0) * clamp(dRad, 0.0, 1.0), 0.0, 1.0);
        }
    }
    vec3 src0 = srgbToLinear(srcS);
    vec3 currentComposite = src0;

    // ---- STAGE 2: LINE THINNING (layer 0 slot, kept as-is) ----
    LayerData L0 = layers[0];
    if (L0.lineThinning > 0.01) {
        vec3 colT = srcLin(coord + ivec2(0,  edgeStep));
        vec3 colB = srcLin(coord + ivec2(0, -edgeStep));
        vec3 colL = srcLin(coord + ivec2(-edgeStep, 0));
        vec3 colR = srcLin(coord + ivec2( edgeStep, 0));
        float lumaC = luma(currentComposite);
        float lumaT = luma(colT); float lumaB = luma(colB);
        float lumaL = luma(colL); float lumaR = luma(colR);
        float edgeGrad = sqrt((lumaR - lumaL) * (lumaR - lumaL) + (lumaT - lumaB) * (lumaT - lumaB));
        if (edgeGrad > L0.lineThinningThreshold) {
            float minLuma = min(min(lumaT, lumaB), min(lumaL, lumaR));
            if (minLuma < lumaC) {
                vec3 darkest = colT;
                if (lumaB == minLuma) darkest = colB;
                if (lumaL == minLuma) darkest = colL;
                if (lumaR == minLuma) darkest = colR;
                currentComposite = mix(currentComposite, darkest, clamp(L0.lineThinning * 0.65, 0.0, 1.0));
            }
        }
    }

    // ---- Sobel gradient (source) for edge normal / line masks ----
    float gx = 0.0;
    float gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            float lum = luma(srcLin(coord + ivec2(x * edgeStep, y * edgeStep)));
            gx += lum * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lum * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);
    vec2 edgeNormal = (lineEdge > 0.05) ? normalize(vec2(gx, gy)) : vec2(0.0);

    // ---- STAGE 3: MULTI-LAYER STACK ----
    int totalLayers = int(clamp(u_layerCount, 1.0, 10.0));

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;

        vec3 layerColor = currentComposite;

        // 1. Depth of field (tilt band or radial), disc blur with bokeh highlight emphasis
        if (L.depthOfField > 0.01) {
            float dist;
            if (L.dofMode > 0.5) {
                vec2 dd = uvN - vec2(0.5, L.dofFocus);
                dd.x *= float(width) / float(height);
                dist = length(dd);
            } else {
                dist = abs(uvN.y - L.dofFocus);
            }
            float rng = clamp(L.dofRange, 0.0, 1.0) * 0.5;
            float fall = max(0.02, L.dofFalloff * 0.6);
            float coc = smoothstep(rng, rng + fall, dist);
            float r = coc * L.depthOfField * 22.0 * resScale;
            if (r > 0.6) {
                vec3 acc = vec3(0.0);
                float wsum = 0.0;
                const int DOF_TAPS = 28;
                for (int k = 0; k < DOF_TAPS; k++) {
                    float fr = (float(k) + 0.5) / float(DOF_TAPS);
                    float rr = sqrt(fr) * r;
                    float th = float(k) * 2.39996323 + L.dofAngle;
                    vec3 s = srcLin(coord + ivec2(round(vec2(cos(th), sin(th)) * rr)));
                    float lw = 1.0 + L.dofBokeh * 6.0 * smoothstep(0.55, 1.2, luma(s));
                    acc += s * lw;
                    wsum += lw;
                }
                layerColor += (acc / wsum - src0) * smoothstep(0.0, 0.15, coc);
            }
        }

        // 2. Edge chromatic aberration (delta)
        if (L.lineChromaStrength > 0.001 && lineEdge > 0.05) {
            float edgeFactor = smoothstep(0.08, 0.35, lineEdge);
            ivec2 sh = ivec2(edgeNormal * (L.lineChromaStrength * 3.0 * resScale));
            vec3 sr = srcLin(coord + sh);
            vec3 sb = srcLin(coord - sh);
            layerColor.r += (sr.r - src0.r) * edgeFactor * 0.80;
            layerColor.b += (sb.b - src0.b) * edgeFactor * 0.80;
        }

        // 3. RGB directional warp shift (delta)
        if (L.copiedChromaShift > 0.001) {
            ivec2 cs = ivec2(int(L.copiedChromaShift * 6.0 * resScale), 0);
            vec3 sr = srcLin(coord + cs);
            vec3 sb = srcLin(coord - cs);
            layerColor.r += sr.r - src0.r;
            layerColor.b += sb.b - src0.b;
        }

        // 4. Denoise: edge-aware bilateral, chroma cleaned harder than luma
        if (L.denoise > 0.01) {
            float dn = clamp(L.denoise, 0.0, 1.0);
            int dRad = clamp(int(round(1.0 + dn * 2.6 * resScale * 0.8)), 1, 4);
            float sigS = max(1.2, float(dRad) * 0.7);
            float sigR = mix(0.035, 0.18, dn);
            vec3 pc = sqrt(src0);
            vec3 acc = src0;
            float wsum = 1.0;
            for (int dy = -dRad; dy <= dRad; dy++) {
                for (int dx = -dRad; dx <= dRad; dx++) {
                    if (dx == 0 && dy == 0) continue;
                    vec3 s = srcLin(coord + ivec2(dx, dy));
                    vec3 ps = sqrt(s);
                    float sd = float(dx * dx + dy * dy);
                    vec3 dc = pc - ps;
                    float rd = dot(dc, dc);
                    float w = exp(-sd / (2.0 * sigS * sigS)) * exp(-rd / (2.0 * sigR * sigR));
                    acc += s * w;
                    wsum += w;
                }
            }
            vec3 avg = acc / wsum;
            float lC = luma(src0);
            float lA = luma(avg);
            vec3 target = vec3(mix(lC, lA, clamp(dn * 0.85, 0.0, 1.0))) + mix(src0 - vec3(lC), avg - vec3(lA), clamp(dn * 1.15, 0.0, 1.0));
            layerColor += (max(target, vec3(0.0)) - src0) * (1.0 - lineEdge * 0.25);
        }

        // 5. Anime skin smoothing: Oklab skin-tone mask + ink-line shielding.
        //    Only skin-toned areas are smoothed; ink lines never bleed into the skin.
        if (L.bilateralIntensity > 0.01) {
            vec3 lab0 = linearRgbToOklab(src0);
            float chroma0 = length(lab0.yz);
            float hue0 = atan(lab0.z, lab0.y);
            float skin = smoothstep(0.30, 0.55, hue0) * (1.0 - smoothstep(1.20, 1.50, hue0))
                       * smoothstep(0.015, 0.040, chroma0) * (1.0 - smoothstep(0.13, 0.19, chroma0))
                       * smoothstep(0.42, 0.62, lab0.x);
            // ink shielding: own gradient + dark-line proximity (centre and 4 neighbours)
            float inkMax = 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord)));
            int inkR = max(2, edgeStep * 2);
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord + ivec2(inkR, 0)))));
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord - ivec2(inkR, 0)))));
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord + ivec2(0, inkR)))));
            inkMax = max(inkMax, 1.0 - smoothstep(0.08, 0.28, luma(srcSrgb(coord - ivec2(0, inkR)))));
            float prot = (1.0 - smoothstep(0.08, 0.30, lineEdge)) * (1.0 - inkMax);
            if (skin > 0.01 && prot > 0.01) {
                float rad = clamp(L.bilateralRadius * resScale * 0.7, 1.0, 6.0);
                int bRad = int(ceil(rad));
                int stp = (bRad > 3) ? 2 : 1;
                float sigS = max(1.0, rad * 0.65);
                float sigR = max(L.bilateralRange, 0.03) * 0.6;
                vec3 pc = sqrt(src0);
                vec3 acc = src0;
                float wsum = 1.0;
                for (int dy = -bRad; dy <= bRad; dy += stp) {
                    for (int dx = -bRad; dx <= bRad; dx += stp) {
                        if (dx == 0 && dy == 0) continue;
                        vec3 s = srcLin(coord + ivec2(dx, dy));
                        vec3 dc = pc - sqrt(s);
                        float inkTap = smoothstep(0.012, 0.060, luma(s));   // near-black ink never contributes
                        float w = exp(-float(dx * dx + dy * dy) / (2.0 * sigS * sigS)) * exp(-dot(dc, dc) / (2.0 * sigR * sigR)) * inkTap;
                        acc += s * w;
                        wsum += w;
                    }
                }
                vec3 smoothC = acc / wsum;
                layerColor += (smoothC - src0) * clamp(L.bilateralIntensity, 0.0, 1.0) * skin * prot;
                layerColor *= 1.0 + skin * prot * L.bilateralIntensity * 0.035;
            }
        }

        // 6. Frequency unsharp mask (delta on source detail)
        if (L.unsharpAmount > 0.01) {
            int uRad = int(clamp(L.unsharpRadius * resScale, 1.0, 6.0));
            vec3 lowPass = vec3(0.0);
            float uW = 0.0;
            for (int uy = -uRad; uy <= uRad; uy += 2) {
                for (int ux = -uRad; ux <= uRad; ux += 2) {
                    lowPass += srcLin(coord + ivec2(ux, uy));
                    uW += 1.0;
                }
            }
            lowPass /= max(uW, 1.0);
            vec3 highPass = src0 - lowPass;
            float diffLum = abs(luma(highPass));
            if (diffLum >= L.unsharpThreshold) {
                float boost = smoothstep(L.unsharpThreshold, L.unsharpThreshold + 0.10, diffLum);
                layerColor += highPass * (L.unsharpAmount * boost * 1.3);
            }
        }

        // 7. Acutance sharpness (delta)
        if (L.sharpness > 0.01) {
            vec3 blur = srcLin(coord + ivec2(0, -edgeStep)) + srcLin(coord + ivec2(0, edgeStep))
                      + srcLin(coord + ivec2(-edgeStep, 0)) + srcLin(coord + ivec2(edgeStep, 0));
            blur *= 0.25;
            layerColor += (src0 - blur) * (L.sharpness * 1.5);
        }

        // 8. S_lining: line-art detection -> tiny inner grey-black blur on the edges
        //    slider 1 (darkOutlines) = intensity + radius, slider 2 (sLiningOpacity) = opacity
        if (L.darkOutlines > 0.01 && L.sLiningOpacity > 0.01) {
            float radius = (1.6 + L.darkOutlines * 5.0) * resScale;
            float sigma = radius * 0.55;
            float cLuma = dot(srcSrgb(coord), vec3(0.2126, 0.7152, 0.0722));
            float centerLine = 1.0 - smoothstep(0.06, 0.30, cLuma);
            float acc = 0.0;
            float wacc = 0.0;
            const int SL_TAPS = 22;
            for (int k = 0; k < SL_TAPS; k++) {
                float fr = (float(k) + 0.5) / float(SL_TAPS);
                float rr = sqrt(fr) * radius;
                float ang = float(k) * 2.39996323;
                float sl = dot(srcSrgb(coord + ivec2(round(vec2(cos(ang), sin(ang)) * rr))), vec3(0.2126, 0.7152, 0.0722));
                float lineness = 1.0 - smoothstep(0.06, 0.30, sl);
                float w = exp(-(rr * rr) / (2.0 * sigma * sigma));
                acc += lineness * w;
                wacc += w;
            }
            float halo = acc / max(wacc, 1e-4);
            float mask = (1.0 - exp(-halo * 4.2)) * (1.0 - centerLine);   // soft, saturating falloff
            vec3 inner = mix(layerColor * 0.12, vec3(0.020), 0.45);        // soft dark, not on the line itself
            float amt = mask * (0.85 + 0.65 * L.darkOutlines) * L.sLiningOpacity * 1.25;
            layerColor = mix(layerColor, inner, clamp(amt, 0.0, 1.0));
        }
        if (L.edgeDarken > 0.01) {
            float innerEdge = smoothstep(0.10, 0.45, lineEdge);
            layerColor *= (1.0 - innerEdge * L.edgeDarken * 0.40);
        }

        // 9. Colour temperature
        if (L.temperature > 1000.0 && abs(L.temperature - 6500.0) > 30.0) {
            layerColor *= colorTempToRGB(L.temperature) / colorTempToRGB(6500.0);
        }

        // ---- OKLAB perceptual grading ----
        vec3 lab = linearRgbToOklab(layerColor);

        // 10. Exposure, contrast, shadows / highlights, gamma
        if (abs(L.brightness) > 0.001) lab.x += L.brightness * 0.35;
        if (abs(L.contrast - 1.0) > 0.001) lab.x = (lab.x - 0.50) * L.contrast + 0.50;
        lab.x = max(lab.x, 0.0);

        if (L.blackCrush > 0.01) lab.x = smoothstep(L.blackCrush * 0.08, 1.0, lab.x);

        lab.x += lab.x * (L.shadows * (1.0 - smoothstep(0.0, 0.45, lab.x)) * 0.30);
        lab.x += lab.x * (L.highlights * smoothstep(0.55, 1.0, lab.x) * 0.30);
        if (abs(L.gamma - 1.0) > 0.001) lab.x = pow(max(lab.x, 0.0), 1.0 / max(L.gamma, 0.001));

        // 11. Mojo teal & orange
        if (L.mblMojoTealOrange > 0.01) {
            float shadowMask = clamp(1.0 - lab.x * 1.8, 0.0, 1.0);
            float warmMask = clamp((lab.x - 0.35) * 1.5, 0.0, 1.0);
            lab.z -= shadowMask * L.mblMojoTealOrange * 0.045;
            lab.y -= shadowMask * L.mblMojoTealOrange * 0.015;
            lab.y += warmMask * L.mblMojoTealOrange * 0.025;
            lab.z += warmMask * L.mblMojoTealOrange * 0.035;
        }

        // 12. Deep teal with skin shielding
        if (L.deepTeal > 0.01) {
            float deepShadowMask = clamp(1.0 - lab.x * 1.8, 0.0, 1.0);
            bool isSkin = (lab.y > 0.015 && lab.z > 0.015);
            float shield = isSkin ? 0.15 : 1.0;
            lab.z -= deepShadowMask * L.deepTeal * 0.055 * shield;
            lab.y -= deepShadowMask * L.deepTeal * 0.025 * shield;
        }

        // 13. Colorista 3-way
        if (abs(L.mblColoristaLift) > 0.001 || abs(L.mblColoristaGamma) > 0.001 || abs(L.mblColoristaGain) > 0.001) {
            lab.x += L.mblColoristaLift * (1.0 - lab.x) * 0.35;
            lab.x = pow(max(0.0, lab.x), 1.0 / max(1.0 + L.mblColoristaGamma * 0.40, 0.01));
            lab.x += L.mblColoristaGain * lab.x * 0.35;
        }

        // 14. Cosmo skin protection
        if (L.cosmoCleanHighlight > 0.01) {
            float faceMask = smoothstep(0.50, 0.85, lab.x) * (1.0 - lineEdge);
            lab.yz = mix(lab.yz, lab.yz * 0.85, faceMask * L.cosmoCleanHighlight * 0.40);
        }

        // 15. Master curve on lightness (C1 monotone cubic, float precision -> no banding)
        if (!curveIsIdentity(L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4)) {
            lab.x = evalCurve5(lab.x, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);
        }
        if (L.magicCurves > 0.01) {
            float lx = clamp(lab.x, 0.0, 1.0);
            float s = lx * lx * (3.0 - 2.0 * lx);
            lab.x = mix(lab.x, s, L.magicCurves * 0.50);
        }

        // 16. Saturation & hue rotation
        // Saturation slider = saturation below 1.0, VIBRANCE above 1.0 (continuous at 1.0).
        //  0..1  : plain Oklab chroma scale (0 = fully grey)
        //  1..2.5: dull colours get the boost, already-vivid colours barely move, skin tones are
        //          protected, so pushing it up no longer turns skin/eyes neon or clips them.
        if (L.saturation <= 1.0) {
            lab.yz *= max(L.saturation, 0.0);
        } else {
            float boost = L.saturation - 1.0;
            float cch = length(lab.yz);
            float lowChroma = 1.0 - smoothstep(0.05, 0.28, cch);          // 1 = dull, 0 = already vivid
            float wv = mix(0.12, 1.0, lowChroma);                          // vivid colours still move a little
            float vh = atan(lab.z, lab.y);
            float skinV = smoothstep(0.30, 0.55, vh) * (1.0 - smoothstep(1.20, 1.50, vh))
                        * smoothstep(0.015, 0.040, cch) * (1.0 - smoothstep(0.13, 0.19, cch))
                        * smoothstep(0.42, 0.62, lab.x);
            wv *= 1.0 - 0.65 * skinV;
            lab.yz *= 1.0 + boost * wv;
        }
        if (abs(L.hue) > 0.001) lab.yz = oklabRotateHue(lab.yz, L.hue * 3.14159265);

        layerColor = oklabToLinearRgb(lab);

        // 17. Per-channel RGB curves, applied in gamma space (as AE does), no cross-channel tint
        {
            bool redOn = !curveIsIdentity(L.curveR0, L.curveR1, L.curveR2, L.curveR3, L.curveR4);
            bool grnOn = abs(L.curveG2 - 0.5) > 0.005;
            bool bluOn = abs(L.curveB2 - 0.5) > 0.005;
            if (redOn || grnOn || bluOn) {
                vec3 over = max(layerColor - 1.0, vec3(0.0));
                vec3 e = pow(clamp(layerColor, 0.0, 1.0), vec3(1.0 / 2.2));
                if (redOn) e.r = evalCurve5(e.r, L.curveR0, L.curveR1, L.curveR2, L.curveR3, L.curveR4);
                if (grnOn) {
                    float m = L.curveG2;
                    e.g = evalCurve5(e.g, 0.0, 0.25 + (m - 0.5) * 0.5, m, 0.75 + (m - 0.5) * 0.5, 1.0);
                }
                if (bluOn) {
                    float m = L.curveB2;
                    e.b = evalCurve5(e.b, 0.0, 0.25 + (m - 0.5) * 0.5, m, 0.75 + (m - 0.5) * 0.5, 1.0);
                }
                layerColor = pow(e, vec3(2.2)) + over;
            }
        }

        // 18. Split toning (per layer)
        if (L.splitToneShadowSat > 0.01 || L.splitToneHighSat > 0.01) {
            vec3 sTint = srgbToLinear(hueToRGB(L.splitToneShadowHue));
            vec3 hTint = srgbToLinear(hueToRGB(L.splitToneHighHue));
            float cl = luma(layerColor);
            float pivot = clamp(0.5 + L.splitToneBalance * 0.35, 0.1, 0.9);
            layerColor = mix(layerColor, layerColor * (sTint * 1.6 + vec3(0.1)), smoothstep(pivot, 0.0, cl) * L.splitToneShadowSat * 0.65);
            layerColor = mix(layerColor, layerColor * (hTint * 1.5 + vec3(0.1)), smoothstep(pivot, 1.0, cl) * L.splitToneHighSat * 0.65);
        }

        // 19. 4-point star glint
        float curLuma = luma(layerColor);
        if (L.copiedStarGlint > 0.01 && curLuma > 0.72) {
            float glint = 0.0;
            int gSpan = int(clamp(L.copiedStarGlint * 16.0 * resScale, 4.0, 24.0));
            for (int d = -gSpan; d <= gSpan; d += 2) {
                float decay = 1.0 - (abs(float(d)) / float(gSpan));
                glint += dot(srcLin(coord + ivec2(d, d)), vec3(0.333)) * decay;
                glint += dot(srcLin(coord + ivec2(d, -d)), vec3(0.333)) * decay;
            }
            glint = (glint / float(gSpan * 2)) * L.copiedStarGlint * 0.60;
            layerColor += vec3(glint);
        }

        // 20. Volumetric god rays
        if (L.bslaGodRays > 0.01) {
            vec2 sunPos = vec2(float(width) * 0.50, float(height) * 0.06);
            vec2 rayDir = normalize(vec2(coord) - sunPos + vec2(0.0001));
            vec3 rayAccum = vec3(0.0);
            float rayWeight = 0.0;
            float stepSize = float(max(width, height)) / 36.0;
            float jitter = hash12(vec2(coord) + vec2(u_time));
            for (int s = 1; s <= 20; s++) {
                float dist = (float(s) + jitter) * stepSize * 0.38;
                vec3 scCol = srcLin(ivec2(vec2(coord) - rayDir * dist));
                float shaftMask = smoothstep(0.50, 0.92, luma(scCol));
                float decay = exp(-0.07 * float(s));
                rayAccum += scCol * shaftMask * decay;
                rayWeight += decay;
            }
            if (rayWeight > 0.001) {
                layerColor += (rayAccum / rayWeight) * (L.bslaGodRays * 2.2) * vec3(1.15, 1.05, 0.90);
            }
        }

        // 21. Volumetric fog (BSL-shader style)
        //     * pseudo view distance: higher in frame = further away, plus a separate ground-fog layer
        //     * domain-warped, drifting fbm gives cloud banks + wisps (not a flat overlay)
        //     * per-channel Beer-Lambert extinction: blue scatters/extinguishes a bit more, so distance
        //       goes cool and desaturated the way real fog does
        //     * in-scatter colour comes from the scene's own sky/ground, plus a forward-scatter (Mie)
        //       sun glow around the same sun position the god rays use
        //     sliders: Fog Density = optical thickness, Fog Depth = how far the fog reaches / how high
        //     the ground fog climbs
        if (L.bslaFogDensity > 0.01) {
            float sigma = clamp(L.bslaFogDensity, 0.0, 1.0);
            float reach = clamp(L.bslaFogDepth, 0.0, 1.0);
            float aspectF = float(width) / float(height);
            float tf = u_time * 0.030;
            float yy = clamp(uvN.y, 0.0, 1.0);                       // 0 = top of frame, 1 = bottom

            // --- noise: domain warp -> banks (low freq) + wisps (high freq) + sun-aligned shafts ---
            vec2 wp = uvN * vec2(2.2 * aspectF, 2.2);
            vec2 warp = vec2(fbm(wp + vec2(tf, 3.1)), fbm(wp + vec2(7.7, -tf * 0.8))) - 0.5;
            vec2 npos = wp + warp * 1.6;
            float bank = fbm(npos * 1.0 + vec2(tf * 1.0, -tf * 0.45));
            float wisp = fbm(npos * 3.4 + vec2(-tf * 1.7, tf * 0.9) + 31.7);
            float vol = smoothstep(0.22, 0.82, mix(bank, wisp, 0.35));

            // --- pseudo depth + height fog ---
            float distFar = 1.0 - yy * 0.62;                                        // 0.38 (near) .. 1.0 (far)
            float groundFog = smoothstep(1.0 - (0.28 + reach * 0.62), 1.0, yy);   // thicker towards the bottom
            float column = (0.40 + 0.75 * reach) * distFar + 0.85 * groundFog;
            float dens = sigma * column * mix(0.40, 1.65, vol);

            // --- sun: same position as the god rays, forward-scatter lobe + soft shafts through the fog ---
            vec2 sunUV = vec2(0.50, 0.06);
            float sd = length((uvN - sunUV) * vec2(aspectF, 1.0));
            float mieTight = exp(-sd * 7.0);
            float mieWide = exp(-sd * 2.2);
            float shafts = fbm(vec2(uvN.x * 15.0 * aspectF, uvN.y * 1.4 - tf * 0.6) + 5.3);
            dens *= 1.0 + 0.30 * (shafts - 0.5) * mieWide;

            // keep ink / fine character detail readable: fog is thinner where detail is dense (= nearer)
            dens *= 1.0 - 0.30 * smoothstep(0.10, 0.50, lineEdge);
            dens = max(dens, 0.0);

            // --- Beer-Lambert, slightly stronger extinction in blue ---
            vec3 trans = exp(-dens * 3.2 * vec3(0.92, 1.00, 1.12));

            // --- in-scatter colour: sky above, ground below, both from the actual scene ---
            vec3 skyC = (srcLin(ivec2(width / 4, height / 8)) + srcLin(ivec2(3 * width / 4, height / 8))) * 0.5;
            vec3 gndC = (srcLin(ivec2(width / 4, 7 * height / 8)) + srcLin(ivec2(3 * width / 4, 7 * height / 8))) * 0.5;
            vec3 amb = (skyC + gndC) * 0.5;
            vec3 cool = srgbToLinear(vec3(0.62, 0.72, 0.84));
            vec3 hazeBase = mix(skyC, gndC, smoothstep(0.30, 0.95, yy));
            vec3 fogCol = mix(cool, hazeBase * 1.40 + cool * 0.20, 0.45);
            float ambL = clamp(luma(amb) * 2.4 + clamp(luma(layerColor), 0.0, 1.0) * 0.5, 0.0, 1.2);
            fogCol *= (0.30 + 0.70 * ambL);
            fogCol *= 1.0 + (bank - 0.5) * 0.40;                                  // lit banks vs shadowed banks
            vec3 sunTint = vec3(1.00, 0.80, 0.55);
            fogCol += sunTint * (mieWide * 0.16 + mieTight * 0.34) * (0.35 + 0.65 * vol) * (0.30 + 0.70 * ambL);
            fogCol = max(fogCol, vec3(0.0));

            layerColor = layerColor * trans + fogCol * (vec3(1.0) - trans);
        }

        // 23. Film grain (luma-weighted, grows in mids like real stock)
        if (L.filmGrain > 0.001) {
            float noise = (hash12(vec2(coord) + vec2(u_time * 17.13, u_time * 31.37)) - 0.5);
            float lw = 0.35 + 0.65 * (1.0 - abs(clamp(luma(layerColor), 0.0, 1.0) - 0.45) * 1.4);
            layerColor += vec3(noise * L.filmGrain * 0.06 * lw);
        }

        // 24. Flicker
        if (L.flickerIntensity > 0.005) {
            float freq = max(L.flickerSpeed, 1.0) * 6.2831853;
            float fWave = sin(u_time * freq) * 0.5 + 0.5;
            layerColor *= (1.0 + (fWave - 0.5) * L.flickerIntensity * 0.30);
        }

        // 25. Vignettes (slightly gentler than v1)
        if (L.vignette > 0.01) {
            vec2 vuv = uvN - 0.5;
            layerColor *= clamp(smoothstep(0.78, 0.18, length(vuv) * (0.62 + L.vignette * 0.58)), 0.0, 1.0);
        }
        if (L.vignetteBoxed > 0.01) {
            vec2 buv = abs(uvN - 0.5) * 2.0;
            layerColor *= clamp(smoothstep(0.98, 0.22, max(buv.x, buv.y) * (0.62 + L.vignetteBoxed * 0.58)), 0.0, 1.0);
        }

        // 26. Centre aura + horizontal ramp
        if (L.centerAura > 0.01) {
            layerColor += vec3(smoothstep(0.60, 0.0, length(uvN - 0.5)) * L.centerAura * 0.30);
        }
        if (L.horizontalRamp > 0.01) {
            layerColor *= (1.0 + smoothstep(0.35, 0.65, uvN.y) * L.horizontalRamp * 0.30);
        }

        // Composite this layer (gamma-space blending by default = AE)
        currentComposite = applyBlendMode(currentComposite, max(layerColor, vec3(0.0)), int(L.blendMode + 0.5), L.opacity, L.blendLinear > 0.5);
    }

    // 28. Stylized metallic text bevel: reads the scene colour around the draggable box, grounds the
    //     text with a contact drop shadow, reflects a multi-band chrome horizon, adds specular glints
    //     and a reflective contour glow.
    if (u_textSuiteEnabled > 0.5) {
        vec2 boxMin = vec2(u_textBoxX, u_textBoxY);
        vec2 boxSize = max(vec2(u_textBoxW, u_textBoxH), vec2(1e-3));
        float tMargin = max(0.06, 0.45 * boxSize.y);        // room for shadow + glow outside the box
        bool inExt = (uvN.x >= boxMin.x - tMargin && uvN.x <= boxMin.x + boxSize.x + tMargin &&
                      uvN.y >= boxMin.y - tMargin && uvN.y <= boxMin.y + boxSize.y + tMargin);
        if (inExt) {
            float tDepth = clamp(u_textBevelDepth, 0.0, 4.0);
            float tChrome = clamp(u_textChromeIntensity, 0.0, 4.0) / 1.2;   // 1.2 = default look
            float tpx = max(resScale, 0.5);
            vec2 whPx = vec2(float(width), float(height));
            vec2 relBox = (uvN - boxMin) / boxSize;                           // 0..1 inside the box

            // ---- ambient scene colour: above / inside / below the box (text pixels excluded) ----
            vec3 skyAcc = vec3(0.0); vec3 midAcc = vec3(0.0); vec3 gndAcc = vec3(0.0);
            float skyWt = 0.0; float midWt = 0.0; float gndWt = 0.0;
            for (int ix = 0; ix < 4; ix++) {
                float bx = boxMin.x + ((float(ix) + 0.5) / 4.0) * boxSize.x;
                ivec2 pS = ivec2(vec2(bx, boxMin.y - 0.10 * boxSize.y - 0.02) * whPx);
                ivec2 pM = ivec2(vec2(bx, boxMin.y + 0.50 * boxSize.y) * whPx);
                ivec2 pG = ivec2(vec2(bx, boxMin.y + 1.10 * boxSize.y + 0.02) * whPx);
                float wS = 1.02 - textFillAt(pS);
                float wM = 1.02 - textFillAt(pM);
                float wG = 1.02 - textFillAt(pG);
                skyAcc += srcLin(pS) * wS; skyWt += wS;
                midAcc += srcLin(pM) * wM; midWt += wM;
                gndAcc += srcLin(pG) * wG; gndWt += wG;
            }
            vec3 skyAmb = skyAcc / max(skyWt, 1e-3);
            vec3 midAmb = midAcc / max(midWt, 1e-3);
            vec3 gndAmb = gndAcc / max(gndWt, 1e-3);
            vec3 skyRef = saturateColor(skyAmb * 0.7 + midAmb * 0.3, 1.35) * 1.5 + vec3(0.06);
            vec3 gndRef = saturateColor(gndAmb * 0.7 + midAmb * 0.3, 1.30) * 1.2 + vec3(0.03);

            // ---- bevel normal from a 3-scale height gradient of the text mask ----
            float fillC = textFillAt(coord);
            vec2 grad = vec2(0.0);
            for (int bi = 0; bi < 4; bi++) {
                float br = (bi == 0) ? 1.2 : ((bi == 1) ? 2.6 : ((bi == 2) ? 4.5 : 8.0));
                float bw = (bi == 0) ? 0.40 : ((bi == 1) ? 0.28 : ((bi == 2) ? 0.20 : 0.12));
                int bo = int(max(round(br * tpx), 1.0));
                grad.x += (textFillAt(coord + ivec2(bo, 0)) - textFillAt(coord - ivec2(bo, 0))) * bw;
                grad.y += (textFillAt(coord + ivec2(0, bo)) - textFillAt(coord - ivec2(0, bo))) * bw;
            }
            vec3 tN = normalize(vec3(-grad * (tDepth * 1.6), 1.0));
            vec3 tLight = normalize(vec3(-0.45, -0.60, 0.65));     // from the top-left
            float rimAmt = clamp(length(grad) * 3.0, 0.0, 1.0);    // 0 on flat faces, 1 on bevel slopes

            // ---- chrome: horizon bands shift with the bevel so the surface reacts to its shape ----
            float vText = clamp(relBox.y + tN.y * 0.10 * tDepth + tN.x * 0.02 * tDepth, 0.0, 1.0);
            vec3 chromeCol = chromeBands(vText, skyRef, gndRef) * tChrome;
            float lambert = clamp(dot(tN, tLight), 0.0, 1.0);
            chromeCol *= mix(0.65, 1.25, lambert);

            // ---- specular + sparkle glints (tinted by the scene) ----
            vec3 tH = normalize(tLight + vec3(0.0, 0.0, 1.0));
            float ndh = max(dot(tN, tH), 0.0);
            vec3 specTint = mix(vec3(1.0), skyRef / max(luma(skyRef), 1e-3), 0.30);
            float spec = pow(ndh, 36.0) * (0.35 + rimAmt) * 2.2;
            float cellSz = float(max(int(round(5.0 * tpx)), 2));
            float cellRnd = hashInt12(coord / ivec2(int(cellSz)));
            float sparkle = step(0.965, cellRnd) * smoothstep(0.45, 0.90, ndh) * rimAmt;
            chromeCol += specTint * (spec + sparkle * 2.4) * max(tChrome, 0.25);

            // ---- contact drop shadow + contour glow from blurred copies of the text mask ----
            float rotT = hash12(vec2(coord) * 0.73 + 5.1) * 6.2831853;
            vec2 shOff = vec2(2.5, 4.5) * tpx * (0.6 + 0.4 * tDepth);
            float blurNear = 0.0;
            float blurFar = 0.0;
            float shadowAcc = 0.0;
            vec3 ringCol = vec3(0.0);
            float ringW = 0.0;
            const int TX_TAPS = 16;
            for (int tk = 0; tk < TX_TAPS; tk++) {
                float tfr = (float(tk) + 0.5) / float(TX_TAPS);
                float tang = rotT + float(tk) * 2.39996323;
                vec2 tdir = vec2(cos(tang), sin(tang));
                ivec2 pNear = coord + ivec2(round(tdir * (3.0 + 5.0 * tfr) * tpx));
                ivec2 pFar  = coord + ivec2(round(tdir * (9.0 + 16.0 * tfr) * tpx));
                float fNear = textFillAt(pNear);
                float fFar  = textFillAt(pFar);
                blurNear += fNear;
                blurFar  += fFar;
                ringCol += srcLin(pNear) * fNear + srcLin(pFar) * fFar;
                ringW += fNear + fFar;
                shadowAcc += textFillAt(coord - ivec2(round(shOff)) + ivec2(round(tdir * (1.0 + 5.0 * tfr) * tpx)));
            }
            blurNear /= float(TX_TAPS);
            blurFar /= float(TX_TAPS);
            shadowAcc /= float(TX_TAPS);
            float outside = 1.0 - fillC;

            // the text's own colour (hue only, luma = 1): glow + metal follow it instead of fixed colours
            vec3 textHue = vec3(1.0);
            if (ringW > 0.5) {
                vec3 tcol = ringCol / ringW;
                float tl = max(luma(tcol), 1e-4);
                textHue = saturateColor(clamp(tcol / tl, vec3(0.05), vec3(6.0)), 1.25);
                textHue /= max(luma(textHue), 1e-4);
            }
            // 1 just inside the letter edges, 0 deep inside: drives the bright rim light
            float edgeIn = clamp(fillC * (1.0 - blurNear) * 2.2, 0.0, 1.0);
            // wide dark smoky halo behind the letters (makes the neon read as deep, like the reference)
            float smokeAcc = 0.0;
            for (int sk = 0; sk < 8; sk++) {
                float sa = rotT + float(sk) * 2.39996323;
                float sr = (26.0 + 34.0 * (float(sk) + 0.5) / 8.0) * tpx;
                smokeAcc += textFillAt(coord + ivec2(round(vec2(cos(sa), sin(sa)) * sr)));
            }
            float smoke = (smokeAcc / 8.0) * outside;

            // grounded shadow (tight contact + wide soft), tinted by the scene instead of pure black
            float contact = shadowAcc * outside;
            float soft = blurFar * outside * 0.35;
            vec3 shadowTint = mix(vec3(0.02), midAmb * 0.12, 0.5);
            currentComposite = mix(currentComposite, shadowTint, clamp(contact * 0.78 + soft * 0.45 + smoke * 0.55, 0.0, 0.92));

            // reflective contour glow: takes the chrome band colour of its own height, so it reads as light
            // bouncing off the metal rather than a flat halo
            vec3 glowBand = saturateColor(chromeBands(clamp(relBox.y, 0.0, 1.0), skyRef, gndRef), 1.4);
            float glowAmt = (blurNear * 0.9 + blurFar * 1.1) * outside;
            vec3 glowCol = mix(glowBand, textHue * max(luma(glowBand), 0.40), 0.65);
            vec3 contourGlow = glowCol * glowAmt * 0.60 * max(tChrome, 0.2);
            contourGlow *= 1.0 - 0.50 * clamp(luma(currentComposite), 0.0, 1.0);
            currentComposite += contourGlow;

            // finally the metal itself
            vec3 metal = chromeCol * mix(vec3(1.0), textHue, 0.55);
            metal += mix(vec3(1.0), textHue, 0.25) * pow(edgeIn, 1.6) * (0.55 + 0.45 * lambert) * 0.90 * max(tChrome, 0.25);
            currentComposite = mix(currentComposite, max(metal, vec3(0.0)), smoothstep(0.0, 1.0, fillC) * 0.96);
        }
    }

    // HDR half-float store. LUT + tonemap + dither happen in pass 6, after all glows.
    packComposite(pixelIndex, vec4(currentComposite, rawPixel.a));
}
