#version 450
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// =============================================================================
// STORAGE BUFFER BINDINGS
// =============================================================================
layout(std430, binding = 0) readonly buffer InputBuffer {
    uint in_pixels[];
};

layout(std430, binding = 1) buffer OutputBuffer {
    uint out_pixels[];
};

// 3D LUT Table: 32 x 32 x 32 = 32,768 RGB triplets (98,304 floats)
layout(std430, binding = 3) readonly buffer LutBuffer {
    float lut_table[];
};

// Dual Kawase Downsampled Pyramid Storage Buffers
layout(std430, binding = 4) buffer KawaseL0 {
    uint kawase_l0[]; // 1/2 resolution
};

layout(std430, binding = 5) buffer KawaseL1 {
    uint kawase_l1[]; // 1/4 resolution
};

layout(std430, binding = 6) buffer KawaseL2 {
    uint kawase_l2[]; // 1/8 resolution
};

// Push Constants for Multi-Pass Dual Kawase Routing
layout(push_constant) uniform PushConsts {
    int u_passIndex;   // 0: Main Grade + Prefilter, 1: Down1, 2: Down2, 3: Up1, 4: Up0, 5: Composite
    int u_passWidth;
    int u_passHeight;
    float u_passRadius;
};

// =============================================================================
// UNIFORM STRUCTURES (Exact 1:1 match with main.dart and vulkan_processor.cpp)
// =============================================================================
struct LayerData {
    float isEnabled;              // Offset 0
    float opacity;                // Offset 1
    float blendMode;              // Offset 2
    float brightness;             // Offset 3

    float saturation;             // Offset 4
    float contrast;               // Offset 5
    float sharpness;              // Offset 6
    float gamma;                  // Offset 7

    float hue;                    // Offset 8
    float temperature;            // Offset 9
    float deepGlowIntensity;      // Offset 10
    float deepGlowRadius;         // Offset 11

    float deepGlowThreshold;      // Offset 12
    float edgeGlowTint;           // Offset 13
    float thinStreakIntensity;    // Offset 14
    float thinStreakWidth;        // Offset 15

    float lineChromaStrength;     // Offset 16
    float volRaysLength;          // Offset 17
    float volRaysDecay;           // Offset 18
    float shadows;                // Offset 19

    float highlights;             // Offset 20
    float blackCrush;             // Offset 21
    float vignette;               // Offset 22
    float vignetteBoxed;          // Offset 23

    float edgeDarken;             // Offset 24
    float darkOutlines;           // Offset 25
    float denoise;                // Offset 26
    float filmGrain;              // Offset 27

    float flickerIntensity;       // Offset 28
    float flickerSpeed;           // Offset 29
    float halationRadius;         // Offset 30
    float halationWarmth;         // Offset 31

    float depthOfField;           // Offset 32
    float dofFocus;               // Offset 33
    float dofAngle;               // Offset 34
    float unsharpRadius;          // Offset 35

    float unsharpAmount;          // Offset 36
    float unsharpThreshold;       // Offset 37
    float curveM0;
    float curveM1;

    float curveM2;
    float curveM3;
    float curveM4;
    float curveR0;

    float curveR1;
    float curveR2;
    float curveR3;
    float curveR4;

    float curveG2;                // Offset 48
    float curveB2;                // Offset 49
    float sapphireGlowWidth;      // Offset 50
    float sapphireGlowThreshold;  // Offset 51

    float thinStreakOpacity;      // Offset 52
    float mblMojoTealOrange;      // Offset 53
    float bslaGodRays;            // Offset 54
    float bslaFogDensity;         // Offset 55

    float bslaFogDepth;           // Offset 56
    float bslaBloomHaze;          // Offset 57
    float bslFogScatter;          // Offset 58
    float cosmoCleanHighlight;    // Offset 59

    float mblColoristaLift;       // Offset 60
    float mblColoristaGamma;      // Offset 61
    float mblColoristaGain;       // Offset 62
    float centerAura;             // Offset 63
};

layout(std430, binding = 2) readonly buffer UniformBlock {
    float u_time;                 // 0
    float u_layerCount;            // 1
    float u_tonemapMode;           // 2
    float u_imgWidth;              // 3
    float u_imgHeight;             // 4
    float u_hasLut;                // 5
    float u_lutOpacity;            // 6
    float u_copiedChromaShift;     // 7
    float u_copiedEdgeRays;        // 8
    float u_copiedProMist;         // 9
    float u_copiedStarGlint;       // 10
    float u_horizontalRamp;        // 11
    float u_ditherStrength;        // 12
    
    float u_textSuiteEnabled;      // 13
    float u_textBoxX;              // 14
    float u_textBoxY;              // 15
    float u_textBoxW;              // 16
    float u_textBoxH;              // 17
    float u_textBevelDepth;        // 18
    float u_textChromeIntensity;   // 19

    float u_shaderlyGlowIntensity; // 20
    float u_shaderlyGlowRadius;    // 21
    float u_shaderlyGlowThreshold; // 22
    float u_splitToneShadowHue;    // 23
    float u_splitToneShadowSat;    // 24
    float u_splitToneHighHue;      // 25
    float u_splitToneHighSat;      // 26
    float u_splitToneBalance;      // 27

    float u_bitDepthMode;          // 28: 0.0 = 8-bit, 1.0 = 10-bit, 2.0 = 16-bit
    float u_reserved1;             // 29
    float u_reserved2;             // 30
    float u_reserved3;             // 31

    LayerData layers[4];           // 32 + (l * 64)
};

// -----------------------------------------------------------------------------
// BIT-DEPTH PRECISION UNPACK & PACK ENGINES (TRUE 8-BIT, 10-BIT, AND 16-BIT)
// -----------------------------------------------------------------------------
vec4 unpackRGBA_Dynamic(int pixelIndex, float bitMode) {
    if (bitMode > 1.5) {
        uint word0 = in_pixels[pixelIndex * 2];
        uint word1 = in_pixels[pixelIndex * 2 + 1];
        float r = float(word0 & 0xFFFFu) / 65535.0;
        float g = float((word0 >> 16u) & 0xFFFFu) / 65535.0;
        float b = float(word1 & 0xFFFFu) / 65535.0;
        float a = float((word1 >> 16u) & 0xFFFFu) / 65535.0;
        return vec4(r, g, b, a);
    } else if (bitMode > 0.5) {
        uint val = in_pixels[pixelIndex];
        float r = float(val & 0x3FFu) / 1023.0;
        float g = float((val >> 10u) & 0x3FFu) / 1023.0;
        float b = float((val >> 20u) & 0x3FFu) / 1023.0;
        float a = float((val >> 30u) & 0x3u) / 3.0;
        return vec4(r, g, b, a);
    } else {
        uint val = in_pixels[pixelIndex];
        float r = float(val & 0xFFu) / 255.0;
        float g = float((val >> 8u) & 0xFFu) / 255.0;
        float b = float((val >> 16u) & 0xFFu) / 255.0;
        float a = float((val >> 24u) & 0xFFu) / 255.0;
        return vec4(r, g, b, a);
    }
}

vec4 unpackOut_Dynamic(int pixelIndex, float bitMode) {
    if (bitMode > 1.5) {
        uint word0 = out_pixels[pixelIndex * 2];
        uint word1 = out_pixels[pixelIndex * 2 + 1];
        float r = float(word0 & 0xFFFFu) / 65535.0;
        float g = float((word0 >> 16u) & 0xFFFFu) / 65535.0;
        float b = float(word1 & 0xFFFFu) / 65535.0;
        float a = float((word1 >> 16u) & 0xFFFFu) / 65535.0;
        return vec4(r, g, b, a);
    } else if (bitMode > 0.5) {
        uint val = out_pixels[pixelIndex];
        float r = float(val & 0x3FFu) / 1023.0;
        float g = float((val >> 10u) & 0x3FFu) / 1023.0;
        float b = float((val >> 20u) & 0x3FFu) / 1023.0;
        float a = float((val >> 30u) & 0x3u) / 3.0;
        return vec4(r, g, b, a);
    } else {
        uint val = out_pixels[pixelIndex];
        float r = float(val & 0xFFu) / 255.0;
        float g = float((val >> 8u) & 0xFFu) / 255.0;
        float b = float((val >> 16u) & 0xFFu) / 255.0;
        float a = float((val >> 24u) & 0xFFu) / 255.0;
        return vec4(r, g, b, a);
    }
}

void packRGBA_Dynamic(int pixelIndex, vec4 col, float bitMode) {
    if (bitMode > 1.5) {
        uint r = uint(clamp(col.r * 65535.0 + 0.5, 0.0, 65535.0));
        uint g = uint(clamp(col.g * 65535.0 + 0.5, 0.0, 65535.0));
        uint b = uint(clamp(col.b * 65535.0 + 0.5, 0.0, 65535.0));
        uint a = uint(clamp(col.a * 65535.0 + 0.5, 0.0, 65535.0));
        out_pixels[pixelIndex * 2] = (g << 16u) | r;
        out_pixels[pixelIndex * 2 + 1] = (a << 16u) | b;
    } else if (bitMode > 0.5) {
        uint r = uint(clamp(col.r * 1023.0 + 0.5, 0.0, 1023.0));
        uint g = uint(clamp(col.g * 1023.0 + 0.5, 0.0, 1023.0));
        uint b = uint(clamp(col.b * 1023.0 + 0.5, 0.0, 1023.0));
        uint a = uint(clamp(col.a * 3.0 + 0.5, 0.0, 3.0));
        out_pixels[pixelIndex] = (a << 30u) | (b << 20u) | (g << 10u) | r;
    } else {
        uint r = uint(clamp(col.r * 255.0 + 0.5, 0.0, 255.0));
        uint g = uint(clamp(col.g * 255.0 + 0.5, 0.0, 255.0));
        uint b = uint(clamp(col.b * 255.0 + 0.5, 0.0, 255.0));
        uint a = uint(clamp(col.a * 255.0 + 0.5, 0.0, 255.0));
        out_pixels[pixelIndex] = (a << 24u) | (b << 16u) | (g << 8u) | r;
    }
}

vec3 sRGBToLinear(vec3 c) {
    return mix(c / 12.92, pow((c + vec3(0.055)) / 1.055, vec3(2.4)), step(vec3(0.04045), c));
}

vec3 linearToSRGB(vec3 c) {
    c = max(c, vec3(0.0));
    return mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, step(vec3(0.0031308), c));
}

vec3 compressShoulder(vec3 c) {
    return c / (vec3(1.0) + c * 0.35);
}

float interleavedGradientNoise(vec2 screenPos) {
    vec3 magic = vec3(0.06711056, 0.00583715, 52.9829189);
    return fract(magic.z * fract(dot(screenPos, magic.xy)));
}

vec3 hueToRGB(float h) {
    float r = abs(h * 6.0 - 3.0) - 1.0;
    float g = 2.0 - abs(h * 6.0 - 2.0);
    float b = 2.0 - abs(h * 6.0 - 4.0);
    return clamp(vec3(r, g, b), 0.0, 1.0);
}

vec3 tonemapAnimeFilmic(vec3 x) {
    x = max(vec3(0.0), x);
    vec3 a = x * (2.2 * x + vec3(0.04));
    vec3 b = x * (2.0 * x + vec3(0.55)) + vec3(0.14);
    return clamp(a / b, 0.0, 1.0);
}

vec3 tonemapAgX(vec3 x) {
    x = max(vec3(0.0), x);
    vec3 mapped = (x * (x + vec3(0.024)) - vec3(0.00009)) /
                  (x * (0.98 * x + vec3(0.43)) + vec3(0.24));
    return clamp(mapped, 0.0, 1.0);
}

vec3 sample3DLut(vec3 color, float opacity) {
    if (opacity <= 0.001) return color;

    vec3 coord = clamp(color, 0.0, 1.0) * 31.0;
    ivec3 c0 = clamp(ivec3(floor(coord)), ivec3(0), ivec3(31));
    ivec3 c1 = clamp(c0 + ivec3(1), ivec3(0), ivec3(31));
    vec3 f = fract(coord);

    #define LUT_IDX(r, g, b) (((b) * 1024 + (g) * 32 + (r)) * 3)

    int idx000 = LUT_IDX(c0.x, c0.y, c0.z);
    int idx100 = LUT_IDX(c1.x, c0.y, c0.z);
    int idx010 = LUT_IDX(c0.x, c1.y, c0.z);
    int idx110 = LUT_IDX(c1.x, c1.y, c0.z);
    int idx001 = LUT_IDX(c0.x, c0.y, c1.z);
    int idx101 = LUT_IDX(c1.x, c0.y, c1.z);
    int idx011 = LUT_IDX(c0.x, c1.y, c1.z);
    int idx111 = LUT_IDX(c1.x, c1.y, c1.z);

    vec3 s000 = vec3(lut_table[idx000], lut_table[idx000 + 1], lut_table[idx000 + 2]);
    vec3 s100 = vec3(lut_table[idx100], lut_table[idx100 + 1], lut_table[idx100 + 2]);
    vec3 s010 = vec3(lut_table[idx010], lut_table[idx010 + 1], lut_table[idx010 + 2]);
    vec3 s110 = vec3(lut_table[idx110], lut_table[idx110 + 1], lut_table[idx110 + 2]);
    vec3 s001 = vec3(lut_table[idx001], lut_table[idx001 + 1], lut_table[idx001 + 2]);
    vec3 s101 = vec3(lut_table[idx101], lut_table[idx101 + 1], lut_table[idx101 + 2]);
    vec3 s011 = vec3(lut_table[idx011], lut_table[idx011 + 1], lut_table[idx011 + 2]);
    vec3 s111 = vec3(lut_table[idx111], lut_table[idx111 + 1], lut_table[idx111 + 2]);

    vec3 s00 = mix(s000, s100, f.x);
    vec3 s01 = mix(s001, s101, f.x);
    vec3 s10 = mix(s010, s110, f.x);
    vec3 s11 = mix(s011, s111, f.x);
    vec3 s0 = mix(s00, s10, f.y);
    vec3 s1 = mix(s01, s11, f.y);

    return mix(color, mix(s0, s1, f.z), opacity);
}

float evalCatmullRom(float x, float p0, float p1, float p2, float p3, float p4) {
    x = clamp(x, 0.0, 1.0);
    float seg = x * 4.0;
    int idx = int(floor(seg));
    if (idx >= 4) return p4;
    float t = seg - float(idx);

    float cp0 = (idx == 0) ? p0 : (idx == 1) ? p0 : (idx == 2) ? p1 : p2;
    float cp1 = (idx == 0) ? p0 : (idx == 1) ? p1 : (idx == 2) ? p2 : p3;
    float cp2 = (idx == 0) ? p1 : (idx == 1) ? p2 : (idx == 2) ? p3 : p4;
    float cp3 = (idx == 0) ? p2 : (idx == 1) ? p3 : (idx == 2) ? p4 : p4;

    float m1 = clamp(0.5 * (cp2 - cp0), -1.2, 1.2);
    float m2 = clamp(0.5 * (cp3 - cp1), -1.2, 1.2);
    float t2 = t * t;
    float t3 = t2 * t;

    float h00 = 2.0 * t3 - 3.0 * t2 + 1.0;
    float h10 = t3 - 2.0 * t2 + t;
    float h01 = -2.0 * t3 + 3.0 * t2;
    float h11 = t3 - t2;

    return clamp(h00 * cp1 + h10 * m1 + h01 * cp2 + h11 * m2, 0.0, 1.0);
}

float hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
}

vec3 colorTempToRGB(float kelvin) {
    if (kelvin < 1000.0) return vec3(1.0);
    float temp = kelvin / 100.0;
    float red, green, blue;

    if (temp <= 66.0) {
        red = 255.0;
        green = temp;
        green = 99.4708025861 * log(max(green, 1.0)) - 161.1195681661;
        if (temp <= 19.0) {
            blue = 0.0;
        } else {
            blue = temp - 10.0;
            blue = 138.5177312231 * log(max(blue, 1.0)) - 305.0447927307;
        }
    } else {
        red = temp - 60.0;
        red = 329.698727446 * pow(max(red, 1.0), -0.1332047592);
        green = temp - 60.0;
        green = 288.1221695283 * pow(max(green, 1.0), -0.0755148492);
        blue = 255.0;
    }

    return clamp(vec3(red, green, blue) / 255.0, 0.0, 1.0);
}

vec3 applyBlendMode(vec3 baseCol, vec3 blendCol, int mode, float opacity) {
    vec3 result = blendCol;
    if (mode == 1) { // Screen
        result = 1.0 - (1.0 - baseCol) * (1.0 - clamp(blendCol, 0.0, 1.0));
    } else if (mode == 2) { // Linear Add
        result = baseCol + blendCol * 0.75;
    } else if (mode == 3) { // Overlay
        result = mix(2.0 * baseCol * blendCol, 1.0 - 2.0 * (1.0 - baseCol) * (1.0 - blendCol), step(vec3(0.5), baseCol));
    } else if (mode == 4) { // Soft Light
        result = (1.0 - 2.0 * blendCol) * baseCol * baseCol + 2.0 * blendCol * baseCol;
    } else if (mode == 5) { // Multiply
        result = baseCol * blendCol;
    }
    return mix(baseCol, clamp(result, 0.0, 1.0), clamp(opacity, 0.0, 1.0));
}

// -----------------------------------------------------------------------------
// DUAL KAWASE BLUR TIER PACKING (Packed in RGB8 inside uint)
// -----------------------------------------------------------------------------
vec3 unpackHalfFloat(uint val) {
    float r = float(val & 0xFFu) / 255.0;
    float g = float((val >> 8u) & 0xFFu) / 255.0;
    float b = float((val >> 16u) & 0xFFu) / 255.0;
    return vec3(r, g, b);
}

uint packHalfFloat(vec3 col) {
    uint r = uint(clamp(col.r * 255.0 + 0.5, 0.0, 255.0));
    uint g = uint(clamp(col.g * 255.0 + 0.5, 0.0, 255.0));
    uint b = uint(clamp(col.b * 255.0 + 0.5, 0.0, 255.0));
    return (255u << 24u) | (b << 16u) | (g << 8u) | r;
}

// =============================================================================
// PASS 1 & 2: DUAL KAWASE DOWNSAMPLE (5-TAP CORNER TENT FILTER)
// =============================================================================
void executeKawaseDownsample(int passIdx, ivec2 coord, int w, int h, float radius) {
    int srcW = (passIdx == 1) ? (w * 2) : (w * 2);
    int srcH = (passIdx == 1) ? (h * 2) : (h * 2);

    ivec2 centerCoord = coord * 2;
    int rStep = max(1, int(round(radius)));

    auto fetchSrc = [&](int x, int y) -> vec3 {
        x = clamp(x, 0, srcW - 1);
        y = clamp(y, 0, srcH - 1);
        int idx = y * srcW + x;
        return (passIdx == 1) ? unpackHalfFloat(kawase_l0[idx]) : unpackHalfFloat(kawase_l1[idx]);
    };

    // 5-Tap Kawase Downsample: 4 * center + 4 corners
    vec3 sum = fetchSrc(centerCoord.x, centerCoord.y) * 4.0;
    sum += fetchSrc(centerCoord.x - rStep, centerCoord.y - rStep);
    sum += fetchSrc(centerCoord.x + rStep, centerCoord.y - rStep);
    sum += fetchSrc(centerCoord.x - rStep, centerCoord.y + rStep);
    sum += fetchSrc(centerCoord.x + rStep, centerCoord.y + rStep);
    sum /= 8.0;

    int dstIdx = coord.y * w + coord.x;
    if (passIdx == 1) {
        kawase_l1[dstIdx] = packHalfFloat(sum);
    } else {
        kawase_l2[dstIdx] = packHalfFloat(sum);
    }
}

// =============================================================================
// PASS 3 & 4: DUAL KAWASE UPSAMPLE (8-TAP SMOOTH TENT BLUR)
// =============================================================================
void executeKawaseUpsample(int passIdx, ivec2 coord, int w, int h, float radius) {
    int srcW = (passIdx == 3) ? (w / 2) : (w / 2);
    int srcH = (passIdx == 3) ? (h / 2) : (h / 2);

    ivec2 srcCoord = coord / 2;
    int rStep = max(1, int(round(radius)));

    auto fetchSrc = [&](int x, int y) -> vec3 {
        x = clamp(x, 0, srcW - 1);
        y = clamp(y, 0, srcH - 1);
        int idx = y * srcW + x;
        return (passIdx == 3) ? unpackHalfFloat(kawase_l2[idx]) : unpackHalfFloat(kawase_l1[idx]);
    };

    // 8-Tap Kawase Upsample Filter: 4 orthogonal (weight 2) + 4 diagonals (weight 1)
    vec3 sum = vec3(0.0);
    sum += fetchSrc(srcCoord.x - rStep, srcCoord.y) * 2.0;
    sum += fetchSrc(srcCoord.x + rStep, srcCoord.y) * 2.0;
    sum += fetchSrc(srcCoord.x, srcCoord.y - rStep) * 2.0;
    sum += fetchSrc(srcCoord.x, srcCoord.y + rStep) * 2.0;

    sum += fetchSrc(srcCoord.x - rStep, srcCoord.y - rStep);
    sum += fetchSrc(srcCoord.x + rStep, srcCoord.y - rStep);
    sum += fetchSrc(srcCoord.x - rStep, srcCoord.y + rStep);
    sum += fetchSrc(srcCoord.x + rStep, srcCoord.y + rStep);
    sum /= 12.0;

    int dstIdx = coord.y * w + coord.x;
    if (passIdx == 3) {
        vec3 existing = unpackHalfFloat(kawase_l1[dstIdx]);
        kawase_l1[dstIdx] = packHalfFloat(mix(existing, sum, 0.50));
    } else {
        vec3 existing = unpackHalfFloat(kawase_l0[dstIdx]);
        kawase_l0[dstIdx] = packHalfFloat(mix(existing, sum, 0.50));
    }
}

// =============================================================================
// PASS 5: MASTER COMPOSITE (Dual Kawase Cloud + Color Grade + Line Protection)
// =============================================================================
void executeKawaseComposite(ivec2 coord, int width, int height) {
    int pixelIndex = coord.y * width + coord.x;
    float bitMode = u_bitDepthMode;
    vec4 gradedPixel = unpackOut_Dynamic(pixelIndex, bitMode);
    vec3 finalCol = gradedPixel.rgb;

    int l0X = clamp(coord.x / 2, 0, (width / 2) - 1);
    int l0Y = clamp(coord.y / 2, 0, (height / 2) - 1);
    vec3 bloomCloud = unpackHalfFloat(kawase_l0[l0Y * (width / 2) + l0X]);

    LayerData L = layers[0];

    // Compute Sobel line edge so ink lines stay 100% sharp and clean
    float resScale = float(max(width, height)) / 720.0;
    int edgeStep = max(1, int(round(resScale)));
    float gx = 0.0, gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 c = clamp(coord + ivec2(x * edgeStep, y * edgeStep), ivec2(0), ivec2(width - 1, height - 1));
            vec4 p = unpackOut_Dynamic(c.y * width + c.x, bitMode);
            float lum = dot(p.rgb, vec3(0.2126, 0.7152, 0.0722));
            gx += lum * float(x) * ((y == 0) ? 2.0 : 1.0);
            gy += lum * float(y) * ((x == 0) ? 2.0 : 1.0);
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);

    // Apply Tint
    vec3 glowTint = vec3(1.0);
    if (L.edgeGlowTint == 1.0) glowTint = vec3(1.20, 1.05, 0.65);
    else if (L.edgeGlowTint == 2.0) glowTint = vec3(0.40, 1.10, 1.45);
    else if (L.edgeGlowTint == 3.0) glowTint = vec3(1.25, 0.85, 0.40);
    else if (L.edgeGlowTint == 4.0) glowTint = vec3(1.30, 0.25, 0.30);
    else if (L.edgeGlowTint == 5.0) glowTint = vec3(1.00, 0.55, 1.45);
    else if (L.edgeGlowTint == 6.0) glowTint = vec3(1.35, 0.65, 0.95);

    // 1. DUAL KAWASE CONTINUOUS BLOOM COMPOSITE (Zero Ghost Duplicates)
    float totalGlowWeight = L.deepGlowIntensity + u_shaderlyGlowIntensity + L.sapphireGlowWidth;
    if (totalGlowWeight > 0.01) {
        vec3 finalBloom = bloomCloud * glowTint * (totalGlowWeight * 1.25);
        // Light wraps AROUND the character, ink line is never washed out
        finalBloom *= (1.0 - lineEdge * 0.65);
        finalBloom = compressShoulder(finalBloom);

        finalCol = 1.0 - (1.0 - finalCol) * (1.0 - clamp(finalBloom, 0.0, 0.88));
    }

    // Master Tonemapping
    if (u_tonemapMode == 1.0) finalCol = tonemapAnimeFilmic(finalCol);
    else if (u_tonemapMode == 2.0) finalCol = tonemapAgX(finalCol);

    // Adaptive Dither
    if (u_ditherStrength > 0.01) {
        float ign = interleavedGradientNoise(vec2(coord));
        float quantStep = bitMode > 1.5 ? (1.0 / 65535.0) : (bitMode > 0.5 ? (1.0 / 1023.0) : (1.0 / 255.0));
        finalCol = clamp(finalCol + vec3((ign - 0.5) * quantStep * (u_ditherStrength * 3.5)), 0.0, 1.0);
    }

    packRGBA_Dynamic(pixelIndex, vec4(finalCol, gradedPixel.a), bitMode);
}

// =============================================================================
// MAIN ENTRY POINT
// =============================================================================
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    int width = u_passWidth;
    int height = u_passHeight;

    if (coord.x >= width || coord.y >= height) return;

    // Route to the appropriate Dual Kawase Pass
    if (u_passIndex == 1 || u_passIndex == 2) {
        executeKawaseDownsample(u_passIndex, coord, width, height, u_passRadius);
        return;
    } else if (u_passIndex == 3 || u_passIndex == 4) {
        executeKawaseUpsample(u_passIndex, coord, width, height, u_passRadius);
        return;
    } else if (u_passIndex == 5) {
        executeKawaseComposite(coord, width, height);
        return;
    }

    // -------------------------------------------------------------------------
    // PASS 0: FULL COLOR GRADE PIPELINE (100% OF YOUR ORIGINAL FILTERS INTACT)
    // -------------------------------------------------------------------------
    int pixelIndex = coord.y * width + coord.x;
    float bitMode = u_bitDepthMode;
    vec4 basePixel = unpackRGBA_Dynamic(pixelIndex, bitMode);
    vec3 currentComposite = basePixel.rgb;

    float resScale = float(max(width, height)) / 720.0;
    int edgeStep = max(1, int(round(resScale)));

    float gx = 0.0, gy = 0.0;
    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 c = clamp(coord + ivec2(x * edgeStep, y * edgeStep), ivec2(0), ivec2(width - 1, height - 1));
            vec4 p = unpackRGBA_Dynamic(c.y * width + c.x, bitMode);
            float lum = dot(p.rgb, vec3(0.2126, 0.7152, 0.0722));
            float kx = float(x) * ((y == 0) ? 2.0 : 1.0);
            float ky = float(y) * ((x == 0) ? 2.0 : 1.0);
            gx += lum * kx;
            gy += lum * ky;
        }
    }
    float lineEdge = clamp(sqrt(gx * gx + gy * gy) * 1.5, 0.0, 1.0);
    vec2 edgeNormal = (lineEdge > 0.05) ? normalize(vec2(gx, gy)) : vec2(0.0);

    int totalLayers = int(clamp(u_layerCount, 0.0, 4.0));

    for (int i = 0; i < totalLayers; i++) {
        LayerData L = layers[i];
        if (L.isEnabled < 0.5) continue;

        vec3 layerColor = currentComposite;

        // 1. TILT-SHIFT DEPTH OF FIELD
        if (L.depthOfField > 0.01) {
            float normY = float(coord.y) / float(height);
            float dofDist = abs(normY - L.dofFocus);
            float dofBlurAmt = smoothstep(0.10, 0.45, dofDist) * L.depthOfField * 6.0 * resScale;
            if (dofBlurAmt > 0.5) {
                vec2 dofDir = vec2(cos(L.dofAngle), sin(L.dofAngle));
                vec3 dofSum = layerColor;
                float dofTotal = 1.0;
                for (int step = 1; step <= 6; step++) {
                    ivec2 dOffset = ivec2(dofDir * (float(step) * (dofBlurAmt / 6.0)));
                    ivec2 dP1 = clamp(coord + dOffset, ivec2(0), ivec2(width - 1, height - 1));
                    ivec2 dP2 = clamp(coord - dOffset, ivec2(0), ivec2(width - 1, height - 1));
                    dofSum += unpackRGBA_Dynamic(dP1.y * width + dP1.x, bitMode).rgb;
                    dofSum += unpackRGBA_Dynamic(dP2.y * width + dP2.x, bitMode).rgb;
                    dofTotal += 2.0;
                }
                layerColor = dofSum / dofTotal;
            }
        }

        // 2. EDGE CHROMATIC ABERRATION
        if (L.lineChromaStrength > 0.001 && lineEdge > 0.05) {
            float edgeFactor = smoothstep(0.08, 0.35, lineEdge);
            ivec2 shift = ivec2(edgeNormal * (L.lineChromaStrength * 3.0 * resScale));
            ivec2 rCoord = clamp(coord + shift, ivec2(0), ivec2(width - 1, height - 1));
            ivec2 bCoord = clamp(coord - shift, ivec2(0), ivec2(width - 1, height - 1));
            layerColor.r = mix(layerColor.r, unpackRGBA_Dynamic(rCoord.y * width + rCoord.x, bitMode).r, edgeFactor * 0.80);
            layerColor.b = mix(layerColor.b, unpackRGBA_Dynamic(bCoord.y * width + bCoord.x, bitMode).b, edgeFactor * 0.80);
        }

        // 3. RGB Directional Warp Shift
        if (u_copiedChromaShift > 0.001) {
            ivec2 cShift = ivec2(int(u_copiedChromaShift * 6.0 * resScale), 0);
            ivec2 rCoord = clamp(coord + cShift, ivec2(0), ivec2(width - 1, height - 1));
            ivec2 bCoord = clamp(coord - cShift, ivec2(0), ivec2(width - 1, height - 1));
            layerColor.r = unpackRGBA_Dynamic(rCoord.y * width + rCoord.x, bitMode).r;
            layerColor.b = unpackRGBA_Dynamic(bCoord.y * width + bCoord.x, bitMode).b;
        }

        // 4. REAL WIDE BILATERAL DENOISE
        if (L.denoise > 0.01) {
            vec3 centerCol = layerColor;
            vec3 denoiseSum = centerCol;
            float denoiseWeight = 1.0;
            int dRad = clamp(int(round(L.denoise * 3.0 * resScale)), 1, 5);
            float sigmaSpatial = max(1.5, L.denoise * 4.0);
            float sigmaColor = 0.16;

            for (int dy = -dRad; dy <= dRad; dy++) {
                for (int dx = -dRad; dx <= dRad; dx++) {
                    if (dx == 0 && dy == 0) continue;
                    ivec2 sc = clamp(coord + ivec2(dx, dy), ivec2(0), ivec2(width - 1, height - 1));
                    vec3 scCol = unpackRGBA_Dynamic(sc.y * width + sc.x, bitMode).rgb;
                    float spatialDist = float(dx * dx + dy * dy);
                    float colorDist = distance(centerCol, scCol);

                    float w = exp(-spatialDist / (2.0 * sigmaSpatial * sigmaSpatial)) * exp(-(colorDist * colorDist) / (2.0 * sigmaColor * sigmaColor));
                    denoiseSum += scCol * w;
                    denoiseWeight += w;
                }
            }
            layerColor = mix(layerColor, denoiseSum / max(denoiseWeight, 0.001), clamp(L.denoise * 0.90, 0.0, 1.0));
        }

        // 5. Frequency Unsharp Mask
        if (L.unsharpAmount > 0.01) {
            int uRad = int(clamp(L.unsharpRadius * resScale, 1.0, 6.0));
            vec3 lowPass = vec3(0.0);
            float uWeightTotal = 0.0;
            for (int uy = -uRad; uy <= uRad; uy += 2) {
                for (int ux = -uRad; ux <= uRad; ux += 2) {
                    ivec2 uc = clamp(coord + ivec2(ux, uy), ivec2(0), ivec2(width - 1, height - 1));
                    lowPass += unpackRGBA_Dynamic(uc.y * width + uc.x, bitMode).rgb;
                    uWeightTotal += 1.0;
                }
            }
            lowPass /= max(uWeightTotal, 1.0);
            vec3 highPass = layerColor - lowPass;
            float diffLum = abs(dot(highPass, vec3(0.2126, 0.7152, 0.0722)));
            if (diffLum >= L.unsharpThreshold) {
                float boost = smoothstep(L.unsharpThreshold, L.unsharpThreshold + 0.10, diffLum);
                layerColor += highPass * (L.unsharpAmount * boost);
            }
        }

        // 6. High-Pass Anime Line Acutance Sharpness
        if (L.sharpness > 0.01) {
            vec3 blur = vec3(0.0);
            blur += unpackRGBA_Dynamic(clamp(coord.y - edgeStep, 0, height - 1) * width + coord.x, bitMode).rgb;
            blur += unpackRGBA_Dynamic(clamp(coord.y + edgeStep, 0, height - 1) * width + coord.x, bitMode).rgb;
            blur += unpackRGBA_Dynamic(coord.y * width + clamp(coord.x - edgeStep, 0, width - 1), bitMode).rgb;
            blur += unpackRGBA_Dynamic(coord.y * width + clamp(coord.x + edgeStep, 0, width - 1), bitMode).rgb;
            blur *= 0.25;
            vec3 detail = layerColor - blur;
            layerColor += detail * (L.sharpness * 1.5);
        }

        // 7. Sobel Cel Line Darkeners
        if (L.darkOutlines > 0.01) {
            float outlineFactor = smoothstep(0.12, 0.40, lineEdge);
            layerColor = mix(layerColor, vec3(0.0), outlineFactor * L.darkOutlines * 0.75);
        }
        if (L.edgeDarken > 0.01) {
            float innerEdge = smoothstep(0.10, 0.45, lineEdge);
            layerColor *= (1.0 - innerEdge * L.edgeDarken * 0.40);
        }

        // 8. Color Temperature
        if (L.temperature > 1000.0 && abs(L.temperature - 6500.0) > 30.0) {
            vec3 tempColor = colorTempToRGB(L.temperature);
            layerColor *= tempColor / colorTempToRGB(6500.0);
        }

        // 9. Exposure, Contrast & Shadows
        if (abs(L.brightness) > 0.001) {
            layerColor *= pow(2.0, L.brightness * 1.4);
        }
        layerColor = (layerColor - 0.18) * L.contrast + 0.18;

        if (L.blackCrush > 0.01) {
            layerColor = smoothstep(vec3(L.blackCrush * 0.08), vec3(1.0), layerColor);
        }

        float luma = dot(layerColor, vec3(0.2126, 0.7152, 0.0722));
        float sWeight = 1.0 - smoothstep(0.0, 0.45, luma);
        layerColor += layerColor * (L.shadows * sWeight * 0.30);

        float hWeight = smoothstep(0.55, 1.0, luma);
        layerColor += layerColor * (L.highlights * hWeight * 0.30);
        layerColor = pow(max(layerColor, vec3(0.0)), vec3(1.0 / max(L.gamma, 0.001)));

        // 10. Magic Mojo II
        if (L.mblMojoTealOrange > 0.01) {
            float shadowMask = clamp(1.0 - luma * 1.5, 0.0, 1.0);
            float warmMask = clamp((luma - 0.40) * 1.6, 0.0, 1.0);
            vec3 tealTint = vec3(0.48, 0.86, 1.12);
            vec3 orangeTint = vec3(1.18, 0.96, 0.74);
            layerColor = mix(layerColor, layerColor * tealTint, shadowMask * L.mblMojoTealOrange * 0.35);
            layerColor = mix(layerColor, layerColor * orangeTint, warmMask * L.mblMojoTealOrange * 0.28);
        }

        // 11. Colorista 3-Way
        if (abs(L.mblColoristaLift) > 0.001 || abs(L.mblColoristaGamma) > 0.001 || abs(L.mblColoristaGain) > 0.001) {
            layerColor += vec3(L.mblColoristaLift) * (1.0 - luma) * 0.5;
            layerColor = pow(max(layerColor, vec3(0.0)), vec3(1.0 / max(1.0 + L.mblColoristaGamma * 0.4, 0.01)));
            layerColor += vec3(L.mblColoristaGain) * luma * 0.5;
        }

        // 12. Cosmo Skin Protection
        if (L.cosmoCleanHighlight > 0.01) {
            float faceMask = smoothstep(0.50, 0.85, luma) * (1.0 - lineEdge);
            float skinLuma = dot(layerColor, vec3(0.2126, 0.7152, 0.0722));
            vec3 neutralHighlight = mix(layerColor, vec3(skinLuma), 0.30);
            layerColor = mix(layerColor, neutralHighlight, faceMask * L.cosmoCleanHighlight * 0.45);
        }

        // 13. Spline Curves
        layerColor.r = evalCatmullRom(layerColor.r, L.curveR0, L.curveR1, L.curveR2, L.curveR3, L.curveR4);
        layerColor.g = mix(layerColor.g, L.curveG2, 0.15 * (L.curveG2 - 0.5));
        layerColor.b = mix(layerColor.b, L.curveB2, 0.15 * (L.curveB2 - 0.5));
        layerColor.r = evalCatmullRom(layerColor.r, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);
        layerColor.g = evalCatmullRom(layerColor.g, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);
        layerColor.b = evalCatmullRom(layerColor.b, L.curveM0, L.curveM1, L.curveM2, L.curveM3, L.curveM4);

        // 14. Saturation & RGB Hue Shift
        luma = dot(layerColor, vec3(0.2126, 0.7152, 0.0722));
        layerColor = mix(vec3(luma), layerColor, L.saturation);

        if (abs(L.hue) > 0.001) {
            float angle = L.hue * 3.14159265;
            float cosA = cos(angle);
            float sinA = sin(angle);
            mat3 hueMat = mat3(
                vec3(0.213 + cosA*0.787 - sinA*0.213, 0.715 - cosA*0.715 - sinA*0.715, 0.072 - cosA*0.072 + sinA*0.928),
                vec3(0.213 - cosA*0.213 + sinA*0.143, 0.715 + cosA*0.285 + sinA*0.140, 0.072 - cosA*0.072 - sinA*0.283),
                vec3(0.213 - cosA*0.213 - sinA*0.787, 0.715 - cosA*0.715 + sinA*0.715, 0.072 + cosA*0.928 + sinA*0.072)
            );
            layerColor = clamp(hueMat * layerColor, 0.0, 1.0);
        }

        // 15. SPLIT TONING
        if (u_splitToneShadowSat > 0.01 || u_splitToneHighSat > 0.01) {
            vec3 sTint = hueToRGB(u_splitToneShadowHue);
            vec3 hTint = hueToRGB(u_splitToneHighHue);
            float pivot = clamp(0.5 + u_splitToneBalance * 0.35, 0.1, 0.9);
            float sFac = smoothstep(pivot, 0.0, luma) * u_splitToneShadowSat * 0.65;
            float hFac = smoothstep(pivot, 1.0, luma) * u_splitToneHighSat * 0.65;
            layerColor = mix(layerColor, layerColor * (sTint * 1.6 + vec3(0.1)), sFac);
            layerColor = mix(layerColor, layerColor * (hTint * 1.5 + vec3(0.1)), hFac);
        }

        // 16. 4-POINT STAR SPARKLE GLINT
        if (u_copiedStarGlint > 0.01 && luma > 0.72) {
            float glint = 0.0;
            int gSpan = int(clamp(u_copiedStarGlint * 16.0 * resScale, 4.0, 24.0));
            for (int d = -gSpan; d <= gSpan; d += 2) {
                float decay = 1.0 - (abs(float(d)) / float(gSpan));
                ivec2 cCross1 = clamp(coord + ivec2(d, d), ivec2(0), ivec2(width - 1, height - 1));
                ivec2 cCross2 = clamp(coord + ivec2(d, -d), ivec2(0), ivec2(width - 1, height - 1));
                glint += dot(unpackRGBA_Dynamic(cCross1.y * width + cCross1.x, bitMode).rgb, vec3(0.333)) * decay;
                glint += dot(unpackRGBA_Dynamic(cCross2.y * width + cCross2.x, bitMode).rgb, vec3(0.333)) * decay;
            }
            glint = (glint / float(gSpan * 2)) * u_copiedStarGlint * 0.60;
            layerColor += vec3(glint);
        }

        // 17. REAL 1D ANAMORPHIC FLARES
        if (L.thinStreakIntensity > 0.01 && L.thinStreakOpacity > 0.01) {
            float halfSpan = clamp(L.thinStreakWidth * float(width) * 0.35, 30.0, float(width) * 0.5);
            vec3 flareAccum = vec3(0.0);
            float totalW = 0.0;
            float vRadius = max(1.0, 2.5 * resScale);

            for (int s = -24; s <= 24; s++) {
                float normX = float(s) / 24.0;
                float pixelDist = normX * halfSpan;
                float falloffX = exp(-2.8 * normX * normX);

                for (int vy = -1; vy <= 1; vy++) {
                    float falloffY = (vy == 0) ? 1.0 : 0.5;
                    ivec2 sc = clamp(coord + ivec2(int(pixelDist), int(float(vy) * vRadius)), ivec2(0), ivec2(width - 1, height - 1));
                    vec3 srcCol = unpackRGBA_Dynamic(sc.y * width + sc.x, bitMode).rgb;
                    float srcLuma = dot(srcCol, vec3(0.2126, 0.7152, 0.0722));

                    float highlightEnergy = smoothstep(0.70, 0.98, srcLuma);
                    if (highlightEnergy > 0.001) {
                        float w = falloffX * falloffY;
                        flareAccum += srcCol * highlightEnergy * w;
                        totalW += w;
                    }
                }
            }

            if (totalW > 0.001) {
                vec3 flareBeam = (flareAccum / totalW) * (L.thinStreakIntensity * 2.2) * L.thinStreakOpacity;
                flareBeam = compressShoulder(flareBeam);
                layerColor = 1.0 - (1.0 - layerColor) * (1.0 - clamp(flareBeam, 0.0, 0.80));
            }
        }

        // 18. VOLUMETRIC GOD RAYS
        if (L.bslaGodRays > 0.01) {
            vec2 sunPos = vec2(float(width) * 0.5, float(height) * 0.05);
            vec2 rayDir = normalize(vec2(coord) - sunPos + vec2(0.001));
            vec3 rayAccum = vec3(0.0);
            float rayWeight = 0.0;
            float stepSize = float(max(width, height)) / 32.0;

            float jitter = hash12(vec2(coord) + vec2(u_time));
            for (int s = 1; s <= 24; s++) {
                float dist = (float(s) + jitter) * stepSize * 0.35;
                vec2 samplePos = vec2(coord) - rayDir * dist;
                ivec2 sc = clamp(ivec2(samplePos), ivec2(0), ivec2(width - 1, height - 1));
                vec3 scCol = unpackRGBA_Dynamic(sc.y * width + sc.x, bitMode).rgb;
                float scLuma = dot(scCol, vec3(0.2126, 0.7152, 0.0722));

                float shaftMask = smoothstep(0.48, 0.92, scLuma);
                float decay = exp(-0.06 * float(s));
                rayAccum += scCol * shaftMask * decay;
                rayWeight += decay;
            }

            if (rayWeight > 0.001) {
                vec3 radiantShafts = (rayAccum / rayWeight) * (L.bslaGodRays * 2.0);
                vec3 warmSun = vec3(1.15, 1.05, 0.85);
                radiantShafts = compressShoulder(radiantShafts * warmSun);
                layerColor = 1.0 - (1.0 - layerColor) * (1.0 - clamp(radiantShafts, 0.0, 0.75));
            }
        }

        // 19. Volumetric Fog
        if (L.bslaFogDensity > 0.01) {
            vec2 uv = vec2(coord) / vec2(width, height);
            float fogAlt = smoothstep(1.0 - L.bslaFogDepth, 0.0, uv.y);
            vec3 mistColor = vec3(0.68, 0.75, 0.82) * (1.0 + L.bslaBloomHaze * 0.5);
            float fogAmount = L.bslaFogDensity * (0.25 + 0.75 * fogAlt);
            layerColor = mix(layerColor, mistColor, clamp(fogAmount, 0.0, 0.65));
        }

        // 20. Pro-Mist & Halation
        if (L.halationRadius > 0.01 || u_copiedProMist > 0.01) {
            float mistStrength = max(L.halationRadius, u_copiedProMist);
            float redBleed = smoothstep(0.55, 0.95, luma) * mistStrength * 0.25;
            layerColor.r += redBleed * (1.0 + L.halationWarmth * 0.40);
            layerColor.g += redBleed * (0.20 + L.halationWarmth * 0.10);
        }

        // 21. Film Grain
        if (L.filmGrain > 0.001) {
            float noise = (hash12(vec2(coord) + vec2(u_time * 17.13, u_time * 31.37)) - 0.5);
            layerColor += vec3(noise * L.filmGrain * 0.06);
        }

        // 22. Micro-Pulse / Flicker
        if (L.flickerIntensity > 0.005) {
            float freq = max(L.flickerSpeed, 1.0) * 6.2831853;
            float fWave = sin(u_time * freq) * 0.5 + 0.5;
            layerColor *= (1.0 + (fWave - 0.5) * L.flickerIntensity * 0.30);
        }

        // 23. Radial & Boxed Vignettes
        if (L.vignette > 0.01) {
            vec2 uv = (vec2(coord) / vec2(width, height)) - 0.5;
            float dist = length(uv);
            float vig = smoothstep(0.75, 0.15, dist * (0.7 + L.vignette * 0.8));
            layerColor *= clamp(vig, 0.0, 1.0);
        }
        if (L.vignetteBoxed > 0.01) {
            vec2 uv = abs((vec2(coord) / vec2(width, height)) - 0.5) * 2.0;
            float boxDist = max(uv.x, uv.y);
            float boxVig = smoothstep(0.95, 0.20, boxDist * (0.7 + L.vignetteBoxed * 0.8));
            layerColor *= clamp(boxVig, 0.0, 1.0);
        }

        // 24. Centre Aura & Horizontal Ramp
        vec2 uv = vec2(coord) / vec2(width, height);
        if (L.centerAura > 0.01) {
            float dist = length(uv - 0.5);
            float aura = smoothstep(0.60, 0.0, dist) * L.centerAura * 0.30;
            layerColor += vec3(aura);
        }
        if (u_horizontalRamp > 0.01) {
            float ramp = smoothstep(0.35, 0.65, uv.y) * u_horizontalRamp * 0.30;
            layerColor *= (1.0 + ramp);
        }

        currentComposite = applyBlendMode(currentComposite, layerColor, int(L.blendMode), L.opacity);
    }

    // 25. ISOLATED TEXT SUITE METALLIC BEVEL
    if (u_textSuiteEnabled > 0.5) {
        vec2 normCoord = vec2(coord) / vec2(width, height);
        bool inBox = (normCoord.x >= u_textBoxX && normCoord.x <= (u_textBoxX + u_textBoxW) &&
                      normCoord.y >= u_textBoxY && normCoord.y <= (u_textBoxY + u_textBoxH));

        if (inBox) {
            float textLuma = dot(currentComposite, vec3(0.2126, 0.7152, 0.0722));
            float textMask = smoothstep(0.50, 0.80, textLuma) * smoothstep(0.08, 0.40, lineEdge);

            if (textMask > 0.01) {
                vec3 N = normalize(vec3(edgeNormal.x * (u_textBevelDepth * resScale), edgeNormal.y * (u_textBevelDepth * resScale), 1.0));
                vec3 L_dir = normalize(vec3(0.35, -0.65, 0.65));
                float NdotL = max(0.0, dot(N, L_dir));

                float reflY = clamp(N.y * 0.5 + 0.5, 0.0, 1.0);
                float chromeReflection = sin(reflY * 6.28318) * 0.5 + 0.5;
                chromeReflection = pow(chromeReflection, 2.0) * u_textChromeIntensity;

                vec3 V = vec3(0.0, 0.0, 1.0);
                vec3 H = normalize(L_dir + V);
                float spec = pow(max(0.0, dot(N, H)), 24.0) * 1.8;

                vec3 chromeColor = mix(vec3(0.12, 0.14, 0.18), vec3(0.95, 0.98, 1.05), chromeReflection);
                chromeColor += vec3(spec);

                currentComposite = mix(currentComposite, chromeColor, textMask * 0.90);
            }
        }
    }

    // 26. 3D LUT APPLICATION
    if (u_hasLut > 0.5) {
        currentComposite = sample3DLut(currentComposite, u_lutOpacity);
    }

    // Write base composite to OutputBuffer
    packRGBA_Dynamic(pixelIndex, vec4(currentComposite, basePixel.a), bitMode);

    // -------------------------------------------------------------------------
    // WRITE TO DUAL KAWASE LEVEL 0 BUFFER (Prefilter Highlights & Edge Outward Rays)
    // -------------------------------------------------------------------------
    if ((coord.x % 2 == 0) && (coord.y % 2 == 0)) {
        int l0Idx = (coord.y / 2) * (width / 2) + (coord.x / 2);
        float lumaVal = dot(currentComposite, vec3(0.2126, 0.7152, 0.0722));

        // Soft-knee highlight threshold for Deep Glow & Soft Bloom
        float thresh = clamp(layers[0].deepGlowThreshold, 0.15, 0.88);
        float knee = smoothstep(thresh, thresh + 0.20, lumaVal);

        // Sapphire S_Glow and S_EdgeRays: Outward edge radiance
        float edgeRadiance = smoothstep(0.10, 0.40, lineEdge) * smoothstep(0.35, 0.85, lumaVal) * (u_copiedEdgeRays * 1.4);

        vec3 prefilterGlow = currentComposite * max(knee, edgeRadiance);
        kawase_l0[l0Idx] = packHalfFloat(prefilterGlow);
    }
}
